{
  "version": 2,
  "redzone": [
    {
      "id": "database",
      "globs": ["prisma/schema.prisma", "prisma/migrations/**", "prisma/seed.ts", "src/modules/permissions/permission-catalog.ts"],
      "why": "数据结构、迁移与权限 seed"
    },
    {
      "id": "authentication",
      "globs": ["src/modules/auth/**", "src/modules/authz/**", "src/modules/permissions/*.service.ts", "src/common/guards/**", "src/common/decorators/*auth*", "src/common/decorators/*public*", "src/**/*throttle*", "src/modules/storage/storage-crypto.service.ts", "src/bootstrap/**", "src/main.ts", "src/app.module.ts"],
      "why": "身份、判权核心、凭证加密与全局接线"
    }
  ],
  "selfGuard": [
    {
      "id": "ci-control",
      "globs": [".github/workflows/**", "harness/redzone.json", "package.json", "pnpm-lock.yaml", "eslint*.mjs", "eslint-rules/**", "harness/*baseline*.json", "harness/ratchet-registry.json", "tsconfig*.json", "test/jest*.ts", "test/tsconfig*.json", "test/setup/**", "scripts/check-cold-lint.ts", ".env.test", ".claude/settings.json"],
      "why": "测试和 lint 执行入口、豁免基线、危险命令设置及可信裁判"
    }
  ]
}
