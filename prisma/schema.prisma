// =============================================================================
// ===== 保险模块 T1(2026-06-13)三表 + Activity.requiresInsurance =====
//
// 沿冻结评审稿 docs/archive/reviews/insurance-module-review.md §3.1(maintainer
// 2026-06-12 goal「保险模块」拍板)。业务依据:报名"无保险信息不予通过" + 志愿者
// 自购 + 队统一买(需求 :687/:698/:422/:452 + 顶层设计 §8 + C015)。
// - member_insurances:自购保险,每队员多条,App 自助 CRUD(self-scope 不接 RBAC);
//   coverageEnd 是有效性唯一依据(D-INS-5,自报即可 v1 无核验);policyNumber 无唯一约束(E-2)。
// - team_insurance_policies:队统一保单,一张 = 一条,admin CRUD;软删不级联覆盖行
//   (门槛查询 join p.deletedAt IS NULL,被删保单下覆盖行自然失效,E-4)。
// - team_insurance_coverages:保单 × 队员 join;partial unique (policyId, memberId)
//   WHERE "deletedAt" IS NULL 由 migration.sql 末尾手写(E-3,沿 activity_registrations 范式);
//   service 用 P2002 兜底转 26004。
// - 字段长度上限不落 @db.VarChar,由 DTO + class-validator 承担(沿批次 1/2/3 B 路径)。
// - 保单图不占 schema 字段:attachments 多态(ownerType + ownerId)天然支持,
//   接线(enum 分支 + 8 权限码)挂 NEXT_TASKS 单独立项(E-20)。
// =============================================================================

model MemberInsurance {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberId         String
  insurerName      String // 保险公司;长度 128 由 DTO 约束(沿 Certificate.issuingOrg 范式)
  policyNumber     String // 保单号;长度 128 由 DTO 约束(沿 certNumber;无唯一约束,E-2)
  coverageStart    DateTime? // 起保日(可选;有值时门槛校验 coverageStart <= 活动 startAt,E-11)
  coverageEnd      DateTime // 到期时间(必填;有效性唯一依据,D-INS-5)
  expireNotifiedAt DateTime? // v0.47.0 到期提醒幂等 marker;首次命中 30 天窗口后置 now,不因改期自动清空

  // D-INSURANCE v3 PR4 final。legacy(含软删)仍沿 PR1 统一 pending/v0，不推断 verified；
  // version 非负且 pending/reviewed snapshot 组合由 migration CHECK 兜底。
  reviewStatusCode String    @default("pending") // pending / verified / rejected
  version          Int       @default(0)
  reviewedByUserId String?
  reviewedAt       DateTime?

  member                        Member                         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  reviewer                      User?                          @relation("MemberInsuranceReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  insuranceEligibilityEvidences InsuranceEligibilityEvidence[]

  @@index([memberId])
  @@index([reviewStatusCode])
  @@index([reviewedByUserId])
  @@index([coverageEnd])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("member_insurances")
}

model TeamInsurancePolicy {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  insurerName      String // 保险公司;长度 128 由 DTO 约束
  policyNumber     String // 保单号;长度 128 由 DTO 约束
  coverageStart    DateTime // 起保(必填,goal ②)
  coverageEnd      DateTime // 到期
  expireNotifiedAt DateTime? // v0.47.0 管理面到期提醒幂等 marker;首次命中 30 天窗口后置 now
  note             String? // 备注;长度 500 由 DTO 约束

  coverages TeamInsuranceCoverage[]

  @@index([coverageEnd])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("team_insurance_policies")
}

model TeamInsuranceCoverage {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  policyId String
  memberId String

  policy                        TeamInsurancePolicy            @relation(fields: [policyId], references: [id], onDelete: Restrict)
  member                        Member                         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  insuranceEligibilityEvidences InsuranceEligibilityEvidence[]

  // 业务唯一约束(partial unique;E-3):
  // - (policyId, memberId) WHERE "deletedAt" IS NULL
  // - 索引名 team_insurance_coverages_policy_member_active_unique
  // - Prisma DSL 不支持带 WHERE,migration.sql 末尾手动追加(沿 ActivityRegistration 范式)
  @@index([policyId])
  @@index([memberId])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("team_insurance_coverages")
}

// D-INSURANCE v3 PR4 final evidence model.
// exactly-one、kind 对齐、区间、审核快照、跨 member、全局单 owner 与 immutable
// 约束定义于 20260719160335_insurance_constraints migration，deploy 后才在 DB 生效；
// Prisma DSL 仅表达最终必填列与关系，CHECK/partial unique/trigger 以 migration source 为准。
// 本表刻意不含 updatedAt/deletedAt，也不存保单号、图片/附件/key/URL 或自由文本。
model InsuranceEligibilityEvidence {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  sourceKind              String
  memberInsuranceId       String?
  teamInsuranceCoverageId String?
  ownerKind               String
  activityRegistrationId  String?
  teamJoinApplicationId   String?
  sourceRevision          Int?
  sourceReviewedByUserId  String?
  sourceReviewedAt        DateTime?
  requiredFrom            DateTime
  requiredThrough         DateTime
  sourceCoverageStart     DateTime?
  sourceCoverageEnd       DateTime

  memberInsurance       MemberInsurance?       @relation(fields: [memberInsuranceId], references: [id], onDelete: Restrict)
  teamInsuranceCoverage TeamInsuranceCoverage? @relation(fields: [teamInsuranceCoverageId], references: [id], onDelete: Restrict)
  activityRegistration  ActivityRegistration?  @relation(fields: [activityRegistrationId], references: [id], onDelete: Restrict)
  teamJoinApplication   TeamJoinApplication?   @relation(fields: [teamJoinApplicationId], references: [id], onDelete: Restrict)
  sourceReviewer        User?                  @relation("InsuranceEvidenceSourceReviewer", fields: [sourceReviewedByUserId], references: [id], onDelete: Restrict)

  @@index([memberInsuranceId])
  @@index([teamInsuranceCoverageId])
  @@index([activityRegistrationId])
  @@index([teamJoinApplicationId])
  @@index([sourceReviewedByUserId])
  @@index([createdAt])
  @@map("insurance_eligibility_evidences")
}

// =============================================================================
// ===== 招新一期(招新前段)T1(2026-06-18)3 表 + RealnameProviderType enum =====
//
// 沿冻结评审稿 docs/archive/reviews/recruitment-phase1-review.md §3.1(maintainer
// 2026-06-18 goal「招新一期(招新前段)」拍板 + §0.5 四分叉元核验冻结 + 3 配套)。
// 业务依据:招新需求会(讨论稿 v1 + 技术就绪度对照 v1)。报名者不建 User / 不进 members,
// 身份全由 recruitment_applications 承载,临时编号绑报名记录、永不进 members(D-R-1)。
// - recruitment_cycles:招新轮次,后台开/关 + 容量(可临时增容)+ tempNoSeq 临时编号原子
//   计数器(发号时 update +1,行级自增天然串行,E-R-9)+ 通知配置(后填,E-R-17)。
// - recruitment_applications:报名记录;openid 锚点(code2session 复用,E-R-7);敏感资料
//   (留存 SOP 30 天后 NULL 化 + 按 idCardImageKey 删 storage blob,配套②)与脱敏留存字段
//   (永久行级)共存(D-R-7 / E-R-14);statusCode String 沿 activity_registrations 范式(4 态);
//   tempNo 仅 verified 有值、≠ memberNo;**仅 FK→cycle(无 Member FK,D-R-1 的 schema 保证)**。
//   partial unique ×2 由 migration.sql 末尾手写(E-R-9/10,Prisma DSL 不支持带 WHERE)。
// - realname_verification_settings:实名核验单例,镜像 SmsSettings;凭证两段(secretId+
//   secretKey)AES-256-GCM(RealnameCryptoService,T2)明文永不入库;singleton 由 Service 保证。
// - 字段长度上限不落 @db.VarChar,由 DTO + class-validator 承担(沿近期惯例)。
// =============================================================================

model RecruitmentCycle {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  year        Int // 招新年份(临时编号 T{year}{seq} 的 year)
  name        String // 轮次名(如「2026 年度招新」);长度由 DTO 约束
  statusCode  String // open / closed(后台开关;String 沿 activity_registrations.statusCode 范式)
  capacity    Int? // 容量上限(可临时增容;null=不限)
  tempNoSeq   Int       @default(0) // 临时编号原子计数器(发号时 update +1,E-R-9)
  // 招新二期(2026-06-19,评审稿 recruitment-phase2-review.md E-R2-6):永久编号当年流水原子计数器
  // (批量 promote 单事务内 +N,镜像 tempNoSeq 行级自增);{YY}{NNN} 的 NNN。
  memberNoSeq Int       @default(0)
  openedAt    DateTime?
  closedAt    DateTime?

  // 通知配置(后填;小程序展示 + 可选短信文案;E-R-17)
  meetingInfo    String? // 见面会信息
  qqGroup        String? // QQ 群
  notifyTemplate Json? // 可配置通知模板(各节点文案)

  applications     RecruitmentApplication[]
  identitySessions RecruitmentIdentitySession[]

  // 业务唯一约束(partial unique;migration.sql 手写,Prisma DSL 不支持带 WHERE;十项收口刀B):
  // - recruitment_cycles_single_open_unique ON ("statusCode")
  //   WHERE "statusCode" = 'open' AND "deletedAt" IS NULL —— 至多一个 open 轮 DB 兜底
  //   (开轮 count-then-update 在 READ COMMITTED 下可并发穿透);service P2002 兜底转 28032
  @@index([year])
  @@index([statusCode])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("recruitment_cycles")
}

model RecruitmentApplication {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cycleId    String
  statusCode String // pending_verification / verified / manual_review / rejected
  tempNo     String? // 临时编号 T{year}{seq};仅 verified 有值;≠ memberNo(永不进 members)

  openid String? // 微信 openid(code2session;再查询 + 同轮去重次级键;掩码回显)

  // ===== 敏感资料(留存 SOP:rejected 或 本轮 closed 满 30 天后 NULL 化 + 按 idCardImageKey 删 blob)=====
  realName          String?
  idCardNumber      String? // 身份证号(高敏感;同轮去重键;留存清)
  birthDate         DateTime? // 精确生日(从身份证号提取;留存清)
  phone             String? // 手机(仅通知联系方式,非身份证据,配套③;留存清)
  detailedAddress   String? // 详细住址(留存清)
  idCardImageKey    String? // 证件照 storage key(分叉③A;留存按 key 删 storage blob)
  emergencyContacts Json? // 紧急联系人 ≥2:[{name, relation, phone}](留存清)
  profileExtra      Json? // 其余报名字段(Q7 精简后冻结,本期最小;留存清)
  // 招新可用性收口 F5(2026-07-11;评审稿 §2.8 R5;第 42 migration,全 additive 可空):
  // 签名图 = 责任文件——promote 搬 member_profiles.signatureImageKey 长期留存 + 报名行清空
  // (镜像 idCardImageKey 搬运范式);未发号(rejected/withdrawn)行的 blob 随既有留存 SOP 按 key 删。
  signatureImageKey String? // 申请人签名图 storage key(multipart 必填文件位 signatureImage;存量可为 null)
  // 证书标准库 PR-4b(第 67 migration,contract):三个证书 JSON 列**已 DROP**
  // (certificateImages / certificateReviewStatus / certificateIssuanceInfo)。
  // 它们是「按类别一格」时代的产物 —— 结构上表达不了同类别多张证书,
  // 也做不到单证重传与单证审核。取代者是下面的 `certificateClaims` 关系(一证一行)。
  // PR-4a-2 已停写(申请人侧唯一写者 uploadCertificateImages 随旧端点删除)。

  // ===== 脱敏留存字段(永久行级保留)=====
  documentTypeCode String // 证件类型(判非大陆证件/人工核验;非高敏)
  isForeigner      Boolean @default(false) // 历史 DB 列:非大陆证件(不代表国籍;列改名另行挂账)
  genderCode       String?
  ageGroup         String? // 年龄段(提交时从生日派生)
  cityDistrict     String? // 城市到区(提交时从住址派生)
  sourceChannel    String? // 来源渠道
  eliminationStage String? // 淘汰环节(rejected 时记)

  // 核验 / 人工记账
  verifiedAt        DateTime?
  verifyOutcome     String? // matched / mismatch / manual / skipped
  reviewedByUserId  String? // 人工 resolve 操作人(admin;不建外键,沿 SmsSettings.updatedBy)
  reviewedAt        DateTime?
  reviewNote        String?
  sensitivePurgedAt DateTime? // 留存清理(字段 NULL + blob 删)执行时刻

  // 业务唯一约束(partial unique;migration.sql 手写,Prisma DSL 不支持带 WHERE):
  // - (cycleId,idCardNumber/openid/phone) 各自 WHERE deletedAt IS NULL AND
  //   statusCode NOT IN ('rejected','withdrawn') AND 身份列 IS NOT NULL —— 同轮每个身份键至多
  //   一条活跃报名；service 预检负责友好失败，DB 约束兜底并发穿透后按 target 分流 28003/28004/28005。

  // 招新可用性收口 F5(2026-07-11;评审稿 §2.8;第 42 migration,全 additive 可空):
  // 知情同意留痕——submit 必填 privacyConsentAccepted=true(⚠️ 契约收紧)落时间戳 + 前端传版本号;
  // promote 的 member_profiles.privacyConsentSigned 由硬编码 true 改搬真值(acceptedAt != null)。
  // 本组为脱敏留存字段(非 PII,永久行级保留,不随留存 SOP 清)。
  privacyConsentAcceptedAt DateTime? // 勾选知情同意的时刻(submit 落 now;存量历史行 null)
  privacyConsentVersion    String? // 同意文本版本号(前端传,如 '2026-07';后端只存不校验内容)

  // ===== 招新二期(后段;2026-06-19,评审稿 recruitment-phase2-review.md)=====
  // 状态机扩展为 +3 String 态(pending_evaluation / publicity / promoted),沿 statusCode String 范式无 migration;
  // eliminationStage +2 值(evaluation / threshold-timeout)。以下为新增列(全可空,纯加列无破坏):
  thresholdMarks    Json? // 门槛标记(M-3 / E-R2-2):{ patrol1:{at,by}, patrol2, training, redCross, bsafe };仅 verified/pending_evaluation 态可标
  evaluatedByUserId String? // 综合评定操作人(不建外键,沿 reviewedByUserId / SmsSettings.updatedBy)
  evaluatedAt       DateTime?
  evaluationNote    String? // 综合评定备注(D-R2-3)
  promotedMemberId  String? // 报名→Member 链(E-R2-8;不建外键,保 phase-1 D-R-1「报名行无 Member FK」字面)

  // ===== 招新四期 S4a(H5 + 手机身份链;2026-06-24,评审稿 recruitment-phase4-loop-optimization-review.md §3.4)=====
  // 手机号上调为身份链锚(原仅通知用途);以下全可空、纯加列无破坏。phone 明文仍存 phone 列(留存清),
  // 本组为身份链元数据:验证方式 / 换绑轨迹 / 风险标记。掩码三不:audit/日志/snapshot 不出明文手机。
  phoneVerifiedAt         DateTime? // H5 验码成功时刻(小程序链恒 null);submit/rebind-phone 落
  phoneVerificationMethod String? // sms(H5 验码)/ wechat(小程序辅);提交时落
  phoneChangedAt          DateTime? // 自助换手机换绑时刻(rebind-phone)
  phoneChangeReason       String? // 换手机原因(自由短串,可含 PII;rebind-phone;留存/promote 清——十项收口刀C)
  phoneBindingHistory     Json? // 换绑历史追加 [{from,to,at,reason,method}](rebind-phone;DB 内可存明文,沿 phone 列同敏感级;留存/promote 清——十项收口刀C)
  phoneRiskFlag           String? // 风险标记(后台解绑纠错切片用;本刀仅建列不写)

  // ===== 招新四期 S4b(OCR 六分流 + 重拍计数;2026-06-24,评审稿 recruitment-phase4-loop-optimization-review.md §2)=====
  // 把现「5 分支全塞 manual_review」拆为六分流;以下 4 列全 additive(可空/有默认,纯加列无破坏,无 enum)。
  // verifyOutcome(机器判定原因,既有)保留并复用;manualReviewReason(后台人工队列分类)+ riskLevel(三栏分流)并存(§2.2 E-P4-2)。
  // 重拍计数落 §3 报名前身份会话行(recruitment_identity_sessions,Q-P4-1);submit 落库时把会话行最近 OCR 结论快照进 lastOcrOutcome。
  manualReviewReason         String? // 后台人工原因分类:ocr_mismatch_confirmed / forgery_suspected / system_ocr_error / special_document(§2.2/§2.4)
  riskLevel                  String? // 复核风险级:normal / high(防伪/篡改)/ system(上游异常)——驱动后台三栏(§2.4);**申请人侧不暴露**
  applicantConfirmedOcrWrong Boolean @default(false) // mismatch 三选一之③:申请人确认 OCR 错、坚持填写为准 → 落普通人工(§2.1)
  lastOcrOutcome             String? // 最近一次 OCR 结论快照(= 某 verifyOutcome 值;submit 落库时从会话行结转,§2.2/§2.3)

  // ===== OCR 鉴伪版充分利用(2026-06-29,评审稿 recruitment-ocr-anti-forgery-enrichment-review.md §3.1/§4)=====
  // 仅 mainland_id RecognizeValidIDCardOCR 充分利用:扩展字段入库 + 主体/头像裁剪图入库。以下 6 列全 additive
  // (可空,纯加列无破坏,无 enum、无默认、无回填)。OCR 读取值 = **顾问式存档,非权威**;gender/birth 仍由身份证号
  // 推导(genderCode/birthDate),本组**不参与**派生、OCR 的 Sex/Birth 仅 recognize 回显不持久。住址为高敏感 PII,
  // 与 idCardNumber 同级、纳入 read.sensitive 门控(masked→null)。裁剪图仅 submit 解码入库,base64 不入响应/日志(L3)。
  // 十项收口刀C(2026-07-11):本组 6 列 promote 时即时清(OCR 4 列置 NULL;主体裁剪图先删 blob 再清 key;
  // 头像裁剪图搬 User.avatarKey 后清 key)——promote 置 sensitivePurgedAt 会使留存 SOP 永久跳过该行,漏清即永久残留。
  ocrAddress             String? // OCR 住址(顾问式存档;≠ applicant 自填 detailedAddress;高敏感,read.sensitive 门控;留存/promote 清)
  ocrNation              String? // OCR 民族(民族属敏感个人信息;留存/promote 清)
  ocrAuthority           String? // OCR 签发机关(留存/promote 清)
  ocrValidDate           String? // OCR 有效期(腾讯返串,如 2010.07.21-2020.07.21 / 2010.07.21-长期;不解析 DateTime;留存/promote 清)
  idCardCropImageKey     String? // 主体框裁剪图 storage key(CardImage;后台人工复核查看;留存/promote 按 key 删 blob 后清)
  idCardPortraitImageKey String? // 头像裁剪图 storage key(PortraitImage;十项收口刀E:promote 搬 User.avatarKey 设为队员头像,同一 blob 属主转 user、本列清空;未发号行留存按 key 删 blob)

  cycle RecruitmentCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  // 证书标准库 PR-2(§5.5 结尾):一张真实证书一条 Claim 的反向数组。
  // 冻结稿 §26 铁律 11 要求关系双向完整、每个 PR 都能 prisma generate,不许只写单边。
  // 上面三个证书 JSON 列(certificateImages / certificateReviewStatus /
  // certificateIssuanceInfo)在 PR-4a 停写、PR-4b DROP,由本关系取代。
  certificateClaims RecruitmentCertificateClaim[]

  // 业务唯一约束(partial unique;migration.sql 末尾手写,E-R-9/10;Prisma DSL 不支持带 WHERE):
  // - recruitment_applications_cycle_idcard_active_unique ON (cycleId, idCardNumber)
  //   WHERE "deletedAt" IS NULL AND "statusCode" NOT IN ('rejected','withdrawn') —— 防重复报名
  //   (同轮同人),允许 rejected / withdrawn(F6 自助撤销,R4)后同轮重试;service P2002 兜底转
  //   28003(沿 activity_registrations 范式;排除集 F6 第 43 migration 重建)
  // - recruitment_applications_cycle_tempno_unique ON (cycleId, tempNo)
  //   WHERE "tempNo" IS NOT NULL —— 临时编号同轮唯一(配合 tempNoSeq 原子自增兜底并发)
  @@index([cycleId])
  @@index([statusCode])
  @@index([openid])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("recruitment_applications")
}

// 招新四期 S4a(H5 + 手机身份链;2026-06-24,评审稿 recruitment-phase4-loop-optimization-review.md §3.3 / E-P4-5)。
// 报名前身份会话行(净新建):承载「H5 验码 → 短时一次性 token → 提交」的有时间差身份链。
// **不进 recruitment_applications,不参与去重/统计/容量**;TTL 过期由留存 SOP 清(expiresAt 索引)。
// 临时凭证(沿 sms_verification_codes / refresh_tokens 范式):token 入库只存 sha256 hex,
// consumedAt 标一次性消费(非 deletedAt 软删);明文 token 仅验码响应一次性返客户端,永不入库/日志。
// ocrAttemptCount/lastOcrOutcome/requiresRetake 为 S4b(OCR 六分流重拍计数)**预建列,本刀不写逻辑**(Q-P4-1)。
model RecruitmentIdentitySession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime // 签发 + TTL(30min);过期即不可消费

  cycleId String // 轮次锚(token 限定本轮);真实 FK

  phone                      String // 验证过的手机(身份链锚)
  phoneVerifiedAt            DateTime // 验码成功时刻
  phoneVerificationMethod    String // sms(H5)/ wechat(小程序辅)
  phoneVerificationTokenHash String    @unique // sha256(raw) hex;明文 token 永不入库,验码一次性返客户端
  consumedAt                 DateTime? // submit 原子消费即作废(一次性;镜像 sms_verification_codes.consumedAt)
  openid                     String? // 可选(小程序链 code2session 得)

  // S4b 预建(OCR 六分流重拍计数;本刀仅建列、不写逻辑;Q-P4-1)
  ocrAttemptCount Int     @default(0)
  lastOcrOutcome  String?
  requiresRetake  Boolean @default(false)

  cycle RecruitmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([phone, cycleId]) // 手机 + 轮次查(§3.3)
  @@index([cycleId])
  @@index([expiresAt]) // TTL 清理(留存 SOP)
  @@map("recruitment_identity_sessions")
}

// 招新可用性收口 F1(2026-07-11;评审稿 recruitment-usability-closeout-review.md §2.5/E-U-1)。
// 付费 OCR 调用(recognize + submit 共享)按 IP × 北京自然日(UTC+8)封顶的持久化计数表:
// 独立于内存态限流器(重启不清零),env `RECRUITMENT_OCR_DAILY_IP_LIMIT`(默认 30)判限。
// 纯基建计数行(非业务行):无 deletedAt / 无 FK;原子 upsert increment 后判限(先加后判,
// 拒者恒拒,超限尝试也计数 = 保守防滥用,沿 sms 日限「含失败行」口径 E-11)。
// 旧日期行由留存 SOP 按 dateKey 清理(不建 cron)。
model RecruitmentOcrDailyCounter {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ip      String // 请求出口 IP(req.ip;缺省归一 'unknown' 桶,不可绕计)
  dateKey String // 北京自然日 YYYY-MM-DD(固定 UTC+8 日界,沿 sms/stats 各模块级实现口径)
  count   Int    @default(0) // 当日该 IP 已发起的付费 OCR 调用数(含被上游拒/失败的尝试)

  @@unique([ip, dateKey])
  @@index([dateKey])
  @@map("recruitment_ocr_daily_counters")
}

// singleton 由第 49 migration 的 unique index on constant((true)) 在 DB 层强制;
// Prisma schema DSL 无法表达 expression index,故此处仅保留注释,不可误删 migration 索引。
model RealnameVerificationSettings {
  id String @id @default(cuid())

  // 通道选型(production-like 禁 DEV_STUB,写入与运行时双重校验,镜像 sms E-15)
  providerType RealnameProviderType
  enabled      Boolean              @default(true)

  // 腾讯云实名核验运行参数(非 secret,明文;DEV_STUB 下闲置)
  region String? // 如 ap-guangzhou

  // 凭证(两段 secretId+secretKey;AES-256-GCM 加密,RealnameCryptoService T2;明文永不入库,密文也不回显)
  secretIdEncrypted    String?
  secretKeyEncrypted   String?
  credentialConfigured Boolean @default(false) // DB 层简单事实;运行时 credentialStatus 三态由 Service 合成

  // 元信息(沿 SmsSettings 范式;updatedBy 不建外键)
  remarks   String?
  updatedBy String? // User.id
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("realname_verification_settings")
}

enum RealnameProviderType {
  DEV_STUB // 非生产联调通道:确定性两路(身份证校验位 偶=matched / 奇=mismatch,E-R-6;production-like 不可达)
  TENCENT_CLOUD
}

// =============================================================================
// 招新三期(入队:志愿者 → 队员)—— 第 27 模块 team-join(2026-06-19)
// 冻结评审稿 docs/archive/reviews/recruitment-phase3-review.md §3.1。
// - team_join_cycles:入队轮(annual,admin 开/关,至多一个 open);比 recruitment_cycles
//   更简(无发号 seq / capacity / 通知配置 —— member 已有 memberNo,本期不发号)。
// - team_join_applications:入队申请,**有真实 memberId FK**(申请人已是 member,与
//   recruitment_applications「无 Member FK」相反);gateMarks Json 落 8 通用 + 0~4 专业队 gate
//   (contribution 实时算不落库);partial unique 由 migration.sql 末尾手写(E-J-2,Prisma DSL
//   不支持带 WHERE);selectedOrganizationId 一键入队时定最终单部门。
// - 字段长度上限不落 @db.VarChar,由 DTO + class-validator 承担(沿近期惯例)。
// =============================================================================

model TeamJoinCycle {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  year              Int // 入队年份(贡献值 cutoff = {year}-03-31 北京日界;级别/编号无关)
  name              String // 轮次名(长度由 DTO 约束)
  statusCode        String // open / closed(后台开关;至多一个 open:service 预检 + partial unique DB 兜底)
  openedAt          DateTime?
  closedAt          DateTime?
  requiresInsurance Boolean   @default(false) // PR3 single gate=true 时参与 final join；默认 false

  // 入队候选部门配置(PR-4 才接业务):null/空=全部 ACTIVE;max null=默认 8。
  openOrganizationIds Json?
  maxTargetOrgs       Int?

  applications TeamJoinApplication[]

  // 业务唯一约束(partial unique;migration.sql 手写,Prisma DSL 不支持带 WHERE;十项收口刀B):
  // - team_join_cycles_single_open_unique ON ("statusCode")
  //   WHERE "statusCode" = 'open' AND "deletedAt" IS NULL —— 至多一个 open 轮 DB 兜底
  //   (镜像 recruitment_cycles_single_open_unique);service P2002 兜底转 28231
  @@index([year])
  @@index([statusCode])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("team_join_cycles")
}

model TeamJoinApplication {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cycleId  String
  memberId String // 申请人(phase-2 promote 出的已转正志愿者);真实 FK,与 recruitment_applications 相反

  statusCode             String // joining / pending_evaluation / approved / joined / rejected
  targetOrganizationIds  Json // 候选目标部门 orgId 数组(志愿者自助选,可多;joining 态可改)
  gateMarks              Json? // { [gateCode]: { at, by, passed, completionDate, extendedUntil? } };8 通用 + 0~4 专业队;contribution 不在此(实时算)
  selectedOrganizationId String? // 一键入队时 admin 定的最终单部门

  evaluatedByUserId       String? // 综合评估操作人(不建外键,沿 reviewedByUserId / SmsSettings.updatedBy)
  evaluatedAt             DateTime?
  evaluationNote          String?
  evaluationExtendedUntil DateTime? // 综合评估延长期(自本版起仅存档;approved 不随轮关闭失效)

  eliminationStage String? // evaluation / gate-timeout(rejected 时记)
  joinedAt         DateTime? // 一键入队执行时刻

  cycle                         TeamJoinCycle                  @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  member                        Member                         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  organization                  Organization?                  @relation(fields: [selectedOrganizationId], references: [id], onDelete: Restrict)
  insuranceEligibilityEvidences InsuranceEligibilityEvidence[]

  // 业务唯一约束(partial unique;migration.sql 末尾手写,E-J-2;Prisma DSL 不支持带 WHERE):
  // - team_join_applications_member_cycle_active_unique ON (memberId, cycleId)
  //   WHERE "deletedAt" IS NULL AND "statusCode" <> 'rejected' —— 同轮同人至多一活跃申请,
  //   允许 rejected 后同轮重试;service P2002 兜底转 28203(沿 recruitment 范式)
  @@index([cycleId])
  @@index([memberId])
  @@index([statusCode])
  @@index([selectedOrganizationId])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("team_join_applications")
}

// CMS 内容发布模块(第 28 模块,2026-06-21;冻结评审稿 docs/archive/reviews/content-module-review.md)。
// 公告 / 公示 / 简报 / 推文统一一表;正文 Markdown 原文;5 级可见(每篇选一档);立即发布无 cron。
// 封面 / 正文图 / 文件附件统一为 Attachment 行(ownerType='content-image'|'content-file' + ownerId=content.id),
// 不在本表;content 读取面自签下载 URL 并按文章可见级闸控(评审稿 §5 + attachments/CLAUDE.md 范围例外 a)。
model Content {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  title           String // 标题(DTO ≤ 200)
  summary         String? // 摘要(DTO ≤ 500)
  body            String // 正文 Markdown 原文(PG text);含 ![](attachment:<attachmentId>) 占位,读时改写为签名 URL;DTO ≤ 50000
  contentTypeCode String // ∈ content_type 字典 item(announcement / publicity / briefing / post)
  statusCode      String // draft / published / archived(String 常量,无 enum,沿 recruitment 范式)
  visibilityCode  String // public / member / formal_member / department / management(每篇选一档)

  visibleOrganizationIds String[] @default([]) // department 档可见部门 orgId;String[] 供 list where hasSome 过滤(沿 attachments.tags 范式)
  tags                   String[] @default([]) // 标签;读取面 hasSome 筛选(无 GIN,沿 attachments.tags / MemberProfile.exerciseMethods 无索引惯例,v1 顺扫)

  coverImageKey     String? // 封面反范式 storage key(列表缩略图直签,免 per-row Attachment 查询)
  coverAttachmentId String? // 封面对应 content-image 附件 id(标记 / 换 / 清;不建外键)

  viewCount Int @default(0) // 累计 PV(详情打开原子自增;列表 / 预览 / 404 不计)

  pinned       Boolean   @default(false) // 置顶
  publishedAt  DateTime? // publish 时置 now;unpublish 保留;draft 从未发布为 null
  authorUserId String? // 创建 / 操作 admin;不建外键(沿 reviewedByUserId / SmsSettings.updatedBy)

  @@index([statusCode])
  @@index([visibilityCode])
  @@index([contentTypeCode])
  @@index([publishedAt])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([statusCode, publishedAt]) // 公开 / 会员列表:published 按发布时间序常用复合
  @@map("contents")
}

// ===== 统一通知模块 S1:站内信渠道(第 28 模块 notifications 扩 controller,非新模块)=====
//
// 冻结评审稿:docs/archive/reviews/unified-notification-dispatcher-review.md(T0 修订;统一形状 §2/§5/§11)
//   supersede 原 docs/archive/reviews/member-notification-review.md §3(站内信 schema 本切片照建)。
// 镜像 Content(状态机 draft/published/archived + 可见性分档〔去 public = 4 档〕+ 软删 + readCount 反范式);
// 额外一张轻量已读表 NotificationRead(站内信核心差异)。**首切片一次建成统一形状**:audienceType /
// sourceType / channels 前向兼容列本切片即加(S1 仅用 broadcast / admin / in-app 值),后续 S2 微信 quota /
// S3 producer 定向(recipientMemberId / producerModule)只 additive 扩列扩表,站内状态机 / 可见性 / 已读语义零返工。
model Notification {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  title                String // 标题(DTO ≤ 200)
  body                 String // 站内信正文(PG text;纯文本 / 轻 Markdown;DTO ≤ 5000,v1 无正文图 / 附件)
  notificationTypeCode String // ∈ notification_type 字典 item(activity-reminder / recruitment / emergency / general / expiry-reminder)
  statusCode           String // draft / published / archived(String 常量,无 enum,镜像 content)
  visibilityCode       String // member / formal_member / department / management(4 档;去 public,会员面专属)

  visibleOrganizationIds String[] @default([]) // department 档可见部门 orgId 数组(hasSome;镜像 content)

  // ===== 统一通知形状前向兼容列(S1 即加默认值;S2/S3 additive 不返工)=====
  audienceType String   @default("broadcast") // broadcast(S1/S2 admin 广播)| directed(S3 producer 定向)(D-N9)
  sourceType   String   @default("admin") // admin(S1/S2 撰写)| system(S3 producer 自动)(D-N1)
  channels     String[] @default(["in-app"]) // 目标渠道声明(§7;in-app 恒发,wechat = S2,sms = S5)

  // 定向收件人(统一通知 S3;评审稿 §2.1 / §9.1;migration 第 29)。
  // 广播 = null;directed = 单一收件人 member。FK onDelete Restrict(沿仓内惯例;收件人软删后定向行成无害孤儿)。
  // feed 仅本人可见(notification-read.service 扩 where:广播可见 ∪ 本人定向;他人 → 31001 防枚举)。
  recipientMemberId String?

  readCount         Int       @default(0) // 反范式已读人数(首次 mark-read 原子 increment;镜像 content.viewCount)
  pinned            Boolean   @default(false) // 置顶
  publishedAt       DateTime? // publish 时置 now;unpublish 保留;draft 从未发布为 null
  publishGeneration Int       @default(0) // 发布代次(G1 expand-only;G2 runtime 已读写,生产 migration 未 deploy)
  authorUserId      String? // 发布 admin;不建外键(沿 content.authorUserId / reviewedByUserId);system 定向为 null

  reads      NotificationRead[]
  deliveries NotificationDelivery[] // 推送渠道(微信/短信)per-recipient 投递态(S2 起;站内不落)
  recipient  Member?                @relation(fields: [recipientMemberId], references: [id], onDelete: Restrict)

  @@index([statusCode])
  @@index([visibilityCode])
  @@index([notificationTypeCode])
  @@index([publishedAt])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([statusCode, publishedAt]) // 会员 feed:published 按发布时间序常用复合
  @@index([audienceType, recipientMemberId]) // 定向 feed:某 member 的 directed 通知(S3)
  @@map("notifications")
}

// 已读回执(notificationId × memberId,append-once;无 updatedAt / 无 deletedAt = immutable)。
// plain unique([notificationId, memberId])——已读不软删,无需 partial-unique-WHERE(与 TeamInsuranceCoverage 刻意差异)。
// FK 全 onDelete: Restrict(沿仓内惯例);通知软删后已读行成无害孤儿(retention SOP 手动清,不解锁 cron)。
model NotificationRead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) // = 首次已读时刻(readAt)

  notificationId String
  memberId       String

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([notificationId, memberId]) // 一会员对一通知至多一条(plain unique;mark-read upsert 幂等键)
  @@index([memberId]) // 会员未读查询主路径(NOT EXISTS 子查询)
  @@index([notificationId])
  @@map("notification_reads")
}

// =============================================================================
// 统一通知模块 S2 微信订阅 quota 渠道(2026-06-25;冻结评审稿
// docs/archive/reviews/unified-notification-dispatcher-review.md §3/§9.1,D-N2/D-N3/D-N6)。
// 三张净新增表(全 additive,无破坏、无回填、无 enum;migration 第 28);站内 S1 语义零返工。
// =============================================================================

// 推送渠道 per-recipient 投递态(§2.1 核心张力解法:fan-out 只发生在推送渠道,站内不落)。
// S2 仅 wechat 渠道;短信 = S5。流水语义(沿 sms_send_logs append-only;notificationId FK Restrict 串父记录,
// memberId 松引用不建 FK——投递日志不应被会员软删牵制,镜像 sms_send_logs 零 FK 取舍)。
// recipientRef = 掩码后 openid / phone(maskOpenid / maskPhone;明文永不入库,L3/L2 纪律)。
model NotificationDelivery {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  notificationId String
  channel        String // wechat(S2 唯一)| sms(S5);代码常量非字典
  memberId       String // 收件人 member(松引用,不建 FK;openid 可换绑故按 memberId 留痕)
  recipientRef   String // 掩码 openid / phone(回显安全;明文不入库)
  status         String // pending | sent | failed | skipped
  reasonCode     String? // no-quota / no-openid / need-resubscribe / invalid-openid / template-param / token-failed / no-template
  providerMsgId  String? // provider 回执 ID(微信 msgid;不含 secret)
  errCode        String? // 失败时 provider 错误码(微信 errcode 字符串;不含 secret)
  attemptedAt    DateTime? // 实际发起外部调用时刻(skipped = null,未发起外部调用)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)

  @@index([notificationId])
  @@index([memberId, channel])
  @@index([status])
  @@map("notification_deliveries")
}

// 微信订阅消息配额(memberId × templateId → availableCount;D-N2 上限默认 5)。
// 按 memberId 存(非 openid)——openid 可换绑(招新 S4a rebind),memberId 稳定;发送时 member→user→openid 现取。
// +1(ack)= upsert increment 配上限;-1(发送)= 条件原子扣减 updateMany(availableCount>0),count===1 才发。
// 松引用 memberId 不建 FK(状态表,会员软删不应牵制;镜像 sms_send_logs / wechat 流水取舍)。
model WechatSubscriptionQuota {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberId       String
  templateId     String
  availableCount Int    @default(0) // ≥ 0(条件原子扣减杜绝越扣为负)

  @@unique([memberId, templateId]) // 一会员一模板至多一行(ack upsert 键 + count 查询主路径)
  @@index([templateId]) // 派发:按 templateId 取有配额会员(availableCount > 0)
  @@map("wechat_subscription_quotas")
}

// 微信订阅消息模板配置(notificationTypeCode → templateId;运营可配,D-N3)。
// 镜像 sms_settings.templateIdBirthday「模板 ID 存配置、运营改不重部署」先例,但一类型一模板故独立表(1:1)。
// 字段映射(payload → 微信 data key)= 内置代码(随类型固定,不入本表;见 notification.wechat-data.ts)。
// templateId 可空:小程序后台审批后由 admin 填;未填 / disabled = 该类型微信渠道不可发(派发 skip no-template)。
model WechatSubscribeTemplate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notificationTypeCode String  @unique // ∈ notification_type 字典;一类型一模板
  templateId           String? // 微信订阅消息模板 ID(运维上线后台审批后填)
  enabled              Boolean @default(true)
  remarks              String?
  updatedBy            String? // User.id(不建外键,沿 settings 范式)

  @@map("wechat_subscribe_templates")
}

// PostgreSQL durable notification outbox(D-Outbox;2026-07-18)。
// status 使用代码常量而非 enum，worker 以 SKIP LOCKED + lease/fencing 多实例领取；
// payload 只保存内部引用与安全文案，手机号/openid/token/secret/credential/signed URL
// 及 provider 原始请求/响应均不得进入本表。成功/死信 retention 仅走人工 SOP。
// migration 另有手写 partial unique：微信 delivery / admin SMS 各自同
// aggregateId/destinationRef 同时至多一条 pending/processing；Prisma DSL 无法表达 partial
// unique，勿用普通 @@unique 误伤 terminal generation history。
model NotificationOutboxIntent {
  id             String @id @default(cuid())
  eventKey       String @unique
  eventType      String
  payloadVersion Int
  payload        Json

  aggregateType   String
  aggregateId     String
  destinationType String
  destinationRef  String

  status      String   @default("pending")
  attempts    Int      @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)

  leaseOwner     String?
  lockedAt       DateTime? @db.Timestamptz(3)
  leaseExpiresAt DateTime? @db.Timestamptz(3)

  preparedAt         DateTime? @db.Timestamptz(3)
  preparedTemplateId String?
  sentAt             DateTime? @db.Timestamptz(3)
  completedAt        DateTime? @db.Timestamptz(3)

  lastErrorCode  String?
  lastErrorClass String?
  deadAt         DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // ⚠️ 本表还有**三条手写 partial unique**,Prisma DSL 表达不了 WHERE 子句,故不在此处:
  //   notification_outbox_wechat_delivery_active_unique  (第 18 migration)
  //   notification_outbox_admin_sms_active_unique        (第 18 migration)
  //   notification_outbox_wecom_delivery_active_unique   (第 69 migration;T5B)
  // 三条形状一致:键 ("eventType","aggregateId","destinationRef"),谓词 = 各自的 eventType
  // + status IN ('pending','processing')。谓词按 eventType **分域**是刻意的 ——
  // 合成一条不含 eventType 谓词的通用索引会让同一通知同一人的微信小程序 child 与
  // 企业微信 child 互相占槽,两个渠道无法同时投递(企业微信冻结稿 §10.3)。
  @@index([status, availableAt, leaseExpiresAt])
  @@index([leaseExpiresAt])
  @@index([aggregateType, aggregateId])
  @@index([status, completedAt])
  @@index([status, deadAt])
  @@index([createdAt])
  @@map("notification_outbox_intents")
}

// PostgreSQL shared throttler storage(D-Throttle;2026-07-18):10 个命名 throttler
// 共用数据库桶，(throttlerName,key) 物理隔离。hitExpiresAt 保存每次未 blocked hit
// 的独立滚动过期点；过期桶仅走手动 retention SOP，刻意不新增第 3 个 cron。
model ThrottlerBucket {
  id String @id @default(cuid())

  throttlerName String
  key           String

  hitExpiresAt    DateTime[] @default([]) @db.Timestamptz(3)
  windowExpiresAt DateTime   @default(now()) @db.Timestamptz(3)
  blockedUntil    DateTime?  @db.Timestamptz(3)
  retentionAt     DateTime   @default(now()) @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([throttlerName, key])
  @@index([retentionAt])
  @@map("throttler_buckets")
}

// ===== 企业微信接入 T1(2026-08-01):三张新表 =====
//
// 冻结稿:docs/archive/reviews/wecom-integration-t0-terminal-review.md §5(2026-07-29 冻结,
// D-WC-1..31 按推荐)。本刀 **expand-only**:净新 3 张空表 + User 两条反向 relation +
// SmsPurpose 一个 enum 值;**零 runtime 读写、零 endpoint、零 permission、零 audit、
// 零回填、零删数、零默认绑定**。T2 才有 settings 端点,T3 才有 OAuth 与绑定。
//
// 命名铁律(冻结稿开头「命名约定」):`WeCom`/`wecom` = 企业微信;现有 `Wechat`/`wechat`
// 专指微信小程序。二者不得混写、混表、混错误码、混通知渠道 —— 这也是本批不复用
// wechat_settings / User.openid 的根本原因。
//
// `@@map` 物理名:prisma/CLAUDE.md 默认禁 @@map,本批由 goal 显式授权(冻结稿 §5 逐字
// 给出三个 @@map),沿 activity_check_ins / activity_feedbacks / throttler_buckets 等
// 「goal 指定 @@map」既有先例。

// 冻结稿 §5.1。单 Corp 单 Agent(§0.3 硬禁区:不做多企业 / 多 CorpID / 多 Agent / 多租户),
// 故本表是 singleton —— 至多一行由 migration 末尾的 constant unique index 在 **DB 层**强制,
// 不靠应用层自觉(沿第 49 migration 四张 provider settings 表的同一形状)。
//
// providerType 按冻结稿逐字为 `String`(取值 DEV_STUB | WECOM),**刻意不建 Prisma enum** ——
// 与 WechatSettings 的 WechatProviderType 形成对照是冻结稿的选择,不是遗漏;本刀不擅自"改进"。
//
// 三个开关默认全 false(冻结稿 §13 T2「默认所有开关 false」):enabled=false 时登录与消息
// 全部 fail-closed;loginEnabled/messageEnabled 为二级闸,置 true 必须 enabled=true(T2 校验)。
//
// 凭证红线(§5.5 L3):corpSecretEncrypted 与 access token **永不**进响应 / Audit / 日志。
// configurationGeneration 不落库,由 T2 按 §5.1 规则 8 的字段集做 SHA-256 opaque hash。
model WecomSettings {
  id             String  @id @default(cuid())
  providerType   String  @default("DEV_STUB") // DEV_STUB | WECOM
  enabled        Boolean @default(false)
  loginEnabled   Boolean @default(false)
  messageEnabled Boolean @default(false)

  corpId     String?
  agentId    Int?
  webBaseUrl String? // 仅 origin,如 https://app.example.com;production 必须 HTTPS 且不带 path/query/fragment

  corpSecretEncrypted  String? // AES-256-GCM 密文;§5.5 L3,永不回显、永不 Audit、永不日志
  credentialConfigured Boolean @default(false)

  remarks   String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wecom_settings")
}

// 冻结稿 §5.2。企业微信身份绑定 **User**(§1.2 结论 4:会话属于 User;Admin 账号可能没有
// Member;Member 的业务准入另由 AppIdentityResolver 决定),故这里既无 memberId 也无
// 通讯录快照(departmentIds / name / avatar / mobile / email 一概不建,§5.2 语义)。
//
// 无 soft delete:`revoked` 本身已是终态历史语义。绑定 / 换绑 / 清除**全部保留历史行** ——
// 换绑是"结束旧 active 行 + 新建 active 行",不是覆盖旧行的 wecomUserId。
//
// 两条 active partial unique(migration 末尾手写;Prisma DSL 表达不了 WHERE 子句):
//   subject_active_unique  (corpId, wecomUserId) WHERE status='active' —— 一个企业微信身份至多绑一个 active User
//   user_active_unique     (corpId, userId)      WHERE status='active' —— 一个 User 在当前 Corp 下至多一个 active 身份
// 两条 CHECK:status 闭集 + revocation 形状(active⇔revokedAt IS NULL)。
//
// wecomUserId 是企业内部稳定标识,§5.5 定为 L2:**必须明文存储**(发消息要用),
// 但所有响应 / Audit / 日志一律掩码。
model WecomIdentity {
  id              String    @id @default(cuid())
  userId          String
  corpId          String
  wecomUserId     String
  status          String    @default("active") // active | revoked;闭集由 CHECK 强制
  bindingSource   String // pre-auth | me
  boundAt         DateTime  @default(now())
  revokedAt       DateTime?
  revokedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Restrict:User 恒软删不物理删(v1 契约),引用悬空仅理论风险 —— 沿 auditLogs / refreshTokens 同型
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([corpId, status])
  @@index([wecomUserId])
  @@map("wecom_identities")
}

// 冻结稿 §5.3。OAuth state 与 binding ticket 的一次性凭证台账。
//
// 最硬的一条:**原始 state、原始 bindingTicket、OAuth code 都不入库** —— 前两者只存
// SHA-256 hash(故列名带 Hash 后缀且 @unique),code 连 hash 都不存,也不入日志、不入 Audit(§5.5)。
//
// 状态闭集(§5.3):pending / state_consumed / binding_required / completed / failed。
// 本刀**刻意不给 status 加 CHECK** —— 冻结稿 §5.3 只在 WecomIdentity 上要求两条 CHECK,
// 这里给的是状态机文档而非 DB 约束;不自行加码(§26「不擅自加严冻结稿」)。
//
// corpId / wecomUserId 仅在"未绑定登录转入 binding_required"时临时保存,不是身份真相源
//(身份真相在 WecomIdentity)。
//
// retention:成功 / 失败 / 过期行由**手动 SOP** 清理 —— §0.3 硬禁区「不新增第三个 Cron」,
// 与 throttler_buckets 同一处置。
model WecomAuthAttempt {
  id            String  @id @default(cuid())
  purpose       String // login | bind_self
  status        String  @default("pending")
  subjectUserId String? // bind_self 时固定为发起 authorize 的登录用户;login 恒 null

  stateHash       String    @unique // sha256(原始 state);原始值只出现在 authorize URL
  returnPath      String
  stateExpiresAt  DateTime
  stateConsumedAt DateTime?

  bindingTicketHash String?   @unique // sha256(原始 ticket);原始值仅在 bindingRequired 响应里出现一次
  corpId            String?
  wecomUserId       String?
  bindingExpiresAt  DateTime?
  bindingConsumedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjectUser User? @relation(fields: [subjectUserId], references: [id], onDelete: Restrict)

  @@index([status, stateExpiresAt])
  @@index([bindingExpiresAt])
  @@map("wecom_auth_attempts")
}

// ============================================================================
// 活动改造 v1.1 —— 第 1 批第一刀:Session / Participation / Capacity
// (2026-08-04;合同 docs/archive/reviews/activity-business-overhaul-v1.1/
//  §3.2 / §3.3 / §3.8 / §3.9 / §3.10;§14「第 1 批」建议拆分第 1 项)
//
// 本刀是纯 schema expand:**六张新表零调用方**是预期状态,不接线、不写业务代码。
// 既有 ActivityPosition / ActivityRegistration 一列不动、一行不迁,两表并存期间
// 不写任何双写／双读(合同 §0.4 明禁长期双读双写);它们的退场归 contract 阶段。
//
// 命名:本批**不使用 @@map**(prisma/CLAUDE.md 默认禁,goal 未授权),物理表名
// 即 PascalCase model 名 —— 沿 CertificateStandard / RecruitmentCertificateClaim
// 等近批新表的既有做法。
//
// 状态类字段一律 String + migration CHECK 闭集兜底,不建 Prisma enum
// (合同 §3 前言:「避免为了新增状态频繁修改 PostgreSQL enum」)。
//
// 万人量级前提(第 0 批 #906 实测):批量写恒走 unnest 数组参数,与人数无关地只占
// 常数个 bind 参数(Prisma bind 上限 32767)。本刀不写批量逻辑,但建表按此前提设计
// —— 不引入任何"每行一个参数"才能维护的结构。
// ============================================================================

// ===== §3.2 ActivitySession:一行 = 一个实际执行场次 =====
//
// 时间窗口四件套 + 定位策略在本表**冻结最终值**,运行时不再回查模板
// (合同 §3.4:「不实时继承模板;模板变化不修改已发布活动」)。
model ActivitySession {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // 仅草稿可软删;发布后取消走 statusCode,不删除历史

  activityId String
  code       String // 同活动稳定业务编码,创建后不可改
  name       String

  startAt DateTime
  endAt   DateTime

  locationText    String
  meetingPoint    String?
  executionPoint  String?
  evacuationPoint String?
  // 沿 Activity.locationLongitude / locationLatitude 的 Decimal(10,7)(WGS84 ~1.1cm)
  longitude       Decimal? @db.Decimal(10, 7)
  latitude        Decimal? @db.Decimal(10, 7)

  capacity Int? // 场次参与人次上限;null 不限

  checkInOpenAt      DateTime
  checkInCloseAt     DateTime
  checkOutOpenAt     DateTime
  checkOutCloseAt    DateTime
  preparationStartAt DateTime? // null = 不单独计准备时段

  locationRequired           Boolean
  radiusMeters               Int? // 要求定位时 50..10000;不要求定位时必须 null
  locationPolicySourceCode   String // system / template / activity / session / position
  accuracyWarningMeters      Int     @default(100) // 合同 §3.2「固定 100;本期只提醒」
  lateGraceMinutes           Int     @default(15) // 0..60
  earlyLeaveThresholdMinutes Int     @default(15) // 0..60

  terminationCheckOutDeadline DateTime? // 场次提前终止后的真实签退截止

  statusCode       String // scheduled / cancelled / terminated;进行中／结束按时间派生
  workflowRevision Int    @default(0)
  sortOrder        Int    @default(0)

  activity                Activity                        @relation(fields: [activityId], references: [id], onDelete: Restrict)
  positions               ActivitySessionPosition[]
  participationIdentities ActivityParticipationIdentity[]

  // 第 1 批第二刀(§3.13 / §3.14):场次级规则集、场次级邀请、现场访客。
  qualificationRuleSets ActivityQualificationRuleSet[]
  invitations           ActivityInvitation[]
  visitors              ActivityVisitor[]

  // 第 1 批第三刀(§3.15 / §3.16):场次级二维码凭证与打卡事件。
  qrCredentials AttendanceQrCredential[]
  punchEvents   AttendancePunchEvent[]

  // 第 1 批第四刀反向 relation(合同 §3.23 / §3.27):仅关系映射,零标量字段。
  ledgerEntries ParticipationLedgerEntry[]
  batchJobs     ActivityBatchJob[]

  // 复合 FK 的被引用侧:让子表 (activityId, sessionId) 双锚点由 **DB** 保证
  // 「session 属于 activity」,而不是只靠 service 自觉(合同 §3.3 原话:
  // 「双锚点,service 与 DB 约束保证 session 属于 activity」)。
  @@unique([activityId, id])
  @@index([activityId])
  @@index([statusCode])
  @@index([startAt])
  @@index([endAt])
  @@index([checkOutCloseAt])
  @@index([activityId, sortOrder])
  @@index([deletedAt])
}

// ===== §3.3 ActivitySessionPosition:场次级岗位 =====
//
// ⚠️ 合同 §3.3 说既有 ActivityPosition「可重命名／重建」为本模型 —— 本刀按 goal ③
// **新建**本表,既有 activity_positions 一列不动、一行不迁,退场归 contract 阶段。
//
// ✅ 合同字段表里的 `qualificationRuleSetId` 在第一刀按「跨切片的列不提前占位」暂缓,
// **本刀(第二刀)连列带外键一起补上** —— 它指向的 ActivityQualificationRuleSet(§3.13)
// 正是本刀建的表。这是「不占位」范式的后半程。
model ActivitySessionPosition {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // 仅草稿软删;发布后用变更提案取消或替代

  activityId String
  sessionId  String

  code               String
  name               String
  attendanceRoleCode String
  capacity           Int? // null 不限

  // 有值时必须同空同有(CHECK);「位于 session 内」是跨行判据,由 service +
  // 后续批次的 ProposalApplier 保证,单表 CHECK 表达不了。
  startAt DateTime?
  endAt   DateTime?

  genderRequirementCode String?

  // §3.3「可空岗位资格版本」。第一刀按「跨切片不占位」暂缓,第二刀(建 §3.13 表的这一刀)
  // 连列带 FK 补齐。可空 = 岗位不追加岗位级资格时继承场次/活动级规则集。
  qualificationRuleSetId String?

  // 可空覆盖 session;发布时解析最终值进入快照(§3.4)。
  locationRequired Boolean?
  radiusMeters     Int?

  leaderMemberId String? // 岗位负责人业务关系,**不直接产生权限**(§3.3)
  description    String?
  equipmentNotes String?
  sortOrder      Int     @default(0)

  activity                Activity                        @relation(fields: [activityId], references: [id], onDelete: Restrict)
  // 复合 FK:(activityId, sessionId) → ActivitySession(activityId, id)。
  // 单列 sessionId FK 挡不住"岗位挂到别的活动的场次上"这种脏行。
  session                 ActivitySession                 @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  leader                  Member?                         @relation("SessionPositionLeader", fields: [leaderMemberId], references: [id], onDelete: Restrict)
  participationIdentities ActivityParticipationIdentity[]
  participationRevisions  ActivityParticipationRevision[]

  // 第 1 批第二刀(§3.3 / §3.13 / §3.14)。
  qualificationRuleSet        ActivityQualificationRuleSet?  @relation("PositionQualificationRuleSet", fields: [qualificationRuleSetId], references: [id], onDelete: Restrict)
  // §3.13 规则集反向指回岗位(岗位级作用域)与 §3.14 邀请指定岗位。
  scopedQualificationRuleSets ActivityQualificationRuleSet[] @relation("PositionQualificationRuleSetScope")
  invitations                 ActivityInvitation[]           @relation("InvitationPosition")

  // 第 1 批第三刀(§3.16):打卡事件的岗位上下文(可空)。
  punchEvents AttendancePunchEvent[] @relation("PunchEventPosition")

  @@index([activityId])
  @@index([sessionId])
  @@index([attendanceRoleCode])
  @@index([leaderMemberId])
  @@index([sessionId, sortOrder])
  @@index([deletedAt])
  @@index([qualificationRuleSetId])
}

// ===== §3.8 ActivityParticipationIdentity:P0-04 核心模型 =====
//
// 一行 = 一个队员参加一个场次的**永久**身份。取消重报只追加
// ActivityParticipationRevision 并改当前指针,**永不再建身份行**
// ⇒ (activityId, sessionId, memberId) 是**普通 unique,不带删除条件**(§3.8 原话)。
// 因此本表**没有 deletedAt**:永久身份不软删。
model ActivityParticipationIdentity {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId     String
  sessionId      String
  registrationId String
  memberId       String

  currentRevision   Int     @default(0)
  currentStatusCode String
  currentPositionId String?

  // ⚠️ DoD 7 选项 (a):**不加 FK** 的快速指针。
  // 真值在 CapacityReservation 行上(§3.10「每个当前占位的可追溯事实」);
  // 本列只是"当前占位记录"的快捷入口。加 FK 会与 CapacityReservation.identityId
  // 形成**循环外键**,并给占位事务凭空多一条隐式死锁边 —— 本仓已有「audit 外键是
  // 看不见的死锁边」的事故(见 concurrency-review-m1-m6)。
  // 指针失同步的发现手段:LEFT JOIN 对账查询(见配套 spec 的"悬空指针"用例),
  // 不靠 DB 兜底。
  capacityReservationId String?

  populationIncluded Boolean @default(false) // 是否进入当前应结算人口;随状态原子更新
  version            Int     @default(0) // CAS 版本

  activity     Activity                 @relation(fields: [activityId], references: [id], onDelete: Restrict)
  session      ActivitySession          @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  registration ActivityRegistration     @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  member       Member                   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  position     ActivitySessionPosition? @relation(fields: [currentPositionId], references: [id], onDelete: Restrict)

  revisions    ActivityParticipationRevision[]
  reservations CapacityReservation[]

  // 第 1 批第二刀(§3.13):资格评估快照的反向 relation。
  qualificationSnapshots QualificationEvaluationSnapshot[]

  // 第 1 批第三刀(§3.16 / §3.18):打卡事件与服务段修订的反向 relation。
  punchEvents             AttendancePunchEvent[]
  serviceSegmentRevisions ParticipantServiceSegmentRevision[]

  // 第 1 批第四刀反向 relation(合同 §3.20 / §3.23 / §3.25):仅关系映射,零标量字段。
  settlementResultRevisions ParticipantSettlementResultRevision[]
  ledgerEntries             ParticipationLedgerEntry[]
  correctionRequests        AttendanceCorrectionRequest[]

  @@unique([activityId, sessionId, memberId])
  @@index([activityId])
  @@index([sessionId])
  @@index([memberId])
  @@index([registrationId])
  @@index([currentStatusCode])
  @@index([currentPositionId])
  @@index([activityId, populationIncluded])
}

// ===== §3.9 ActivityParticipationRevision:不可变状态修订 =====
//
// 不可变模型 ⇒ 按合同 §3 前言**不带 updatedAt / deletedAt**。
//
// ⚠️ 合同字段表里的 `allocationBatchId` **本刀不建**:它指向 ActivityAllocationBatch
// (§3.11),那是第 4 刀(Settlement / Allocation 域)才建的表。同 goal ② 口径。
model ActivityParticipationRevision {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  identityId String
  revision   Int

  // 闭集(§3.9,14 态),由 migration CHECK 兜底;
  // ActivityParticipationIdentity.currentStatusCode 共用同一闭集。
  statusCode String

  positionId         String?
  preferenceSnapshot Json?
  waitlistRank       Int?

  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?

  cancelledByUserId String?
  cancelledAt       DateTime?
  cancelReason      String?

  effectiveAt     DateTime
  createdByUserId String?
  sourceCode      String
  requestKey      String?
  requestHash     String?

  identity    ActivityParticipationIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  position    ActivitySessionPosition?      @relation(fields: [positionId], references: [id], onDelete: Restrict)
  reviewedBy  User?                         @relation("ParticipationRevisionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  cancelledBy User?                         @relation("ParticipationRevisionCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  createdBy   User?                         @relation("ParticipationRevisionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([identityId, revision])
  @@index([identityId])
  @@index([statusCode])
  @@index([positionId])
  @@index([effectiveAt])
  @@index([requestKey])
}

// ===== §3.10 ActivityCapacityBucket:容量桶 =====
//
// scopeId 是**多态** id(activity / session / position / reserve group),
// 故不加 FK —— 沿 role_bindings.principalId「多态无 FK」既有范式。
model ActivityCapacityBucket {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String // 聚合根

  // activity_person / session_participation / position_participation / reserve_group
  scopeTypeCode String
  scopeId       String

  capacity Int? // null 不限;有值 >= 1
  occupied Int  @default(0) // >= 0 且不大于 capacity
  version  Int  @default(0) // CAS

  activity     Activity              @relation(fields: [activityId], references: [id], onDelete: Restrict)
  reservations CapacityReservation[]

  @@unique([scopeTypeCode, scopeId])
  @@index([activityId])
  @@index([scopeTypeCode])
}

// ===== §3.10 CapacityReservation:每个当前占位的可追溯事实 =====
//
// partial unique(migration 末尾手写):一个 identity 对一个 bucket 至多一条 active。
//
// ⚠️ 合同 §3.10 还要求第二条 partial unique「一个 member／activity 至多一条 active
// activity-person reservation」,但 §3.10 自己的字段表**没有给 memberId / activityId
// 两列**,该索引无从建起。goal DoD 5 也只列了第一条。本刀实现第一条,第二条作为
// 合同内部不一致**上报维护者**,不自行发明列去补(AGENTS §2)。
model CapacityReservation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identityId      String
  bucketId        String
  reservationType String

  status        String // active / released(CHECK 闭集 + 形状 CHECK)
  releasedAt    DateTime?
  releaseReason String?

  identity ActivityParticipationIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  bucket   ActivityCapacityBucket        @relation(fields: [bucketId], references: [id], onDelete: Restrict)

  @@index([identityId])
  @@index([bucketId])
  @@index([status])
  @@index([bucketId, status])
}

// ============================================================================
// 活动改造 v1.1 —— 第 1 批第二刀:报名修订 / 报名表 / 资格 / 邀请 / 访客
// (2026-08-04;合同 docs/archive/reviews/activity-business-overhaul-v1.1/
//  SRVF_活动业务全流程改造_详细开发文档_v1.1.md §3.7 / §3.12 / §3.13 / §3.14;
//  §14「第 1 批」建议拆分第 2 项)
//
// 与第一刀同口径:纯 schema expand,**十张新表零调用方**是预期状态 —— 不接线、
// 不写 service / controller / DTO / policy / presenter,消费方在第 3–5 批。
// 既有 ActivityPosition / ActivityRegistration 一行不迁、不双写。
//
// 命名:不使用 @@map,物理表名即 PascalCase model 名(沿第一刀)。
// 状态类字段一律 String + migration CHECK 闭集兜底,不建 Prisma enum(§3 前言:
// 「避免为了新增状态频繁修改 PostgreSQL enum」)。
//
// ⚠️ 敏感信息口径(维护者 2026-08-04 拍板):报名表题目由发布人自定义,**可能**出现
// 身份证号 / 病史 / 紧急联系人等。按合同设计,本刀不额外设限 —— 合同已给每道题
// `visibilityCode`(谁能看)与 `exportable`(能否导出)两个开关;答案跟随报名记录
// 存在,**不单独设保存期限**;掩码与读侧权限在后续批次做。本刀一行读侧代码都不写。
// ============================================================================

// ===== §3.7 ActivityRegistrationRevision:不可变报名修订 =====
//
// 「不可变记录每次报名／重报／撤回／后台代建」⇒ 按合同 §3 前言**不带
// updatedAt / deletedAt**(沿第一刀 ActivityParticipationRevision 同一处置)。
//
// ⚠️ 本表在第一刀就该建(§3.7),当时按 goal ②「跨切片外键列不提前占位」整体移出 ——
// 它的 formVersionId 指向本刀才建的 RegistrationFormVersion。本刀连表带列一起落。
model ActivityRegistrationRevision {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  registrationId String
  revision       Int

  // ⚠️ 可空,合同字段表未标 `?` —— 偏离理由:§3.12 **没有**要求每个活动都必须建
  // RegistrationFormVersion(没有自定义报名表的活动是常态),无表时本列无版本可指。
  // 有表时由 service 绑定,并禁止把新版本字段填进旧报名修订(§3.12 原话)。
  formVersionId String?
  // 原始答案存 RegistrationFormAnswer 行,这里只留指纹(§3.7:不在 audit context
  // 复制敏感文件内容)。无表 / 无题时无答案可哈希 ⇒ 同样可空。
  answersHash   String?

  sourceCode        String // self / admin / invitation / onsite(§3.6 闭集,migration CHECK 兜底)
  // ⚠️ 可空,合同字段表未标 `?` —— 沿本仓 actor FK 一律可空的既有范式
  // (reviewedBy / cancelledByUserId / createdByUserId / terminatedByUserId 无一例外)。
  submittedByUserId String?
  submittedAt       DateTime

  // §3.7「requestKey/requestHash unique idempotency」。两列可空 —— 非幂等入口不带 key。
  // 唯一由 migration 末尾**手写 partial unique**,键是 **requestKey 单列**
  // (WHERE requestKey IS NOT NULL),不是 (requestKey, requestHash) 复合:
  // 复合唯一恰好放行「同一个 key 配不同 payload」——那正是幂等键要拒的冲突,
  // 复合形态等于把闸门开在错误的一侧。单列唯一严格蕴含复合唯一,故同时满足合同字面。
  requestKey  String?
  requestHash String?

  priorRevisionId String?
  reason          String?

  registration  ActivityRegistration          @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  formVersion   RegistrationFormVersion?      @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  submittedBy   User?                         @relation("RegistrationRevisionSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  priorRevision ActivityRegistrationRevision? @relation("RegistrationRevisionChain", fields: [priorRevisionId], references: [id], onDelete: Restrict)

  nextRevisions          ActivityRegistrationRevision[]    @relation("RegistrationRevisionChain")
  answers                RegistrationFormAnswer[]
  qualificationSnapshots QualificationEvaluationSnapshot[]

  @@unique([registrationId, revision])
  @@index([registrationId])
  @@index([formVersionId])
  @@index([submittedByUserId])
  @@index([submittedAt])
  @@index([requestKey])
  @@index([priorRevisionId])
}

// ===== §3.12 RegistrationFormVersion:报名表版本 =====
//
// 版本化模型,靠 statusCode(draft / active / retired)退场,**不软删** ⇒ 无 deletedAt。
model RegistrationFormVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String
  version    Int // 1 起递增;(activityId, version) 唯一
  statusCode String // draft / active / retired(§3.12 明写闭集)

  workflowRevision Int       @default(0)
  // ⚠️ 可空,合同字段表未标 `?` —— 偏离理由:schemaHash 是「字段集冻结指纹」,
  // 草稿仍在增删题目时无冻结值可言,自然在激活那一刻才落。
  schemaHash       String?
  activatedAt      DateTime?
  retiredAt        DateTime?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)

  fields                  RegistrationFormField[]
  registrationRevisions   ActivityRegistrationRevision[]
  uploadSessions          RegistrationUploadSession[]
  currentForRegistrations ActivityRegistration[]         @relation("RegistrationCurrentFormVersion")

  // §3.12「一活动至多一个 active」是 **partial** unique(WHERE statusCode='active'),
  // Prisma DSL 表达不了 WHERE,手写在 migration 末尾。
  @@unique([activityId, version])
  @@index([activityId])
  @@index([statusCode])
}

// ===== §3.12 RegistrationFormField:报名表题目 =====
//
// ⚠️ 本表**没有** deletedAt:题目属于某个冻结版本,改题 = 出新版本,不软删旧题。
//
// ⚠️ 敏感口径(见文件头):题目由发布人自定义,可能承载身份证号 / 病史 /
// 紧急联系人。合同给的两个开关就在这张表上 —— `visibilityCode`(谁能看)与
// `exportable`(能否导出)。**本刀只建列**,读侧过滤与导出裁剪在后续批次。
model RegistrationFormField {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formVersionId String
  fieldCode     String
  label         String
  helpText      String?

  // short_text / long_text / number / date / single_choice / multi_choice /
  // file / confirmation(§3.12 明写八种;migration CHECK 闭集)
  typeCode String

  required Boolean @default(false)

  // number 类题目的取值域;与 RegistrationFormAnswer.valueNumber 共用同一
  // Decimal(18,6) 域 —— 边界与取值必须可直接比较,精度不同即无法比较。
  minValue Decimal? @db.Decimal(18, 6)
  maxValue Decimal? @db.Decimal(18, 6)

  minLength     Int? // 文本长度下限
  maxLength     Int? // 文本长度上限
  maxSelections Int? // multi_choice 可选上限

  optionsJson    Json?
  // ⚠️ 合同**未给** visibilityCode 的闭集(§3.1 的 internal/invitation 是活动可见性,
  // 另一个域),故本刀**不加**闭集 CHECK,不自行发明取值(AGENTS §2)。
  visibilityCode String
  exportable     Boolean @default(false) // 默认不可导出 —— 敏感口径下的保守起点
  sortOrder      Int     @default(0)

  formVersion RegistrationFormVersion  @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  answers     RegistrationFormAnswer[]

  @@unique([formVersionId, fieldCode])
  @@index([formVersionId])
  @@index([typeCode])
  @@index([formVersionId, sortOrder])
}

// ===== §3.12 RegistrationFormAnswer:一题一答 =====
//
// 挂在**不可变**的报名修订上 ⇒ 本表同样不可变,不带 updatedAt / deletedAt。
//
// exactly-one 由 migration CHECK 保证,写法是**计数式**
// (`CASE WHEN … IS NOT NULL THEN 1 ELSE 0 END` 求和 = 1),不是 AND/OR 串:
// `IS NOT NULL` 是二值谓词,CASE 求和恒为非 NULL 整数,`= 1` 恒为 TRUE 或 FALSE,
// **不可能求值成 NULL** ⇒ 不存在"表达式为 NULL 时 CHECK 判通过"的静默失效
// (第一刀 location_policy 的血教训就是踩在这上面)。
model RegistrationFormAnswer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  registrationRevisionId String
  fieldId                String

  valueText    String?
  valueNumber  Decimal?  @db.Decimal(18, 6)
  valueDate    DateTime?
  valueJson    Json?
  attachmentId String?

  registrationRevision ActivityRegistrationRevision @relation(fields: [registrationRevisionId], references: [id], onDelete: Restrict)
  field                RegistrationFormField        @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  // file 型答案指向 attachments。Restrict:答案一旦落定,附件不得被删走
  // (attachments 是硬删表,无 deletedAt)。
  attachment           Attachment?                  @relation("RegistrationAnswerAttachment", fields: [attachmentId], references: [id], onDelete: Restrict)

  @@unique([registrationRevisionId, fieldId])
  @@index([registrationRevisionId])
  @@index([fieldId])
  @@index([attachmentId])
}

// ===== §3.12 RegistrationUploadSession:报名附件上传会话 =====
//
// ⚠️ 只存 `tokenHash`(sha256 hex),**原始 token 不入库、不落日志、不进任何响应** ——
// 沿本仓 refresh_tokens.tokenHash 的 opaque + sha256 范式(§3.12 原话:
// 「原始 token 只返回一次,不入库」)。@unique 让"拿 token 换会话"是一次索引命中。
//
// §3.12 明写「不新增自动清理 cron,过期会话由现有手动 retention SOP 清理」
// ⇒ 本刀不建任何 cron / 定时任务。
model RegistrationUploadSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId    String
  memberId      String
  // 上传会话必然发生在"填某一版报名表的 file 题"语境里 ⇒ 与 §3.7 不同,这里
  // NOT NULL(合同字段表也未标 `?`)。
  formVersionId String

  tokenHash  String    @unique
  expiresAt  DateTime // §3.12 必填 —— 无过期的上传票据等于永久凭证
  consumedAt DateTime? // 只在 consumed 态有值(migration 形状 CHECK)
  // ⚠️ 合同**未给** statusCode 闭集,故本刀不加闭集 CHECK;只按 DoD 落
  // 「consumedAt 只在 consumed 态有值」这条形状约束。
  statusCode String

  activity    Activity                @relation(fields: [activityId], references: [id], onDelete: Restrict)
  member      Member                  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  formVersion RegistrationFormVersion @relation(fields: [formVersionId], references: [id], onDelete: Restrict)

  @@index([activityId])
  @@index([memberId])
  @@index([formVersionId])
  @@index([statusCode])
  @@index([expiresAt])
}

// ===== §3.13 ActivityQualificationRuleSet:资格规则冻结版本 =====
//
// 「一组规则的冻结版本,发布审核后 active」。三级作用域:活动级(session/position 皆空)、
// 场次级(sessionId 有值)、岗位级(positionId 有值)。
//
// ⚠️ 合同**未给** statusCode 闭集(只说"发布审核后 active"),故本刀不加闭集 CHECK,
// 不把 §3.12 表单版本的 draft/active/retired 挪用过来(那是另一张表的闭集)。
// ⚠️ 合同也**未给**本表任何 unique,故不加 —— 不自行发明 (activityId, version)。
model ActivityQualificationRuleSet {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String
  sessionId  String?
  positionId String?

  version    Int
  statusCode String

  activity Activity                 @relation(fields: [activityId], references: [id], onDelete: Restrict)
  // 复合 FK(activityId, sessionId)→ ActivitySession(activityId, id):沿第一刀,
  // 让「场次属于该活动」由 DB 保证。sessionId 为 NULL 时 PostgreSQL MATCH SIMPLE
  // 不校验该 FK —— 正是活动级规则集要的行为。
  session  ActivitySession?         @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  position ActivitySessionPosition? @relation("PositionQualificationRuleSetScope", fields: [positionId], references: [id], onDelete: Restrict)

  rules               ActivityQualificationRule[]
  evaluationSnapshots QualificationEvaluationSnapshot[]
  // §3.3 的 ActivitySessionPosition.qualificationRuleSetId 反向侧(本刀兑现第一刀的欠账)
  scopedPositions     ActivitySessionPosition[]         @relation("PositionQualificationRuleSet")

  @@index([activityId])
  @@index([sessionId])
  @@index([positionId])
  @@index([statusCode])
}

// ===== §3.13 ActivityQualificationRule:单条资格规则 =====
model ActivityQualificationRule {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ruleSetId       String
  // grade / organization / certificate / age / training / gender / insurance
  // (§3.13「支持 …」七种;migration CHECK 闭集 —— 与 goal 对 §3.12「支持类型」
  //  同样按闭集处理保持一致口径)
  ruleTypeCode    String
  enforcementCode String // block / warn(§3.13 明写闭集)

  operator  String
  valueJson Json? // 可空:存在性类算子(如"持有某证书")没有操作数
  message   String?
  sortOrder Int     @default(0)

  ruleSet ActivityQualificationRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)

  @@index([ruleSetId])
  @@index([ruleTypeCode])
  @@index([ruleSetId, sortOrder])
}

// ===== §3.13 QualificationEvaluationSnapshot:资格评估快照 =====
//
// 不可变快照 ⇒ 无 updatedAt / deletedAt。
//
// ⚠️ identityId / registrationRevisionId 双双可空,合同字段表未标 `?` —— 偏离理由
// 直接来自 §3.13 同段原话:「**展示**、提交和审核三次评估分别留快照」。**展示**发生在
// 报名之前,那一刻既没有 ParticipationIdentity 也没有 RegistrationRevision;
// 若两列 NOT NULL,展示态快照根本写不进来,合同自相矛盾。
//
// §3.13 硬约束:「不把证件号、完整保单或其他高敏感原值复制进 details,
// 只保存规则编号、结果和必要引用」—— 那是**写侧 service 的**职责,本刀只建列。
model QualificationEvaluationSnapshot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  identityId             String?
  registrationRevisionId String?
  ruleSetVersionId       String // 指向 ActivityQualificationRuleSet 行(该表自带 version 列)

  evaluatedAt DateTime
  resultCode  String // pass / warn / fail(§3.13 明写闭集)

  detailsJson    Json?
  inputFactsHash String?

  identity             ActivityParticipationIdentity? @relation(fields: [identityId], references: [id], onDelete: Restrict)
  registrationRevision ActivityRegistrationRevision?  @relation(fields: [registrationRevisionId], references: [id], onDelete: Restrict)
  ruleSetVersion       ActivityQualificationRuleSet   @relation(fields: [ruleSetVersionId], references: [id], onDelete: Restrict)

  @@index([identityId])
  @@index([registrationRevisionId])
  @@index([ruleSetVersionId])
  @@index([resultCode])
  @@index([evaluatedAt])
}

// ===== §3.14 ActivityInvitation:定向邀请 =====
//
// 「接受时调用同一 registration/qualification/capacity service,不直接改为 pass」
// —— 那是后续批次的 service 纪律,本刀只建表。
//
// ⚠️ active partial unique 是 (activityId, memberId, sessionId),而 sessionId **可空**
// (活动级邀请)。PostgreSQL 默认 NULL 互不相等 ⇒ 同一个人可被重复发出多张活动级
// 邀请而不被拦。本刀显式用 **NULLS NOT DISTINCT**(PG15+;本库 postgres:16)让 NULL
// 参与去重,沿 role_bindings_active_unique 既有先例。见 migration 末尾。
model ActivityInvitation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String
  memberId   String
  sessionId  String? // 空 = 活动级邀请
  positionId String?

  statusCode String // pending / accepted / declined / revoked / expired(§3.14 明写闭集)

  expiresAt       DateTime
  invitedByUserId String? // 沿本仓 actor FK 一律可空的既有范式
  respondedAt     DateTime?
  revokedAt       DateTime?
  reason          String?

  operationKey String?
  requestHash  String?

  activity  Activity                 @relation(fields: [activityId], references: [id], onDelete: Restrict)
  member    Member                   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  session   ActivitySession?         @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  position  ActivitySessionPosition? @relation("InvitationPosition", fields: [positionId], references: [id], onDelete: Restrict)
  invitedBy User?                    @relation("ActivityInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([activityId])
  @@index([memberId])
  @@index([sessionId])
  @@index([positionId])
  @@index([statusCode])
  @@index([expiresAt])
  @@index([operationKey])
}

// ===== §3.14 ActivityVisitor:现场访客 =====
//
// 🔴 **刻意零 Member relation**,不是漏了。合同 §3.14 原话:「与 Member、Participation、
// Ledger 无 relation;禁止通过访客创建贡献分」。`invitedByMemberId` 只是一个**裸字符串
// 留痕列**,不建外键、不建 relation —— 一旦接上 Member,访客就有了通往
// Participation / Ledger 的图上路径,"禁止通过访客创建贡献分"这条不变量就只剩文字。
// (Activity / ActivitySession 不在合同的禁止清单里,故双锚点 FK 照建。)
//
// 本表没有 identity / revision / 结算列,天然进不了任何贡献分链路。
model ActivityVisitor {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String
  sessionId  String

  name              String
  organization      String?
  // 🔴 裸列,**无 FK / 无 relation**(见上)。
  invitedByMemberId String?
  note              String?
  attendanceCode    String?

  activity Activity        @relation(fields: [activityId], references: [id], onDelete: Restrict)
  session  ActivitySession @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)

  @@index([activityId])
  @@index([sessionId])
  @@index([invitedByMemberId])
  @@index([attendanceCode])
}

// ============================================================================
// 活动改造 v1.1 —— 第 1 批第三刀:Punch / Evidence
// (2026-08-04;合同 docs/archive/reviews/activity-business-overhaul-v1.1/
//  §3.15 / §3.16 / §3.17 / §3.18;§14「第 1 批」建议拆分第 3 项)
//
// 本刀是纯 schema expand:**五张新表零调用方**是预期状态,消费方在第 5 批。
// 沿前两刀的四条工程判断:① 只做加法 ② 跨切片外键列不提前占位
// ③ 既有表原样保留 ④ 合同没给的一律不发明。
//
// 本刀按 ② 明确**不建**三个列(不是漏了):
//   - AttendancePunchEvent.importJobItemId   → ActivityBatchJobItem(§3.27,第四刀)
//   - AttendancePunchEvent.offlinePackageId  → OfflinePackage(合同第三处内部矛盾:
//     被 §5 列为核心新对象、被 §3.16 当外键列引用、被 §5.7 描述协议字段,
//     但 §3 数据模型从头到尾**没有定义它**。按 ④ 不从散文推导表结构,归第 6 批)
//   - ParticipantServiceSegmentRevision.effectiveBatchId → 结算批次(§3.19/§3.22,第四刀)
//
// ⚠️ 时间重叠**刻意不进 DB**:§3.18 明写「时间重叠校验在现有 member lock 内完成」
// ⇒ 不用 exclusion constraint / btree_gist 表达段重叠,那是 service 层的事(第 5 批)。
//
// ⚠️ 坐标按普通业务字段保存(修订说明 §7 拍板):零加密仓、零隔离库、零专用保存期限。
// ⚠️ tokenDigest 只存服务端签名载荷摘要,signingKeyVersion 只是整数版本号
// ⇒ 本刀**零密钥材料、零签名实现、零 crypto 代码**(沿第二刀 tokenHash 同一纪律)。
//
// 命名沿前两刀:**不使用 @@map**,物理表名即 PascalCase model 名。
// 状态类字段一律 String + migration CHECK 闭集兜底,不建 Prisma enum(合同 §3 前言)。
// ============================================================================

// ===== §3.15 AttendanceQrCredential:场次签到/签退二维码凭证 =====
//
// §3.15 原话:「tokenDigest = 服务端签名载荷摘要,**不保存可直接使用的完整二维码文本**」。
// 本表因此只有摘要与整数密钥版本号,没有任何可复原成有效二维码的材料。
//
// §4.4:`active → revoked | expired` **不可逆**;重发建新 credentialVersion,
// 不把旧行改回 active ⇒ 「至多一个 active」用 partial unique 落 DB(§3.15 明写要求)。
model AttendanceQrCredential {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String
  sessionId  String
  actionCode String // check_in / check_out(§3.15 明写二值闭集)

  credentialVersion Int // 同 (sessionId, actionCode) 内单调递增
  statusCode        String // active / revoked / expired(§3.15 明写闭集)

  tokenDigest       String
  signingKeyVersion Int

  validFrom  DateTime
  validUntil DateTime

  issuedByUserId String? // 沿本仓 actor FK 一律可空的既有范式
  issuedAt       DateTime

  revokedByUserId String?
  revokedAt       DateTime?
  revokeReason    String?

  operationKey String? // 重发／作废防重
  requestHash  String?

  activity  Activity        @relation(fields: [activityId], references: [id], onDelete: Restrict)
  // 双锚点复合 FK:(activityId, sessionId) → ActivitySession(activityId, id),
  // 挡住「凭证挂到别的活动的场次上」(沿第一刀 ActivitySessionPosition 范式)。
  session   ActivitySession @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  issuedBy  User?           @relation("AttendanceQrCredentialIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  revokedBy User?           @relation("AttendanceQrCredentialRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  punchEvents AttendancePunchEvent[]

  // 默认名 AttendanceQrCredential_sessionId_actionCode_credentialVersion_key = 65 字符
  // > PostgreSQL 63 字符标识符上限 ⇒ 必须显式 map(否则被静默截断,与既有长名漂移同源)。
  @@unique([sessionId, actionCode, credentialVersion], map: "attendance_qr_credential_session_action_version_key")
  @@index([activityId])
  @@index([sessionId])
  @@index([statusCode])
  @@index([validUntil])
  @@index([operationKey])
  @@index([sessionId, actionCode, statusCode])
}

// ===== §3.16 AttendancePunchEvent:追加式打卡事件 =====
//
// §3.16 原话:「正式现场事实的**唯一写入表**,不提供 update/delete endpoint」
// +「append-only trigger／权限:生产业务角色不得 UPDATE/DELETE」。
// ⇒ 本表由 **DB trigger** 强制 append-only(migration 末尾,镜像既有
//    trg_insurance_evidence_20_immutable 的「函数 + trigger」两段范式)。
//
// 不可变模型 ⇒ 按合同 §3 前言 **不带 updatedAt / deletedAt**
// (§3.16 字段表亦明写「createdAt 入库时间;无 updatedAt/deletedAt」)。
//
// ⚠️ offlinePackageId / importJobItemId **本刀不建**,见文件头说明。
model AttendancePunchEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  activityId String
  sessionId  String
  positionId String?

  participationIdentityId String
  memberId                String

  eventTypeCode String // check_in / check_out / early_departure_close / void / replace
  sourceCode    String // self_qr / staff_scan / proxy / bulk / import / offline / correction

  occurredAt DateTime // 真实发生时间;在线由服务端生成(DTO 不接客户端时间)
  receivedAt DateTime // 服务端收到时间

  operatorUserId   String // §3.16「本人自助也记录 User」⇒ 恒有值
  operatorMemberId String?

  reason String? // 特殊闭合、作废和替代必填(CHECK 兜底);见下方 reason CHECK 的口径说明

  qrCredentialId String?
  deviceId       String?

  // 🟢 **兑现第三刀欠账**(第三刀按「跨切片外键列不提前占位」暂缓,目标表 §3.27
  //    ActivityBatchJobItem 正是本刀建的):import / bulk 来源的事件指回产生它的任务项。
  //    可空 —— 自助 / 现场扫码等在线来源没有任务项。
  //    ⚠️ 本表有 append-only trigger,但加列走的是 ALTER TABLE ADD COLUMN(DDL),
  //       行级 trigger 不参与 DDL;加列后已重跑该 trigger 的四条判据(见 migration 说明)。
  importJobItemId String?

  // §3.16「普通业务字段,可空」;修订说明 §7 拍板坐标按普通业务字段保存。
  // 精度沿既有 activity_check_ins:经纬度 Decimal(10,7)、精度/距离 Decimal(10,2)。
  longitude Decimal? @db.Decimal(10, 7)
  latitude  Decimal? @db.Decimal(10, 7)
  accuracy  Decimal? @db.Decimal(10, 2)
  distance  Decimal? @db.Decimal(10, 2)

  // 判定快照:写入时冻结,不回查规则(沿 §3.4「不实时继承」同一思路)。
  geoVerified Boolean @default(false)
  outOfRange  Boolean @default(false)
  lowAccuracy Boolean @default(false)

  eventKey    String // 客户端或任务防重号,**全局 unique**(§3.16 + §11.3)
  requestHash String

  supersedesEventId String? // void / replace 的目标事件
  evidenceRevision  Int // 本事件提交后活动证据版本

  activity              Activity                      @relation(fields: [activityId], references: [id], onDelete: Restrict)
  session               ActivitySession               @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  position              ActivitySessionPosition?      @relation("PunchEventPosition", fields: [positionId], references: [id], onDelete: Restrict)
  participationIdentity ActivityParticipationIdentity @relation(fields: [participationIdentityId], references: [id], onDelete: Restrict)
  member                Member                        @relation("AttendancePunchEventMember", fields: [memberId], references: [id], onDelete: Restrict)
  operatorUser          User                          @relation("AttendancePunchEventOperatorUser", fields: [operatorUserId], references: [id], onDelete: Restrict)
  operatorMember        Member?                       @relation("AttendancePunchEventOperatorMember", fields: [operatorMemberId], references: [id], onDelete: Restrict)
  qrCredential          AttendanceQrCredential?       @relation(fields: [qrCredentialId], references: [id], onDelete: Restrict)
  importJobItem         ActivityBatchJobItem?         @relation("PunchEventImportJobItem", fields: [importJobItemId], references: [id], onDelete: Restrict)

  supersedesEvent AttendancePunchEvent?  @relation("PunchEventSupersede", fields: [supersedesEventId], references: [id], onDelete: Restrict)
  supersededBy    AttendancePunchEvent[] @relation("PunchEventSupersede")

  serviceSegmentCheckIns ParticipantServiceSegmentRevision[] @relation("SegmentSourceCheckInEvent")
  serviceSegmentCloses   ParticipantServiceSegmentRevision[] @relation("SegmentSourceCloseEvent")

  @@unique([eventKey])
  // §11.3 点名的三条:
  @@index([activityId, sessionId, occurredAt])
  @@index([participationIdentityId, occurredAt], map: "attendance_punch_event_identity_occurred_idx")
  @@index([operatorUserId, createdAt])
  @@index([activityId])
  @@index([sessionId])
  @@index([positionId])
  @@index([memberId])
  @@index([eventTypeCode])
  @@index([qrCredentialId])
  @@index([supersedesEventId])
  @@index([importJobItemId])
}

// ===== §3.17 ActivityEvidenceState:一活动一行的证据/人口版本指针 =====
//
// §3.17:由 PunchEvent、ParticipationRevision、场次取消／终止、人工复核正式化
// **同事务**递增。本刀只建表与约束,不写任何递增逻辑(第 2 批)。
model ActivityEvidenceState {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String @unique // §3.17「一活动一行」

  evidenceRevision   Int @default(0)
  populationRevision Int @default(0)
  version            Int @default(0) // CAS 版本

  lastEvidenceAt   DateTime?
  lastPopulationAt DateTime?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
}

// ===== §3.17 EvidenceSeal:不可变封场凭证 =====
//
// 「不可变」指**内容**不可变(evidenceRevision / contentHash / 计数快照一旦写入不改);
// §4.6 明确 statusCode 走 `active → superseded` 投影(「可在新 seal 写入时把旧 active 改
// superseded 作为投影」)⇒ 本行**会被 UPDATE**,故按合同 §3 前言默认带 updatedAt,
// 且**不装** append-only trigger(与 AttendancePunchEvent 的处置刻意不同)。
//
// ⚠️ 合同**未给**「一活动至多一个 active seal」的 partial unique
// (§11.3 只给 Closure 点了 partial unique active,Seal 没给)⇒ 按 ④ 不自行发明。
model EvidenceSeal {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId   String
  sealRevision Int

  evidenceRevision   Int
  populationRevision Int
  workflowRevision   Int

  allWindowsClosedAt       DateTime
  openSegmentCount         Int
  manualReviewPendingCount Int

  populationCountDistinct  Int
  populationCountBySession Json

  contentHash String
  statusCode  String // active / superseded(§3.17 明写闭集)

  sealedByUserId String? // 沿本仓 actor FK 一律可空的既有范式
  sealedAt       DateTime

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  sealedBy User?    @relation("EvidenceSealSealer", fields: [sealedByUserId], references: [id], onDelete: Restrict)

  // 第 1 批第四刀反向 relation(合同 §3.19 / §3.26):仅关系映射,零标量字段。
  settlementVersions AttendanceSettlementVersion[]
  closureRevisions   ActivitySettlementClosureRevision[]

  @@unique([activityId, sealRevision])
  @@index([activityId])
  @@index([statusCode])
  @@index([sealedAt])
}

// ===== §3.18 ParticipantServiceSegmentRevision:服务段投影与修订 =====
//
// §3.18:服务段**不是**直接人工编辑的主事实 —— 普通草稿由 PunchEvent 重建;
// 认定变更形成**新的** segment revision,不覆盖旧 revision。
//
// ⚠️ **时间重叠不进 DB**:§3.18 明写「时间重叠校验在现有 member lock 内完成」
// ⇒ 刻意不用 exclusion constraint / btree_gist(见文件头)。
// DB 只落「每个 (identityId, segmentKey) 至多一个非 superseded 当前修订」这条
// 单点 partial unique —— 它是**点唯一**不是**区间不相交**,两者不是一回事。
//
// ⚠️ effectiveBatchId **本刀不建**(结算批次表在第四刀),见文件头。
model ParticipantServiceSegmentRevision {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participationIdentityId String
  segmentKey              String
  revision                Int

  sourceCheckInEventId String
  // ⚠️ 合同字段表未标 `?`,本刀**改可空并上报**:§4.5「无开放段＋check_in → open」
  // 说明存在「已签到、尚未闭合」的段,此刻闭合事件根本不存在;NOT NULL 会让该形态
  // 写不进来(沿第二刀 QualificationEvaluationSnapshot 同一处置)。
  sourceCloseEventId   String?

  resultCode String // valid / early_departure_zero / voided / replaced(§3.18 明写闭集)
  statusCode String // draft / committed / superseded(§3.18 明写闭集)

  checkInAt    DateTime
  // 同上:开放段没有签退时间与时长。
  checkOutAt   DateTime?
  serviceHours Decimal?  @db.Decimal(5, 2) // 精度沿既有 AttendanceRecord.serviceHours

  lateFlag           Boolean @default(false)
  earlyLeaveFlag     Boolean @default(false)
  exceptionFlagsJson Json?

  baseRevisionId String? // 首个 revision 无前驱

  // 🟢 **兑现第三刀欠账**(目标表 §3.22 LedgerPostingBatch 正是本刀建的):
  //    §3.18 字段表原文 `baseRevisionId/effectiveBatchId?` —— 合同**自带** `?`,
  //    正式生效前(draft 段)本就没有批次。
  effectiveBatchId String?

  identity           ActivityParticipationIdentity @relation(fields: [participationIdentityId], references: [id], onDelete: Restrict)
  sourceCheckInEvent AttendancePunchEvent          @relation("SegmentSourceCheckInEvent", fields: [sourceCheckInEventId], references: [id], onDelete: Restrict)
  sourceCloseEvent   AttendancePunchEvent?         @relation("SegmentSourceCloseEvent", fields: [sourceCloseEventId], references: [id], onDelete: Restrict)

  baseRevision     ParticipantServiceSegmentRevision?  @relation("SegmentBaseRevision", fields: [baseRevisionId], references: [id], onDelete: Restrict)
  derivedRevisions ParticipantServiceSegmentRevision[] @relation("SegmentBaseRevision")

  effectiveBatch LedgerPostingBatch? @relation("SegmentEffectiveBatch", fields: [effectiveBatchId], references: [id], onDelete: Restrict)

  // model 名 33 字符 ⇒ 复合索引默认名普遍越过 PostgreSQL 63 字符上限,全部显式 map。
  @@unique([participationIdentityId, segmentKey, revision], map: "participant_service_segment_identity_key_revision_key")
  @@index([participationIdentityId], map: "participant_service_segment_identity_idx")
  @@index([participationIdentityId, statusCode], map: "participant_service_segment_identity_status_idx")
  @@index([statusCode], map: "participant_service_segment_status_idx")
  @@index([resultCode], map: "participant_service_segment_result_idx")
  @@index([sourceCheckInEventId], map: "participant_service_segment_checkin_event_idx")
  @@index([sourceCloseEventId], map: "participant_service_segment_close_event_idx")
  @@index([baseRevisionId], map: "participant_service_segment_base_revision_idx")
  @@index([effectiveBatchId], map: "participant_service_segment_effective_batch_idx")
}

// ============================================================================
// 活动改造 v1.1 —— 第 1 批第四刀:Settlement / Ledger / Correction / Closure / Job
// (2026-08-04;合同 docs/archive/reviews/activity-business-overhaul-v1.1/
//  §3.19 / §3.20 / §3.21 / §3.22 / §3.23 / §3.24 / §3.25 / §3.26 / §3.27;
//  §14「第 1 批」建议拆分第 4 项)
//
// 本刀是纯 schema expand:**十四张新表零调用方**是预期状态,消费方在第 2 批。
// 沿前三刀的四条工程判断:① 只做加法 ② 跨切片外键列不提前占位
// ③ 既有表原样保留 ④ 合同没给的一律不发明。
//
// 🔴 本刀语义像钱:`ParticipationLedgerEntry` 一旦随 batch committed 就是队员贡献值真值。
//
// 本刀**兑现**前面欠下的两个列(第三刀按 ② 暂缓,目标表正是本刀建的):
//   - ParticipantServiceSegmentRevision.effectiveBatchId → LedgerPostingBatch(§3.22)
//   - AttendancePunchEvent.importJobItemId               → ActivityBatchJobItem(§3.27)
//
// 本刀按 ② 仍**不建**:AttendancePunchEvent.offlinePackageId(OfflinePackage 是合同第三处
// 内部矛盾,§3 从未定义该表,归第 6 批);§3.11 分配相关四表与
// ActivityParticipationRevision.allocationBatchId(**合同第四处内部矛盾**:§14 任何一刀
// 都没列入,而第 4 批行为实现要用 —— 维护者 2026-08-04 拍板另走第五刀)。
//
// ⚠️ 「日合计 0..3」(§3.24)**刻意不进任何表级 CHECK / trigger**:那是**跨行**不变量
//    (同一 member 同一 ledgerDate 的多条分录求和),表级 CHECK 只能看单行,trigger 伪造
//    跨行求和会在并发下骗人。跨行日上限归 service(第 2 批,在既有 member advisory lock 内)。
//    详见 migration 末尾的具名声明段。
//
// ⚠️ `ledgerDate` **唯一选型 = `DateTime @db.Date`**(§3.21 明写「必须唯一选型」),
//    三处同型:ParticipantSettlementDay / ParticipationLedgerEntry /
//    MemberContributionDayState。混型会让 (memberId, ledgerDate) 唯一在跨表 join 时静默错位。
//    业务侧的北京日换算统一走 BeijingCalendarService(第 2 批),本刀零转换代码。
//
// ⚠️ worker 协议**零新增基础设施**(§3.27):`ActivityBatchJob` 的 lease/fencing 列镜像
//    既有 outbox / storage-operation 两张表的形状,复用 PostgreSQL `SKIP LOCKED + lease`。
//    本刀**不新增 cron**(全仓终态恰 2)、不引入 Redis/queue、不注册 worker 进程。
//
// ⚠️ **不存敏感原值**(§3.27 明写):`ActivityBatchJobItem` 只有 `lastErrorCode`(编码)与
//    `safeMessage`(已脱敏文案),**没有为异常堆栈 / SQL / 敏感原值预留任何字段**;
//    `ActivitySettlementClosureRevision.checksJson` 只存非敏感摘要与失败计数,不复制人员明细。
//
// 命名沿前三刀:**不使用 @@map**,物理表名即 PascalCase model 名。
// 状态类字段一律 String + migration CHECK 闭集兜底,不建 Prisma enum(合同 §3 前言)。
// 本刀 model 名普遍 ≥ 24 字符 ⇒ 复合索引默认名易越过 PostgreSQL 63 字符上限并被静默截断,
// 故**所有** @@unique / @@index 一律显式 `map:`(沿第三刀 ParticipantServiceSegmentRevision)。
// ============================================================================

// ===== §3.19 AttendanceSettlementRun:结算根,一活动一行 =====
//
// §3.19:「状态是页面投影和流程根,正式人员结果／账本仍由版本和 batch 主导」
// ⇒ 本行**会被 UPDATE**(statusCode / 各 current* 指针 / version CAS),按 §3 前言带 updatedAt。
model AttendanceSettlementRun {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String @unique // §3.19「一活动一行」

  // not_started / drafting / submitted / pending_first_review / pending_final_review
  // / posting / posted / correction_open / closed(§3.19 明写九值闭集)
  statusCode String

  // 快速指针,不是真相源(真相在 Version / PostingBatch / ClosureRevision 行上)。
  currentDraftVersion     Int?
  currentSubmittedVersion Int?
  currentPostedVersion    Int?
  currentClosureRevision  Int?

  version Int @default(0) // CAS

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)

  versions           AttendanceSettlementVersion[]
  postingBatches     LedgerPostingBatch[]
  correctionRequests AttendanceCorrectionRequest[]

  @@index([statusCode], map: "attendance_settlement_run_status_idx")
}

// ===== §3.19 AttendanceSettlementVersion:不可变提交版本 =====
//
// 「不可变」指**内容**不可变(evidenceSealId / contentHash / 三个计数快照一旦写入不改);
// 但 §3.19 的 statusCode 闭集含 `returned/approved/voided` —— 审核结果要写回本行
// ⇒ 本行**会被 UPDATE**,故按 §3 前言带 updatedAt,且**不装** append-only trigger。
// 这与第三刀 EvidenceSeal 的处置逐字同源(内容不可变 ≠ 行不可变)。
model AttendanceSettlementVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settlementRunId String
  version         Int

  evidenceSealId     String
  evidenceRevision   Int
  populationRevision Int
  workflowRevision   Int

  contentHash               String
  personCount               Int
  sessionParticipationCount Int
  serviceSegmentCount       Int

  createdByUserId String? // 沿本仓 actor FK 一律可空的既有范式
  submittedAt     DateTime?

  statusCode String // draft / submitted / returned / approved / voided(§3.19 明写五值闭集)

  priorVersionId  String? // 首版无前驱
  returnFromStage String? // 仅退回版本有值
  returnReason    String?

  operationKey String?
  requestHash  String?

  settlementRun AttendanceSettlementRun @relation(fields: [settlementRunId], references: [id], onDelete: Restrict)
  evidenceSeal  EvidenceSeal            @relation(fields: [evidenceSealId], references: [id], onDelete: Restrict)
  createdBy     User?                   @relation("SettlementVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  priorVersion    AttendanceSettlementVersion?  @relation("SettlementVersionPrior", fields: [priorVersionId], references: [id], onDelete: Restrict)
  derivedVersions AttendanceSettlementVersion[] @relation("SettlementVersionPrior")

  reviewActions      SettlementReviewAction[]
  resultRevisions    ParticipantSettlementResultRevision[]
  postingBatches     LedgerPostingBatch[]
  closureRevisions   ActivitySettlementClosureRevision[]
  correctionRequests AttendanceCorrectionRequest[]         @relation("CorrectionRequestBaseVersion")
  correctionApplied  CorrectionApplication[]               @relation("CorrectionApplicationNewVersion")
  batchJobs          ActivityBatchJob[]

  @@unique([settlementRunId, version], map: "attendance_settlement_version_run_version_key")
  @@index([settlementRunId], map: "attendance_settlement_version_run_idx")
  @@index([statusCode], map: "attendance_settlement_version_status_idx")
  @@index([evidenceSealId], map: "attendance_settlement_version_seal_idx")
  @@index([priorVersionId], map: "attendance_settlement_version_prior_idx")
  @@index([operationKey], map: "attendance_settlement_version_operation_key_idx")
}

// ===== §3.19 SettlementReviewAction:审核动作,append-only =====
//
// §3.19 明写 append-only ⇒ 按 §3 前言**不带 updatedAt / deletedAt**。
// ⚠️ 与 ParticipationLedgerEntry 不同,合同**没有**为本表点名「数据库角色层禁止
//    UPDATE/DELETE」(那句只写在 §3.23.8 账本上)⇒ 本刀**不装** append-only trigger,
//    只用「无 updatedAt + 至多一个生效决定」的形状表达。沿 ④ 不自行加码。
//
// 🔴 actorUserId 取 NOT NULL(合同字段表未标 `?`):§3.19 的「提交人／一审人／终审人分离」
//    是事务内硬不变量,审核动作没有 actor 就无法复判分离 —— 与第三刀
//    AttendancePunchEvent.operatorUserId 同一处置(该列亦因合同点名而 NOT NULL)。
model SettlementReviewAction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  settlementVersionId String
  stageCode           String // first / final(§3.19 明写二值闭集)
  actionCode          String // approve / return(§3.19 明写二值闭集)

  actorUserId String
  actedAt     DateTime
  note        String?

  operationKey String  @unique // §3.19 明写 unique;单列不复合(复合恰好放行同 key 不同 payload)
  requestHash  String?

  settlementVersion AttendanceSettlementVersion @relation(fields: [settlementVersionId], references: [id], onDelete: Restrict)
  actor             User                        @relation("SettlementReviewActionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([settlementVersionId], map: "settlement_review_action_version_idx")
  @@index([settlementVersionId, stageCode], map: "settlement_review_action_version_stage_idx")
  @@index([actorUserId, actedAt], map: "settlement_review_action_actor_acted_idx")
}

// ===== §3.20 ParticipantSettlementResultRevision:人员结算结果修订 =====
//
// §3.20:unique `(settlementVersionId, participationIdentityId)` —— 一个 identity
// 每个正式版本**一条**(注意:unique 不含 revision,revision 只是本条的修订序号)。
// statusCode `draft/committed/superseded` 是投影 ⇒ 本行会被 UPDATE,带 updatedAt。
model ParticipantSettlementResultRevision {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settlementVersionId     String
  participationIdentityId String
  revision                Int

  // present / leave / absent / cancelled / not_selected / waitlist_expired
  // / review_expired / invitation_expired / exempt / early_departure_zero(§3.20 明写十值闭集)
  resultCode String

  lateFlag           Boolean @default(false)
  earlyLeaveFlag     Boolean @default(false)
  exceptionFlagsJson Json?

  // 精度沿既有 AttendanceRecord.serviceHours / contributionPoints = Decimal(5,2)。
  // 四列**均 NOT NULL**:请假/缺席/未入选等零结果写 0,不是写 NULL ——
  // 「认定 ≠ 计算 ⇒ adjustmentReason 必填」那条 CHECK 依赖它们可比较。
  recognizedServiceHours       Decimal @db.Decimal(5, 2)
  recognizedContributionPoints Decimal @db.Decimal(5, 2)
  calculatedServiceHours       Decimal @db.Decimal(5, 2)
  calculatedContributionPoints Decimal @db.Decimal(5, 2)

  adjustmentReason String? // §3.20:认定与计算不同**必填**(migration CHECK 兜底)

  statusCode String // draft / committed / superseded(§3.20 明写三值闭集)

  baseResultRevisionId String? // 首个 revision 无前驱
  correctionRequestId  String?

  settlementVersion AttendanceSettlementVersion   @relation(fields: [settlementVersionId], references: [id], onDelete: Restrict)
  identity          ActivityParticipationIdentity @relation(fields: [participationIdentityId], references: [id], onDelete: Restrict)

  baseResultRevision ParticipantSettlementResultRevision?  @relation("ResultRevisionBase", fields: [baseResultRevisionId], references: [id], onDelete: Restrict)
  derivedRevisions   ParticipantSettlementResultRevision[] @relation("ResultRevisionBase")

  correctionRequest AttendanceCorrectionRequest? @relation(fields: [correctionRequestId], references: [id], onDelete: Restrict)

  settlementDays ParticipantSettlementDay[]
  ledgerEntries  ParticipationLedgerEntry[]

  @@unique([settlementVersionId, participationIdentityId], map: "participant_settlement_result_version_identity_key")
  // §11.3 点名的两条:
  @@index([settlementVersionId, resultCode], map: "participant_settlement_result_version_result_idx")
  @@index([participationIdentityId, statusCode], map: "participant_settlement_result_identity_status_idx")
  @@index([statusCode], map: "participant_settlement_result_status_idx")
  @@index([baseResultRevisionId], map: "participant_settlement_result_base_idx")
  @@index([correctionRequestId], map: "participant_settlement_result_correction_idx")
}

// ===== §3.21 ParticipantSettlementDay:北京日拆分 =====
//
// 🔴 `ledgerDate` = `DateTime @db.Date`(§3.21 明写「必须唯一选型」)—— 三处同型之一。
//
// ⚠️ 本表也有 recognized / credited / cappedOut 三列,但**刻意不落**
//    `recognized = credited + cappedOut` 的等式 CHECK:§3.23.6 只把该等式加在
//    **账本分录**上,而 §3.21 明写本表「preparing 阶段可重算」—— 重算是分步 UPDATE,
//    中途出现不平衡是合法过程态,加等式会静默误杀合法写入(沿第三刀「过严 CHECK 会误杀
//    合法行」的实测教训)。等式的执法位在 ParticipationLedgerEntry 上,那里 committed 即真值。
model ParticipantSettlementDay {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resultRevisionId String
  memberId         String
  ledgerDate       DateTime @db.Date

  serviceHours     Decimal @db.Decimal(5, 2)
  recognizedPoints Decimal @db.Decimal(5, 2)
  creditedPoints   Decimal @db.Decimal(5, 2)
  cappedOutPoints  Decimal @db.Decimal(5, 2)

  sequenceStartAt DateTime // 当日服务起点,日内稳定排序的第一键
  stableOrderKey  String // 同起点时的确定性 tiebreaker(不依赖 id 生成顺序)

  resultRevision ParticipantSettlementResultRevision @relation(fields: [resultRevisionId], references: [id], onDelete: Restrict)
  member         Member                              @relation("ParticipantSettlementDayMember", fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([resultRevisionId, ledgerDate], map: "participant_settlement_day_result_date_key")
  @@index([memberId, ledgerDate], map: "participant_settlement_day_member_date_idx")
  @@index([resultRevisionId], map: "participant_settlement_day_result_idx")
}

// ===== §3.22 LedgerPostingBatch:账本发布批次 =====
//
// §3.22:「准备中和 ready 分录必须对所有正常读面不可见,只允许通过
// `batch.statusCode='committed'` join 后读取」⇒ 可见性由 batch 状态决定,
// 本刀只建表与约束,读面切换在第 2 批。
model LedgerPostingBatch {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settlementRunId     String
  settlementVersionId String
  batchRevision       Int // 同一 run 内单调递增

  statusCode String // preparing / ready / committed / failed / voided(§3.22 明写五值闭集)

  requestKey  String  @unique // 幂等键;**单列**不复合(复合恰好放行同 key 不同 payload)
  requestHash String?

  baselineJsonHash String? // seal、人员、day-state 基线摘要

  preparedCount Int @default(0)
  totalCount    Int @default(0)
  failureCount  Int @default(0)

  preparedAt  DateTime?
  committedAt DateTime?
  failedAt    DateTime?
  voidedAt    DateTime?

  preparedByUserId  String? // 沿本仓 actor FK 一律可空的既有范式
  committedByUserId String?

  version Int @default(0) // CAS

  settlementRun     AttendanceSettlementRun     @relation(fields: [settlementRunId], references: [id], onDelete: Restrict)
  settlementVersion AttendanceSettlementVersion @relation(fields: [settlementVersionId], references: [id], onDelete: Restrict)
  preparedBy        User?                       @relation("LedgerPostingBatchPreparer", fields: [preparedByUserId], references: [id], onDelete: Restrict)
  committedBy       User?                       @relation("LedgerPostingBatchCommitter", fields: [committedByUserId], references: [id], onDelete: Restrict)

  ledgerEntries     ParticipationLedgerEntry[]
  dayStates         MemberContributionDayState[]
  closureRevisions  ActivitySettlementClosureRevision[]
  correctionApplied CorrectionApplication[]             @relation("CorrectionApplicationNewBatch")
  batchJobs         ActivityBatchJob[]
  effectiveSegments ParticipantServiceSegmentRevision[] @relation("SegmentEffectiveBatch")

  @@unique([settlementVersionId, batchRevision], map: "ledger_posting_batch_version_revision_key")
  // §11.3 点名的两条:
  @@index([statusCode, createdAt], map: "ledger_posting_batch_status_created_idx")
  @@index([settlementVersionId], map: "ledger_posting_batch_version_idx")
  @@index([settlementRunId], map: "ledger_posting_batch_run_idx")
}

// ===== §3.23 ParticipationLedgerEntry:正式账本 =====
//
// 🔴 §3.23 明写「append-only,无 updatedAt/deletedAt」+ §3.23.8「只允许 INSERT;
//    数据库角色层禁止业务账号 UPDATE/DELETE」⇒ 由 **DB trigger** 强制,
//    镜像第三刀 AttendancePunchEvent 的函数 + trigger 两段范式(本刀第二组)。
//
// 🔴 §3.23.6「recognized = credited + cappedOut 对每个贡献分录成立」——
//    四个 delta 列**全部 NOT NULL**,且 migration 里的等式 CHECK 把
//    `IS NOT NULL` 守卫写在 AND 链**最前**(AND 是 FALSE-主导 ⇒ 整式结构上不可能塌成 NULL,
//    不会出现「表达式为 NULL ⇒ CHECK 判通过」的静默失效)。两道防线,见 migration 说明。
//
// 🔴 `ledgerDate` = `DateTime @db.Date` —— 三处同型之二。
model ParticipationLedgerEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  postingBatchId String

  entryKey     String  @unique // 分录级幂等键
  operationKey String  @unique // 操作级幂等键
  requestHash  String?

  memberId                String
  activityId              String
  sessionId               String
  participationIdentityId String
  resultRevisionId        String

  ledgerDate DateTime @db.Date

  // service_credit / contribution_credit / service_reversal / contribution_reversal
  entryTypeCode String

  // 精度沿既有 AttendanceRecord.serviceHours / contributionPoints = Decimal(5,2)。
  // 四列**均 NOT NULL** —— 账本没有「不知道」的余地,冲回写负数不写 NULL。
  serviceHoursDelta     Decimal @db.Decimal(5, 2)
  recognizedPointsDelta Decimal @db.Decimal(5, 2)
  creditedPointsDelta   Decimal @db.Decimal(5, 2)
  cappedOutPointsDelta  Decimal @db.Decimal(5, 2)

  reversesEntryId String? // §3.23.4:reversal 必带;普通 credit 不得带(migration CHECK)

  postingBatch   LedgerPostingBatch                  @relation(fields: [postingBatchId], references: [id], onDelete: Restrict)
  member         Member                              @relation("ParticipationLedgerEntryMember", fields: [memberId], references: [id], onDelete: Restrict)
  activity       Activity                            @relation(fields: [activityId], references: [id], onDelete: Restrict)
  // 双锚点复合 FK:(activityId, sessionId) → ActivitySession(activityId, id),
  // 挡住「分录挂到别的活动的场次上」(沿第一刀 / 第三刀范式)。
  session        ActivitySession                     @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  identity       ActivityParticipationIdentity       @relation(fields: [participationIdentityId], references: [id], onDelete: Restrict)
  resultRevision ParticipantSettlementResultRevision @relation(fields: [resultRevisionId], references: [id], onDelete: Restrict)

  reversesEntry ParticipationLedgerEntry?  @relation("LedgerEntryReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy    ParticipationLedgerEntry[] @relation("LedgerEntryReversal")

  reversalClaim LedgerEntryReversalClaim? @relation("ReversalClaimOriginalEntry")

  @@unique([postingBatchId, resultRevisionId, ledgerDate, entryTypeCode], map: "participation_ledger_entry_batch_result_date_type_key")
  // §11.3 点名的三条:
  @@index([memberId, ledgerDate], map: "participation_ledger_entry_member_date_idx")
  @@index([activityId, postingBatchId], map: "participation_ledger_entry_activity_batch_idx")
  @@index([postingBatchId, resultRevisionId], map: "participation_ledger_entry_batch_result_idx")
  @@index([sessionId], map: "participation_ledger_entry_session_idx")
  @@index([participationIdentityId], map: "participation_ledger_entry_identity_idx")
  @@index([entryTypeCode], map: "participation_ledger_entry_type_idx")
  @@index([reversesEntryId], map: "participation_ledger_entry_reverses_idx")
}

// ===== §3.23.5 LedgerEntryReversalClaim:冲回占位辅助表 =====
//
// §3.23.5 **点名**要这张辅助表:「一条原 entry 至多被一个 committed reversal 逻辑冲回;
// 因跨 batch 状态,service 锁后检查 + partial unique 辅助表
// `LedgerEntryReversalClaim(originalEntryId unique)`」。
//
// 沿 ④:合同只点名 `originalEntryId unique` 这一件事,故本表**只有这一列**。
// 「是哪条 reversal 冲的」不需要再存一列 —— ParticipationLedgerEntry.reversesEntryId
// 已经指回 originalEntryId,加列反而是两处真相源。
model LedgerEntryReversalClaim {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  originalEntryId String @unique

  originalEntry ParticipationLedgerEntry @relation("ReversalClaimOriginalEntry", fields: [originalEntryId], references: [id], onDelete: Restrict)
}

// ===== §3.24 MemberContributionDayState:持久化日版本行 =====
//
// §3.24 明写「**不是**新的 advisory lock」—— 本表只承载日版本与日合计,
// 排他性仍由既有 member advisory lock 提供,本刀**不建第二套 member 锁域**。
//
// 🔴 `ledgerDate` = `DateTime @db.Date` —— 三处同型之三。
//
// ⚠️ §3.24「日合计必须 0..3」**刻意不落 CHECK** —— 见文件头与 migration 末尾具名声明。
model MemberContributionDayState {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberId   String
  ledgerDate DateTime @db.Date

  version                 Int     @default(0)
  committedCreditedPoints Decimal @default(0) @db.Decimal(5, 2)

  latestBatchId String?

  member      Member              @relation("MemberContributionDayStateMember", fields: [memberId], references: [id], onDelete: Restrict)
  latestBatch LedgerPostingBatch? @relation(fields: [latestBatchId], references: [id], onDelete: Restrict)

  @@unique([memberId, ledgerDate], map: "member_contribution_day_state_member_date_key")
  @@index([ledgerDate], map: "member_contribution_day_state_date_idx")
  @@index([latestBatchId], map: "member_contribution_day_state_batch_idx")
}

// ===== §3.25 AttendanceCorrectionRequest:更正申请 =====
model AttendanceCorrectionRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId              String
  settlementRunId         String
  participationIdentityId String? // §3.25 明标 `?`:活动级更正没有单人锚点

  baseSettlementVersionId String
  baseResultRevisionId    String? // §3.25 明标 `?`
  baseClosureRevision     Int

  requestTypeCode String // result / service / time / points / person_identity / other

  requestedChangeJson Json
  reason              String
  attachmentIds       Json?

  // pending / returned / approved / rejected / applying / applied / voided(§3.25 明写七值闭集)
  statusCode String

  submittedByUserId String? // 沿本仓 actor FK 一律可空的既有范式
  submittedAt       DateTime
  reviewedByUserId  String?
  reviewedAt        DateTime?
  reviewNote        String?

  operationKey String?
  requestHash  String?
  version      Int     @default(0) // CAS

  activity              Activity                       @relation(fields: [activityId], references: [id], onDelete: Restrict)
  settlementRun         AttendanceSettlementRun        @relation(fields: [settlementRunId], references: [id], onDelete: Restrict)
  identity              ActivityParticipationIdentity? @relation(fields: [participationIdentityId], references: [id], onDelete: Restrict)
  baseSettlementVersion AttendanceSettlementVersion    @relation("CorrectionRequestBaseVersion", fields: [baseSettlementVersionId], references: [id], onDelete: Restrict)
  submittedBy           User?                          @relation("CorrectionRequestSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedBy            User?                          @relation("CorrectionRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  applications      CorrectionApplication[]
  resultRevisions   ParticipantSettlementResultRevision[]
  supersededClosure ActivitySettlementClosureRevision[]   @relation("ClosureSupersededByCorrection")

  // §11.3 点名的两条:
  @@index([activityId, statusCode], map: "attendance_correction_request_activity_status_idx")
  @@index([participationIdentityId, statusCode], map: "attendance_correction_request_identity_status_idx")
  @@index([settlementRunId], map: "attendance_correction_request_run_idx")
  @@index([baseSettlementVersionId], map: "attendance_correction_request_base_version_idx")
  @@index([operationKey], map: "attendance_correction_request_operation_key_idx")
}

// ===== §3.25 CorrectionApplication:批准后的不可变应用版本 =====
//
// statusCode `preparing/committed/failed/voided` 是过程投影 ⇒ 本行会被 UPDATE,带 updatedAt。
model CorrectionApplication {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  correctionRequestId    String
  newSettlementVersionId String
  newResultRevisionIds   Json // 本次应用产出的 ResultRevision id 列表
  newPostingBatchId      String

  statusCode String // preparing / committed / failed / voided(§3.25 明写四值闭集)

  correctionRequest    AttendanceCorrectionRequest @relation(fields: [correctionRequestId], references: [id], onDelete: Restrict)
  newSettlementVersion AttendanceSettlementVersion @relation("CorrectionApplicationNewVersion", fields: [newSettlementVersionId], references: [id], onDelete: Restrict)
  newPostingBatch      LedgerPostingBatch          @relation("CorrectionApplicationNewBatch", fields: [newPostingBatchId], references: [id], onDelete: Restrict)

  @@index([correctionRequestId], map: "correction_application_request_idx")
  @@index([statusCode], map: "correction_application_status_idx")
  @@index([newSettlementVersionId], map: "correction_application_new_version_idx")
  @@index([newPostingBatchId], map: "correction_application_new_batch_idx")
}

// ===== §3.26 ActivitySettlementClosureRevision:关闭版本 =====
//
// 「不可变」同 EvidenceSeal / SettlementVersion:**内容**不可变,但 statusCode
// `active → superseded` 是投影(§3.26「旧 active closure 在同一事务变 superseded」)
// ⇒ 本行会被 UPDATE,带 updatedAt,不装 append-only trigger。
//
// ⚠️ `serviceHours` / `contributionPoints` 是**整活动合计**,不是单人值
//    ⇒ 精度取 Decimal(12,2) 而非本刀其它表的 (5,2):万人 × 24h 会直接撑爆 999.99。
//    这是**刻意与既有单人列不同型**,不是漂移。
//
// ⚠️ `checksJson` 只存非敏感摘要与失败计数(§3.26 明写「不复制人员明细」)。
model ActivitySettlementClosureRevision {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String
  revision   Int

  settlementVersionId String
  postingBatchId      String
  evidenceSealId      String

  evidenceRevision   Int
  populationRevision Int
  workflowRevision   Int

  personCount               Int
  sessionParticipationCount Int
  resultCountsJson          Json
  serviceHours              Decimal @db.Decimal(12, 2)
  contributionPoints        Decimal @db.Decimal(12, 2)

  checksHash String
  checksJson Json

  statusCode String // active / superseded / voided(§3.26 明写三值闭集)

  closedByUserId String? // 沿本仓 actor FK 一律可空的既有范式
  closedAt       DateTime

  supersededAt             DateTime?
  supersededByCorrectionId String?

  activity          Activity                    @relation(fields: [activityId], references: [id], onDelete: Restrict)
  settlementVersion AttendanceSettlementVersion @relation(fields: [settlementVersionId], references: [id], onDelete: Restrict)
  postingBatch      LedgerPostingBatch          @relation(fields: [postingBatchId], references: [id], onDelete: Restrict)
  evidenceSeal      EvidenceSeal                @relation(fields: [evidenceSealId], references: [id], onDelete: Restrict)
  closedBy          User?                       @relation("ClosureRevisionCloser", fields: [closedByUserId], references: [id], onDelete: Restrict)

  supersededByCorrection AttendanceCorrectionRequest? @relation("ClosureSupersededByCorrection", fields: [supersededByCorrectionId], references: [id], onDelete: Restrict)

  @@unique([activityId, revision], map: "activity_settlement_closure_activity_revision_key")
  @@index([activityId], map: "activity_settlement_closure_activity_idx")
  @@index([statusCode], map: "activity_settlement_closure_status_idx")
  @@index([settlementVersionId], map: "activity_settlement_closure_version_idx")
  @@index([postingBatchId], map: "activity_settlement_closure_batch_idx")
  @@index([evidenceSealId], map: "activity_settlement_closure_seal_idx")
  @@index([supersededByCorrectionId], map: "activity_settlement_closure_superseded_by_idx")
}

// ===== §3.27 ActivityBatchJob:后台任务 =====
//
// §3.27:「复用现有 PostgreSQL `SKIP LOCKED + lease/fencing` 模式,在现有 worker 进程
// 注册 ActivityBatchWorker,**不新增 cron 和外部队列**」⇒ 本刀只建表,
// lease/fencing 列的形状镜像既有 `notification_outbox_intents` 与
// `storage_object_operations`(两表并集恰好就是 §3.27 点名的五列:
// leaseOwner / leaseGeneration / leaseExpiresAt / attempts / availableAt;
// `leaseGeneration` 在 outbox 上没有、在 storage-operation 上有)。
// `availableAt` / `leaseExpiresAt` 沿两表的 `@db.Timestamptz(3)` 逐字同型 ——
// 领取判据要和 `now()` 直接比较,时区语义必须与既有 worker 一致。
model ActivityBatchJob {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // settlement_prepare / bulk_proxy / import_preview / import_execute
  // / export / notification_expand / reconciliation(§3.27 明写七值闭集)
  jobTypeCode String

  activityId          String
  sessionId           String?
  settlementVersionId String?
  postingBatchId      String?

  // pending / processing / succeeded / partial_failed / failed / cancelled / dead
  statusCode String

  operationKey   String  @unique // §3.27 幂等;单列不复合
  requestHash    String?
  payloadVersion Int
  payload        Json

  total     Int @default(0)
  succeeded Int @default(0)
  failed    Int @default(0)
  skipped   Int @default(0)

  // ↓ worker 协议五列,镜像既有 outbox / storage-operation,零新增基础设施。
  leaseOwner      String?
  leaseGeneration Int       @default(0)
  leaseExpiresAt  DateTime? @db.Timestamptz(3)
  attempts        Int       @default(0)
  availableAt     DateTime  @default(now()) @db.Timestamptz(3)

  createdByUserId String? // 沿本仓 actor FK 一律可空的既有范式
  startedAt       DateTime?
  completedAt     DateTime?
  lastErrorCode   String? // 只存编码,不存堆栈/SQL(§3.27)

  activity          Activity                     @relation(fields: [activityId], references: [id], onDelete: Restrict)
  session           ActivitySession?             @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  settlementVersion AttendanceSettlementVersion? @relation(fields: [settlementVersionId], references: [id], onDelete: Restrict)
  postingBatch      LedgerPostingBatch?          @relation(fields: [postingBatchId], references: [id], onDelete: Restrict)
  createdBy         User?                        @relation("ActivityBatchJobCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  items ActivityBatchJobItem[]

  // §11.3 点名的两条:
  @@index([statusCode, availableAt, leaseExpiresAt], map: "activity_batch_job_claim_idx")
  @@index([activityId, createdAt], map: "activity_batch_job_activity_created_idx")
  @@index([leaseExpiresAt], map: "activity_batch_job_lease_expires_idx")
  @@index([jobTypeCode], map: "activity_batch_job_type_idx")
  @@index([sessionId], map: "activity_batch_job_session_idx")
  @@index([settlementVersionId], map: "activity_batch_job_version_idx")
  @@index([postingBatchId], map: "activity_batch_job_batch_idx")
}

// ===== §3.27 ActivityBatchJobItem:逐项进度 =====
//
// 🔴 §3.27 明写「**不存异常堆栈、SQL 和敏感原值**」⇒ 本表只有:
//    `lastErrorCode`(错误编码)、`safeMessage`(已脱敏的可展示文案)、
//    `payloadHash`(摘要,不是原值)、`resultReference`(指针,不是内容)。
//    本刀**没有为原值预留任何字段**,这条在建表时就没有落点,不靠后续代码自律。
//
// ⚠️ 本表 statusCode **刻意不落闭集 CHECK**:§3.27 给了 Job 的七值闭集,
//    却**没给 Item 的取值集**(沿 ④ 不自行发明;第二刀对三处未给闭集同样处置)。
//    已在报告与 PR body 列为合同缺口。
model ActivityBatchJobItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobId   String
  itemKey String

  statusCode    String
  attempts      Int     @default(0)
  lastErrorCode String?
  safeMessage   String?

  // 逐项防重锚点;import_preview 这类「资源尚未创建」的任务此刻没有资源可指
  // ⇒ 两列可空(合同字段表未标 `?`,本刀改可空并上报,沿第二刀同一处置)。
  resourceType String?
  resourceId   String?

  payloadHash     String?
  resultReference String?

  job ActivityBatchJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  punchEvents AttendancePunchEvent[] @relation("PunchEventImportJobItem")

  @@unique([jobId, itemKey], map: "activity_batch_job_item_job_key_key")
  // §11.3 点名的一条:
  @@index([jobId, statusCode], map: "activity_batch_job_item_job_status_idx")
  @@index([resourceType, resourceId], map: "activity_batch_job_item_resource_idx")
}
