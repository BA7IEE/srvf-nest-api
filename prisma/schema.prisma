// ===== issue #1055 T1:member_official_portraits(队员标准照)=====
//
// 队员标准照 = 穿队服、符合冻结规格的**正式肖像**,归队伍管理,用于名录 / 组织架构 /
// 展示墙 / 制证 / 正式材料。它与另外两类图片是**三条互不相通的链**(issue §一):
//   - 账号头像(`User.avatarAttachmentId`)—— 用户本人控制,App 个性化展示;
//   - 身份证件影像(招新 / 敏感档案)—— 只用于身份核验,**禁止任何展示用途**。
// 三者之间**没有任何自动派生路径**:标准照不得由微信头像、身份证人像或 OCR 裁剪图生成
// (issue §5.2 末条 + 本 goal §3 硬禁区)。
//
// **为什么是版本表而不是 Member 上的一列**:标准照是正式业务事实,制证 / 年度名录 /
// 对外报送一旦定稿就不能因为本人换了照片而"背后变图"(issue §10.3)。所以每次替换
// **新建一行**,旧行转 SUPERSEDED 保留 —— 正式材料引用的是
// `MemberOfficialPortrait.id`,不是"当前那张"。
//
// **本刀只建表,不接任何读写路径**(T1 = expand)。Admin 上传 / 激活 / 作废在 T4。
//
// ===== 约束在哪儿执行(三处,缺一不可)=====
// 1. `@@unique([memberId, version])` —— 版本号按队员单调,不重号。Prisma DSL 表达得了。
// 2. **一个 Member 至多一张 ACTIVE** —— partial unique,Prisma DSL **表达不了**
//    (至 6.x 不支持带 WHERE 的唯一索引),由 migration.sql 末尾手写
//    `member_official_portrait_one_active_per_member`,沿
//    `User_memberId_active_key` / `member_org_membership_primary_active_unique` 既有范式。
// 3. **状态与终结字段的相容性** —— 四条 DB CHECK,见 migration.sql。
//    ⚠️ 这三处**每一条都在 e2e 里配了一个"违反它"的负面用例**;DB 约束有太多种静默
//    失效形状(写错谓词 / 建在错列 / 被后续 migration DROP 掉),"写了"不等于"挡得住"。
//
// 软删:**无 `deletedAt`,刻意的**。历史版本用 SUPERSEDED / VOIDED 终态表达,不是"删掉";
// 软删一条历史照片等于让"这个人当年长什么样"这件事凭空消失,而正式材料还引着它。
model MemberOfficialPortrait {
  id       String @id @default(cuid())
  memberId String
  // 按 Member 单调递增,从 1 起。不复用、不回退 —— 作废第 3 版后再传,下一版是 4 不是 3。
  version  Int

  // 可空**不是因为"可以没有照片"**,而是因为历史版本的二进制被合规清理后
  // (`purgedAt` 非空),元数据仍须留存以解释"曾经有过第 N 版"。
  // ACTIVE 行必须非空 —— 由 CHECK 兜住(见 migration)。
  // @unique:一张 Attachment 只能属于一个版本,杜绝两行共用同一 blob 后互相删。
  attachmentId String? @unique

  // 冻结规格代码,受控闭集(DB CHECK),当前唯一合法值 `uniform-portrait-v1`。
  // 改规格 = 新增 v2 并**保留旧行的旧值**,绝不批量改写(issue §6.1)——
  // 旧照片当年确实是按旧规格拍的,改写它就是伪造历史。
  specVersion String

  source MemberOfficialPortraitSource

  // 实际拍摄日期。未知留空 —— **不拿上传日期冒充拍摄日期**。
  capturedAt DateTime?

  status MemberOfficialPortraitStatus @default(ACTIVE)

  // ⚠️ **刻意不给 `@default(now())`**(issue §5.2 的建议模型里有,这里是有理由的偏离)。
  //
  // 仓内有一条「写用库时钟、判用应用时钟」的缺陷类闸(`clock-authority.spec.ts`):
  // 每个非审计的 `@default(now())` 列都必须先归档成「判定列」或「显式豁免」。
  // 本刀新建时它两档都不合适 —— 还没有任何读写点,归哪档都是在替 T4 预先表态。
  //
  // 去掉默认值把这件事从**约定**变成**类型**:没有默认值 ⇒ Prisma 的 `create` 把它变成必填
  // ⇒ T4 写激活事务时被编译器逼着显式传一个应用时钟值,没有"忘了传就悄悄吃库时钟"这条路。
  // 顺带解锁一个 T4 需要的性质:替换时旧版 `endedAt` 与新版 `activatedAt` 可以取**同一瞬间**,
  // 版本历史不留缝也不重叠;若这一列吃库时钟,两者就来自两个时钟源,对不齐。
  activatedAt       DateTime
  activatedByUserId String

  // 终结三件套:SUPERSEDED / VOIDED 时必须齐备(CHECK 兜),ACTIVE 时必须全空。
  endedAt       DateTime?
  endedByUserId String?
  endReason     String?

  // 二进制合规清理时间。非空 ⇒ 状态不能是 ACTIVE 且 attachmentId 必须已清空(CHECK 兜)。
  purgedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict:队员行不能在还挂着标准照时被硬删(软删离队不受影响 —— 离队**不删标准照**,
  // issue §5.2 不变量 7)。
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  // SetNull:附件被 durable delete 后本行转为"元数据留存"态,不连坐删掉版本历史。
  attachment  Attachment? @relation("MemberOfficialPortraitAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)
  activatedBy User        @relation("OfficialPortraitActivator", fields: [activatedByUserId], references: [id], onDelete: Restrict)
  endedBy     User?       @relation("OfficialPortraitEnder", fields: [endedByUserId], references: [id], onDelete: Restrict)

  @@unique([memberId, version])
  @@index([memberId, status])
  @@index([attachmentId])
  @@map("member_official_portraits")
}

// 结构闭集用 enum(沿 MembershipType / MembershipStatus 范式;区别于运营可扩的字典码)。
enum MemberOfficialPortraitStatus {
  ACTIVE
  // 被新版本顶替。属正常世代更替,不含"这张照片有问题"的判断。
  SUPERSEDED
  // 照片**本身**被判定无效(拍错人 / 没穿队服 / 严重失焦)。
  // ⚠️ 与队员离队无关 —— 离队不作废标准照(issue §5.2 不变量 6/7)。
  VOIDED
}

enum MemberOfficialPortraitSource {
  ADMIN_UPLOAD
  // 存量老队员由 API 脚本一次性录入时使用(维护者 2026-08-20 拍板:存量走脚本,不做 DB 迁移)。
  LEGACY_IMPORT
}

// ===== V2 第一阶段批次 2:certificates =====
//
// N:1 with Member;承载外部资质 + 本会颁发证书(同表承载,CT-11)。
// 详见 docs:
//   - 批次2_schema草案_certificates.md (v1.0 冻结版)
//   - 批次2_schema草案评审决议表.md (Q-S1~Q-S10)
//   - 批次2_schema草案评审决议表_v0.1.md (Q-D1~Q-D8)
//
// 设计选择(沿批次 1 B 路径):
// - 字段长度上限不落 @db.VarChar,由 DTO + class-validator 承担。
// - 纯日期字段(issuedAt / expiredAt / verifiedAt / expireNotifyDueAt)统一 DateTime,
//   业务层按 00:00:00.000Z 规范化处理(不落 @db.Date)。
// - 字典 code 字段(certTypeCode / certSubTypeCode / certStatusCode)schema 不做 FK,
//   业务层校验字典存在性(沿 v0.2.0 gradeCode / nodeTypeCode 模式)。
//
// FK(全部 ON DELETE Restrict,与 v0.2.0 + 批次 1 一致):
// - memberId           → Member.id            (CT-1)
// - verifiedBy         → Member.id            (CT-9a, Q-D1 已决议)
// - supersededByCertId → Certificate.id 自引用 (CT-12, Q-D2 已决议)
//
// 状态机:4 态闭集 (pending / verified / expired / rejected);
//   schema 不固化,由 service 层映射代码常量与 cert_status 字典 code。
//
// 索引:7 个单列;
//   Q-D6 不加 (expireNotifyDueAt) 单列索引;
//   Q-D8 不加 (memberId, certTypeCode, certStatusCode, expiredAt) 4 列复合索引;
//   Q-S6 不加 (memberId, certTypeCode) 联合索引。
//
// 业务唯一约束:无(草案 §11.2);仅 id 主键唯一。
//
// 软删:走 deletedAt;禁用 hard delete(R12)。
//
// CT-10 attachmentKey 字段已于 V2.x C-7 attachments 批次废弃(沿 D6 Q10 B / D7 v1.0 §4.6);
// 多态附件统一走 `attachments` 表(ownerType='certificate' + ownerId=certificate.id)。

model Certificate {
  id        String    @id @default(cuid())
  memberId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // ===== 业务字段(CT-4 ~ CT-12 + HK-1) =====
  //
  // 证书标准库 PR-4b(第 67 migration,contract):**已 DROP 四列** ——
  //   certTypeCode / certSubTypeCode  类别与等级现在是 Standard 的属性,由 standardId 唯一决定;
  //                                   留着就是「按 category 猜 Standard」的现成入口(§21 硬禁区)。
  //   isInternal                      本会颁发与否属标准的性质,已在 CertificateStandard.isInternal;
  //                                   实例侧那一列自建库起恒 false,是纯冗余。
  //   imageKeys                       证据现在读 sourceClaim.imageKeys(§13.5),
  //                                   blob 单一属主是 Claim;实例侧再存一份 key 就是第二个属主。
  issuingOrg         String // CT-4 机构名称**快照**(§5.6;由认定规则解析后写入,不是客户端自由文本)
  certNumber         String? // CT-5 Q-D5 schema 可空;长度 128(Q-D3)由 DTO 约束
  issuedAt           DateTime // CT-6 业务层日期规范化
  expiredAt          DateTime? // CT-7 NULL = 终身有效(Q-S4)
  certStatusCode     String // CT-8 字典 cert_status;无 default,service 填 pending
  verifiedBy         String? // CT-9a FK→Member.id 可空(Q-D1)
  verifiedAt         DateTime? // CT-9b
  verifyNote         String? // CT-9c 长度 500(Q-S5)由 DTO 约束
  supersededByCertId String? // CT-12 自引用 FK 可空(Q-D2)
  expireNotifyDueAt  DateTime? // HK-1 60 天提醒 hook;Q-D6 不加索引

  // ===== 证书标准库 PR-2(冻结稿 §5.6;expand-only,全部 nullable)=====
  //
  // 本刀只建列与约束,**零写入路径**:PR-4a 才开始写 standardId / recognitionPolicyId /
  // sourceCode,PR-4b 收紧为 NOT NULL 并 DROP 上面 4 个重复事实列
  // (certTypeCode / certSubTypeCode / isInternal / imageKeys)。
  //
  // 为什么本刀就必须加 `sourceClaimId`:§5.5 的 Claim 有 `certificate Certificate?`
  // 反向关系,缺这一侧 `prisma generate` 直接失败,而冻结稿 §26 铁律 11 要求
  // **每个 PR 都必须可 generate**,不许只写单边 relation。
  //
  // 复合 FK 本刀就落(维护者 2026-07-30 拍板,把 goal 原定 PR-4b 的这一项提前):
  // 列此刻全为 NULL,PostgreSQL 复合 FK 走 MATCH SIMPLE —— 任一列为 NULL 即放行,
  // 所以提前落不会挡住空表期;而 PR-4a 一开始写入就有 DB 兜底,不会出现
  // 「写了一轮不合法的 policy/standard 组合、等 PR-4b 才发现」。这是收紧,不是放松。
  // PR-4b 收紧:三列转 NOT NULL(§20.2「nullable 过渡字段不得进入 release」)。
  // recognitionIssuerId 仍可空 —— FREE_TEXT 认定规则下本就没有 issuer 实体,
  // 机构名在 issuingOrg 快照里;把它一起收紧会逼出一个假的「自由文本 issuer 行」。
  standardId          String
  recognitionPolicyId String
  recognitionIssuerId String?
  sourceClaimId       String?           @unique // 一条 Claim 最多生成一张证书(§8.5 防重跑)
  sourceCode          CertificateSource

  member       Member        @relation("CertificateMember", fields: [memberId], references: [id], onDelete: Restrict)
  verifier     Member?       @relation("CertificateVerifier", fields: [verifiedBy], references: [id], onDelete: Restrict)
  supersededBy Certificate?  @relation("CertificateSupersession", fields: [supersededByCertId], references: [id], onDelete: Restrict)
  supersedes   Certificate[] @relation("CertificateSupersession")

  standard    CertificateStandard           @relation(fields: [standardId], references: [id], onDelete: Restrict)
  // 复合 FK:锁死「这张证的 Policy 必须属于这张证的 Standard」(§5.6),
  // 不能只按 policyId 单列引用 —— 否则能写出 policy 指向另一个 standard 的错行。
  policy      CertificateRecognitionPolicy  @relation(fields: [recognitionPolicyId, standardId], references: [id, standardId], onDelete: Restrict)
  // 同理:issuer 必须属于该证锁定的 Policy。
  issuer      CertificateRecognitionIssuer? @relation(fields: [recognitionIssuerId, recognitionPolicyId], references: [id, policyId], onDelete: Restrict)
  sourceClaim RecruitmentCertificateClaim?  @relation(fields: [sourceClaimId], references: [id], onDelete: Restrict)

  @@index([memberId])
  @@index([certStatusCode])
  @@index([expiredAt])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([supersededByCertId])
  @@index([standardId])
  @@index([recognitionPolicyId])
  @@index([sourceCode])
}

// ===== 证书标准库 / 队内认定规则 / 招新证书申报(PR-2 骨架)=====
//
// 冻结稿 [`docs/archive/reviews/certificate-standard-library-t0-review.md`](../docs/archive/reviews/certificate-standard-library-t0-review.md) v1.2 §5。
// 本刀 **expand-only**:4 张净新空表 + 8 枚举 + Certificate 5 个 nullable 列;
// 零 controller / 零 service / 零 DTO / 零业务写入口(PR-3 起才有 API)。
//
// 第一性拆分(§2,D-CERT-001):四类事实必须分表,不能由一张模板表同时承担 ——
//   CertificateStandard          「这是什么证」= 证书身份,稳定不变
//   CertificateRecognitionPolicy 「本队某时期怎么认可它」= 规则版本,可迭代
//   RecruitmentCertificateClaim  「申请人拿来了什么」= 一张原始申报,可暂未分类
//   Certificate                  「审核后确认了什么」= 正式档案
// 合表的代价见 §0:认可机构或有效期一变,同一种证就被迫复制出 v2/v3,
// 最后变成 bsafe_l2_final_final —— 那不是版本管理,是证书身份被炸碎。
//
// 命名:全部走 Prisma 默认表名(PascalCase),**不加 `@@map`**(prisma/CLAUDE.md 铁律);
// 冻结稿 §5.3/§5.4 的手写 partial unique SQL 也正是按 `"CertificateRecognitionPolicy"`
// 这种带引号的 PascalCase 写的,两边一致。
// FK 全 `onDelete: Restrict`(沿全仓约定,证书是长期档案,不做级联删)。

enum CertificateStandardKind {
  FAMILY // 目录分组用,不可被认定 / 不可持有(D-CERT-003)
  CREDENTIAL // 真实可持有的证书标准
}

enum CertificateStandardStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum CertificateRecognitionPolicyStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum CertificateIssuerPolicy {
  FIXED // 恰好 1 个 issuer,实例可不传
  ALLOWLIST // ≥1 个 issuer,实例必须传 recognitionIssuerId
  FREE_TEXT // 0 个 issuer,实例必须传 issuingOrg 自由文本
}

// §5.3:EXPLICIT_REQUIRED / EXPLICIT_OPTIONAL 是刻意拆开的两态 ——
// 旧设计用一个模糊的 MANUAL 同时表达「必须手填到期日」和「可不填即终身」,
// 两种语义混在一个值里,校验写不出来。
enum CertificateValidityMode {
  PERMANENT // 到期日必须 NULL
  FIXED_MONTHS // 后端按自然月算(addMonthsClamped),客户端不得传
  EXPLICIT_REQUIRED // 证书上有具体到期日,必填
  EXPLICIT_OPTIONAL // 到期日可空,空值明确代表终身有效
}

enum CertificateNumberMode {
  REQUIRED // trim 后必须非空
  OPTIONAL // 空字符串归一为 NULL
  NONE // 必须为 NULL;客户端传值直接拒绝
}

// §5.1:第一版只有真实存在的两种来源。**不预埋** APP_SELF / IMPORT
// (冻结稿 §1.1 第 7 条:不预埋尚未实施的来源)。
enum CertificateSource {
  ADMIN
  RECRUITMENT
}

enum RecruitmentCertificateClaimStatus {
  SUBMITTED
  NEEDS_INFO
  APPROVED
  REJECTED
  PROMOTED
  WITHDRAWN
}

// §5.2 证书身份。code 创建后不可改、不可复用(D-CERT-004);
// 类别/等级/父级/内部属性首次启用后冻结,只留名称/说明/排序可在审计下修文案(D-CERT-005)。
model CertificateStandard {
  id           String                    @id @default(cuid())
  code         String                    @unique
  name         String
  description  String?
  kind         CertificateStandardKind
  categoryCode String // 字典 cert_type;沿全仓约定不做 FK,业务层校验
  levelCode    String? // 字典 cert_sub_type;可空
  parentId     String? // 必须指向 FAMILY;子父 categoryCode 必须一致;禁环
  isInternal   Boolean                   @default(false)
  status       CertificateStandardStatus @default(DRAFT)
  sortOrder    Int                       @default(0)
  activatedAt  DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  deletedAt    DateTime?

  parent   CertificateStandard?  @relation("CertificateStandardTree", fields: [parentId], references: [id], onDelete: Restrict)
  children CertificateStandard[] @relation("CertificateStandardTree")

  policies        CertificateRecognitionPolicy[]
  certificates    Certificate[]
  suggestedClaims RecruitmentCertificateClaim[]  @relation("ClaimSuggestedStandard")
  resolvedClaims  RecruitmentCertificateClaim[]  @relation("ClaimResolvedStandard")

  @@index([kind])
  @@index([categoryCode])
  @@index([levelCode])
  @@index([parentId])
  @@index([status])
  @@index([sortOrder])
  @@index([deletedAt])
  @@index([createdAt])
}

// §5.3 队内认定规则版本。同一 Standard 至多一个 ACTIVE(D-CERT-006,
// 由 migration 末尾手写 partial unique 兜底);已激活/已退役的规则永久不可改(D-CERT-007)。
model CertificateRecognitionPolicy {
  id             String                             @id @default(cuid())
  standardId     String
  version        Int
  status         CertificateRecognitionPolicyStatus @default(DRAFT)
  issuerPolicy   CertificateIssuerPolicy
  validityMode   CertificateValidityMode
  validityMonths Int? // 仅 FIXED_MONTHS 有值,1..600
  certNumberMode CertificateNumberMode
  activatedAt    DateTime?
  retiredAt      DateTime?
  createdAt      DateTime                           @default(now())
  updatedAt      DateTime                           @updatedAt
  deletedAt      DateTime?

  standard     CertificateStandard            @relation(fields: [standardId], references: [id], onDelete: Restrict)
  issuers      CertificateRecognitionIssuer[]
  certificates Certificate[]
  claims       RecruitmentCertificateClaim[]

  @@unique([standardId, version])
  // 复合 FK 的引用目标:让 Certificate / Claim 能按 (policyId, standardId) 整体引用,
  // 从而在 DB 层锁死「policy 属于该 standard」。单看是冗余,是复合 FK 的必要前置。
  @@unique([id, standardId])
  @@index([standardId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
}

// §5.4 认可机构。实例认可靠 issuer id,**不靠机构文字匹配**(D-CERT-021;
// 中文机构名匹配不可靠)。normalizedName 只用于 DRAFT 内去重,不做模糊匹配。
model CertificateRecognitionIssuer {
  id             String    @id @default(cuid())
  policyId       String
  name           String
  normalizedName String // trim + 连续空白折叠 + ASCII 大小写归一;不删中文法律名称
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  policy       CertificateRecognitionPolicy  @relation(fields: [policyId], references: [id], onDelete: Restrict)
  claims       RecruitmentCertificateClaim[]
  certificates Certificate[]

  // 同上:复合 FK 的引用目标,锁死「issuer 属于该 policy」。
  @@unique([id, policyId])
  @@index([policyId])
  @@index([sortOrder])
  @@index([deletedAt])
}

// §5.5 招新证书申报。**一张真实证书一条 Claim**(D-CERT-012),不再按 category
// 聚合成 JSON —— 旧 JSON 结构无法表达「同一类别多张不同证书」,也做不到单证重传/单证审核。
// 允许审核前没有 Standard(D-CERT-014「不知道」是工作流状态,不是一种正式证书);
// APPROVED 时必须解析为具体 CREDENTIAL Standard + Policy。
model RecruitmentCertificateClaim {
  id            String                            @id @default(cuid())
  applicationId String
  version       Int                               @default(0) // 申请人重传 vs 管理员审核的 CAS,避免双方互相覆盖
  status        RecruitmentCertificateClaimStatus @default(SUBMITTED)

  // 申请人侧原始申报(suggestedStandardId 只是建议,不是审核结论,D-CERT-016)
  categoryHintCode    String
  rawCertificateName  String?
  suggestedStandardId String?

  // 审核锁定的标准化结论(APPROVED 时非空,由 migration CHECK 兜底)
  standardId          String?
  recognitionPolicyId String?
  recognitionIssuerId String?

  issuingOrg String?
  certNumber String?
  issuedAt   DateTime?
  expiredAt  DateTime?
  // 只在数据库内部使用:永不进普通响应、日志、审计或 OpenAPI 示例(§5.5 / D-CERT-024)。
  imageKeys  Json?

  reviewedByUserId  String?
  reviewedAt        DateTime?
  reviewNote        String?
  promotedAt        DateTime?
  sensitivePurgedAt DateTime? // 发号后清空重复标量的时刻(§8.5 第 11 步)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  application       RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  suggestedStandard CertificateStandard?   @relation("ClaimSuggestedStandard", fields: [suggestedStandardId], references: [id], onDelete: Restrict)
  standard          CertificateStandard?   @relation("ClaimResolvedStandard", fields: [standardId], references: [id], onDelete: Restrict)

  // 复合 FK,与 Certificate 同款(§5.6 明确「Claim 使用同样约束」)。
  // 冻结稿 §5.5 的示意片段写的是单列关系,但 §5.6 要求的是复合约束;这里按后者落,
  // 并且**用 Prisma 声明而不是在 SQL 里手加** —— 手加的 FK 不在 schema 里,
  // 下一次 `prisma migrate diff` 会认为它是多余约束并生成 DROP,制造长期漂移。
  // 跨表一致性(Policy.standardId = Claim.standardId、Issuer.policyId =
  // Claim.recognitionPolicyId)由 Resolver 在事务内校验,这两条 FK 是 DB 兜底。
  policy      CertificateRecognitionPolicy? @relation(fields: [recognitionPolicyId, standardId], references: [id, standardId], onDelete: Restrict)
  issuer      CertificateRecognitionIssuer? @relation(fields: [recognitionIssuerId, recognitionPolicyId], references: [id, policyId], onDelete: Restrict)
  certificate Certificate?

  @@index([applicationId])
  @@index([status])
  @@index([standardId])
  @@index([recognitionPolicyId])
  @@index([deletedAt])
  @@index([createdAt])
}

// ===== V2 第一阶段批次 3:activities =====
//
// 详见 docs:
//   - 批次3_schema前评审.md v0.2.4 修正版
//   - 批次3_schema前评审决议表.md v1.0 定稿
//   - 批次3_schema草案_activities_attendances.md v0.5 草案版
//   - 批次3_schema草案评审决议表.md v1.4
//
// 设计选择(沿批次 1 / 批次 2 B 路径):
// - 字段长度上限不落 @db.VarChar,由 DTO + class-validator 承担。
// - 字典 code 字段(activityTypeCode / statusCode 等)schema 不做 FK,
//   业务层校验字典存在性(沿 v0.2.0 范式)。
//
// FK(全部 ON DELETE Restrict):
// - organizationId  → Organization.id  (NOT NULL,service 校验禁根节点 R8 / D17)
// - publishedBy     → User.id          (可空,Q-S1 audit 字段落表)
// - cancelledBy     → User.id          (可空)
//
// 显式 @db.Decimal 注解(Q-D2 + Q-D19):
// - locationLongitude / locationLatitude → Decimal(10, 7)(WGS84 ~1.1 cm 精度)
//
// description 必须 String?(Q-D14 v1.4 必填性澄清,v0.5 修订):
// - 从 v0.1 沿用的 NOT NULL 改为 String? 可空
// - 语义:列表展示短说明 / 摘要;详情页正文走 content
//
// 索引:7 单列;v0.2 / v0.4 新增字段(content / locationLongitude / locationLatitude)
//   不加索引(沿 Q-D11/12/13/19;同批的 galleryImageUrls / coverImageUrl 已由 P2-14 刀 B DROP)。
//   P2-14 刀 A 新增的 4 个附件制字段(coverImageKey / coverAttachmentId /
//   galleryImageKeys / galleryAttachmentIds)同样不加索引 —— 它们只在按 id 取到活动之后被读,
//   从不作为查询条件(与对照组 Content.coverImageKey / coverAttachmentId 一致,那两列也无索引)。
// 无唯一约束。

model Activity {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  title                              String
  activityTypeCode                   String
  // Activity OS R1 / A4：新活动未来会记录一次明确的模板版本选择；本刀只占可空指针，
  // NULL 继续表示历史 activityTypeCode 路径，绝不在这里切换 resolver 或回填旧活动。
  selectedTemplateVersionId          String?
  // Activity OS R1 / A6：从模板创建成功结果的持久化幂等锚。两列均可空，历史 Activity
  // 零回填；operationKey 全局唯一，requestHash 绑定操作、调用者、精确 Version/hash 与输入。
  // 不能复用 IntegrationCommandReceipt：后者绑定服务主体凭证，安全边界不同。
  createFromTemplateOperationKey     String? @unique(map: "activity_create_from_template_operation_key_key")
  createFromTemplateRequestHash      String?
  organizationId                     String
  startAt                            DateTime
  endAt                              DateTime
  location                           String
  description                        String? // v0.5 修订(Q-D14 v1.4):NOT NULL → String? 可空
  capacity                           Int?
  genderRequirementCode              String?
  registrationDeadline               DateTime?
  registrationNotes                  String?
  statusCode                         String
  initiatorMemberId                  String?
  workflowRevision                   Int       @default(0)
  publishedBy                        String?
  publishedAt                        DateTime?
  startReminderSentAt                DateTime?
  cancelledBy                        String?
  cancelledAt                        DateTime?
  cancelReason                       String?
  isPublicRegistration               Boolean   @default(true)
  // 保险模块(2026-06-13):报名保险门槛开关;default false = 迁移安全,既有活动 /
  // 测试零影响,新活动发布时显式开(评审稿 insurance-module-review.md D-INS-1)。
  requiresInsurance                  Boolean   @default(false)
  // 第 4 批⑫前置 D84:每个 Activity 只保存一个当前分配方式。
  // default 仅作旧 server / 存量兼容桥；新活动显式选择由紧接的 C 刀 DTO + 发布硬门完成。
  allocationModeCode                 String    @default("first_come") // first_come / qualification_rank / lottery
  registrationSchema                 Json? // v0.2 D12 报名表自定义字段 schema 字段位预留
  attendanceDeclaredCompleteAt       DateTime?
  attendanceDeclaredCompleteByUserId String?

  // v0.2 展示内容字段(Q-D11 / Q-D12 / Q-D13)
  //
  // ⚠️ P2-14 刀 B(2026-08-25):裸 URL 遗留列 `coverImageUrl String?` / `galleryImageUrls Json?`
  // 已 DROP(migration `20260825170000_activity_drop_legacy_image_url_columns`,**不可逆**)。
  // 封面 / 图集一律走下方附件制四列 + `resolveSignedUrlTrusted` 现签。
  // ⚠️ 审批快照(publish review)的 JSON 里仍保留这两个键、恒为 null —— 那是**逐字兼容**
  // 已持久化快照的 sha256 / canonicalJson 比对,不是漏删,见 `activity-proposal.types.ts` 注释。
  content Json?

  // ===== P2-14 刀 A:封面 / 图集改附件制(2026-08-22)=====
  //
  // 与 `Content.coverImageKey` / `Content.coverAttachmentId` **逐字同形**:
  //   - `*ImageKey(s)`     反范式 storage key,列表缩略图直签,免 per-row Attachment 查询
  //   - `*AttachmentId(s)` 附件 id,供标记 / 换 / 清
  // **刻意不建外键**(沿 Content 同名两列的「不建外键」与 reviewedByUserId / SmsSettings.updatedBy
  // 的仓内惯例):附件被删后 id 变悬空,由 `resolveSignedUrlTrusted(key)` 返回 null 兜底 ——
  // 与内容模块行为逐字一致。改成真外键就是造第二种形状。
  coverImageKey     String?
  coverAttachmentId String?

  // 图集是**有序多图**,两列逐位对齐(`galleryImageKeys[i]` 是 `galleryAttachmentIds[i]` 的 key),
  // 由写入侧在同一事务内成对写入。对齐不变量的执行位是 migration 末尾的
  // `activity_gallery_arrays_aligned_check`(等长 CHECK),不是应用层约定 ——
  // 应用层约定漂移时没有症状。`String[]` 沿 tags / visibleOrganizationIds 惯例,不用 Json。
  galleryImageKeys     String[] @default([])
  galleryAttachmentIds String[] @default([])

  // v0.4 经纬度字段(Q-D19;显式 @db.Decimal(10, 7),WGS84 ~1.1 cm 精度)
  locationLongitude Decimal? @db.Decimal(10, 7)
  locationLatitude  Decimal? @db.Decimal(10, 7)

  // ===== 活动改造 v1.1 第 1 批第一刀:§3.1 加法部分(2026-08-04)=====
  //
  // 合同:docs/archive/reviews/activity-business-overhaul-v1.1/ §3.1。
  // 本刀是 expand→migrate→contract 的 **expand 阶段**:只加列,一个 DROP / RENAME 都不做。
  // 合同 §3.1 另要求删 attendanceDeclaredCompleteAt / attendanceDeclaredCompleteByUserId
  // 两列、并把 `completed` 移出活动状态闭集 —— 那两项属 **contract 阶段**,等行为迁移
  // 完成后另立 goal(`completed` 全仓 376 处引用,在建表 PR 里动它会打穿半个仓库)。
  // 同理 statusCode 的取值闭集本刀**不动**,不加 CHECK。
  //
  // ⚠️ 为什么下面三列是**可空**而不是合同字面的 NOT NULL:
  // goal DoD 2 要求「既有行零改写」⇒ 不许回填 ⇒ NOT NULL 必须配常量 default。
  // 而 registrationModeCode 的常量 default 是**可证伪的错**:既有
  // `isPublicRegistration=false` 的活动语义上是 `admin_only` 而非 `open_apply`,
  // 一个常量填不对两种行。visibilityCode / defaultLocationRequired 同理是业务默认值,
  // 不由 AI 代定。三列在本 expand 刀一律可空(null = 尚未解析),由后续 contract 刀
  // 连同真回填一起收紧为 NOT NULL —— 沿证书标准库 PR-2 expand(standardId /
  // recognitionPolicyId / sourceCode 先可空)→ PR-4b contract(转 NOT NULL)既有范式。
  // 合同**明写了初值**的三列(archiveWaitingDays=7 / 两个 revision=0)则照字面带 default。
  registrationModeCode       String? // open_apply / invitation_only / admin_only / paused
  visibilityCode             String? // internal / invitation;不得兼任报名方式
  defaultCheckInRadiusMeters Int? // null = 沿模板／系统默认,**不是**"不限制"
  defaultLocationRequired    Boolean?
  archiveWaitingDays         Int      @default(7) // 合同 §3.1:默认 7,范围 0..365(CHECK 兜底)
  currentEvidenceRevision    Int      @default(0) // 现场事实变化同事务 +1
  currentPopulationRevision  Int      @default(0) // 参与身份变化同事务 +1
  currentClosureRevision     Int? // 当前生效关闭版本号,只是快速指针

  // 提前终止事实(§3.1)。CHECK 只守新列自身的形状:terminatedAt 有值 ⇒ statusCode='terminated'。
  // 既有行三列恒 NULL ⇒ 该 CHECK 对存量恒真,不可能让既有行为变红。
  terminatedAt       DateTime?
  terminatedByUserId String?
  terminationReason  String?

  // §10.3 取消:当前取消操作防重。单列 unique 不把相同 key + 不同 payload 误放行。
  // 全历史操作记录另表尚未定义(合同缺口 #12),本刀不自造该表。
  cancelOperationKey String? @unique(map: "activity_cancel_operation_key_key")
  // §10.3 取消:与 cancelOperationKey 配对持久化的 canonical requestHash。
  cancelRequestHash  String?

  // §10.3 提前终止:当前终止操作防重，单列 unique。
  terminateOperationKey String? @unique(map: "activity_terminate_operation_key_key")
  // §10.3 提前终止:与 terminateOperationKey 配对持久化的 canonical requestHash。
  terminateRequestHash  String?

  // ===== 归档动作(§6.6 + AC-004 / AC-064;维护者 2026-08-25 拍板三问)=====
  //
  // 拍板原文:「同一个标记,两套开工条件」/「默认不显示,可勾『显示已归档』看到」/
  //          「能取消归档,但要留痕(谁归的、谁撤的、什么时候)」。
  //
  // ⭐ 「同一个标记」= `statusCode = 'archived'`(闭集第 6 值),**不是**第二个布尔位。
  //    理由:全仓活动读面里有 6 处硬写 `statusCode: 'published'`(App 广场 / available /
  //    dashboard 两计数 / 到期提醒 / 报名对账入队),它们靠**状态值**天然把已归档挡在外面;
  //    换成正交布尔位,这 6 处每一处都得记得再加一条 `archivedAt: null`,漏一处就是
  //    「归档了还在列表里」。执行位放在值域上比放在「每个人都要记得加过滤」上硬。
  //
  // ⚠️ 归档**不改**任何结算语义:关账的「已结束」判据是
  //    `terminatedAt !== null || now > endAt`(activity-closure.service.ts evaluateChecks ①),
  //    它一个字都不读 statusCode;唯一读 statusCode 的那格是「普通取消不伪造结算」。
  //    ⇒ `completed → archived` 不会让「已关账的活动」在关账链里变形(AC-064 的
  //    「合法更正不因 7 天过去而被永久禁止」不受本刀影响)。
  //
  // 🔴 下面十列**全部可空**:存量既有行一律取 NULL,读作「从未归档过」,
  //    行为与本刀之前逐字相同。零回填、零 DROP、零 RENAME、零既有行重解释。
  //
  // 留痕成对(DoD:「这个活动被归档过又撤销过」查得出来吗?):
  //   - 归档三件事实 archivedAt / archivedByUserId / archiveReasonCode
  //   - 撤销两件事实 unarchivedAt / unarchivedByUserId
  //   - **撤销时刻不清空归档三件事实** ⇒ 「归过又撤过」= 两侧时刻同时非 NULL,
  //     一条 where 就查得出来。当前是否处于归档态由 statusCode 单独承载,
  //     不靠「archivedAt 有没有被抹掉」去推 —— 抹掉就等于把留痕删了。
  archivedAt             DateTime?
  archivedByUserId       String?
  // 归档前的 statusCode。撤销归档要退回**哪里**是归档时冻下来的事实,不是猜出来的:
  // 没有它,一个 published 的活动被归档后撤销就只能退回某个常量,静默改写活动状态。
  archivedFromStatusCode String?
  // 走的是哪一套开工条件:`stale_draft`(长期无人处理草稿)/ `settled`(结算已关账且过等待期)。
  // 两套条件各自可判的**留痕**位 —— 事后能回答「这条为什么准归档」。
  archiveReasonCode      String?
  // 当前归档操作防重。与 cancelOperationKey / terminateOperationKey 逐字同形(单列 unique)。
  // ⚠️ 归档可反复(归→撤→再归),故本列保存的是**最近一次**归档的 key:
  //    用更早一轮的 key 重放会拿到操作键冲突,不会静默再归档一次。
  archiveOperationKey    String?   @unique(map: "activity_archive_operation_key_key")
  archiveRequestHash     String?

  unarchivedAt          DateTime?
  unarchivedByUserId    String?
  unarchiveOperationKey String?   @unique(map: "activity_unarchive_operation_key_key")
  unarchiveRequestHash  String?

  organization                 Organization                       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  selectedTemplateVersion      ActivityTemplate?                  @relation("ActivitySelectedTemplateVersion", fields: [selectedTemplateVersionId], references: [id], onDelete: Restrict)
  seriesOccurrence             ActivitySeriesOccurrence?          @relation("ActivitySeriesOccurrenceActivity")
  creationCommandReceipts      ActivityCreationCommandReceipt[]   @relation("ActivityCreationCommandReceiptActivity")
  emergencyInitiation          ActivityEmergencyInitiation?       @relation("ActivityEmergencyInitiationActivity")
  initiator                    Member?                            @relation("ActivityInitiator", fields: [initiatorMemberId], references: [id], onDelete: Restrict)
  publisher                    User?                              @relation("ActivityPublisher", fields: [publishedBy], references: [id], onDelete: Restrict)
  canceller                    User?                              @relation("ActivityCanceller", fields: [cancelledBy], references: [id], onDelete: Restrict)
  attendanceDeclaredCompleteBy User?                              @relation("ActivityAttendanceDeclaration", fields: [attendanceDeclaredCompleteByUserId], references: [id], onDelete: Restrict)
  terminatedBy                 User?                              @relation("ActivityTerminator", fields: [terminatedByUserId], references: [id], onDelete: Restrict)
  archivedBy                   User?                              @relation("ActivityArchiver", fields: [archivedByUserId], references: [id], onDelete: Restrict)
  unarchivedBy                 User?                              @relation("ActivityUnarchiver", fields: [unarchivedByUserId], references: [id], onDelete: Restrict)
  registrations                ActivityRegistration[]
  activityPositions            ActivityPosition[]
  activityCheckIns             ActivityCheckIn[]
  activityFeedbacks            ActivityFeedback[]
  attendanceSheets             AttendanceSheet[]
  publishReviews               ActivityPublishReview[]
  responsibilityAssignments    ActivityResponsibilityAssignment[]

  // 活动改造 v1.1 第 1 批第一刀反向 relation(合同 §3.2 / §3.3 / §3.8 / §3.10)。
  sessions                ActivitySession[]
  // Activity OS R2 / B1：地点快照属于活动根；B1 只建立持久化关系，不新增 writer / read API。
  activityPlaces          ActivityPlace[]
  sessionPositions        ActivitySessionPosition[]
  participationIdentities ActivityParticipationIdentity[]
  capacityBuckets         ActivityCapacityBucket[]
  // 第 4 批前置微刀(第 78 migration):activity-person capacity reservation 的直接锚点。
  capacityReservations    CapacityReservation[]

  // 活动改造 v1.1 第 1 批第二刀反向 relation(合同 §3.12 / §3.13 / §3.14):
  // 仅关系映射,零标量字段(沿 R2 范式)。
  registrationFormVersions   RegistrationFormVersion[]
  registrationUploadSessions RegistrationUploadSession[]
  qualificationRuleSets      ActivityQualificationRuleSet[]
  invitations                ActivityInvitation[]
  visitors                   ActivityVisitor[]

  // 活动改造 v1.1 第 1 批第三刀反向 relation(合同 §3.15 / §3.16 / §3.17):
  // 仅关系映射,零标量字段。evidenceState 是 `?` 单值 —— §3.17「一活动一行」由
  // ActivityEvidenceState.activityId 的 unique 在 DB 侧保证。
  qrCredentials AttendanceQrCredential[]
  punchEvents   AttendancePunchEvent[]
  evidenceState ActivityEvidenceState?
  evidenceSeals EvidenceSeal[]

  // 第 6 批:离线包与异常复核均双锚到 Activity/Session，保留 Activity 反向查询入口。
  offlinePackages            OfflinePackage[]
  offlinePackageParticipants OfflinePackageParticipant[]
  offlinePunchReviewItems    OfflinePunchReviewItem[]

  // 活动改造 v1.1 第 1 批第四刀反向 relation(合同 §3.19 / §3.23 / §3.25 / §3.26 / §3.27):
  // 仅关系映射,零标量字段。settlementRun 是 `?` 单值 —— §3.19「一活动一行」由
  // AttendanceSettlementRun.activityId 的 unique 在 DB 侧保证。
  settlementRun      AttendanceSettlementRun?
  ledgerEntries      ParticipationLedgerEntry[]
  correctionRequests AttendanceCorrectionRequest[]
  closureRevisions   ActivitySettlementClosureRevision[]
  batchJobs          ActivityBatchJob[]

  // 活动改造 v1.1 第 1 批第五刀反向 relation(合同 §3.11):仅关系映射,零标量字段。
  allocationBatches   ActivityAllocationBatch[]
  reservedQuotaGroups ActivityReservedQuotaGroup[]

  // 活动改造 v1.1 第 3 批①.5(合同 §3.4):发布审核通过后生成的不可变规则快照。
  ruleSnapshots ActivityRuleSnapshot[]

  @@index([deletedAt])
  @@index([createdAt])
  @@index([statusCode])
  @@index([organizationId])
  @@index([activityTypeCode])
  @@index([selectedTemplateVersionId])
  @@index([startAt])
  @@index([isPublicRegistration])
  @@index([initiatorMemberId])
  @@index([attendanceDeclaredCompleteAt])
}

// ===== 活动责任闭环 PR1:发布审核请求 =====
//
// status / requestType 保持 String，沿活动域运营字典码与后续状态机校验；
// 同一活动只允许一个 pending 请求的 partial unique 由 migration 手写。
model ActivityPublishReview {
  id                      String  @id @default(cuid())
  activityId              String
  requestType             String
  requestVersion          Int
  baseRevision            Int
  status                  String
  snapshot                Json
  directPublish           Boolean @default(false)
  audienceTagCodes        Json?
  // 组织定向(维护者 2026-08-25 拍板):与 audienceTagCodes 逐字同形的 nullable JSONB,
  // 运行时只把 `string[]` 视为有效。`null` = 未按组织定向(存量行与不勾组织的新行都落这里);
  // `[]` = 不作组织收窄(与 audienceTagCodes 的 `[]` 同构:空数组表示该维度不设限);
  // 非空 = 收件人须在这些组织**或其后代**中有有效任职 —— 「勾上级含下级」走 organization_closure
  // 真子树,不是编码前缀匹配。与 audienceTagCodes **取交集(AND)**:两个维度都满足才收到。
  audienceOrganizationIds Json?

  submittedByUserId String
  submittedAt       DateTime  @default(now())
  reviewedByUserId  String?
  reviewedAt        DateTime?
  reviewNote        String?

  // §10.3 发布提交:同一 operationKey 必须唯一;同一活动可用不同 key 多次提交。
  operationKey String? @unique(map: "activity_publish_review_operation_key_key")
  // §10.3 发布提交:与 operationKey 配对持久化的 canonical requestHash。
  requestHash  String?

  // §10.3 审核通过／退回:本表就是成功结果 reference，故本次审核动作 key 单列 unique。
  reviewOperationKey String? @unique(map: "activity_publish_review_review_operation_key_key")
  // §10.3 审核通过／退回:与 reviewOperationKey 配对持久化的 canonical requestHash。
  reviewRequestHash  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activity      Activity               @relation(fields: [activityId], references: [id], onDelete: Restrict)
  submittedBy   User                   @relation("ActivityPublishReviewSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedBy    User?                  @relation("ActivityPublishReviewReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  ruleSnapshots ActivityRuleSnapshot[]

  @@unique([activityId, requestVersion])
  @@index([activityId, status])
  @@index([status, submittedAt])
  @@index([submittedByUserId])
  @@index([reviewedByUserId])
  @@map("activity_publish_reviews")
}

// ===== Activity OS R1 / A2:TemplateFamily 稳定身份 =====
//
// Family 承载可识别的模板族、分类、归属、范围与生命周期占位；Version 的具体定义仍在
// ActivityTemplate。A2 只提供储存和 FK / 唯一性，不引入业务写路径、闭集、Version 元数据默认值或 seed。
// C1 D1 internal metric catalogue. No Activity pointer, runtime writer or public API.
// CHECKs and triggers live in the additive C1 migration; activated semantics are immutable.
model ActivityMetricDefinition {
  id                String   @id @default(cuid())
  code              String
  version           Int
  name              String
  kindCode          String
  unit              String?
  configurationJson Json
  schemaVersion     Int
  definitionHash    String
  statusCode        String
  activatedAt       DateTime?
  retiredAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  setItems ActivityMetricSetItem[]

  @@unique([code, version])
  @@index([statusCode])
}

model ActivityMetricSetVersion {
  id             String   @id @default(cuid())
  code           String
  version        Int
  name           String
  schemaVersion  Int
  definitionHash String
  statusCode     String
  activatedAt    DateTime?
  retiredAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items ActivityMetricSetItem[]

  @@unique([code, version])
  @@index([statusCode])
}

model ActivityMetricSetItem {
  id                 String   @id @default(cuid())
  setVersionId       String
  metricDefinitionId String
  key                String
  sortOrder          Int
  required           Boolean
  createdAt          DateTime @default(now())

  setVersion       ActivityMetricSetVersion @relation(fields: [setVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  metricDefinition ActivityMetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([setVersionId, key])
  @@unique([setVersionId, metricDefinitionId])
  @@unique([setVersionId, sortOrder])
  @@index([metricDefinitionId])
}

model ActivityTemplateFamily {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  code                String  @unique
  name                String
  categoryCode        String
  ownerOrganizationId String?
  scopeTypeCode       String
  statusCode          String

  ownerOrganization Organization?      @relation("ActivityTemplateFamilyOwnerOrganization", fields: [ownerOrganizationId], references: [id], onDelete: Restrict)
  versions          ActivityTemplate[]

  @@index([ownerOrganizationId])
  @@index([categoryCode])
  @@index([scopeTypeCode])
  @@index([statusCode])
}

// ===== §3.4 ActivityTemplate:可版本化默认配置 =====
//
// 模板更新新建版本,不覆盖已发布活动;故唯一键是 (code, version),绝不把 code 单列 unique。
// A3 起,只有 familyId 非空的未来 Version 行受 migration 中的 draft → active → retired 闭集与
// 冻结 trigger 约束；familyId 为 NULL 的 legacy 行仍保留原 statusCode / resolver 兼容语义。
// 各默认列均以当前 Activity / ActivitySession 的最终字段为来源;解析与继承归第 3 批第二刀。
model ActivityTemplate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  code             String
  name             String
  activityTypeCode String
  statusCode       String // legacy 不限；familyId 非空的 future Version 受 A3 条件 CHECK / trigger 约束。
  version          Int
  // Activity OS R1 / A2-A3：legacy 行保持全部可空、零回填。familyId 非空的 future Version
  // 必须提供 canonical JSON/hash/schemaVersion；A3 只写入 DB 不变量，绝不把字段接进现有 resolver 或 API。
  familyId         String?
  schemaVersion    Int?
  definitionJson   Json?
  definitionHash   String?
  effectiveFrom    DateTime?
  effectiveTo      DateTime?

  // 默认报名方式 → Activity.registrationModeCode。
  defaultRegistrationModeCode       String?
  // 默认定位 → Activity.defaultLocationRequired / defaultCheckInRadiusMeters。
  defaultLocationRequired           Boolean?
  defaultCheckInRadiusMeters        Int?
  // 窗口偏移 → ActivitySession 的四个窗口边界;签到开／关相对 session.startAt，
  // 签退开／关相对 session.endAt，单位均为分钟。
  checkInOpenOffsetMinutes          Int?
  checkInCloseOffsetMinutes         Int?
  checkOutOpenOffsetMinutes         Int?
  checkOutCloseOffsetMinutes        Int?
  // 迟到／早退 → ActivitySession 两个最终阈值。
  defaultLateGraceMinutes           Int?
  defaultEarlyLeaveThresholdMinutes Int?
  // 归档等待 → Activity.archiveWaitingDays。
  defaultArchiveWaitingDays         Int?
  // 常用岗位模板:数组元素结构由第 3 批第二刀的 template-resolution 合同定义。
  commonPositionTemplates           Json?

  family        ActivityTemplateFamily? @relation(fields: [familyId], references: [id], onDelete: Restrict)
  // Activity OS R1 / A4：仅供未来 Activity 显式选择 Version 的反向映射；A4 不接入解析或写入路径。
  selectedByActivities Activity[] @relation("ActivitySelectedTemplateVersion")
  seriesRevisions      ActivitySeriesRevision[] @relation("ActivitySeriesRevisionTemplate")
  ruleSnapshots ActivityRuleSnapshot[]

  @@unique([code, version])
  @@unique([familyId, version])
  @@index([activityTypeCode])
  @@index([statusCode])
  @@index([familyId])
}

// ===== Activity OS R1 / A7：活动系列与有限窗口生成 =====
//
// Series 只保留可变生命周期；排期、模板版本、文案和组织归属全部冻结在 Revision。
// Generation / 状态变更等命令共用一张 receipt 表，避免为单一命令再造平行持久化协议。
model ActivitySeries {
  id        String   @id @default(cuid())
  code      String   @unique
  statusCode String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions       ActivitySeriesRevision[]
  commandReceipts ActivitySeriesCommandReceipt[]
  occurrences     ActivitySeriesOccurrence[]

  @@index([statusCode])
}

// 不带 updatedAt / deletedAt；migration 以 trigger 拒绝历史 Revision 的 UPDATE / DELETE。
model ActivitySeriesRevision {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  seriesId                       String
  revision                       Int
  templateVersionId              String
  templateDefinitionHash         String
  frequencyCode                  String
  interval                       Int
  weeklyWeekdayMask              Int
  monthlyDay                     Int?
  timeZone                       String
  localStartDate                 DateTime @db.Date
  localStartMinute               Int
  durationMinutes                Int
  title                          String
  organizationId                 String
  location                       String
  registrationDeadlineOffsetMinutes Int?
  effectiveFromLocalDate         DateTime @db.Date
  effectiveToLocalDate           DateTime @db.Date
  generationWindowDays           Int
  createdByUserId                String

  series          ActivitySeries   @relation(fields: [seriesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  templateVersion ActivityTemplate @relation("ActivitySeriesRevisionTemplate", fields: [templateVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organization    Organization     @relation("ActivitySeriesRevisionOrganization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser   User             @relation("ActivitySeriesRevisionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  commandReceipts ActivitySeriesCommandReceipt[]
  occurrences     ActivitySeriesOccurrence[]

  @@unique([seriesId, revision])
  // 收据 / Occurrence 的 (revisionId, seriesId) 复合 FK 的被引用锚点；禁止把另一条
  // Series 的 Revision 伪装成本 Series 的历史事实。
  @@unique([id, seriesId], map: "activity_series_revision_id_series_key")
  @@index([templateVersionId])
  @@index([organizationId])
  @@index([createdByUserId])
}

// 不带 updatedAt / deletedAt；同一 operationKey 绑定命令类别与 canonical requestHash。
// result 只保存安全的业务标识，不保存请求原文、hash key 或模板定义 JSON。
model ActivitySeriesCommandReceipt {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  commandCode      String
  operationKey     String   @unique(map: "activity_series_command_receipt_operation_key_key")
  requestHash      String
  seriesId         String
  revisionId       String?
  resultRevision   Int?
  resultStatusCode String
  activityIds      String[] @default([])

  series   ActivitySeries          @relation(fields: [seriesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision ActivitySeriesRevision? @relation(fields: [revisionId, seriesId], references: [id, seriesId], onDelete: Restrict, onUpdate: Restrict)

  @@index([seriesId, createdAt])
  @@index([revisionId])
}

// 不带 updatedAt / deletedAt；每个 (seriesId, occurrenceKey) 至多物化一个独立 Activity。
// activityId 单列唯一，确保任一生成 Activity 不能被重新归属到另一条 occurrence。
model ActivitySeriesOccurrence {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  seriesId      String
  revisionId    String
  activityId    String   @unique(map: "activity_series_occurrence_activity_id_key")
  occurrenceKey String
  startAt       DateTime
  endAt         DateTime

  series   ActivitySeries         @relation(fields: [seriesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision ActivitySeriesRevision @relation(fields: [revisionId, seriesId], references: [id, seriesId], onDelete: Restrict, onUpdate: Restrict)
  activity Activity               @relation("ActivitySeriesOccurrenceActivity", fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([seriesId, occurrenceKey])
  @@index([revisionId])
  @@index([startAt])
}

// ===== Activity OS R2 / B6 D1:受控创建的数据地基 =====
//
// 专业 / 紧急创建各自以 actor + command + operation key 精确幂等；快速模式继续使用
// Activity 上既有 A6 锚点，不能混用。收据不保存原请求、响应体、受众或其它敏感内容。
model ActivityCreationCommandReceipt {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  actorUserId  String
  commandCode  String
  operationKey String
  requestHash  String
  activityId   String   @unique(map: "activity_creation_command_receipt_activity_id_key")

  activity            Activity                     @relation("ActivityCreationCommandReceiptActivity", fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor               User                         @relation("ActivityCreationCommandReceiptActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  emergencyInitiation ActivityEmergencyInitiation? @relation("ActivityEmergencyInitiationReceipt")

  @@unique([actorUserId, commandCode, operationKey], map: "activity_creation_command_receipt_actor_command_key")
  // 紧急起源通过 (receiptId, activityId) 引用本锚，数据库证明二者属于同一活动。
  @@unique([id, activityId], map: "activity_creation_command_receipt_id_activity_key")
  @@index([actorUserId, createdAt], map: "activity_creation_command_receipt_actor_created_idx")
}

// 一条紧急起源只锚定一次创建事实与一次活动；真实发送生命周期由后续 outbox 接线唯一承载，
// 本表不复制通知状态、不设伪事故编号、也不保存受众或精确地点。
model ActivityEmergencyInitiation {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  activityId        String   @unique(map: "activity_emergency_initiation_activity_id_key")
  creationReceiptId String   @unique(map: "activity_emergency_initiation_receipt_id_key")
  callQueuedAt      DateTime

  activity        Activity                        @relation("ActivityEmergencyInitiationActivity", fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creationReceipt ActivityCreationCommandReceipt  @relation("ActivityEmergencyInitiationReceipt", fields: [creationReceiptId, activityId], references: [id, activityId], onDelete: Restrict, onUpdate: Restrict)
  followUpItems   ActivityEmergencyFollowUpItem[]

  // Prisma 的一对一关系也需定义侧的复合唯一锚；与 creationReceiptId 单列唯一共同锁死。
  @@unique([creationReceiptId, activityId], map: "activity_emergency_initiation_receipt_activity_key")
}

// 固定的事后补齐义务。pending 不得伪装成已处理；只有带时间与操作人的 verified /
// unrepresentable 终态才成立。D1 不提供任意自由文本、完成开关或运行时写入入口。
model ActivityEmergencyFollowUpItem {
  id                    String    @id @default(cuid())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  emergencyInitiationId String
  itemCode              String
  statusCode            String    @default("pending")
  resolvedAt            DateTime?
  resolvedByUserId      String?

  emergencyInitiation ActivityEmergencyInitiation @relation(fields: [emergencyInitiationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resolvedBy          User?                       @relation("ActivityEmergencyFollowUpItemResolver", fields: [resolvedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([emergencyInitiationId, itemCode], map: "activity_emergency_follow_up_item_initiation_code_key")
  @@index([statusCode], map: "activity_emergency_follow_up_item_status_idx")
}

// ===== §3.4 ActivityRuleSnapshot:发布／关键变更审核通过后的不可变规则快照 =====
//
// 不带 updatedAt / deletedAt;migration 另以 trigger 禁 UPDATE / DELETE。
model ActivityRuleSnapshot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  activityId        String
  workflowRevision  Int
  templateVersionId String?
  // canonical JSON 的完整解析配置,含活动默认及每个 session / position 的最终值。
  resolvedConfig    Json
  snapshotHash      String
  createdByReviewId String

  activity          Activity                  @relation(fields: [activityId], references: [id], onDelete: Restrict)
  templateVersion   ActivityTemplate?         @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  createdByReview   ActivityPublishReview     @relation(fields: [createdByReviewId], references: [id], onDelete: Restrict)
  allocationBatches ActivityAllocationBatch[]
  offlinePackages   OfflinePackage[]

  // 一个活动的一个 workflow revision 只能对应一份最终规则快照。createdByReviewId
  // 只保存审核来源，不假定合同未声明的“一审核请求至多一快照”。
  @@unique([activityId, workflowRevision])
  // 业务复合锚点闭合(第六轮评审 A-2 / B-03):被引用侧锚点 —— PostgreSQL 复合外键
  // 要求被引用列上有**精确匹配**的 unique;id 单列主键不能替代。仅作 FK 靶点,不新增业务约束。
  @@unique([id, activityId], map: "activity_rule_snapshot_id_activity_key")
  @@index([templateVersionId])
}

// ===== 活动责任闭环 PR1:负责人 / 协办历史 =====
//
// 活跃 owner / 活跃 member 唯一性及能力、终止时间不变量由 migration 约束；
// 历史只结束或撤销，不提供物理删除入口。
model ActivityResponsibilityAssignment {
  id         String @id @default(cuid())
  activityId String
  memberId   String

  responsibilityType     String
  canManageRegistrations Boolean
  canManageAttendance    Boolean
  status                 String  @default("active")

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  assignedByUserId String
  endedByUserId    String?
  source           String
  reason           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  assignedBy User     @relation("ActivityResponsibilityAssigner", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  endedBy    User?    @relation("ActivityResponsibilityEnder", fields: [endedByUserId], references: [id], onDelete: Restrict)

  @@index([activityId, status])
  @@index([memberId, status])
  @@index([assignedByUserId])
  @@map("activity_responsibility_assignments")
}

// ===== 活动岗位与时段 F1:activity_positions =====
//
// 活动岗位是 activities 模块内的嵌套子资源，与 organization_positions 组织职务无关。
// attendanceRoleCode / genderRequirementCode 沿字典 code 业务校验，不加 FK。
// live (activityId, name) partial unique 由 migration.sql 末尾手写；
// Prisma DSL 6.x 无法表达 WHERE "deletedAt" IS NULL。
// goal 明确要求物理表名 activity_positions，本模型使用 @@map 固定该名称。
model ActivityPosition {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  activityId            String
  name                  String
  attendanceRoleCode    String
  capacity              Int?
  startAt               DateTime?
  endAt                 DateTime?
  genderRequirementCode String?
  description           String?
  sortOrder             Int       @default(0)

  activity      Activity               @relation(fields: [activityId], references: [id], onDelete: Restrict)
  registrations ActivityRegistration[]

  // 业务复合锚点闭合(第六轮评审 A-2 / B-03):被引用侧锚点 —— PostgreSQL 复合外键
  // 要求被引用列上有**精确匹配**的 unique;id 单列主键不能替代。仅作 FK 靶点,不新增业务约束。
  @@unique([id, activityId], map: "activity_position_id_activity_key")
  @@index([activityId])
  @@index([attendanceRoleCode])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([sortOrder])
  @@map("activity_positions")
}

// ===== V2 第一阶段批次 3:activity_registrations =====
//
// statusCode 字典 4 态(Q-D15 v0.3):pending / pass / reject / cancelled
//
// FK(全部 ON DELETE Restrict):
// - activityId         → Activity.id           (NOT NULL)
// - memberId           → Member.id             (NOT NULL)
// - reviewedBy         → User.id               (可空,沿 Q-S4)
// - cancelledByUserId  → User.id               (可空,Q-D16 v0.3)
// - activityPositionId → activity_positions.id (可空,无岗位活动 / 存量报名)
//
// 业务唯一约束(永久报名头;活动改造 v1.1 第 4 批第九刀):
// - (activityId, memberId) 跨 cancelled / soft-deleted 全历史只能有一个头
// - 索引名 activity_registrations_activity_member_permanent_unique
// - 取消/重报的 runtime 复用仍属后续刀;本刀只落 DB 地基
//
// extras Json?(D12 字段位预留)。
//
// 索引:7 单列(activityId / activityPositionId / memberId / statusCode / deletedAt / createdAt / registeredAt)。

model ActivityRegistration {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  activityId         String
  activityPositionId String?
  memberId           String
  statusCode         String
  registeredAt       DateTime  @default(now())
  reviewedBy         String?
  reviewedAt         DateTime?
  reviewNote         String?
  extras             Json?

  // v0.3 新增 取消留痕(Q-D16)
  cancelledByUserId String?
  cancelledAt       DateTime?
  cancelReason      String?

  // ===== 活动改造 v1.1 第 1 批第二刀(2026-08-04;合同 §3.6)=====
  // 四列全部**可空或带 default** ⇒ 有存量行的库零回填、零失败。
  //
  // §3.6 把本表重定义为「活动级总报名头」:一活动一队员永久唯一,不因取消重报另建头行。
  // 这四列是那份定义缺的部分;既有列一个不动、语义一字不改(expand 段)。
  currentRevision      Int     @default(0) // 当前修订号投影,真值在 ActivityRegistrationRevision
  currentFormVersionId String? // 本次报名绑定的报名表版本;活动没有自定义表时恒 NULL
  // active / completed / cancelled / not_selected / expired
  // (§3.6 聚合规则原文给出的取值;migration CHECK 闭集,放行 NULL = 尚未聚合)
  statusSummaryCode    String?
  sourceCode           String? // self / admin / invitation / onsite(§3.6 明写闭集;放行 NULL)

  activity                      Activity                        @relation(fields: [activityId], references: [id], onDelete: Restrict)
  activityPosition              ActivityPosition?               @relation(fields: [activityPositionId, activityId], references: [id, activityId], onDelete: Restrict)
  member                        Member                          @relation(fields: [memberId], references: [id], onDelete: Restrict)
  reviewer                      User?                           @relation("RegistrationReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  canceller                     User?                           @relation("RegistrationCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  attendanceRecords             AttendanceRecord[]
  activityCheckIns              ActivityCheckIn[]
  insuranceEligibilityEvidences InsuranceEligibilityEvidence[]
  // 活动改造 v1.1 第 1 批第一刀反向 relation(合同 §3.8):仅关系映射,零标量字段。
  // ⚠️ §3.6 把本表重定义为「活动级总报名头」并新增 currentRevision /
  // currentFormVersionId / statusSummaryCode 等列 —— 那些列指向第二刀才建的
  // RegistrationFormVersion,按 goal ②「跨切片的列不提前占位」移出本刀。
  participationIdentities       ActivityParticipationIdentity[]

  // 第 1 批第二刀(合同 §3.6 / §3.7)。
  currentFormVersion RegistrationFormVersion?       @relation("RegistrationCurrentFormVersion", fields: [currentFormVersionId, activityId], references: [id, activityId], onDelete: Restrict)
  revisions          ActivityRegistrationRevision[]

  @@unique([activityId, memberId], map: "activity_registrations_activity_member_permanent_unique")
  // 业务复合锚点闭合(第六轮评审 A-2 / B-03):被引用侧锚点 —— PostgreSQL 复合外键
  // 要求被引用列上有**精确匹配**的 unique;id 单列主键不能替代。仅作 FK 靶点,不新增业务约束。
  @@unique([id, activityId, memberId], map: "activity_registration_id_activity_member_key")
  @@index([activityId])
  @@index([activityPositionId])
  @@index([memberId])
  @@index([statusCode])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([registeredAt])
  @@index([currentFormVersionId])
  @@index([statusSummaryCode])
}

// ===== 活动自助 GPS 签到 F1:activity_check_ins =====
//
// append-only 证据表；第一版不开放修改 / 删除端点，deletedAt 仅作 schema 预留。
// 三条 FK 均 Restrict：证据必须稳定锚定活动、队员与当次报名。
// live registrationId partial unique 由 migration.sql 末尾手写；Prisma DSL 6.x
// 无法表达 WHERE "deletedAt" IS NULL。
// 本模型获冻结稿一次性 @@map 例外，物理表名固定为 activity_check_ins。
model ActivityCheckIn {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  activityId     String
  memberId       String
  registrationId String
  checkInAt      DateTime
  checkOutAt     DateTime?

  checkInLongitude  Decimal? @db.Decimal(10, 7)
  checkInLatitude   Decimal? @db.Decimal(10, 7)
  checkInAccuracy   Decimal? @db.Decimal(10, 2)
  checkInDistance   Decimal? @db.Decimal(10, 2)
  checkOutLongitude Decimal? @db.Decimal(10, 7)
  checkOutLatitude  Decimal? @db.Decimal(10, 7)
  checkOutAccuracy  Decimal? @db.Decimal(10, 2)
  checkOutDistance  Decimal? @db.Decimal(10, 2)

  geoVerified Boolean
  outOfRange  Boolean @default(false)

  activity     Activity             @relation(fields: [activityId], references: [id], onDelete: Restrict)
  member       Member               @relation(fields: [memberId], references: [id], onDelete: Restrict)
  registration ActivityRegistration @relation(fields: [registrationId, activityId, memberId], references: [id, activityId, memberId], onDelete: Restrict)

  @@index([activityId])
  @@index([memberId])
  @@index([registrationId])
  @@index([checkInAt])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("activity_check_ins")
}

// ===== 活动评价 F1:activity_feedbacks =====
//
// 真到场者在 Activity.endAt + 配置窗口内对 completed 活动提交 1～5 星评价。
// 资格由业务层读取 approved AttendanceSheet 内未软删 AttendanceRecord 判定；
// 本表不保存 registrationId，也不影响考勤 / 贡献值 / 结算。
// live (activityId, memberId) partial unique 由 migration.sql 末尾手写；
// Prisma DSL 6.x 无法表达 WHERE "deletedAt" IS NULL。
// goal 明确要求物理表名 activity_feedbacks，本模型使用 @@map 固定该名称。
model ActivityFeedback {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  activityId String
  memberId   String
  rating     Int
  comment    String?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([activityId])
  @@index([memberId])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([rating])
  @@map("activity_feedbacks")
}

// ===== V2 第一阶段批次 3:attendance_sheets =====
//
// statusCode 字典 3 态(D18):pending / approved / rejected。
// version Int @default(1)(Q-D8 不做乐观锁,仅展示用)。
// previousSnapshot Json?(D38 / Q-D1 后端事务内自动生成)。
//
// FK(全部 ON DELETE Restrict):
// - activityId       → Activity.id  (NOT NULL,D47 一 Activity 多 Sheet / R30)
// - submitterUserId  → User.id      (NOT NULL,Q-S4 系统操作人)
// - reviewerUserId   → User.id      (可空,APD 审核员)
//
// 索引:7 单列。

model AttendanceSheet {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  activityId            String
  submitterUserId       String
  submittedAt           DateTime  @default(now())
  statusCode            String
  reviewerUserId        String?
  reviewedAt            DateTime?
  reviewNote            String?
  // V2 第一阶段批次 4-A 新增三字段(D-S5):APD 部门部长 / 副部长终审。
  // 与 reviewer* 系列对称(沿 baseline §2.1 命名);均可空,在 final-approve / final-reject
  // service 内事务填入。APD 一级 approve 时 statusCode 进入 pending_final_review;
  // 终审通过 → approved(贡献值正式生效,触发 attendance.recorded);终审驳回 → final_rejected。
  finalReviewerUserId   String?
  finalReviewedAt       DateTime?
  finalReviewNote       String?
  lastSubmittedByUserId String?
  lastSubmittedAt       DateTime?
  returnedByUserId      String?
  returnedAt            DateTime?
  returnNote            String?
  returnedFromStageCode String?
  previousSnapshot      Json? // D38 后端事务内自动生成
  version               Int       @default(1) // Q-D8 不做乐观锁;服务端版本号

  activity      Activity           @relation(fields: [activityId], references: [id], onDelete: Restrict)
  submitter     User               @relation("SheetSubmitter", fields: [submitterUserId], references: [id], onDelete: Restrict)
  reviewer      User?              @relation("SheetReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  finalReviewer User?              @relation("SheetFinalReviewer", fields: [finalReviewerUserId], references: [id], onDelete: Restrict)
  lastSubmitter User?              @relation("AttendanceSheetLastSubmitter", fields: [lastSubmittedByUserId], references: [id], onDelete: Restrict)
  returnedBy    User?              @relation("AttendanceSheetReturner", fields: [returnedByUserId], references: [id], onDelete: Restrict)
  records       AttendanceRecord[]

  @@index([activityId])
  @@index([submitterUserId])
  @@index([reviewerUserId])
  @@index([finalReviewerUserId])
  @@index([statusCode])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([submittedAt])
  @@index([lastSubmittedByUserId])
  @@index([returnedByUserId])
  @@index([returnedAt])
}

// ===== V2 第一阶段批次 3:attendance_records =====
//
// attendanceStatusCode 字典 3 态(D44 / D51 v0.2.4 撤销 absent / leave):
//   present / late / early_leave。
//
// roleCode 字典 7 项(D13):member / instructor / assistant / coach /
//   front_command / back_command / info。
//
// 显式 @db.Decimal 注解(Q-D2):
// - serviceHours        → Decimal(5, 2) NOT NULL,业务必填且 > 0,允许 < 跨度(D46)
// - contributionPoints  → Decimal(5, 2)? 字段层可空,业务 approved 前必填(R31)
//
// FK:
// - sheetId         → AttendanceSheet.id        (NOT NULL, Restrict, R20)
// - memberId        → Member.id                 (NOT NULL, Restrict)
// - registrationId  → ActivityRegistration.id   (可空,**Restrict** 不是 SetNull,Q-S21)
//
// 索引:7 单列 + 1 复合(memberId, deletedAt)用于时间不重叠校验性能(R16)。
// 业务唯一约束:无(D8 撤销 v0.1 AT-9)。

model AttendanceRecord {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sheetId              String
  memberId             String
  roleCode             String
  checkInAt            DateTime
  checkOutAt           DateTime
  serviceHours         Decimal  @db.Decimal(5, 2) // Q-D2 显式注解;必填且 > 0(D45/D51)
  attendanceStatusCode String
  note                 String?
  registrationId       String? // Q-D26 / D27 可空(临时参加 / 非公开报名)
  contributionPoints   Decimal? @db.Decimal(5, 2) // Q-D2 + R31;字段层可空,APD approved 前必填

  sheet        AttendanceSheet       @relation(fields: [sheetId], references: [id], onDelete: Restrict)
  member       Member                @relation(fields: [memberId], references: [id], onDelete: Restrict)
  registration ActivityRegistration? @relation(fields: [registrationId], references: [id], onDelete: Restrict) // Q-S21:Restrict 不是 SetNull

  @@index([sheetId])
  @@index([memberId])
  @@index([registrationId])
  @@index([attendanceStatusCode])
  @@index([roleCode])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([memberId, deletedAt]) // R16 时间不重叠校验性能
}

// ===== V2 第一阶段批次 4-A:contribution_rules =====
//
// 详见 docs:
// - 批次4_贡献值业务规则前评审决议表.md v1.0 D14 候选 5.B
// - 批次4_贡献值业务规则_schema草案评审决议表.md v1.0 D-S1 / D-S3 / D-S4
// - 批次4_贡献值业务规则_字典扩展决议表.md v1.0 D-D5
// - 批次4_贡献值业务规则_API草案.md v1.0 D-A8
//
// 模型用途:承载 D14 5.B 系统预填 contributionPoints 的规则映射。
// service 在 POST /attendance-sheets 事务内查表预填;APD 一级 approve 时 R31 必填校验;
// APD 可现场修订(沿 D4 终决权)。第一版不暴露管理 API(D-A9),seed/运营后台维护。
//
// 关联(D-D5):
// - activityTypeCode → activity_type 字典 code(2 级树;关联叶子或无子父节点,运营自治)
// - attendanceRoleCode → attendance_role 字典 code(扁平结构)
// - 不引外键 FK(字典 code 字符串关联,运营后台决定取值;沿 v0.4.0 *Code 字段风格)
//
// 时长档位(D-S3 简化档位):
// - durationThreshold?:时长阈值(小时);null 表示无档位,直接按 pointsBelow 取值
// - pointsBelow:≤ durationThreshold(或无档位)的预填分值
// - pointsAbove?:> durationThreshold 的预填分值;无档位时不填
// - 救援 / 救助后方人员的"每 6h 0.5"线性公式不通过本字段集精确表达(D-S3 / D-A8 §5);
//   后方角色按简化档位预填(<6h = pointsBelow / >=6h = pointsAbove),APD 现场修订。
//
// 每日上限(D-S3 / D-D5):
// - dailyCap?:**已 deprecated(活动闭环硬化 2026-06-21)**。每日封顶语义由「每条记录各自封顶」
//   改为「全局每日上限」(一人单个北京日历日总分封顶 GLOBAL_DAILY_CONTRIBUTION_CAP=3),封顶落在
//   汇总处 team-join `computeContribution`,ContributionCalculator 不再读此列。列保留不删(免 migration);
//   旧值照旧存库、不参与计算。原行为:null 时由 service 兜底默认 1.5(Q-OPEN-7);R22 类填 0(D-S9 §6.3)。
//
// 启停字段(D-S1):沿 baseline §2.2.3 + v0.4.0 现有 enum 风格,用大写 ACTIVE/INACTIVE;
// 禁止使用 isActive / isEnabled / enabled。
//
// 审计字段:createdByUserId / updatedByUserId / deletedByUserId 可空 FK,运营后台维护时填入。
//
// 唯一约束(D-RULE-1):(activityTypeCode, attendanceRoleCode) 在 deletedAt IS NULL
// AND status = 'ACTIVE' 范围内唯一；同一 type × role 只能有一条生效规则，
// durationThreshold 是该规则内部的档位参数，不再参与 ACTIVE 槽位维度。Prisma DSL 至 6.x 不支持
// @@unique 内表达 WHERE 子句的 partial unique;沿 batch 3 active_unique 范式手动
// 追加 migration SQL(参见 migration.sql 末尾)。schema 仅声明普通 @@index。

model ContributionRule {
  id                 String                 @id @default(cuid())
  activityTypeCode   String
  attendanceRoleCode String
  durationThreshold  Decimal?               @db.Decimal(5, 2) // 时长档位阈值(小时);null 表示无档位
  pointsBelow        Decimal                @db.Decimal(5, 2) // ≤ 阈值(或无档位)的预填分值
  pointsAbove        Decimal?               @db.Decimal(5, 2) // > 阈值的预填分值;无档位时不填
  dailyCap           Decimal?               @db.Decimal(5, 2) // [deprecated 2026-06-21] 全局每日封顶改落 team-join computeContribution;calculator 不再读,列保留免 migration
  status             ContributionRuleStatus @default(ACTIVE)
  remark             String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?
  createdByUserId    String?
  updatedByUserId    String?
  deletedByUserId    String?

  createdBy User? @relation("ContributionRuleCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy User? @relation("ContributionRuleUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  deletedBy User? @relation("ContributionRuleDeleter", fields: [deletedByUserId], references: [id], onDelete: Restrict)

  @@index([activityTypeCode])
  @@index([attendanceRoleCode])
  @@index([activityTypeCode, attendanceRoleCode]) // 查表预填走 (activityTypeCode × attendanceRoleCode) 主路径
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
}

enum ContributionRuleStatus {
  ACTIVE
  INACTIVE
}

// ===== V2 第一阶段批次 6:audit_logs =====
//
// 详见 docs:
// - 批次6_audit_logs_业务确认稿.md(B1-B5)
// - 批次6_audit_logs_API前评审.md(D6 v1.1 §4 / §9 / §10)
//
// 设计选择(D6 v1.1 §4):
// - 单表 9 个业务字段 + 1 个 User relation;无 updatedAt / 无 deletedAt(R1 红线:写入后不可改不可删)
// - event / resourceType 用 String 不用 Prisma enum(union 在 audit-logs.types.ts / common/audit/audit-placeholder.ts 维护)
// - actorRoleSnap 用 Prisma Role enum(取自 currentUser.role 快照,D10)
// - context 用 Json,但运行时强约束为 AuditContext(6 字段:3 必填 + 3 可选,D7)
// - success 默认 true,BizException 回滚后不写入(D-B fail-fast)
//
// FK:
// - actorUserId → User.id  (可空;系统操作时为 null;onDelete: Restrict + onUpdate: Restrict,R14)
//
// 索引(D6 v1.1 §4.1;3 个复合索引,默认排序 [{ createdAt: 'desc' }, { id: 'desc' }] tie-breaker 用 PK):
// - (resourceType, resourceId):查某资源的全部审计记录(emergency_contact / certificate)
// - (actorUserId, createdAt):查某操作人的全部审计记录(管理员查自己)
// - (event, createdAt):按事件类型筛选(emergency-contact.write / certificate.create / ...)

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // 主体(D6 v1.1 §4.1;actorRoleSnap = 操作时角色快照,不查 user 表反向取最新角色)
  actorUserId   String?
  actorRoleSnap Role?

  // 客体(D6 v1.1 §4.1;create 失败时 resourceId 可为 null)
  resourceType String // 'emergency_contact' / 'certificate'(第一批 2 种)
  resourceId   String?

  // 动作(沿 AuditLogEvent union 同值,union 在 audit-logs.types.ts 维护)
  event String

  // 上下文(锁形 AuditContext,见 audit-logs.types.ts;D7)
  context Json

  // 状态(D-B fail-fast:audit 与业务同事务,失败回滚整体;成功路径默认 true)
  success Boolean @default(true)

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Integration Foundation v1 双主体审计(规格书 §22;语义矩阵见 T0 冻结稿 §12.1):
  // 真人直接=actorUser;机器自身=actorServicePrincipal;机器代表真人=SP+onBehalfOfUser;
  // SRVF 内部系统任务=三项全 null(12 处现存 Worker 行 —— migration 的 4 条 CHECK 必须放行)。
  actorServicePrincipalId String?
  actorCredentialId       String?
  onBehalfOfUserId        String?
  onBehalfOfRoleSnap      Role?

  actorServicePrincipal ServicePrincipal?          @relation("AuditActorServicePrincipal", fields: [actorServicePrincipalId], references: [id], onDelete: Restrict)
  actorCredential       ServicePrincipalCredential? @relation("AuditActorCredential", fields: [actorCredentialId], references: [id], onDelete: Restrict)
  onBehalfOfUser        User?                       @relation("AuditOnBehalfOfUser", fields: [onBehalfOfUserId], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId])
  @@index([actorUserId, createdAt])
  @@index([event, createdAt])
  @@index([actorServicePrincipalId, createdAt])
  @@index([onBehalfOfUserId, createdAt])
  @@map("audit_logs")
}

// ===== V2.x C-6 RBAC 4 表(沿 D7 v1.1 §4 schema 草案) =====
//
// 段位 BizCode 300xx + 301xx(F1 锁;baseline §1.1 已预留)。
// users.policy.ts 永久共存(D12 永不切换);RBAC 仅作新增 V2 接口业务级补充(F9)。
// v1 enum Role 保持不动(SUPER_ADMIN / ADMIN / USER 三层永远不变;沿 A-2 + A-4 红线)。
// v1.1 命名:RBAC role model 名为 RbacRole(避开 v1 enum Role 冲突);
//   DB 表名仍 @@map("roles") / @@map("permissions") / @@map("role_permissions") / @@map("user_roles")
//   保持 snake_case 复数风格(沿 audit_logs / API 路径风格)。
// 实施仅本 PR(C-6 实施 PR #1)落地 schema + migration;
// service / controller / DTO / seed / 判权已在 C-6 后续 PR(#2-#8)全部实装。
// 详见:
//   - docs/批次8_RBAC_API前评审.md §4(schema 草案;v1.1 修订稿)
//   - docs/批次8_RBAC_V2x立项记录.md §二(立项内容)

model RbacRole {
  id          String    @id @default(cuid())
  code        String    @unique // 业务 code,kebab-case;F7 锁定 3-32 字符
  displayName String // 显示名;真实名走 .env.seed.local(F6 / R13)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // D4:RbacRole 软删

  // P1-32 PR 4a(2026-08-23):角色**权限集**的版本号,供 `PUT /roles/:id/permissions`
  // 做乐观并发(`expectedRevision` 不符 → 30111)。每次**成功且有实际变化**的权限集写入 +1,
  // 与映射写入、audit 同一事务、同一把角色行锁之后。
  //
  // ⚠️ **不能用 `updatedAt` 代替**:两者语义不同 —— 改 displayName / description 会动
  //    `updatedAt` 却不该让别人手里的权限编辑作废;而权限集空转(目标集合与现状相同)
  //    两者都不动。合并成一个字段会同时产生误冲突与漏冲突。
  //
  // 🔴 它不是给旧洞补的:旧 POST(加码)/ DELETE(减码)语义**可交换**,并发不丢更新;
  //    整集替换是读-改-写,窗口是那个新语义带进来的,所以版本号与它同刀落地。
  permissionRevision Int @default(0)

  rolePermissions RolePermission[]

  // 终态 scoped-authz PR6(2026-07-01;冻结稿 §3.6):带 scope 的角色绑定反向 relation(真 FK,Restrict)。
  // RoleBinding(principalType=USER, scopeType=GLOBAL)是旧 UserRole 表的无损升级 = 判权唯一读源;
  // UserRole 表已 DROP(冻结表 cleanup,第 39 migration)。
  roleBindings RoleBinding[]

  // 终态 scoped-authz PR7(2026-07-01;冻结稿 §3.7):职务→角色映射反向 relation(仅关系映射,无列)。
  // **本表纯配置,绝不被任何判权路径读**(消费方是 PR8 AuthzService);org-admin/group-manager/
  // org-supervisor 三管理角色本刀零 user 持有,不影响 RbacService.can() 判权语义。
  rolePolicies OrganizationPositionRolePolicy[]

  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id           String   @id @default(cuid())
  code         String   @unique // <module>.<action>.<resource_type>(D2 锁定;kebab-case)
  module       String // 模块名(冗余,方便后台 UI 按 module 分组)
  action       String // 动作
  resourceType String // 资源类型
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // D4:Permission 物理删,无 deletedAt(seed-driven;运营不主动删)

  rolePermissions RolePermission[]
  delegationGrantPermissions DelegationGrantPermission[]

  // Integration Foundation v1(规格书 §15.1):资格门,默认双 false —— 234 个存量权限
  // 一条也不自动开放给机器;migration 侧 CHECK 钉死 delegated ⇒ servicePrincipal。
  servicePrincipalAllowed Boolean @default(false)
  delegatedAccessAllowed  Boolean @default(false)

  @@index([module])
  @@index([resourceType])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  createdBy    String? // User.id;沿 D11 audit 字段

  role          RbacRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdByUser User?      @relation("RolePermissionCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// 终态 scoped-authz PR6「RoleBinding」(2026-07-01 goal;冻结稿 §3.6 / §8.2 / §7.5 / §4.3;序列 PR6/12)。
//
// **带 scope 的角色绑定:终态替代 / 兼容旧 UserRole 表。** 每条 UserRole 已由第 37 migration 回填为
//   RoleBinding(principalType=USER, principalId=userId, scopeType=GLOBAL, status=ACTIVE);
//   旧 UserRole 表已 DROP(冻结表 cleanup,第 39 migration)。
// **判权唯一读源(行为锁,PR6 起):** RbacService.getUserPermissionCodes / getEffectiveRoles +
//   user-roles CRUD + rbac-cache 失效**全部只读 / 只写 scopeType=GLOBAL 的本表**。
// **🔴 scoped 绑定可存不判(PR8 边界):** ORGANIZATION / ORGANIZATION_TREE / ACTIVITY / RESOURCE / SELF 各型
//   经 role-bindings CRUD 入库,但 **RbacService 只读 GLOBAL、绝不判 scoped**(scoped 判权是 PR8 AuthzService)。
//
// **principalId 多态(沿 Attachment.ownerType/ownerId 范式):** 随 principalType 指向
//   user / member / position_assignment / system(SYSTEM 时可空),**不建通用 Prisma FK**
//   (会对 USER 主体误断言指向 position_assignment 而失败),由 service 按 principalType 校验存在性。
//   仅 roleId→RbacRole、scopeOrgId→Organization 是真 FK(非多态,Restrict)。
// **partial unique(手写,第 37 migration 末尾;PG16 NULLS NOT DISTINCT):**
//   (principalType,principalId,roleId,scopeType,scopeOrgId,scopeActivityId,scopeResourceType,scopeResourceId)
//   WHERE deletedAt IS NULL AND status='ACTIVE'(同一绑定不重复;NULLS NOT DISTINCT 令 GLOBAL 的 NULL scope 列
//   也参与去重 = 保住 UserRole 旧 @@unique(userId,roleId) 的并发去重行为锁;P2002 → ROLE_BINDING_ALREADY_EXISTS)。
model RoleBinding {
  id                String           @id @default(cuid())
  principalType     PrincipalType // USER / MEMBER / POSITION_ASSIGNMENT / SYSTEM
  principalId       String? // 多态、无 FK(SYSTEM 时可空);USER 时 = User.id
  roleId            String
  scopeType         BindingScopeType
  scopeOrgId        String? // ORGANIZATION / ORGANIZATION_TREE 时必填
  scopeActivityId   String? // ACTIVITY 时必填(多态 String,无 FK)
  scopeResourceType String? // RESOURCE 时必填(如 attendance_sheet)
  scopeResourceId   String? // RESOURCE 时必填(多态 String,无 FK)
  status            BindingStatus    @default(ACTIVE)
  startedAt         DateTime         @default(now())
  endedAt           DateTime? // 临时授权可设;过期不授权(PR8 判)
  createdByUserId   String?
  note              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  role              RbacRole      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scopeOrganization Organization? @relation("RoleBindingScopeOrg", fields: [scopeOrgId], references: [id], onDelete: Restrict)

  @@index([principalType, principalId])
  @@index([roleId])
  @@index([scopeType, scopeOrgId])
  @@index([scopeActivityId])
  @@index([status])
  @@index([deletedAt])
  @@map("role_bindings")
}

// ═══════════════════════════════════════════════════════════════════════
// Integration Foundation v1 — PR1 Schema 地基(规格书 §27–§33;T0 冻结稿 §8;
// 维护者 2026-08-28 拍板开工。纯 schema:零 Controller / 零 Token / 零业务接入 —— 那些是 PR2+。)
// ⚠️ 第 100 条 migration:migration 侧另有 Prisma DSL 表达不了的 CHECK(见
//    20260828120000_integration_foundation_pr1_schema/migration.sql 头注)。
// ═══════════════════════════════════════════════════════════════════════

// 机器身份(外部应用/自动化系统的安全主体;不是 User,也不是一串 Secret —— 三者分表)。
model ServicePrincipal {
  id                  String                 @id @default(cuid())
  clientId            String                 @unique // 服务端生成,前缀 srvf_sp_,永不复用(软删后仍占用)
  name                String
  description         String?
  status              ServicePrincipalStatus @default(ACTIVE) // SUSPENDED 下一请求即拒(PR3 接线)
  ownerOrganizationId String?
  createdByUserId     String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  deletedAt           DateTime? // 沿仓内软删惯例;clientId 唯一约束使软删后仍占用

  credentials      ServicePrincipalCredential[]
  delegationGrants DelegationGrant[]
  commandReceipts  IntegrationCommandReceipt[]
  auditLogsAsActor AuditLog[] @relation("AuditActorServicePrincipal")

  ownerOrganization Organization? @relation("ServicePrincipalOwnerOrganization", fields: [ownerOrganizationId], references: [id], onDelete: Restrict)
  createdByUser     User          @relation("ServicePrincipalCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([ownerOrganizationId])
  @@index([deletedAt])
  @@map("service_principals")
}

// 机器凭证(身份与凭证分离,支持无停机轮换:新建 B → 切换 → 撤销 A)。
// 行不可改 secretHash,只能新建 / 撤销;同 SP 同时 ≤2 条 ACTIVE 未过期 —— 计数必须
// 锁定主体后再算(advisory lock 范式),这是 PR2 运行时约束,不是 DB CHECK(跨行)。
model ServicePrincipalCredential {
  id                 String   @id @default(cuid())
  servicePrincipalId String
  secretHash         String   @unique // SHA-256(高熵随机 Secret);明文只在新响应出现一次
  createdByUserId    String
  createdAt          DateTime @default(now())
  expiresAt          DateTime?
  revokedAt          DateTime?
  revokedByUserId    String?
  lastUsedAt         DateTime?

  servicePrincipal ServicePrincipal @relation(fields: [servicePrincipalId], references: [id], onDelete: Restrict)
  createdByUser    User             @relation("ServiceCredentialCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedByUser    User?            @relation("ServiceCredentialRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  receipts         IntegrationCommandReceipt[]
  auditLogsAsActor AuditLog[] @relation("AuditActorCredential")

  @@index([servicePrincipalId, revokedAt])
  @@index([expiresAt])
  @@map("service_principal_credentials")
}

// 受控委托:某 SP 可否在指定权限/范围/期限内代表指定 User(规格书 §19/§30)。
// scope 形状 CHECK 与 endedAt>startedAt 在 migration 侧(PG CHECK;见 migration 头注)。
model DelegationGrant {
  id                   String                @id @default(cuid())
  servicePrincipalId   String
  subjectUserId        String
  status               DelegationGrantStatus @default(ACTIVE)

  scopeType            BindingScopeType
  scopeOrgId           String?
  scopeActivityId      String?
  scopeResourceType    String?
  scopeResourceId      String?

  startedAt            DateTime              @default(now())
  endedAt              DateTime?
  createdByUserId      String
  createdAt            DateTime              @default(now())
  revokedAt            DateTime?
  revokedByUserId      String?
  revokeReason         String?

  servicePrincipal ServicePrincipal @relation(fields: [servicePrincipalId], references: [id], onDelete: Restrict)
  subjectUser       User             @relation("DelegationSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  createdByUser     User             @relation("DelegationGrantCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedByUser     User?            @relation("DelegationGrantRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  permissions       DelegationGrantPermission[]
  receipts          IntegrationCommandReceipt[]

  @@index([servicePrincipalId, status])
  @@index([subjectUserId, status])
  @@index([endedAt])
  @@map("delegation_grants")
}

// 委托权限 allowlist(创建时锁定并复核 delegatedAccessAllowed=true —— PR5 运行时)。
model DelegationGrantPermission {
  id           String @id @default(cuid())
  grantId      String
  permissionId String

  grant      DelegationGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  permission Permission      @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([grantId, permissionId])
  @@index([permissionId])
  @@map("delegation_grant_permissions")
}

// 集成写命令幂等回执(规格书 §32/§38-39:同 SP+operation+key 唯一;业务与回执同事务)。
model IntegrationCommandReceipt {
  id                 String   @id @default(cuid())
  servicePrincipalId String
  credentialId       String
  delegationGrantId  String?
  subjectUserId      String?
  operation          String // 服务端固定常量,客户端不可传
  idempotencyKey     String
  requestHash        String
  resourceType       String?
  resourceId         String?
  responseSnapshot   Json? // 只存重放所需最小非敏感结果;禁 Token/Secret/完整 PII/signed URL
  createdAt          DateTime @default(now())
  completedAt        DateTime @default(now())

  servicePrincipal ServicePrincipal           @relation(fields: [servicePrincipalId], references: [id], onDelete: Restrict)
  credential       ServicePrincipalCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  delegationGrant  DelegationGrant?           @relation(fields: [delegationGrantId], references: [id], onDelete: Restrict)
  subjectUser      User?                      @relation("IntegrationReceiptSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)

  @@unique([servicePrincipalId, operation, idempotencyKey])
  @@index([credentialId])
  @@index([delegationGrantId])
  @@index([subjectUserId])
  @@index([createdAt])
  @@map("integration_command_receipts")
}

// 终态 scoped-authz PR6(2026-07-01;冻结稿 §3.6):RoleBinding 三枚举。
enum PrincipalType {
  USER
  MEMBER
  POSITION_ASSIGNMENT
  SERVICE_PRINCIPAL
  SYSTEM
}

// Integration Foundation v1 PR1(规格书 §27/§30;T0 冻结稿 §8)
enum ServicePrincipalStatus {
  ACTIVE
  SUSPENDED
}

enum DelegationGrantStatus {
  ACTIVE
  REVOKED
  SUSPENDED
}

enum BindingScopeType {
  GLOBAL
  ORGANIZATION
  ORGANIZATION_TREE
  ACTIVITY
  RESOURCE
  SELF
}

enum BindingStatus {
  ACTIVE
  ENDED
  SUSPENDED
}

// 终态 scoped-authz PR7「职务→角色 policy」(2026-07-01 goal;冻结稿 §3.7 / §2.4 BD-1/BD-3 / R5;序列 PR7/12)。
//
// **这是"职务不天然 = 管理员"的关键闸门:** 职务(§3.4 assignment)换算成什么角色、覆盖多大范围,
//   全在此显式声明、可审计、可调。**只为正职映射管理角色**(队长 team-leader / 部长 dept-leader →
//   org-admin;组长 group-leader → group-manager)。**本刀 goal 落地拍板**:合并冻结稿草案原提的
//   team-manager/dept-manager 二分为统一 org-admin(队长/部长合用一套业务面广角色),scope 相对
//   "任职组织"(TREE)天然区分 root(全组织)vs 非 root(本队/本部),无需 conditionJson 分流。
// **🔴 R5 安全红线 —— 副职默认不推导管理角色:** `vice-captain` / `dept-deputy` /
//   `deputy-group-leader` **零**本表行(seed 不写、CI 断言恒为 0)。副职实际管辖权只能来自
//   `OrganizationSupervisionAssignment`(分管)或显式 `RoleBinding`,绝不由头衔自动推导
//   (否则总队 6 名副队长各得近全组织管理 = goal 明禁的"部长=管理员")。`org-supervisor`
//   （分管推导用只读角色)**不是**本表映射目标 —— 它由 PR8 分管推导消费,不经职务 policy。
// **本表纯配置映射:只建 + seed 3 条(仅正职)+ CRUD 预留,绝不被任何判权路径读**
//   (职务→角色的动态推导消费方是 PR8 AuthzService;本刀 0 端点 / 0 新权限码 / 0 controller)。
model OrganizationPositionRolePolicy {
  id            String          @id @default(cuid())
  positionId    String
  roleId        String
  scopeMode     PolicyScopeMode @default(TREE) // 相对"任职所在组织"的 EXACT / TREE
  conditionJson Json? // 可选条件(本刀 seed 不用,留列位;如未来 { nodeTypeCode: 'functional-dept' })
  status        PolicyStatus    @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  position OrganizationPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)
  role     RbacRole             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([positionId, roleId])
  @@index([positionId])
  @@index([roleId])
  @@index([deletedAt])
  @@map("organization_position_role_policies")
}

// 终态 scoped-authz PR7(2026-07-01;冻结稿 §3.0):职务→角色映射的 scope 相对模式。
enum PolicyScopeMode {
  EXACT
  TREE
}

// ===== V2.x C-7 attachments 4 表(沿 D7 v1.0 §4 schema 草案) =====
//
// 段位 BizCode 130xx + 131xx(F5 锁;baseline §1.1 已预留)。
// attachments 是 0 → 1 接入 RBAC 的业务范本(F3:入口仅 JwtAuthGuard,
//   判权全部在 Service 层 rbac.can())。
// Permission code 正则已于 v1.2(PR #66)/ C-7 实施 PR #1(PR #70) 放宽至 3-4 段,
//   支持 attachment.upload.cert.self 等 4 段权限点(D7 v1.0 Q11)。
// 实施仅本 PR 落地 schema + migration + Certificate.attachmentKey drop column;
// service / controller / DTO / RBAC 集成 / audit 集成 / 配置三表 CRUD 已在 C-7 后续 PR 全部实装。
// 详见:
//   - docs/批次7_attachments_API前评审.md §4(schema 草案;v1.0 冻结稿)
//   - docs/批次7_attachments_V2x立项记录.md §二(立项内容)
//
// 设计选择(沿批次 1/2/3 B 路径):
// - 字段长度上限不落 @db.VarChar,由 DTO + class-validator 承担
// - 硬删除(D6 Q5 B):主表无 deletedAt;配置三表沿 baseline §2.1 软删
// - 多态外键(D6 Q4 A):ownerType + ownerId,无 DB FK,Service 层校验
// - tags = String[] PG 原生数组(Q3 v1.0;沿 MemberProfile.exerciseMethods 范式)
// - accessLevel hint + 索引(Q2 v1.0);RBAC 仍是单一权威源

model Attachment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // 沿 D6 Q5 B 硬删除:无 deletedAt

  // ===== 基础字段(D7 v1.0 §4.1) =====
  // V2.x C-7.5 PR(attachment_key_unique):key 加 @unique(沿评审 §8.4.4 + PR #91 已知偏差修复)
  // confirm-upload 二次提交:findFirst 串行早返 13001 + P2002 catch 并发兜底(双层防御)
  key          String   @unique // Provider 侧文件唯一引用;长度由 DTO @MaxLength(256);@unique 全局唯一
  // D-STORAGE-CONSISTENCY expand phase:新 binary 运行时强制同 tx 建立 StorageObject invariant；
  // 本期刻意不声明 relation/FK，以兼容 migration 后尚未退场的旧 writer。backfill gate=0 且
  // 新 binary 全量稳定后，另立 contract migration 加 Attachment.key -> StorageObject.key RESTRICT。
  originalName String // 原始文件名;长度由 DTO @MaxLength(255)
  mime         String // MIME 类型;长度由 DTO @MaxLength(128);走 attachment_mime_configs 白名单
  size         Int // 文件大小(字节);非负;走 attachment_size_limit_configs 上限
  uploadedBy   String // Q4 v1.0:User.id(沿 V2 createdBy / publishedBy 风格)
  uploadedAt   DateTime @default(now())

  // ===== 多态归属(D6 Q3 A + Q4 A;无 DB FK,Service 层校验) =====
  ownerType String // 归属业务对象类型;走 attachment_type_configs 白名单
  ownerId   String // 归属对象 cuid

  // ===== 额外字段(D6 Q2 全字段) =====
  checksum             String? // SHA-256(64 hex);本期不做 unique
  etag                 String? // Provider 侧版本号;本期仅存,不约束格式
  description          String? // 用户备注;长度由 DTO @MaxLength(500)
  accessLevel          AttachmentAccessLevel? // Q2 v1.0:hint + 索引;权限走 RBAC 单一权威
  tags                 String[] // Q3 v1.0:PG 原生数组;不建关联表
  originalUploaderName String? // 冗余存上传者人名;长度由 DTO @MaxLength(50)
  expireAt             DateTime? // 附件本身有效期;本期不做主动清理

  uploader User @relation("AttachmentUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)

  // 活动改造 v1.1 第 1 批第二刀(2026-08-04;合同 §3.12):file 型报名答案的反向 relation。
  // 仅关系映射,零标量字段;FK 在 RegistrationFormAnswer 侧,Restrict。
  registrationFormAnswers RegistrationFormAnswer[] @relation("RegistrationAnswerAttachment")

  // issue #1055 T1:视觉身份两条 1:1 反向 relation(仅关系映射,零标量字段;FK 在对侧,均 SetNull)。
  // 两边都是 `?` 而非数组 —— 对侧 FK 列带 @unique,一张附件至多被一处引用。
  // ⚠️ 这两个 ownerType(`user-avatar` / `member-official-portrait`)是 **internal-only**:
  // 通用 Admin Attachment 接口一律 fail-closed,只能走各自的专用 facade
  // (issue §12;执行位在 attachment-validation.ts 的 internal-only 集合)。
  avatarOfUser     User?                   @relation("UserAvatar")
  officialPortrait MemberOfficialPortrait? @relation("MemberOfficialPortraitAttachment")

  @@index([ownerType, ownerId]) // 业务查询主路径:列出某业务对象的所有附件
  // 第 79 migration(维护者 2026-08-07 按推荐拍板)另手写 partial unique:
  // ownerType='registration-upload-session' 时一个 ownerId 至多一条附件。Prisma DSL
  // 无法表达 WHERE predicate，故不新增 @@unique / @@index DSL；其它 ownerType 仍可多附件。
  @@index([uploadedBy])
  @@index([mime]) // 按 MIME 筛选(后台用)
  @@index([createdAt])
  @@index([accessLevel]) // Q2 v1.0:hint 索引保留
  @@map("attachments")
}

enum AttachmentAccessLevel {
  PUBLIC // 公开;沿 Q7 活动封面 / 培训资料
  INTERNAL // 内部;沿 Q7 活动现场照
  SENSITIVE // 敏感;沿 Q7 队员证件照
}

// Attachment namespace 的 durable provider-object ledger(D-STORAGE-CONSISTENCY Phase 1)。
// state/source 使用 String + migration CHECK，避免把恢复态扩展变成 PostgreSQL enum DDL；
// 运行时只允许 available 进入普通严格读取/签名。历史回填绝不直接写 available。
// provider locator 只保存非秘密定位信息；credential/signed URL/token 永不入表。
model StorageObject {
  id  String @id @default(cuid())
  key String @unique

  // DB CHECK 见 20260718233000；integrity_mismatch 表示已固定对象的确定性 size/etag 冲突，
  // JIT/STRICT 均不可读，只能走双人 manual relocate 恢复。
  state  String @default("pending_upload")
  source String

  providerType   StorageProviderType?
  bucket         String?
  region         String?
  localNamespace String?

  // Provider/storage_settings 的对象上限是 BigInt；现有 Attachment.size 仍是 Int，写 ledger 时
  // 显式 BigInt(size)。这样本期不改 API/DTO，同时 ledger 不把未来 >2 GiB provider metadata 截断。
  expectedSize BigInt?
  actualSize   BigInt?
  expectedMime String?
  actualMime   String?
  etag         String?
  checksum     String?

  // available 后指向 Attachment 聚合；未绑定上传必须保持 null，供 orphan-delete 安全门判断。
  resourceType String?
  resourceId   String?
  version      Int     @default(0)

  unboundExpiresAt      DateTime? @db.Timestamptz(3)
  lastProviderCheckedAt DateTime? @db.Timestamptz(3)
  verifiedAt            DateTime? @db.Timestamptz(3)
  presentAt             DateTime? @db.Timestamptz(3)
  deleteRequestedAt     DateTime? @db.Timestamptz(3)
  absentAt              DateTime? @db.Timestamptz(3)
  missingAt             DateTime? @db.Timestamptz(3)

  lastErrorCode  String?
  lastErrorClass String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  operations StorageObjectOperation[]

  @@index([state])
  @@index([source, state])
  @@index([resourceType, resourceId])
  @@index([unboundExpiresAt])
  @@index([createdAt])
  @@map("storage_objects")
}

// Durable operation ledger。eventKey 幂等；leaseOwner + leaseGeneration 是 fencing token。
// migration 的 partial unique 保证每个 object 同时至多一条 pending/processing operation。
model StorageObjectOperation {
  id              String  @id @default(cuid())
  eventKey        String  @unique
  storageObjectId String
  replayOfId      String?

  kind        String
  status      String @default("pending")
  effectState String @default("not_started")

  payloadVersion Int
  payload        Json
  requestHash    String

  attempts    Int      @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)

  leaseOwner      String?
  leaseGeneration Int       @default(0)
  leaseAcquiredAt DateTime? @db.Timestamptz(3)
  leaseRenewedAt  DateTime? @db.Timestamptz(3)
  leaseExpiresAt  DateTime? @db.Timestamptz(3)

  effectStartedAt   DateTime? @db.Timestamptz(3)
  effectCompletedAt DateTime? @db.Timestamptz(3)
  completedAt       DateTime? @db.Timestamptz(3)
  deadAt            DateTime? @db.Timestamptz(3)

  lastErrorCode  String?
  lastErrorClass String?

  responseSnapshotExpiresAt DateTime? @db.Timestamptz(3)
  responsePurgedAt          DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  storageObject StorageObject            @relation(fields: [storageObjectId], references: [id], onDelete: Restrict)
  replayOf      StorageObjectOperation?  @relation("StorageObjectOperationReplay", fields: [replayOfId], references: [id], onDelete: Restrict)
  replays       StorageObjectOperation[] @relation("StorageObjectOperationReplay")

  @@index([status, availableAt, leaseExpiresAt])
  @@index([storageObjectId, createdAt])
  @@index([kind, status])
  @@index([leaseExpiresAt])
  @@index([responseSnapshotExpiresAt, responsePurgedAt])
  @@index([createdAt])
  @@map("storage_object_operations")
}

model AttachmentTypeConfig {
  id                   String                     @id @default(cuid())
  code                 String                     @unique // ownerType code;如 'member' / 'certificate' / 'activity'
  displayName          String // 后台 UI 显示名
  description          String?
  // ===== 关联业务表名(用于 Service 层 ownerId 真实性校验) =====
  ownerTable           String // 业务表名小写;如 'member' / 'certificate' / 'activity'
  // ===== 默认配置(覆盖至 mime / size 表为空时的兜底) =====
  defaultMaxSizeBytes  Int? // 默认单文件大小上限;null 走全局兜底
  defaultMimeWhitelist String[] // 默认允许 MIME 列表
  // ===== 启停(沿 baseline §2.2.3) =====
  status               AttachmentTypeConfigStatus @default(ACTIVE)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  deletedAt            DateTime? // 沿 baseline §2.1 软删

  mimeOverrides AttachmentMimeConfig[]
  sizeOverrides AttachmentSizeLimitConfig[]

  @@index([status])
  @@index([deletedAt])
  @@map("attachment_type_configs")
}

enum AttachmentTypeConfigStatus {
  ACTIVE
  INACTIVE
}

model AttachmentMimeConfig {
  id           String                     @id @default(cuid())
  typeConfigId String
  mime         String // 如 'image/jpeg' / 'application/pdf'
  status       AttachmentMimeConfigStatus @default(ACTIVE)
  remark       String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  deletedAt    DateTime?

  typeConfig AttachmentTypeConfig @relation(fields: [typeConfigId], references: [id], onDelete: Restrict)

  @@unique([typeConfigId, mime]) // 同一 type 下 mime 不重复
  @@index([typeConfigId])
  @@index([status])
  @@index([deletedAt])
  @@map("attachment_mime_configs")
}

enum AttachmentMimeConfigStatus {
  ACTIVE
  INACTIVE
}

model AttachmentSizeLimitConfig {
  id           String    @id @default(cuid())
  typeConfigId String    @unique // 1:1 with AttachmentTypeConfig(每 type 至多一条 override)
  maxSizeBytes Int // 覆盖 AttachmentTypeConfig.defaultMaxSizeBytes
  remark       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  typeConfig AttachmentTypeConfig @relation(fields: [typeConfigId], references: [id], onDelete: Restrict)

  @@index([deletedAt])
  @@map("attachment_size_limit_configs")
}

// =============================================================================
// V2.x C-7.5 Provider 选型实施 PR #6:storage_settings(沿 §6.5.2 + Q24)
//
// 单条记录(singleton row);系统级 Provider 配置;沿 Q4 锁腾讯 COS + Q18 单 bucket。
// 一次设计 15+ 字段;首期允许部分字段闲置(`null`);**严禁未来推翻 schema**。
// 加密字段 `secretIdEncrypted` / `secretKeyEncrypted` 由 StorageCryptoService 处理;
// 明文永不入库(沿 Q21 / Q22)。
// singleton 由第 49 migration 的 unique index on constant((true)) 在 DB 层强制;
// Prisma schema DSL 无法表达 expression index,故此处仅保留注释,不可误删 migration 索引。
// =============================================================================
model StorageSettings {
  id String @id @default(cuid())

  // Provider 选型(沿 Q4)
  providerType StorageProviderType
  enabled      Boolean             @default(true)

  // 运行参数(沿 Q11 / Q17 / Q18 / Q20)
  bucket                String?
  region                String?
  envPrefix             String?
  uploadUrlTtlSeconds   Int     @default(600)
  downloadUrlTtlSeconds Int     @default(300)
  lifecycleDays         Int     @default(30)

  // 能力开关(允许闲置;首期默认 true)
  enableSignedUrl  Boolean @default(true)
  enableVersioning Boolean @default(true)

  // CORS / 大小 / MIME 策略(沿 §6.5.3)
  corsAllowedOrigins    Json? // 首期闲置;运维 SOP 维护 COS bucket 侧
  maxObjectSizeBytes    BigInt? // 首期闲置;由 attachment_size_limit_configs 管业务侧
  allowedMimePolicyMode StorageMimePolicyMode @default(INHERIT) // 沿 Q-87-1 锁:首期固定 INHERIT

  // 凭证(加密存储;沿 Q21 / Q22)
  // 实际加密 = AES-256-GCM(沿 §6.6.1 + 立项记录 §四;Node 原生 crypto;0 新依赖)
  secretIdEncrypted    String? // 加密后的密文;明文永不入库
  secretKeyEncrypted   String? // 同上
  credentialConfigured Boolean @default(false) // DB 层简单事实;运行时 credentialStatus 三态由 Service 合成

  // 元信息
  remarks   String?
  updatedBy String? // User.id;沿 V2 范式;不建外键(沿 v1 软删 / RBAC 范式)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("storage_settings")
}

enum StorageProviderType {
  LOCAL
  COS
}

enum StorageMimePolicyMode {
  INHERIT // 沿 attachment_mime_configs(默认;首期锁定)
  OVERRIDE // 由 storage_settings 直接限定;留 v1.1+ 启用
}

// ===== V2.x P0-E PR-3 refresh_tokens 表 =====
//
// 沿 docs/first-release-p0e-refresh-token-review.md §5.2 schema 草案。
// rotation always + family revoke + absolute expiration(90d 不滑动);
// refresh token 明文绝不入库,只存 sha256 hash(沿 §5.1)。
//
// 撤销路径:
//   - rotation        → revokedReason='rotated' + replacedById 指向新 token
//   - logout          → revokedReason='logout'(只杀当前 row)
//   - logout-all      → revokedReason='logout'(updateMany where userId)
//   - 重放命中         → revokedReason='family-revoked'(updateMany where familyId)
//   - 改密 / 重置      → revokedReason='self-password-change' / 'admin-password-reset'
//   - 禁用 / 软删       → revokedReason='admin-disable' / 'admin-delete'
//
// revokedReason 不上 Prisma enum(沿 audit event 字符串风格;允许后续扩展不破坏 migration)。
// ipFirstSeen / uaFirstSeen 仅供审计,不出对外 API(沿 v1 §10 信息泄漏防御)。
model RefreshToken {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique // sha256(rawRefresh) hex 64 字符
  familyId      String // 同一登录链 rotation 串关联 id;login 时 cuid() 生成,rotation 继承
  expiresAt     DateTime // 绝对过期时刻;rotation 继承原 family 首个 token 的 expiresAt(不延长)
  createdAt     DateTime  @default(now())
  rotatedAt     DateTime? // 被 rotation 替换的时间
  revokedAt     DateTime? // 撤销时间;null = 仍有效
  revokedReason String? // 撤销原因(字符串枚举)
  replacedById  String?   @unique // rotation 后产生的新 token id
  ipFirstSeen   String? // 仅供审计;login 时写入,不对外
  uaFirstSeen   String? // 仅供审计;login 时写入,不对外

  user       User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  replacedBy RefreshToken? @relation("ReplacedBy", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("ReplacedBy")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

// =============================================================================
// ===== SMS 基础设施 T1(2026-06-10)三表 + 三 enum =====
//
// 沿评审稿 docs/archive/reviews/sms-verification-infra-review.md §3.1(冻结文本;
// 维护者 2026-06-10 goal 拍板)。一次设计,允许部分字段首期闲置(null);严禁未来推翻 schema。
// - sms_settings 镜像 StorageSettings 范式:singleton 由第 49 migration 的
//   unique index on constant((true)) 在 DB 层强制(Prisma schema DSL 无法表达 expression index);
//   凭证 AES-256-GCM 加密(SmsCryptoService,T2),明文永不入库。
// - sms_verification_codes:明文验证码永不入库,只存
//   HMAC-SHA256(scrypt(SMS_ENCRYPTION_KEY,独立 salt),phone:purpose:code) hex(第七刀 F2);
//   同 phone+purpose 单活码由 supersededAt 实现(E-9);userId / codeId 不建外键(E-28)。
// - sms_send_logs:append-only 发送留痕,无更新/删除路径;响应层手机号一律掩码(E-20/E-21)。
// - retention:两表本期不清理,待办挂 NEXT_TASKS P2-6。
// =============================================================================
model SmsSettings {
  id String @id @default(cuid())

  // 通道选型(评审稿 D-SMS-2;production-like 禁 DEV_STUB,写入与运行时双重校验,E-15)
  providerType SmsProviderType
  enabled      Boolean         @default(true)

  // 腾讯云 SMS 运行参数(非 secret,明文;DEV_STUB 下闲置)
  sdkAppId               String?
  signName               String? // 短信签名(须先过审;运维 SOP 见 docs/ops/sms-production-rollout-checklist.md)
  region                 String? // 如 ap-guangzhou
  templateIdVerifyCode   String? // 验证码模板 ID(须先过审;templateKey='verify-code' 的 provider 侧映射)
  templateIdBirthday     String? // 生日祝福模板 ID(须先过审,零变量模板;templateKey='birthday-greeting' 的 provider 侧映射;queue-b 评审稿 §6.2)
  templateIdNotification String? // 通知兜底模板 ID(须先过审,零变量模板;templateKey='notification' 的 provider 侧映射;统一通知 S5 评审稿 §4)

  // 凭证(加密存储;明文永不入库;响应永不回显——密文也不回显)
  secretIdEncrypted    String?
  secretKeyEncrypted   String?
  credentialConfigured Boolean @default(false) // DB 层简单事实;运行时 credentialStatus 三态由 Service 合成

  // 元信息(沿 StorageSettings 范式;updatedBy 不建外键)
  remarks   String?
  updatedBy String? // User.id
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("sms_settings")
}

enum SmsProviderType {
  DEV_STUB // 非生产联调通道:固定码 888888 + debug 日志(评审稿 E-29;production-like 不可达)
  TENCENT_SMS
}

model SmsVerificationCode {
  id String @id @default(cuid())

  phone    String
  purpose  SmsPurpose
  codeHash String // HMAC-SHA256(pepper, phone:purpose:code) hex;明文码/pepper 永不入库
  userId   String? // 签发归属用户;PHONE_BIND=当前登录用户,PASSWORD_RESET=按 phone 解析的目标用户(password-reset 评审稿 E-7);字段可空留未来消费者;不建外键

  expiresAt    DateTime // 签发 +5min(常量,T3)
  consumedAt   DateTime? // 验证成功即消费
  supersededAt DateTime? // 同 phone+purpose 新码签发时旧码作废
  attempts     Int       @default(0) // 错误尝试计数;≥5 作废(统一 SMS_CODE_INVALID,防枚举)
  ip           String? // 签发请求 IP(防刷取证)
  createdAt    DateTime  @default(now())

  // 单活码定位 + 间隔/日限按 phone 前缀查询(评审稿 §3.1)
  @@index([phone, purpose])
  @@map("sms_verification_codes")
}

enum SmsPurpose {
  PHONE_BIND // 手机号绑定 / 换绑(登录态;sms-verification-infra 评审稿)
  PASSWORD_RESET // 找回密码(pre-auth;password-reset-by-sms 评审稿 §3.1)
  LOGIN // OTP 验证码登录(pre-auth;queue-b 评审稿 §5.1;通知用途不占 purpose——生日批走 send_logs.templateKey)
  WECHAT_BIND // 微信 openid 绑定锚点(pre-auth;wechat-mini-login 评审稿 D-W1)
  RECRUITMENT_BIND // H5 招新报名前手机身份链(pre-auth 匿名;recruitment-phase4 评审稿 §3.2 E-P4-3;userId 形参放宽 null,E-P4-4)
  IDENTITY_STEP_UP // 当前绑定手机号作为高危身份换绑的 step-up 因子(identity-session P0 PR1)
  WECOM_BIND // 企业微信未绑定登录时以手机号锚定到已有 User 的 pre-auth 短信用途(wecom T0 冻结稿 §0.2 第 3 条)
}

model SmsSendLog {
  id String @id @default(cuid())

  phone        String // 明文存储(对账需要);响应层一律掩码 138****1234
  templateKey  String // 逻辑模板键:'verify-code'(E-22)/ 'birthday-greeting'(B 队列 F5 生日批,2026-06-11);均非 provider 模板 ID
  providerType SmsProviderType
  status       SmsSendStatus

  providerMsgId String? // provider 回执 ID
  errCode       String? // 失败时 provider 错误码(不含 secret)
  errMsg        String? // 失败时 provider 错误信息(不含 secret)
  codeId        String? // 关联 sms_verification_codes.id;不建外键(retention 清理不受 FK 牵制)

  createdAt DateTime @default(now())

  // 按号排错 + 列表查询
  @@index([phone, createdAt])
  @@map("sms_send_logs")
}

enum SmsSendStatus {
  SENT
  FAILED
}

// =========================================================================
// 微信小程序登录基础设施 T1(2026-06-12;冻结评审稿
// docs/archive/reviews/wechat-mini-login-review.md §3.1,镜像 SmsSettings 范式)
//
// 凭证单例表(singleton 由第 49 migration 的 unique index on constant((true)) 在 DB 层强制;
// Prisma schema DSL 无法表达 expression index,E-3 的 Service WARN/取最早旧策略已退役);
// 与 SmsSettings 的差异:凭证仅 appSecret **一段**加密(SMS 是 secretId+secretKey 两段);
// 无 send-logs 对应物(code2session 免费查询类 API,无资费无触达,E-8)。
// =========================================================================

model WechatSettings {
  id String @id @default(cuid())

  // 通道选型(评审稿 E-6/E-10;production-like 禁 DEV_STUB,写入与运行时双重校验)
  providerType WechatProviderType
  enabled      Boolean            @default(true)

  // 小程序运行参数(非 secret,明文;DEV_STUB 下闲置;镜像 sdkAppId 地位)
  appId String?

  // 凭证(加密存储;明文永不入库;响应永不回显——密文也不回显;L3)
  appSecretEncrypted   String?
  credentialConfigured Boolean @default(false) // DB 层简单事实;运行时 credentialStatus 三态由 Service 合成

  // 元信息(沿 SmsSettings 范式;updatedBy 不建外键)
  remarks   String?
  updatedBy String? // User.id
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("wechat_settings")
}

enum WechatProviderType {
  DEV_STUB // 非生产联调通道:确定性假 openid dev-openid-<code>(评审稿 E-10;production-like 不可达)
  WECHAT
}

// =============================================================================
// ===== 保险模块 T1(2026-06-13)三表 + Activity.requiresInsurance =====
//
// 沿冻结评审稿 docs/archive/reviews/insurance-module-review.md §3.1(maintainer
// 2026-06-12 goal「保险模块」拍板)。业务依据:报名"无保险信息不予通过" + 志愿者
// 自购 + 队统一买(需求 :687/:698/:422/:452 + 顶层设计 §8 + C015)。
// - member_insurances:自购保险,每队员多条,App 自助 CRUD(self-scope 不接 RBAC);
//   coverageEnd 是有效性唯一依据(D-INS-5,自报即可 v1 无核验);policyNumber 无唯一约束(E-2)。
// - team_insurance_policies:队统一保单,一张 = 一条,admin CRUD;软删不级联覆盖行
//   (门槛查询 join p.deletedAt IS NULL,被删保单下覆盖行自然失效,E-4)。
// - team_insurance_coverages:保单 × 队员 join;partial unique (policyId, memberId)
//   WHERE "deletedAt" IS NULL 由 migration.sql 末尾手写(E-3,沿 activity_registrations 范式);
//   service 用 P2002 兜底转 26004。
// - 字段长度上限不落 @db.VarChar,由 DTO + class-validator 承担(沿批次 1/2/3 B 路径)。
// - 保单图不占 schema 字段:attachments 多态(ownerType + ownerId)天然支持,
//   接线(enum 分支 + 8 权限码)挂 NEXT_TASKS 单独立项(E-20)。
// =============================================================================

model MemberInsurance {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberId         String
  insurerName      String // 保险公司;长度 128 由 DTO 约束(沿 Certificate.issuingOrg 范式)
  policyNumber     String // 保单号;长度 128 由 DTO 约束(沿 certNumber;无唯一约束,E-2)
  coverageStart    DateTime? // 起保日(可选;有值时门槛校验 coverageStart <= 活动 startAt,E-11)
  coverageEnd      DateTime // 到期时间(必填;有效性唯一依据,D-INS-5)
  expireNotifiedAt DateTime? // v0.47.0 到期提醒幂等 marker;首次命中 30 天窗口后置 now,不因改期自动清空

  // D-INSURANCE v3 PR4 final。legacy(含软删)仍沿 PR1 统一 pending/v0，不推断 verified；
  // version 非负且 pending/reviewed snapshot 组合由 migration CHECK 兜底。
  reviewStatusCode String    @default("pending") // pending / verified / rejected
  version          Int       @default(0)
  reviewedByUserId String?
  reviewedAt       DateTime?

  member                        Member                         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  reviewer                      User?                          @relation("MemberInsuranceReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  insuranceEligibilityEvidences InsuranceEligibilityEvidence[]

  @@index([memberId])
  @@index([reviewStatusCode])
  @@index([reviewedByUserId])
  @@index([coverageEnd])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("member_insurances")
}

model TeamInsurancePolicy {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  insurerName      String // 保险公司;长度 128 由 DTO 约束
  policyNumber     String // 保单号;长度 128 由 DTO 约束
  coverageStart    DateTime // 起保(必填,goal ②)
  coverageEnd      DateTime // 到期
  expireNotifiedAt DateTime? // v0.47.0 管理面到期提醒幂等 marker;首次命中 30 天窗口后置 now
  note             String? // 备注;长度 500 由 DTO 约束

  coverages TeamInsuranceCoverage[]

  @@index([coverageEnd])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("team_insurance_policies")
}

model TeamInsuranceCoverage {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  policyId String
  memberId String

  policy                        TeamInsurancePolicy            @relation(fields: [policyId], references: [id], onDelete: Restrict)
  member                        Member                         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  insuranceEligibilityEvidences InsuranceEligibilityEvidence[]

  // 业务唯一约束(partial unique;E-3):
  // - (policyId, memberId) WHERE "deletedAt" IS NULL
  // - 索引名 team_insurance_coverages_policy_member_active_unique
  // - Prisma DSL 不支持带 WHERE,migration.sql 末尾手动追加(沿 ActivityRegistration 范式)
  @@index([policyId])
  @@index([memberId])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("team_insurance_coverages")
}

// D-INSURANCE v3 PR4 final evidence model.
// exactly-one、kind 对齐、区间、审核快照、跨 member、全局单 owner 与 immutable
// 约束定义于 20260719160335_insurance_constraints migration，deploy 后才在 DB 生效；
// Prisma DSL 仅表达最终必填列与关系，CHECK/partial unique/trigger 以 migration source 为准。
// 本表刻意不含 updatedAt/deletedAt，也不存保单号、图片/附件/key/URL 或自由文本。
model InsuranceEligibilityEvidence {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  sourceKind                     String
  memberInsuranceId              String?
  teamInsuranceCoverageId        String?
  ownerKind                      String
  activityRegistrationId         String?
  // 第 82 migration:旧 header-only evidence 永久保持 NULL；新 writer 才会绑定
  // 当次不可变报名修订。与 activityRegistrationId 组成复合 FK，DB 保证同头。
  activityRegistrationRevisionId String?
  teamJoinApplicationId          String?
  sourceRevision                 Int?
  sourceReviewedByUserId         String?
  sourceReviewedAt               DateTime?
  requiredFrom                   DateTime
  requiredThrough                DateTime
  sourceCoverageStart            DateTime?
  sourceCoverageEnd              DateTime

  memberInsurance              MemberInsurance?              @relation(fields: [memberInsuranceId], references: [id], onDelete: Restrict)
  teamInsuranceCoverage        TeamInsuranceCoverage?        @relation(fields: [teamInsuranceCoverageId], references: [id], onDelete: Restrict)
  activityRegistration         ActivityRegistration?         @relation(fields: [activityRegistrationId], references: [id], onDelete: Restrict)
  activityRegistrationRevision ActivityRegistrationRevision? @relation("InsuranceEvidenceRegistrationRevision", fields: [activityRegistrationId, activityRegistrationRevisionId], references: [registrationId, id], onDelete: Restrict, onUpdate: Restrict, map: "insurance_evidence_registration_revision_same_head_fkey")
  teamJoinApplication          TeamJoinApplication?          @relation(fields: [teamJoinApplicationId], references: [id], onDelete: Restrict)
  sourceReviewer               User?                         @relation("InsuranceEvidenceSourceReviewer", fields: [sourceReviewedByUserId], references: [id], onDelete: Restrict)

  @@index([memberInsuranceId])
  @@index([teamInsuranceCoverageId])
  @@index([activityRegistrationId])
  @@index([teamJoinApplicationId])
  @@index([sourceReviewedByUserId])
  @@index([createdAt])
  @@map("insurance_eligibility_evidences")
}

// =============================================================================
// ===== 招新一期(招新前段)T1(2026-06-18)3 表 + RealnameProviderType enum =====
//
// 沿冻结评审稿 docs/archive/reviews/recruitment-phase1-review.md §3.1(maintainer
// 2026-06-18 goal「招新一期(招新前段)」拍板 + §0.5 四分叉元核验冻结 + 3 配套)。
// 业务依据:招新需求会(讨论稿 v1 + 技术就绪度对照 v1)。报名者不建 User / 不进 members,
// 身份全由 recruitment_applications 承载,临时编号绑报名记录、永不进 members(D-R-1)。
// - recruitment_cycles:招新轮次,后台开/关 + 容量(可临时增容)+ tempNoSeq 临时编号原子
//   计数器(发号时 update +1,行级自增天然串行,E-R-9)+ 通知配置(后填,E-R-17)。
// - recruitment_applications:报名记录;openid 锚点(code2session 复用,E-R-7);敏感资料
//   (留存 SOP 30 天后 NULL 化 + 按 idCardImageKey 删 storage blob,配套②)与脱敏留存字段
//   (永久行级)共存(D-R-7 / E-R-14);statusCode String 沿 activity_registrations 范式(4 态);
//   tempNo 仅 verified 有值、≠ memberNo;**仅 FK→cycle(无 Member FK,D-R-1 的 schema 保证)**。
//   partial unique ×2 由 migration.sql 末尾手写(E-R-9/10,Prisma DSL 不支持带 WHERE)。
// - realname_verification_settings:实名核验单例,镜像 SmsSettings;凭证两段(secretId+
//   secretKey)AES-256-GCM(RealnameCryptoService,T2)明文永不入库;singleton 由 Service 保证。
// - 字段长度上限不落 @db.VarChar,由 DTO + class-validator 承担(沿近期惯例)。
// =============================================================================

model RecruitmentCycle {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  year        Int // 招新年份(临时编号 T{year}{seq} 的 year)
  name        String // 轮次名(如「2026 年度招新」);长度由 DTO 约束
  statusCode  String // open / closed(后台开关;String 沿 activity_registrations.statusCode 范式)
  capacity    Int? // 容量上限(可临时增容;null=不限)
  tempNoSeq   Int       @default(0) // 临时编号原子计数器(发号时 update +1,E-R-9)
  // 招新二期(2026-06-19,评审稿 recruitment-phase2-review.md E-R2-6):永久编号当年流水原子计数器
  // (批量 promote 单事务内 +N,镜像 tempNoSeq 行级自增);{YY}{NNN} 的 NNN。
  memberNoSeq Int       @default(0)
  openedAt    DateTime?
  closedAt    DateTime?

  // 通知配置(后填;小程序展示 + 可选短信文案;E-R-17)
  meetingInfo    String? // 见面会信息
  qqGroup        String? // QQ 群
  notifyTemplate Json? // 可配置通知模板(各节点文案)

  applications     RecruitmentApplication[]
  identitySessions RecruitmentIdentitySession[]

  // 业务唯一约束(partial unique;migration.sql 手写,Prisma DSL 不支持带 WHERE;十项收口刀B):
  // - recruitment_cycles_single_open_unique ON ("statusCode")
  //   WHERE "statusCode" = 'open' AND "deletedAt" IS NULL —— 至多一个 open 轮 DB 兜底
  //   (开轮 count-then-update 在 READ COMMITTED 下可并发穿透);service P2002 兜底转 28032
  @@index([year])
  @@index([statusCode])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("recruitment_cycles")
}

model RecruitmentApplication {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cycleId    String
  statusCode String // pending_verification / verified / manual_review / rejected
  tempNo     String? // 临时编号 T{year}{seq};仅 verified 有值;≠ memberNo(永不进 members)

  openid String? // 微信 openid(code2session;再查询 + 同轮去重次级键;掩码回显)

  // ===== 敏感资料(留存 SOP:rejected 或 本轮 closed 满 30 天后 NULL 化 + 按 idCardImageKey 删 blob)=====
  realName          String?
  idCardNumber      String? // 身份证号(高敏感;同轮去重键;留存清)
  birthDate         DateTime? // 精确生日(从身份证号提取;留存清)
  phone             String? // 手机(仅通知联系方式,非身份证据,配套③;留存清)
  detailedAddress   String? // 详细住址(留存清)
  idCardImageKey    String? // 证件照 storage key(分叉③A;留存按 key 删 storage blob)
  emergencyContacts Json? // 紧急联系人 ≥2:[{name, relation, phone}](留存清)
  profileExtra      Json? // 其余报名字段(Q7 精简后冻结,本期最小;留存清)
  // 招新可用性收口 F5(2026-07-11;评审稿 §2.8 R5;第 42 migration,全 additive 可空):
  // 签名图 = 责任文件——promote 搬 member_profiles.signatureImageKey 长期留存 + 报名行清空
  // (镜像 idCardImageKey 搬运范式);未发号(rejected/withdrawn)行的 blob 随既有留存 SOP 按 key 删。
  signatureImageKey String? // 申请人签名图 storage key(multipart 必填文件位 signatureImage;存量可为 null)
  // 证书标准库 PR-4b(第 67 migration,contract):三个证书 JSON 列**已 DROP**
  // (certificateImages / certificateReviewStatus / certificateIssuanceInfo)。
  // 它们是「按类别一格」时代的产物 —— 结构上表达不了同类别多张证书,
  // 也做不到单证重传与单证审核。取代者是下面的 `certificateClaims` 关系(一证一行)。
  // PR-4a-2 已停写(申请人侧唯一写者 uploadCertificateImages 随旧端点删除)。

  // ===== 脱敏留存字段(永久行级保留)=====
  documentTypeCode String // 证件类型(判非大陆证件/人工核验;非高敏)
  isForeigner      Boolean @default(false) // 历史 DB 列:非大陆证件(不代表国籍;列改名另行挂账)
  genderCode       String?
  ageGroup         String? // 年龄段(提交时从生日派生)
  cityDistrict     String? // 城市到区(提交时从住址派生)
  sourceChannel    String? // 来源渠道
  eliminationStage String? // 淘汰环节(rejected 时记)

  // 核验 / 人工记账
  verifiedAt        DateTime?
  verifyOutcome     String? // matched / mismatch / manual / skipped
  reviewedByUserId  String? // 人工 resolve 操作人(admin;不建外键,沿 SmsSettings.updatedBy)
  reviewedAt        DateTime?
  reviewNote        String?
  sensitivePurgedAt DateTime? // 留存清理(字段 NULL + blob 删)执行时刻

  // 业务唯一约束(partial unique;migration.sql 手写,Prisma DSL 不支持带 WHERE):
  // - (cycleId,idCardNumber/openid/phone) 各自 WHERE deletedAt IS NULL AND
  //   statusCode NOT IN ('rejected','withdrawn') AND 身份列 IS NOT NULL —— 同轮每个身份键至多
  //   一条活跃报名；service 预检负责友好失败，DB 约束兜底并发穿透后按 target 分流 28003/28004/28005。

  // 招新可用性收口 F5(2026-07-11;评审稿 §2.8;第 42 migration,全 additive 可空):
  // 知情同意留痕——submit 必填 privacyConsentAccepted=true(⚠️ 契约收紧)落时间戳 + 前端传版本号;
  // promote 的 member_profiles.privacyConsentSigned 由硬编码 true 改搬真值(acceptedAt != null)。
  // 本组为脱敏留存字段(非 PII,永久行级保留,不随留存 SOP 清)。
  privacyConsentAcceptedAt DateTime? // 勾选知情同意的时刻(submit 落 now;存量历史行 null)
  privacyConsentVersion    String? // 同意文本版本号(前端传,如 '2026-07';后端只存不校验内容)

  // ===== 招新二期(后段;2026-06-19,评审稿 recruitment-phase2-review.md)=====
  // 状态机扩展为 +3 String 态(pending_evaluation / publicity / promoted),沿 statusCode String 范式无 migration;
  // eliminationStage +2 值(evaluation / threshold-timeout)。以下为新增列(全可空,纯加列无破坏):
  thresholdMarks    Json? // 门槛标记(M-3 / E-R2-2):{ patrol1:{at,by}, patrol2, training, redCross, bsafe };仅 verified/pending_evaluation 态可标
  evaluatedByUserId String? // 综合评定操作人(不建外键,沿 reviewedByUserId / SmsSettings.updatedBy)
  evaluatedAt       DateTime?
  evaluationNote    String? // 综合评定备注(D-R2-3)
  promotedMemberId  String? // 报名→Member 链(E-R2-8;不建外键,保 phase-1 D-R-1「报名行无 Member FK」字面)

  // ===== 招新四期 S4a(H5 + 手机身份链;2026-06-24,评审稿 recruitment-phase4-loop-optimization-review.md §3.4)=====
  // 手机号上调为身份链锚(原仅通知用途);以下全可空、纯加列无破坏。phone 明文仍存 phone 列(留存清),
  // 本组为身份链元数据:验证方式 / 换绑轨迹 / 风险标记。掩码三不:audit/日志/snapshot 不出明文手机。
  phoneVerifiedAt         DateTime? // H5 验码成功时刻(小程序链恒 null);submit/rebind-phone 落
  phoneVerificationMethod String? // sms(H5 验码)/ wechat(小程序辅);提交时落
  phoneChangedAt          DateTime? // 自助换手机换绑时刻(rebind-phone)
  phoneChangeReason       String? // 换手机原因(自由短串,可含 PII;rebind-phone;留存/promote 清——十项收口刀C)
  phoneBindingHistory     Json? // 换绑历史追加 [{from,to,at,reason,method}](rebind-phone;DB 内可存明文,沿 phone 列同敏感级;留存/promote 清——十项收口刀C)
  phoneRiskFlag           String? // 风险标记(后台解绑纠错切片用;本刀仅建列不写)

  // ===== 招新四期 S4b(OCR 六分流 + 重拍计数;2026-06-24,评审稿 recruitment-phase4-loop-optimization-review.md §2)=====
  // 把现「5 分支全塞 manual_review」拆为六分流;以下 4 列全 additive(可空/有默认,纯加列无破坏,无 enum)。
  // verifyOutcome(机器判定原因,既有)保留并复用;manualReviewReason(后台人工队列分类)+ riskLevel(三栏分流)并存(§2.2 E-P4-2)。
  // 重拍计数落 §3 报名前身份会话行(recruitment_identity_sessions,Q-P4-1);submit 落库时把会话行最近 OCR 结论快照进 lastOcrOutcome。
  manualReviewReason         String? // 后台人工原因分类:ocr_mismatch_confirmed / forgery_suspected / system_ocr_error / special_document(§2.2/§2.4)
  riskLevel                  String? // 复核风险级:normal / high(防伪/篡改)/ system(上游异常)——驱动后台三栏(§2.4);**申请人侧不暴露**
  applicantConfirmedOcrWrong Boolean @default(false) // mismatch 三选一之③:申请人确认 OCR 错、坚持填写为准 → 落普通人工(§2.1)
  lastOcrOutcome             String? // 最近一次 OCR 结论快照(= 某 verifyOutcome 值;submit 落库时从会话行结转,§2.2/§2.3)

  // ===== OCR 鉴伪版充分利用(2026-06-29,评审稿 recruitment-ocr-anti-forgery-enrichment-review.md §3.1/§4)=====
  // 仅 mainland_id RecognizeValidIDCardOCR 充分利用:扩展字段入库 + 主体/头像裁剪图入库。以下 6 列全 additive
  // (可空,纯加列无破坏,无 enum、无默认、无回填)。OCR 读取值 = **顾问式存档,非权威**;gender/birth 仍由身份证号
  // 推导(genderCode/birthDate),本组**不参与**派生、OCR 的 Sex/Birth 仅 recognize 回显不持久。住址为高敏感 PII,
  // 与 idCardNumber 同级、纳入 read.sensitive 门控(masked→null)。裁剪图仅 submit 解码入库,base64 不入响应/日志(L3)。
  // 十项收口刀C(2026-07-11):本组 6 列 promote 时即时清(OCR 4 列置 NULL;主体裁剪图先删 blob 再清 key;
  // 头像裁剪图搬 User.avatarKey 后清 key)——promote 置 sensitivePurgedAt 会使留存 SOP 永久跳过该行,漏清即永久残留。
  ocrAddress             String? // OCR 住址(顾问式存档;≠ applicant 自填 detailedAddress;高敏感,read.sensitive 门控;留存/promote 清)
  ocrNation              String? // OCR 民族(民族属敏感个人信息;留存/promote 清)
  ocrAuthority           String? // OCR 签发机关(留存/promote 清)
  ocrValidDate           String? // OCR 有效期(腾讯返串,如 2010.07.21-2020.07.21 / 2010.07.21-长期;不解析 DateTime;留存/promote 清)
  idCardCropImageKey     String? // 主体框裁剪图 storage key(CardImage;后台人工复核查看;留存/promote 按 key 删 blob 后清)
  idCardPortraitImageKey String? // 头像裁剪图 storage key(PortraitImage;十项收口刀E:promote 搬 User.avatarKey 设为队员头像,同一 blob 属主转 user、本列清空;未发号行留存按 key 删 blob)

  cycle RecruitmentCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  // 证书标准库 PR-2(§5.5 结尾):一张真实证书一条 Claim 的反向数组。
  // 冻结稿 §26 铁律 11 要求关系双向完整、每个 PR 都能 prisma generate,不许只写单边。
  // 上面三个证书 JSON 列(certificateImages / certificateReviewStatus /
  // certificateIssuanceInfo)在 PR-4a 停写、PR-4b DROP,由本关系取代。
  certificateClaims RecruitmentCertificateClaim[]

  // 业务唯一约束(partial unique;migration.sql 末尾手写,E-R-9/10;Prisma DSL 不支持带 WHERE):
  // - recruitment_applications_cycle_idcard_active_unique ON (cycleId, idCardNumber)
  //   WHERE "deletedAt" IS NULL AND "statusCode" NOT IN ('rejected','withdrawn') —— 防重复报名
  //   (同轮同人),允许 rejected / withdrawn(F6 自助撤销,R4)后同轮重试;service P2002 兜底转
  //   28003(沿 activity_registrations 范式;排除集 F6 第 43 migration 重建)
  // - recruitment_applications_cycle_tempno_unique ON (cycleId, tempNo)
  //   WHERE "tempNo" IS NOT NULL —— 临时编号同轮唯一(配合 tempNoSeq 原子自增兜底并发)
  @@index([cycleId])
  @@index([statusCode])
  @@index([openid])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("recruitment_applications")
}

// 招新四期 S4a(H5 + 手机身份链;2026-06-24,评审稿 recruitment-phase4-loop-optimization-review.md §3.3 / E-P4-5)。
// 报名前身份会话行(净新建):承载「H5 验码 → 短时一次性 token → 提交」的有时间差身份链。
// **不进 recruitment_applications,不参与去重/统计/容量**;TTL 过期由留存 SOP 清(expiresAt 索引)。
// 临时凭证(沿 sms_verification_codes / refresh_tokens 范式):token 入库只存 sha256 hex,
// consumedAt 标一次性消费(非 deletedAt 软删);明文 token 仅验码响应一次性返客户端,永不入库/日志。
// ocrAttemptCount/lastOcrOutcome/requiresRetake 为 S4b(OCR 六分流重拍计数)**预建列,本刀不写逻辑**(Q-P4-1)。
model RecruitmentIdentitySession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime // 签发 + TTL(30min);过期即不可消费

  cycleId String // 轮次锚(token 限定本轮);真实 FK

  phone                      String // 验证过的手机(身份链锚)
  phoneVerifiedAt            DateTime // 验码成功时刻
  phoneVerificationMethod    String // sms(H5)/ wechat(小程序辅)
  phoneVerificationTokenHash String    @unique // sha256(raw) hex;明文 token 永不入库,验码一次性返客户端
  consumedAt                 DateTime? // submit 原子消费即作废(一次性;镜像 sms_verification_codes.consumedAt)
  openid                     String? // 可选(小程序链 code2session 得)

  // S4b 预建(OCR 六分流重拍计数;本刀仅建列、不写逻辑;Q-P4-1)
  ocrAttemptCount Int     @default(0)
  lastOcrOutcome  String?
  requiresRetake  Boolean @default(false)

  cycle RecruitmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([phone, cycleId]) // 手机 + 轮次查(§3.3)
  @@index([cycleId])
  @@index([expiresAt]) // TTL 清理(留存 SOP)
  @@map("recruitment_identity_sessions")
}

// 招新可用性收口 F1(2026-07-11;评审稿 recruitment-usability-closeout-review.md §2.5/E-U-1)。
// 付费 OCR 调用(recognize + submit 共享)按 IP × 北京自然日(UTC+8)封顶的持久化计数表:
// 独立于内存态限流器(重启不清零),env `RECRUITMENT_OCR_DAILY_IP_LIMIT`(默认 30)判限。
// 纯基建计数行(非业务行):无 deletedAt / 无 FK;原子 upsert increment 后判限(先加后判,
// 拒者恒拒,超限尝试也计数 = 保守防滥用,沿 sms 日限「含失败行」口径 E-11)。
// 旧日期行由留存 SOP 按 dateKey 清理(不建 cron)。
model RecruitmentOcrDailyCounter {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ip      String // 请求出口 IP(req.ip;缺省归一 'unknown' 桶,不可绕计)
  dateKey String // 北京自然日 YYYY-MM-DD(固定 UTC+8 日界,沿 sms/stats 各模块级实现口径)
  count   Int    @default(0) // 当日该 IP 已发起的付费 OCR 调用数(含被上游拒/失败的尝试)

  @@unique([ip, dateKey])
  @@index([dateKey])
  @@map("recruitment_ocr_daily_counters")
}

// singleton 由第 49 migration 的 unique index on constant((true)) 在 DB 层强制;
// Prisma schema DSL 无法表达 expression index,故此处仅保留注释,不可误删 migration 索引。
model RealnameVerificationSettings {
  id String @id @default(cuid())

  // 通道选型(production-like 禁 DEV_STUB,写入与运行时双重校验,镜像 sms E-15)
  providerType RealnameProviderType
  enabled      Boolean              @default(true)

  // 腾讯云实名核验运行参数(非 secret,明文;DEV_STUB 下闲置)
  region String? // 如 ap-guangzhou

  // 凭证(两段 secretId+secretKey;AES-256-GCM 加密,RealnameCryptoService T2;明文永不入库,密文也不回显)
  secretIdEncrypted    String?
  secretKeyEncrypted   String?
  credentialConfigured Boolean @default(false) // DB 层简单事实;运行时 credentialStatus 三态由 Service 合成

  // 元信息(沿 SmsSettings 范式;updatedBy 不建外键)
  remarks   String?
  updatedBy String? // User.id
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("realname_verification_settings")
}

enum RealnameProviderType {
  DEV_STUB // 非生产联调通道:确定性两路(身份证校验位 偶=matched / 奇=mismatch,E-R-6;production-like 不可达)
  TENCENT_CLOUD
}

// =============================================================================
// 招新三期(入队:志愿者 → 队员)—— 第 27 模块 team-join(2026-06-19)
// 冻结评审稿 docs/archive/reviews/recruitment-phase3-review.md §3.1。
// - team_join_cycles:入队轮(annual,admin 开/关,至多一个 open);比 recruitment_cycles
//   更简(无发号 seq / capacity / 通知配置 —— member 已有 memberNo,本期不发号)。
// - team_join_applications:入队申请,**有真实 memberId FK**(申请人已是 member,与
//   recruitment_applications「无 Member FK」相反);gateMarks Json 落 8 通用 + 0~4 专业队 gate
//   (contribution 实时算不落库);partial unique 由 migration.sql 末尾手写(E-J-2,Prisma DSL
//   不支持带 WHERE);selectedOrganizationId 一键入队时定最终单部门。
// - 字段长度上限不落 @db.VarChar,由 DTO + class-validator 承担(沿近期惯例)。
// =============================================================================

model TeamJoinCycle {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  year              Int // 入队年份(贡献值 cutoff = {year}-03-31 北京日界;级别/编号无关)
  name              String // 轮次名(长度由 DTO 约束)
  statusCode        String // open / closed(后台开关;至多一个 open:service 预检 + partial unique DB 兜底)
  openedAt          DateTime?
  closedAt          DateTime?
  requiresInsurance Boolean   @default(false) // PR3 single gate=true 时参与 final join；默认 false

  // 入队候选部门配置(PR-4 才接业务):null/空=全部 ACTIVE;max null=默认 8。
  openOrganizationIds Json?
  maxTargetOrgs       Int?

  applications TeamJoinApplication[]

  // 业务唯一约束(partial unique;migration.sql 手写,Prisma DSL 不支持带 WHERE;十项收口刀B):
  // - team_join_cycles_single_open_unique ON ("statusCode")
  //   WHERE "statusCode" = 'open' AND "deletedAt" IS NULL —— 至多一个 open 轮 DB 兜底
  //   (镜像 recruitment_cycles_single_open_unique);service P2002 兜底转 28231
  @@index([year])
  @@index([statusCode])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("team_join_cycles")
}

model TeamJoinApplication {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cycleId  String
  memberId String // 申请人(phase-2 promote 出的已转正志愿者);真实 FK,与 recruitment_applications 相反

  statusCode             String // joining / pending_evaluation / approved / joined / rejected
  targetOrganizationIds  Json // 候选目标部门 orgId 数组(志愿者自助选,可多;joining 态可改)
  gateMarks              Json? // { [gateCode]: { at, by, passed, completionDate, extendedUntil? } };8 通用 + 0~4 专业队;contribution 不在此(实时算)
  selectedOrganizationId String? // 一键入队时 admin 定的最终单部门

  evaluatedByUserId       String? // 综合评估操作人(不建外键,沿 reviewedByUserId / SmsSettings.updatedBy)
  evaluatedAt             DateTime?
  evaluationNote          String?
  evaluationExtendedUntil DateTime? // 综合评估延长期(自本版起仅存档;approved 不随轮关闭失效)

  eliminationStage String? // evaluation / gate-timeout(rejected 时记)
  joinedAt         DateTime? // 一键入队执行时刻

  cycle                         TeamJoinCycle                  @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  member                        Member                         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  organization                  Organization?                  @relation(fields: [selectedOrganizationId], references: [id], onDelete: Restrict)
  insuranceEligibilityEvidences InsuranceEligibilityEvidence[]

  // 业务唯一约束(partial unique;migration.sql 末尾手写,E-J-2;Prisma DSL 不支持带 WHERE):
  // - team_join_applications_member_cycle_active_unique ON (memberId, cycleId)
  //   WHERE "deletedAt" IS NULL AND "statusCode" <> 'rejected' —— 同轮同人至多一活跃申请,
  //   允许 rejected 后同轮重试;service P2002 兜底转 28203(沿 recruitment 范式)
  @@index([cycleId])
  @@index([memberId])
  @@index([statusCode])
  @@index([selectedOrganizationId])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("team_join_applications")
}

// CMS 内容发布模块(第 28 模块,2026-06-21;冻结评审稿 docs/archive/reviews/content-module-review.md)。
// 公告 / 公示 / 简报 / 推文统一一表;正文 Markdown 原文;5 级可见(每篇选一档);立即发布无 cron。
// 封面 / 正文图 / 文件附件统一为 Attachment 行(ownerType='content-image'|'content-file' + ownerId=content.id),
// 不在本表;content 读取面自签下载 URL 并按文章可见级闸控(评审稿 §5 + attachments/CLAUDE.md 范围例外 a)。
model Content {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  title           String // 标题(DTO ≤ 200)
  summary         String? // 摘要(DTO ≤ 500)
  body            String // 正文 Markdown 原文(PG text);含 ![](attachment:<attachmentId>) 占位,读时改写为签名 URL;DTO ≤ 50000
  contentTypeCode String // ∈ content_type 字典 item(announcement / publicity / briefing / post)
  statusCode      String // draft / published / archived(String 常量,无 enum,沿 recruitment 范式)
  visibilityCode  String // public / member / formal_member / department / management(每篇选一档)

  visibleOrganizationIds String[] @default([]) // department 档可见部门 orgId;String[] 供 list where hasSome 过滤(沿 attachments.tags 范式)
  tags                   String[] @default([]) // 标签;读取面 hasSome 筛选(无 GIN,沿 attachments.tags / MemberProfile.exerciseMethods 无索引惯例,v1 顺扫)

  coverImageKey     String? // 封面反范式 storage key(列表缩略图直签,免 per-row Attachment 查询)
  coverAttachmentId String? // 封面对应 content-image 附件 id(标记 / 换 / 清;不建外键)

  viewCount Int @default(0) // 累计 PV(详情打开原子自增;列表 / 预览 / 404 不计)

  pinned       Boolean   @default(false) // 置顶
  publishedAt  DateTime? // publish 时置 now;unpublish 保留;draft 从未发布为 null
  authorUserId String? // 创建 / 操作 admin;不建外键(沿 reviewedByUserId / SmsSettings.updatedBy)

  @@index([statusCode])
  @@index([visibilityCode])
  @@index([contentTypeCode])
  @@index([publishedAt])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([statusCode, publishedAt]) // 公开 / 会员列表:published 按发布时间序常用复合
  @@map("contents")
}

// ===== 统一通知模块 S1:站内信渠道(第 28 模块 notifications 扩 controller,非新模块)=====
//
// 冻结评审稿:docs/archive/reviews/unified-notification-dispatcher-review.md(T0 修订;统一形状 §2/§5/§11)
//   supersede 原 docs/archive/reviews/member-notification-review.md §3(站内信 schema 本切片照建)。
// 镜像 Content(状态机 draft/published/archived + 可见性分档〔去 public = 4 档〕+ 软删 + readCount 反范式);
// 额外一张轻量已读表 NotificationRead(站内信核心差异)。**首切片一次建成统一形状**:audienceType /
// sourceType / channels 前向兼容列本切片即加(S1 仅用 broadcast / admin / in-app 值),后续 S2 微信 quota /
// S3 producer 定向(recipientMemberId / producerModule)只 additive 扩列扩表,站内状态机 / 可见性 / 已读语义零返工。
model Notification {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  title                String // 标题(DTO ≤ 200)
  body                 String // 站内信正文(PG text;纯文本 / 轻 Markdown;DTO ≤ 5000,v1 无正文图 / 附件)
  notificationTypeCode String // ∈ notification_type 字典 item(activity-reminder / recruitment / emergency / general / expiry-reminder)
  statusCode           String // draft / published / archived(String 常量,无 enum,镜像 content)
  visibilityCode       String // member / formal_member / department / management(4 档;去 public,会员面专属)

  visibleOrganizationIds String[] @default([]) // department 档可见部门 orgId 数组(hasSome;镜像 content)

  // ===== 统一通知形状前向兼容列(S1 即加默认值;S2/S3 additive 不返工)=====
  audienceType String   @default("broadcast") // broadcast(S1/S2 admin 广播)| directed(S3 producer 定向)(D-N9)
  sourceType   String   @default("admin") // admin(S1/S2 撰写)| system(S3 producer 自动)(D-N1)
  channels     String[] @default(["in-app"]) // 目标渠道声明(§7;in-app 恒发,wechat = S2,sms = S5)

  // 定向收件人(统一通知 S3;评审稿 §2.1 / §9.1;migration 第 29)。
  // 广播 = null;directed = 单一收件人 member。FK onDelete Restrict(沿仓内惯例;收件人软删后定向行成无害孤儿)。
  // feed 仅本人可见(notification-read.service 扩 where:广播可见 ∪ 本人定向;他人 → 31001 防枚举)。
  recipientMemberId String?

  readCount         Int       @default(0) // 反范式已读人数(首次 mark-read 原子 increment;镜像 content.viewCount)
  pinned            Boolean   @default(false) // 置顶
  publishedAt       DateTime? // publish 时置 now;unpublish 保留;draft 从未发布为 null
  publishGeneration Int       @default(0) // 发布代次(G1 expand-only;G2 runtime 已读写,生产 migration 未 deploy)
  authorUserId      String? // 发布 admin;不建外键(沿 content.authorUserId / reviewedByUserId);system 定向为 null

  reads      NotificationRead[]
  deliveries NotificationDelivery[] // 推送渠道(微信/短信)per-recipient 投递态(S2 起;站内不落)
  recipient  Member?                @relation(fields: [recipientMemberId], references: [id], onDelete: Restrict)

  @@index([statusCode])
  @@index([visibilityCode])
  @@index([notificationTypeCode])
  @@index([publishedAt])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([statusCode, publishedAt]) // 会员 feed:published 按发布时间序常用复合
  @@index([audienceType, recipientMemberId]) // 定向 feed:某 member 的 directed 通知(S3)
  @@map("notifications")
}

// 已读回执(notificationId × memberId,append-once;无 updatedAt / 无 deletedAt = immutable)。
// plain unique([notificationId, memberId])——已读不软删,无需 partial-unique-WHERE(与 TeamInsuranceCoverage 刻意差异)。
// FK 全 onDelete: Restrict(沿仓内惯例);通知软删后已读行成无害孤儿(retention SOP 手动清,不解锁 cron)。
model NotificationRead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) // = 首次已读时刻(readAt)

  notificationId String
  memberId       String

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([notificationId, memberId]) // 一会员对一通知至多一条(plain unique;mark-read upsert 幂等键)
  @@index([memberId]) // 会员未读查询主路径(NOT EXISTS 子查询)
  @@index([notificationId])
  @@map("notification_reads")
}

// =============================================================================
// 统一通知模块 S2 微信订阅 quota 渠道(2026-06-25;冻结评审稿
// docs/archive/reviews/unified-notification-dispatcher-review.md §3/§9.1,D-N2/D-N3/D-N6)。
// 三张净新增表(全 additive,无破坏、无回填、无 enum;migration 第 28);站内 S1 语义零返工。
// =============================================================================

// 推送渠道 per-recipient 投递态(§2.1 核心张力解法:fan-out 只发生在推送渠道,站内不落)。
// S2 仅 wechat 渠道;短信 = S5。流水语义(沿 sms_send_logs append-only;notificationId FK Restrict 串父记录,
// memberId 松引用不建 FK——投递日志不应被会员软删牵制,镜像 sms_send_logs 零 FK 取舍)。
// recipientRef = 掩码后 openid / phone(maskOpenid / maskPhone;明文永不入库,L3/L2 纪律)。
model NotificationDelivery {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  notificationId String
  channel        String // wechat(S2 唯一)| sms(S5);代码常量非字典
  memberId       String // 收件人 member(松引用,不建 FK;openid 可换绑故按 memberId 留痕)
  recipientRef   String // 掩码 openid / phone(回显安全;明文不入库)
  status         String // pending | sent | failed | skipped
  reasonCode     String? // no-quota / no-openid / need-resubscribe / invalid-openid / template-param / token-failed / no-template
  providerMsgId  String? // provider 回执 ID(微信 msgid;不含 secret)
  errCode        String? // 失败时 provider 错误码(微信 errcode 字符串;不含 secret)
  attemptedAt    DateTime? // 实际发起外部调用时刻(skipped = null,未发起外部调用)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)

  @@index([notificationId])
  @@index([memberId, channel])
  @@index([status])
  @@map("notification_deliveries")
}

// 微信订阅消息配额(memberId × templateId → availableCount;D-N2 上限默认 5)。
// 按 memberId 存(非 openid)——openid 可换绑(招新 S4a rebind),memberId 稳定;发送时 member→user→openid 现取。
// +1(ack)= upsert increment 配上限;-1(发送)= 条件原子扣减 updateMany(availableCount>0),count===1 才发。
// 松引用 memberId 不建 FK(状态表,会员软删不应牵制;镜像 sms_send_logs / wechat 流水取舍)。
model WechatSubscriptionQuota {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberId       String
  templateId     String
  availableCount Int    @default(0) // ≥ 0(条件原子扣减杜绝越扣为负)

  @@unique([memberId, templateId]) // 一会员一模板至多一行(ack upsert 键 + count 查询主路径)
  @@index([templateId]) // 派发:按 templateId 取有配额会员(availableCount > 0)
  @@map("wechat_subscription_quotas")
}

// 微信订阅消息模板配置(notificationTypeCode → templateId;运营可配,D-N3)。
// 镜像 sms_settings.templateIdBirthday「模板 ID 存配置、运营改不重部署」先例,但一类型一模板故独立表(1:1)。
// 字段映射(payload → 微信 data key)= 内置代码(随类型固定,不入本表;见 notification.wechat-data.ts)。
// templateId 可空:小程序后台审批后由 admin 填;未填 / disabled = 该类型微信渠道不可发(派发 skip no-template)。
model WechatSubscribeTemplate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notificationTypeCode String  @unique // ∈ notification_type 字典;一类型一模板
  templateId           String? // 微信订阅消息模板 ID(运维上线后台审批后填)
  enabled              Boolean @default(true)
  remarks              String?
  updatedBy            String? // User.id(不建外键,沿 settings 范式)

  @@map("wechat_subscribe_templates")
}

// PostgreSQL durable notification outbox(D-Outbox;2026-07-18)。
// status 使用代码常量而非 enum，worker 以 SKIP LOCKED + lease/fencing 多实例领取；
// payload 只保存内部引用与安全文案，手机号/openid/token/secret/credential/signed URL
// 及 provider 原始请求/响应均不得进入本表。成功/死信 retention 仅走人工 SOP。
// migration 另有手写 partial unique：微信 delivery / admin SMS 各自同
// aggregateId/destinationRef 同时至多一条 pending/processing；Prisma DSL 无法表达 partial
// unique，勿用普通 @@unique 误伤 terminal generation history。
model NotificationOutboxIntent {
  id             String @id @default(cuid())
  eventKey       String @unique
  eventType      String
  payloadVersion Int
  payload        Json

  aggregateType   String
  aggregateId     String
  destinationType String
  destinationRef  String

  status      String   @default("pending")
  attempts    Int      @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)

  leaseOwner     String?
  lockedAt       DateTime? @db.Timestamptz(3)
  leaseExpiresAt DateTime? @db.Timestamptz(3)

  preparedAt         DateTime? @db.Timestamptz(3)
  preparedTemplateId String?
  sentAt             DateTime? @db.Timestamptz(3)
  completedAt        DateTime? @db.Timestamptz(3)

  lastErrorCode  String?
  lastErrorClass String?
  deadAt         DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // ⚠️ 本表还有**三条手写 partial unique**,Prisma DSL 表达不了 WHERE 子句,故不在此处:
  //   notification_outbox_wechat_delivery_active_unique  (第 18 migration)
  //   notification_outbox_admin_sms_active_unique        (第 18 migration)
  //   notification_outbox_wecom_delivery_active_unique   (第 69 migration;T5B)
  // 三条形状一致:键 ("eventType","aggregateId","destinationRef"),谓词 = 各自的 eventType
  // + status IN ('pending','processing')。谓词按 eventType **分域**是刻意的 ——
  // 合成一条不含 eventType 谓词的通用索引会让同一通知同一人的微信小程序 child 与
  // 企业微信 child 互相占槽,两个渠道无法同时投递(企业微信冻结稿 §10.3)。
  @@index([status, availableAt, leaseExpiresAt])
  @@index([leaseExpiresAt])
  @@index([aggregateType, aggregateId])
  @@index([status, completedAt])
  @@index([status, deadAt])
  @@index([createdAt])
  @@map("notification_outbox_intents")
}

// PostgreSQL shared throttler storage(D-Throttle;2026-07-18):10 个命名 throttler
// 共用数据库桶，(throttlerName,key) 物理隔离。hitExpiresAt 保存每次未 blocked hit
// 的独立滚动过期点；过期桶仅走手动 retention SOP，刻意不新增第 3 个 cron。
model ThrottlerBucket {
  id String @id @default(cuid())

  throttlerName String
  key           String

  hitExpiresAt    DateTime[] @default([]) @db.Timestamptz(3)
  windowExpiresAt DateTime   @default(now()) @db.Timestamptz(3)
  blockedUntil    DateTime?  @db.Timestamptz(3)
  retentionAt     DateTime   @default(now()) @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([throttlerName, key])
  @@index([retentionAt])
  @@map("throttler_buckets")
}

// ===== 企业微信接入 T1(2026-08-01):三张新表 =====
//
// 冻结稿:docs/archive/reviews/wecom-integration-t0-terminal-review.md §5(2026-07-29 冻结,
// D-WC-1..31 按推荐)。本刀 **expand-only**:净新 3 张空表 + User 两条反向 relation +
// SmsPurpose 一个 enum 值;**零 runtime 读写、零 endpoint、零 permission、零 audit、
// 零回填、零删数、零默认绑定**。T2 才有 settings 端点,T3 才有 OAuth 与绑定。
//
// 命名铁律(冻结稿开头「命名约定」):`WeCom`/`wecom` = 企业微信;现有 `Wechat`/`wechat`
// 专指微信小程序。二者不得混写、混表、混错误码、混通知渠道 —— 这也是本批不复用
// wechat_settings / User.openid 的根本原因。
//
// `@@map` 物理名:prisma/CLAUDE.md 默认禁 @@map,本批由 goal 显式授权(冻结稿 §5 逐字
// 给出三个 @@map),沿 activity_check_ins / activity_feedbacks / throttler_buckets 等
// 「goal 指定 @@map」既有先例。

// 冻结稿 §5.1。单 Corp 单 Agent(§0.3 硬禁区:不做多企业 / 多 CorpID / 多 Agent / 多租户),
// 故本表是 singleton —— 至多一行由 migration 末尾的 constant unique index 在 **DB 层**强制,
// 不靠应用层自觉(沿第 49 migration 四张 provider settings 表的同一形状)。
//
// providerType 按冻结稿逐字为 `String`(取值 DEV_STUB | WECOM),**刻意不建 Prisma enum** ——
// 与 WechatSettings 的 WechatProviderType 形成对照是冻结稿的选择,不是遗漏;本刀不擅自"改进"。
//
// 三个开关默认全 false(冻结稿 §13 T2「默认所有开关 false」):enabled=false 时登录与消息
// 全部 fail-closed;loginEnabled/messageEnabled 为二级闸,置 true 必须 enabled=true(T2 校验)。
//
// 凭证红线(§5.5 L3):corpSecretEncrypted 与 access token **永不**进响应 / Audit / 日志。
// configurationGeneration 不落库,由 T2 按 §5.1 规则 8 的字段集做 SHA-256 opaque hash。
model WecomSettings {
  id             String  @id @default(cuid())
  providerType   String  @default("DEV_STUB") // DEV_STUB | WECOM
  enabled        Boolean @default(false)
  loginEnabled   Boolean @default(false)
  messageEnabled Boolean @default(false)

  corpId     String?
  agentId    Int?
  webBaseUrl String? // 仅 origin,如 https://app.example.com;production 必须 HTTPS 且不带 path/query/fragment

  corpSecretEncrypted  String? // AES-256-GCM 密文;§5.5 L3,永不回显、永不 Audit、永不日志
  credentialConfigured Boolean @default(false)

  remarks   String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wecom_settings")
}

// 冻结稿 §5.2。企业微信身份绑定 **User**(§1.2 结论 4:会话属于 User;Admin 账号可能没有
// Member;Member 的业务准入另由 AppIdentityResolver 决定),故这里既无 memberId 也无
// 通讯录快照(departmentIds / name / avatar / mobile / email 一概不建,§5.2 语义)。
//
// 无 soft delete:`revoked` 本身已是终态历史语义。绑定 / 换绑 / 清除**全部保留历史行** ——
// 换绑是"结束旧 active 行 + 新建 active 行",不是覆盖旧行的 wecomUserId。
//
// 两条 active partial unique(migration 末尾手写;Prisma DSL 表达不了 WHERE 子句):
//   subject_active_unique  (corpId, wecomUserId) WHERE status='active' —— 一个企业微信身份至多绑一个 active User
//   user_active_unique     (corpId, userId)      WHERE status='active' —— 一个 User 在当前 Corp 下至多一个 active 身份
// 两条 CHECK:status 闭集 + revocation 形状(active⇔revokedAt IS NULL)。
//
// wecomUserId 是企业内部稳定标识,§5.5 定为 L2:**必须明文存储**(发消息要用),
// 但所有响应 / Audit / 日志一律掩码。
model WecomIdentity {
  id              String    @id @default(cuid())
  userId          String
  corpId          String
  wecomUserId     String
  status          String    @default("active") // active | revoked;闭集由 CHECK 强制
  bindingSource   String // pre-auth | me
  boundAt         DateTime  @default(now())
  revokedAt       DateTime?
  revokedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Restrict:User 恒软删不物理删(v1 契约),引用悬空仅理论风险 —— 沿 auditLogs / refreshTokens 同型
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([corpId, status])
  @@index([wecomUserId])
  @@map("wecom_identities")
}

// 冻结稿 §5.3。OAuth state 与 binding ticket 的一次性凭证台账。
//
// 最硬的一条:**原始 state、原始 bindingTicket、OAuth code 都不入库** —— 前两者只存
// SHA-256 hash(故列名带 Hash 后缀且 @unique),code 连 hash 都不存,也不入日志、不入 Audit(§5.5)。
//
// 状态闭集(§5.3):pending / state_consumed / binding_required / completed / failed。
// 本刀**刻意不给 status 加 CHECK** —— 冻结稿 §5.3 只在 WecomIdentity 上要求两条 CHECK,
// 这里给的是状态机文档而非 DB 约束;不自行加码(§26「不擅自加严冻结稿」)。
//
// corpId / wecomUserId 仅在"未绑定登录转入 binding_required"时临时保存,不是身份真相源
//(身份真相在 WecomIdentity)。
//
// retention:成功 / 失败 / 过期行由**手动 SOP** 清理 —— §0.3 硬禁区「不新增第三个 Cron」,
// 与 throttler_buckets 同一处置。
model WecomAuthAttempt {
  id            String  @id @default(cuid())
  purpose       String // login | bind_self
  status        String  @default("pending")
  subjectUserId String? // bind_self 时固定为发起 authorize 的登录用户;login 恒 null

  stateHash       String    @unique // sha256(原始 state);原始值只出现在 authorize URL
  returnPath      String
  stateExpiresAt  DateTime
  stateConsumedAt DateTime?

  bindingTicketHash String?   @unique // sha256(原始 ticket);原始值仅在 bindingRequired 响应里出现一次
  corpId            String?
  wecomUserId       String?
  bindingExpiresAt  DateTime?
  bindingConsumedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjectUser User? @relation(fields: [subjectUserId], references: [id], onDelete: Restrict)

  @@index([status, stateExpiresAt])
  @@index([bindingExpiresAt])
  @@map("wecom_auth_attempts")
}

// ============================================================================
// 活动改造 v1.1 —— 第 1 批第一刀:Session / Participation / Capacity
// (2026-08-04;合同 docs/archive/reviews/activity-business-overhaul-v1.1/
//  §3.2 / §3.3 / §3.8 / §3.9 / §3.10;§14「第 1 批」建议拆分第 1 项)
//
// 本刀是纯 schema expand:**六张新表零调用方**是预期状态,不接线、不写业务代码。
// 既有 ActivityPosition / ActivityRegistration 一列不动、一行不迁,两表并存期间
// 不写任何双写／双读(合同 §0.4 明禁长期双读双写);它们的退场归 contract 阶段。
//
// 命名:本批**不使用 @@map**(prisma/CLAUDE.md 默认禁,goal 未授权),物理表名
// 即 PascalCase model 名 —— 沿 CertificateStandard / RecruitmentCertificateClaim
// 等近批新表的既有做法。
//
// 状态类字段一律 String + migration CHECK 闭集兜底,不建 Prisma enum
// (合同 §3 前言:「避免为了新增状态频繁修改 PostgreSQL enum」)。
//
// 万人量级前提(第 0 批 #906 实测):批量写恒走 unnest 数组参数,与人数无关地只占
// 常数个 bind 参数(Prisma bind 上限 32767)。本刀不写批量逻辑,但建表按此前提设计
// —— 不引入任何"每行一个参数"才能维护的结构。
// ============================================================================

// ===== §3.2 ActivitySession:一行 = 一个实际执行场次 =====
//
// 时间窗口四件套 + 定位策略在本表**冻结最终值**,运行时不再回查模板
// (合同 §3.4:「不实时继承模板;模板变化不修改已发布活动」)。
model ActivitySession {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // 仅草稿可软删;发布后取消走 statusCode,不删除历史

  activityId String
  code       String // 同活动稳定业务编码,创建后不可改
  name       String

  startAt DateTime
  endAt   DateTime

  locationText    String
  meetingPoint    String?
  executionPoint  String?
  evacuationPoint String?
  // 沿 Activity.locationLongitude / locationLatitude 的 Decimal(10,7)(WGS84 ~1.1cm)
  longitude       Decimal? @db.Decimal(10, 7)
  latitude        Decimal? @db.Decimal(10, 7)

  capacity Int? // 场次参与人次上限;null 不限

  checkInOpenAt      DateTime
  checkInCloseAt     DateTime
  checkOutOpenAt     DateTime
  checkOutCloseAt    DateTime
  preparationStartAt DateTime? // null = 不单独计准备时段

  locationRequired           Boolean
  radiusMeters               Int? // 要求定位时 50..10000;不要求定位时必须 null
  locationPolicySourceCode   String // system / template / activity / session / position
  accuracyWarningMeters      Int     @default(100) // 合同 §3.2「固定 100;本期只提醒」
  lateGraceMinutes           Int     @default(15) // 0..60
  earlyLeaveThresholdMinutes Int     @default(15) // 0..60

  terminationCheckOutDeadline DateTime? // 场次提前终止后的真实签退截止

  statusCode       String // scheduled / cancelled / terminated;进行中／结束按时间派生
  workflowRevision Int    @default(0)
  sortOrder        Int    @default(0)

  activity                Activity                        @relation(fields: [activityId], references: [id], onDelete: Restrict)
  // Activity OS R2 / B1：场次级地点以 (activityId, sessionId) 复合锚物理确认同一活动链。
  activityPlaces          ActivityPlace[]
  positions               ActivitySessionPosition[]
  participationIdentities ActivityParticipationIdentity[]

  // 第 1 批第二刀(§3.13 / §3.14):场次级规则集、场次级邀请、现场访客。
  qualificationRuleSets ActivityQualificationRuleSet[]
  invitations           ActivityInvitation[]
  visitors              ActivityVisitor[]

  // 第 1 批第三刀(§3.15 / §3.16):场次级二维码凭证与打卡事件。
  qrCredentials              AttendanceQrCredential[]
  punchEvents                AttendancePunchEvent[]
  offlinePackages            OfflinePackage[]
  offlinePackageParticipants OfflinePackageParticipant[]
  offlinePunchReviewItems    OfflinePunchReviewItem[]

  // 第 1 批第四刀反向 relation(合同 §3.23 / §3.27):仅关系映射,零标量字段。
  ledgerEntries ParticipationLedgerEntry[]
  batchJobs     ActivityBatchJob[]

  // 第 1 批第五刀反向 relation(合同 §3.11):仅关系映射,零标量字段。
  positionPreferences ActivityPositionPreference[]
  allocationBatches   ActivityAllocationBatch[]

  // 复合 FK 的被引用侧:让子表 (activityId, sessionId) 双锚点由 **DB** 保证
  // 「session 属于 activity」,而不是只靠 service 自觉(合同 §3.3 原话:
  // 「双锚点,service 与 DB 约束保证 session 属于 activity」)。
  @@unique([activityId, id])
  @@index([activityId])
  @@index([statusCode])
  @@index([startAt])
  @@index([endAt])
  @@index([checkOutCloseAt])
  @@index([activityId, sortOrder])
  @@index([deletedAt])
}

// ===== Activity OS Release 2 / B1：地点预设与活动地点快照 =====
//
// PlacePreset 是未来定义层可选来源；ActivityPlace 保存活动 / 场次自己的本地快照。
// B1 不提供预设 writer、生命周期、地图接入或旧字段投影，因而不臆造 status / owner / JSON 配置。
model PlacePreset {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name                 String
  addressText          String
  instruction          String?
  // B2 的物理 CHECK：三列可同时为空（纯文字地点）；否则经纬度必须成对、位于全球
  // 合法范围，coordinateSystemCode 只能是 wgs84 / gcj02 / bd09。
  longitude            Decimal? @db.Decimal(10, 7)
  latitude             Decimal? @db.Decimal(10, 7)
  coordinateSystemCode String?
  providerCode         String?
  providerPlaceId      String?
  checkInEligible      Boolean
  radiusMeters         Int?

  activityPlaces ActivityPlace[]
}

// ActivityPlace 是计划层快照。sourcePresetId 仅保留来源；将来的 writer 必须复制预设值，
// 不能在读侧用当前预设覆盖此处字段。sessionId 为 NULL 表示活动级地点。
model ActivityPlace {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String
  sessionId  String?

  roleCode             String
  name                 String
  addressText          String
  instruction          String?
  // B2 的物理 CHECK：三列可同时为空（纯文字地点）；否则经纬度必须成对、位于全球
  // 合法范围，coordinateSystemCode 只能是 wgs84 / gcj02 / bd09。
  longitude            Decimal? @db.Decimal(10, 7)
  latitude             Decimal? @db.Decimal(10, 7)
  coordinateSystemCode String?
  providerCode         String?
  providerPlaceId      String?
  visibilityCode       String
  checkInEligible      Boolean
  radiusMeters         Int?
  sourcePresetId       String?
  workflowRevision     Int      @default(0)

  activity     Activity         @relation(fields: [activityId], references: [id], onDelete: Restrict)
  session      ActivitySession? @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  sourcePreset PlacePreset?     @relation(fields: [sourcePresetId], references: [id], onDelete: Restrict)

  @@index([activityId])
  @@index([sessionId])
  @@index([sourcePresetId])
}

// ===== §3.3 ActivitySessionPosition:场次级岗位 =====
//
// ⚠️ 合同 §3.3 说既有 ActivityPosition「可重命名／重建」为本模型 —— 本刀按 goal ③
// **新建**本表,既有 activity_positions 一列不动、一行不迁,退场归 contract 阶段。
//
// ✅ 合同字段表里的 `qualificationRuleSetId` 在第一刀按「跨切片的列不提前占位」暂缓,
// **本刀(第二刀)连列带外键一起补上** —— 它指向的 ActivityQualificationRuleSet(§3.13)
// 正是本刀建的表。这是「不占位」范式的后半程。
model ActivitySessionPosition {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // 仅草稿软删;发布后用变更提案取消或替代

  activityId String
  sessionId  String

  code               String
  name               String
  attendanceRoleCode String
  capacity           Int? // null 不限

  // 有值时必须同空同有(CHECK);「位于 session 内」由复合 FK 保证。
  startAt DateTime?
  endAt   DateTime?

  genderRequirementCode String?

  // 可空 = 岗位不追加岗位级资格时继承场次/活动级规则集；第 83 migration 的完整
  // 复合 FK 同时保证它只能指向本活动、本场次、本岗位的规则集。
  qualificationRuleSetId String?

  // 可空覆盖 session;发布时解析最终值进入快照(§3.4)。
  locationRequired Boolean?
  radiusMeters     Int?

  leaderMemberId String? // 岗位负责人业务关系,**不直接产生权限**(§3.3)
  description    String?
  equipmentNotes String?
  sortOrder      Int     @default(0)

  activity                Activity                        @relation(fields: [activityId], references: [id], onDelete: Restrict)
  // 复合 FK:(activityId, sessionId) → ActivitySession(activityId, id)。
  // 单列 sessionId FK 挡不住"岗位挂到别的活动的场次上"这种脏行。
  session                 ActivitySession                 @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  leader                  Member?                         @relation("SessionPositionLeader", fields: [leaderMemberId], references: [id], onDelete: Restrict)
  participationIdentities ActivityParticipationIdentity[]
  participationRevisions  ActivityParticipationRevision[]

  // 第 1 批第二刀(§3.3 / §3.13 / §3.14)。
  qualificationRuleSet        ActivityQualificationRuleSet?  @relation("PositionQualificationRuleSet", fields: [activityId, sessionId, id, qualificationRuleSetId], references: [activityId, sessionId, positionId, id], onDelete: Restrict)
  // §3.13 规则集反向指回岗位(岗位级作用域)与 §3.14 邀请指定岗位。
  scopedQualificationRuleSets ActivityQualificationRuleSet[] @relation("PositionQualificationRuleSetScope")
  invitations                 ActivityInvitation[]           @relation("InvitationPosition")

  // 第 1 批第三刀(§3.16):打卡事件的岗位上下文(可空)。
  punchEvents AttendancePunchEvent[] @relation("PunchEventPosition")

  // 第 1 批第五刀(§3.11):岗位志愿与岗位级分配批次。
  positionPreferences              ActivityPositionPreference[]
  allocationBatches                ActivityAllocationBatch[]                 @relation("AllocationBatchPosition")
  allocationWaitlistCandidates     ActivityAllocationCandidate[]             @relation("AllocationCandidateWaitlistPosition")
  allocationApplicationProjections ActivityAllocationApplicationProjection[] @relation("AllocationApplicationProjectionPosition")
  offlinePackageParticipants       OfflinePackageParticipant[]

  @@unique([activityId, sessionId, id], map: "activity_session_position_activity_session_id_key")
  @@index([activityId])
  @@index([sessionId])
  @@index([attendanceRoleCode])
  @@index([leaderMemberId])
  @@index([sessionId, sortOrder])
  @@index([deletedAt])
  @@index([qualificationRuleSetId])
}

// ===== §3.8 ActivityParticipationIdentity:P0-04 核心模型 =====
//
// 一行 = 一个队员参加一个场次的**永久**身份。取消重报只追加
// ActivityParticipationRevision 并改当前指针,**永不再建身份行**
// ⇒ (activityId, sessionId, memberId) 是**普通 unique,不带删除条件**(§3.8 原话)。
// 因此本表**没有 deletedAt**:永久身份不软删。
model ActivityParticipationIdentity {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId     String
  sessionId      String
  registrationId String
  memberId       String

  currentRevision   Int     @default(0)
  currentStatusCode String
  currentPositionId String?

  // ⚠️ DoD 7 选项 (a):**不加 FK** 的快速指针。
  // 真值在 CapacityReservation 行上(§3.10「每个当前占位的可追溯事实」);
  // 本列只是"当前占位记录"的快捷入口。加 FK 会与 CapacityReservation.identityId
  // 形成**循环外键**,并给占位事务凭空多一条隐式死锁边 —— 本仓已有「audit 外键是
  // 看不见的死锁边」的事故(见 concurrency-review-m1-m6)。
  // 指针失同步的发现手段:LEFT JOIN 对账查询(见配套 spec 的"悬空指针"用例),
  // 不靠 DB 兜底。
  capacityReservationId String?

  populationIncluded Boolean @default(false) // 是否进入当前应结算人口;随状态原子更新
  version            Int     @default(0) // CAS 版本

  activity     Activity                 @relation(fields: [activityId], references: [id], onDelete: Restrict)
  session      ActivitySession          @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  registration ActivityRegistration     @relation(fields: [registrationId, activityId, memberId], references: [id, activityId, memberId], onDelete: Restrict)
  member       Member                   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  position     ActivitySessionPosition? @relation(fields: [currentPositionId, activityId, sessionId], references: [id, activityId, sessionId], onDelete: Restrict)

  revisions    ActivityParticipationRevision[]
  reservations CapacityReservation[]

  // 第 1 批第二刀(§3.13):资格评估快照的反向 relation。
  qualificationSnapshots QualificationEvaluationSnapshot[]

  // 第 1 批第三刀(§3.16 / §3.18):打卡事件与服务段修订的反向 relation。
  punchEvents                AttendancePunchEvent[]
  serviceSegmentRevisions    ParticipantServiceSegmentRevision[]
  offlinePackageParticipants OfflinePackageParticipant[]
  offlinePunchReviewItems    OfflinePunchReviewItem[]

  // 第 1 批第四刀反向 relation(合同 §3.20 / §3.23 / §3.25):仅关系映射,零标量字段。
  settlementResultRevisions ParticipantSettlementResultRevision[]
  ledgerEntries             ParticipationLedgerEntry[]
  correctionRequests        AttendanceCorrectionRequest[]

  // 第 1 批第五刀反向 relation(合同 §3.11):仅关系映射,零标量字段。
  allocationCandidates             ActivityAllocationCandidate[]
  allocationApplicationProjections ActivityAllocationApplicationProjection[] @relation("AllocationApplicationProjectionIdentity")

  @@unique([activityId, sessionId, memberId])
  // 第 85 migration：AllocationCandidate 以 identity + registration 复合 FK
  // 证明候选身份与永久报名头同锚；id 单列主键不能替代 PostgreSQL 的被引用复合 unique。
  @@unique([id, registrationId], map: "activity_participation_identity_id_registration_id_unique")
  // D86 projection 冻结 identity 的 member/activity/session 四元事实；id 单列主键
  // 不能作为 PostgreSQL 复合 FK 的被引用键。
  @@unique([id, activityId, sessionId, memberId], map: "activity_participation_identity_id_activity_session_member_key")
  // 业务复合锚点闭合(第六轮评审 A-2 / B-03):被引用侧锚点 —— PostgreSQL 复合外键
  // 要求被引用列上有**精确匹配**的 unique;id 单列主键不能替代。仅作 FK 靶点,不新增业务约束。
  @@unique([id, activityId, sessionId], map: "activity_participation_identity_id_activity_session_key")
  // 业务复合锚点闭合(第六轮评审 A-2 / B-03):被引用侧锚点 —— PostgreSQL 复合外键
  // 要求被引用列上有**精确匹配**的 unique;id 单列主键不能替代。仅作 FK 靶点,不新增业务约束。
  @@unique([id, registrationId, activityId, sessionId], map: "activity_participation_identity_id_reg_act_sess_key")
  @@index([activityId])
  @@index([sessionId])
  @@index([memberId])
  @@index([registrationId])
  @@index([currentStatusCode])
  @@index([currentPositionId])
  @@index([activityId, populationIncluded])
}

// ===== §3.9 ActivityParticipationRevision:不可变状态修订 =====
//
// 不可变模型 ⇒ 按合同 §3 前言**不带 updatedAt / deletedAt**。
//
// ✅ 合同字段表里的 `allocationBatchId` 在第一刀按「跨切片外键列不提前占位」暂缓
// (原注释预判它归第四刀,实际 §3.11 分配四表是**合同第四处内部矛盾** —— §14 任何
// 一刀都没列入,维护者 2026-08-04 拍板另开第五刀)。目标表 ActivityAllocationBatch
// 正是**第五刀**建的,故本刀**连列带外键一起补上**。这是「不占位」范式的最后一段。
model ActivityParticipationRevision {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  identityId String
  revision   Int

  // 闭集(§3.9,14 态),由 migration CHECK 兜底;
  // ActivityParticipationIdentity.currentStatusCode 共用同一闭集。
  statusCode String

  positionId         String?
  preferenceSnapshot Json?
  waitlistRank       Int?

  // §3.9 字段表第四列。可空:先到先得直接 pass / 后台代建 / 取消重报等路径都不经过
  // 分配批次,此刻无 batch 可指(§5.4 只有资格排序与抽签两种模式必然产生 batch)。
  allocationBatchId String?

  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?

  cancelledByUserId String?
  cancelledAt       DateTime?
  cancelReason      String?

  effectiveAt     DateTime
  createdByUserId String?
  sourceCode      String
  requestKey      String?
  requestHash     String?

  identity                         ActivityParticipationIdentity             @relation(fields: [identityId], references: [id], onDelete: Restrict)
  position                         ActivitySessionPosition?                  @relation(fields: [positionId], references: [id], onDelete: Restrict)
  allocationBatch                  ActivityAllocationBatch?                  @relation(fields: [allocationBatchId], references: [id], onDelete: Restrict)
  allocationApplicationProjections ActivityAllocationApplicationProjection[] @relation("AllocationApplicationProjectionAppliedRevision")
  offlinePackageParticipants       OfflinePackageParticipant[]
  offlinePunchReviewItems          OfflinePunchReviewItem[]
  reviewedBy                       User?                                     @relation("ParticipationRevisionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  cancelledBy                      User?                                     @relation("ParticipationRevisionCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  createdBy                        User?                                     @relation("ParticipationRevisionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([identityId, revision])
  @@unique([id, allocationBatchId, identityId], map: "activity_participation_revision_id_batch_identity_unique")
  @@index([identityId])
  @@index([statusCode])
  @@index([positionId])
  @@index([effectiveAt])
  @@index([requestKey])
  // §11.3「必需索引」逐字点名的一条:ParticipationRevision `(allocationBatchId,statusCode)`。
  @@index([allocationBatchId, statusCode], map: "activity_participation_revision_batch_status_idx")
}

// ===== §3.10 ActivityCapacityBucket:容量桶 =====
//
// scopeId 是**多态** id(activity / session / position / reserve group),
// 故不加 FK —— 沿 role_bindings.principalId「多态无 FK」既有范式。
model ActivityCapacityBucket {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String // 聚合根

  // activity_person / session_participation / position_participation / reserve_group
  scopeTypeCode String
  scopeId       String

  capacity Int? // null 不限;有值 >= 1
  occupied Int  @default(0) // >= 0 且不大于 capacity
  version  Int  @default(0) // CAS

  activity                                       Activity                                  @relation(fields: [activityId], references: [id], onDelete: Restrict)
  reservations                                   CapacityReservation[]
  activityPersonAllocationApplicationProjections ActivityAllocationApplicationProjection[] @relation("AllocationApplicationProjectionActivityPersonBucket")
  sessionAllocationApplicationProjections        ActivityAllocationApplicationProjection[] @relation("AllocationApplicationProjectionSessionBucket")
  positionAllocationApplicationProjections       ActivityAllocationApplicationProjection[] @relation("AllocationApplicationProjectionPositionBucket")

  @@unique([scopeTypeCode, scopeId])
  @@unique([id, activityId], map: "activity_capacity_bucket_id_activity_unique")
  @@index([activityId])
  @@index([scopeTypeCode])
}

// ===== §3.10 CapacityReservation:每个当前占位的可追溯事实 =====
//
// partial unique(迁移末尾手写):一个 identity 对一个 bucket 至多一条 active;
// 第 78 migration 再补一个 member/activity 至多一条 active activity-person 的保证。
model CapacityReservation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identityId      String
  bucketId        String
  reservationType String
  // 第 78 migration:仅 activity_person active 行必须同时带两锚点；其余既有 reservation
  // 保持可空、无 default、零回填，避免改写 session / position 历史。
  memberId        String?
  activityId      String?

  status        String // active / released(CHECK 闭集 + 形状 CHECK)
  releasedAt    DateTime?
  releaseReason String?

  identity                                       ActivityParticipationIdentity             @relation(fields: [identityId], references: [id], onDelete: Restrict)
  bucket                                         ActivityCapacityBucket                    @relation(fields: [bucketId], references: [id], onDelete: Restrict)
  member                                         Member?                                   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  activity                                       Activity?                                 @relation(fields: [activityId], references: [id], onDelete: Restrict)
  activityPersonAllocationApplicationProjections ActivityAllocationApplicationProjection[] @relation("AllocationApplicationProjectionActivityPersonReservation")
  sessionAllocationApplicationProjections        ActivityAllocationApplicationProjection[] @relation("AllocationApplicationProjectionSessionReservation")
  positionAllocationApplicationProjections       ActivityAllocationApplicationProjection[] @relation("AllocationApplicationProjectionPositionReservation")

  @@unique([id, identityId, bucketId], map: "capacity_reservation_id_identity_bucket_unique")
  // D86 的 activity_person reservation 按 member/activity（而非某一 session identity）
  // 复用；该复合键让 committed projection 能冻结其真实锚点与 bucket。
  @@unique([id, memberId, activityId, bucketId], map: "capacity_reservation_id_member_activity_bucket_unique")
  @@index([identityId])
  @@index([bucketId])
  @@index([status])
  @@index([bucketId, status])
}

// ============================================================================
// 活动改造 v1.1 —— 第 1 批第二刀:报名修订 / 报名表 / 资格 / 邀请 / 访客
// (2026-08-04;合同 docs/archive/reviews/activity-business-overhaul-v1.1/
//  SRVF_活动业务全流程改造_详细开发文档_v1.1.md §3.7 / §3.12 / §3.13 / §3.14;
//  §14「第 1 批」建议拆分第 2 项)
//
// 与第一刀同口径:纯 schema expand,**十张新表零调用方**是预期状态 —— 不接线、
// 不写 service / controller / DTO / policy / presenter,消费方在第 3–5 批。
// 既有 ActivityPosition / ActivityRegistration 一行不迁、不双写。
//
// 命名:不使用 @@map,物理表名即 PascalCase model 名(沿第一刀)。
// 状态类字段一律 String + migration CHECK 闭集兜底,不建 Prisma enum(§3 前言:
// 「避免为了新增状态频繁修改 PostgreSQL enum」)。
//
// ⚠️ 敏感信息口径(维护者 2026-08-04 拍板):报名表题目由发布人自定义,**可能**出现
// 身份证号 / 病史 / 紧急联系人等。按合同设计,本刀不额外设限 —— 合同已给每道题
// `visibilityCode`(谁能看)与 `exportable`(能否导出)两个开关;答案跟随报名记录
// 存在,**不单独设保存期限**;掩码与读侧权限在后续批次做。本刀一行读侧代码都不写。
// ============================================================================

// ===== §3.7 ActivityRegistrationRevision:不可变报名修订 =====
//
// 「不可变记录每次报名／重报／撤回／后台代建」⇒ 按合同 §3 前言**不带
// updatedAt / deletedAt**(沿第一刀 ActivityParticipationRevision 同一处置)。
//
// ⚠️ 本表在第一刀就该建(§3.7),当时按 goal ②「跨切片外键列不提前占位」整体移出 ——
// 它的 formVersionId 指向本刀才建的 RegistrationFormVersion。本刀连表带列一起落。
model ActivityRegistrationRevision {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  registrationId String
  revision       Int

  // ⚠️ 可空,合同字段表未标 `?` —— 偏离理由:§3.12 **没有**要求每个活动都必须建
  // RegistrationFormVersion(没有自定义报名表的活动是常态),无表时本列无版本可指。
  // 有表时由 service 绑定,并禁止把新版本字段填进旧报名修订(§3.12 原话)。
  formVersionId String?
  // 原始答案存 RegistrationFormAnswer 行,这里只留指纹(§3.7:不在 audit context
  // 复制敏感文件内容)。无表 / 无题时无答案可哈希 ⇒ 同样可空。
  answersHash   String?

  sourceCode        String // self / admin / invitation / onsite(§3.6 闭集,migration CHECK 兜底)
  // ⚠️ 可空,合同字段表未标 `?` —— 沿本仓 actor FK 一律可空的既有范式
  // (reviewedBy / cancelledByUserId / createdByUserId / terminatedByUserId 无一例外)。
  submittedByUserId String?
  submittedAt       DateTime

  // §3.7「requestKey/requestHash unique idempotency」。两列可空 —— 非幂等入口不带 key。
  // 唯一由 migration 末尾**手写 partial unique**,键是 **requestKey 单列**
  // (WHERE requestKey IS NOT NULL),不是 (requestKey, requestHash) 复合:
  // 复合唯一恰好放行「同一个 key 配不同 payload」——那正是幂等键要拒的冲突,
  // 复合形态等于把闸门开在错误的一侧。单列唯一严格蕴含复合唯一,故同时满足合同字面。
  requestKey  String?
  requestHash String?

  priorRevisionId String?
  reason          String?

  registration  ActivityRegistration          @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  formVersion   RegistrationFormVersion?      @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  submittedBy   User?                         @relation("RegistrationRevisionSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  priorRevision ActivityRegistrationRevision? @relation("RegistrationRevisionChain", fields: [priorRevisionId], references: [id], onDelete: Restrict)

  nextRevisions                 ActivityRegistrationRevision[]    @relation("RegistrationRevisionChain")
  answers                       RegistrationFormAnswer[]
  qualificationSnapshots        QualificationEvaluationSnapshot[]
  insuranceEligibilityEvidences InsuranceEligibilityEvidence[]    @relation("InsuranceEvidenceRegistrationRevision")

  // 第 1 批第五刀(§3.11):岗位志愿挂在报名修订上(志愿变更 ⇒ 新报名修订)。
  positionPreferences  ActivityPositionPreference[]
  // 第 85 migration：候选人冻结到精确报名 revision，不允许跨永久头拼接。
  allocationCandidates ActivityAllocationCandidate[]

  @@unique([registrationId, revision])
  @@unique([registrationId, id], map: "activity_registration_revisions_registration_id_id_unique")
  @@index([registrationId])
  @@index([formVersionId])
  @@index([submittedByUserId])
  @@index([submittedAt])
  @@index([requestKey])
  @@index([priorRevisionId])
}

// ===== §3.12 RegistrationFormVersion:报名表版本 =====
//
// 版本化模型,靠 statusCode(draft / active / retired)退场,**不软删** ⇒ 无 deletedAt。
model RegistrationFormVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String
  version    Int // 1 起递增;(activityId, version) 唯一
  statusCode String // draft / active / retired(§3.12 明写闭集)

  workflowRevision Int       @default(0)
  // ⚠️ 可空,合同字段表未标 `?` —— 偏离理由:schemaHash 是「字段集冻结指纹」,
  // 草稿仍在增删题目时无冻结值可言,自然在激活那一刻才落。
  schemaHash       String?
  activatedAt      DateTime?
  retiredAt        DateTime?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)

  fields                  RegistrationFormField[]
  registrationRevisions   ActivityRegistrationRevision[]
  uploadSessions          RegistrationUploadSession[]
  currentForRegistrations ActivityRegistration[]         @relation("RegistrationCurrentFormVersion")

  // §3.12「一活动至多一个 active」是 **partial** unique(WHERE statusCode='active'),
  // Prisma DSL 表达不了 WHERE,手写在 migration 末尾。
  @@unique([activityId, version])
  // 业务复合锚点闭合(第六轮评审 A-2 / B-03):被引用侧锚点 —— PostgreSQL 复合外键
  // 要求被引用列上有**精确匹配**的 unique;id 单列主键不能替代。仅作 FK 靶点,不新增业务约束。
  @@unique([id, activityId], map: "registration_form_version_id_activity_key")
  @@index([activityId])
  @@index([statusCode])
}

// ===== §3.12 RegistrationFormField:报名表题目 =====
//
// ⚠️ 本表**没有** deletedAt:题目属于某个冻结版本,改题 = 出新版本,不软删旧题。
//
// ⚠️ 敏感口径(见文件头):题目由发布人自定义,可能承载身份证号 / 病史 /
// 紧急联系人。合同给的两个开关就在这张表上 —— `visibilityCode`(谁能看)与
// `exportable`(能否导出)。**本刀只建列**,读侧过滤与导出裁剪在后续批次。
model RegistrationFormField {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formVersionId String
  fieldCode     String
  label         String
  helpText      String?

  // short_text / long_text / number / date / single_choice / multi_choice /
  // file / confirmation(§3.12 明写八种;migration CHECK 闭集)
  typeCode String

  required Boolean @default(false)

  // number 类题目的取值域;与 RegistrationFormAnswer.valueNumber 共用同一
  // Decimal(18,6) 域 —— 边界与取值必须可直接比较,精度不同即无法比较。
  minValue Decimal? @db.Decimal(18, 6)
  maxValue Decimal? @db.Decimal(18, 6)

  minLength     Int? // 文本长度下限
  maxLength     Int? // 文本长度上限
  maxSelections Int? // multi_choice 可选上限

  optionsJson    Json?
  // 维护者 2026-08-07 按推荐拍板的闭集:self_and_registration_staff /
  // self_and_owner / self_only。第 79 migration 用 CHECK 兜底；§3.1 的
  // internal/invitation 是活动可见性，仍是另一个域。
  visibilityCode String
  exportable     Boolean @default(false) // 默认不可导出 —— 敏感口径下的保守起点
  sortOrder      Int     @default(0)

  // Activity OS R2 / B3：legacy Field 五列全 NULL；新的 governed Field 由第 108 条
  // migration 的 all-or-none CHECK 固定四项治理码 + 空 prefill。词表与敏感启用门槛只在
  // registration-form-definition.ts 解释，避免 schema / SQL / JSON 三套闭集漂移。
  purposeCode         String?
  dataClassCode       String?
  retentionPolicyCode String?
  maskingPolicyCode   String?
  prefillSourceCode   String?

  formVersion RegistrationFormVersion  @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  answers     RegistrationFormAnswer[]

  @@unique([formVersionId, fieldCode])
  @@index([formVersionId])
  @@index([typeCode])
  @@index([formVersionId, sortOrder])
}

// ===== §3.12 RegistrationFormAnswer:一题一答 =====
//
// 挂在**不可变**的报名修订上 ⇒ 本表同样不可变,不带 updatedAt / deletedAt。
//
// exactly-one 由 migration CHECK 保证,写法是**计数式**
// (`CASE WHEN … IS NOT NULL THEN 1 ELSE 0 END` 求和 = 1),不是 AND/OR 串:
// `IS NOT NULL` 是二值谓词,CASE 求和恒为非 NULL 整数,`= 1` 恒为 TRUE 或 FALSE,
// **不可能求值成 NULL** ⇒ 不存在"表达式为 NULL 时 CHECK 判通过"的静默失效
// (第一刀 location_policy 的血教训就是踩在这上面)。
model RegistrationFormAnswer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  registrationRevisionId String
  fieldId                String

  valueText    String?
  valueNumber  Decimal?  @db.Decimal(18, 6)
  valueDate    DateTime?
  valueJson    Json?
  attachmentId String?

  registrationRevision ActivityRegistrationRevision @relation(fields: [registrationRevisionId], references: [id], onDelete: Restrict)
  field                RegistrationFormField        @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  // file 型答案指向 attachments。Restrict:答案一旦落定,附件不得被删走
  // (attachments 是硬删表,无 deletedAt)。
  attachment           Attachment?                  @relation("RegistrationAnswerAttachment", fields: [attachmentId], references: [id], onDelete: Restrict)

  @@unique([registrationRevisionId, fieldId])
  @@index([registrationRevisionId])
  @@index([fieldId])
  @@index([attachmentId])
}

// ===== §3.12 RegistrationUploadSession:报名附件上传会话 =====
//
// ⚠️ 只存 `tokenHash`(sha256 hex),**原始 token 不入库、不落日志、不进任何响应** ——
// 沿本仓 refresh_tokens.tokenHash 的 opaque + sha256 范式(§3.12 原话:
// 「原始 token 只返回一次,不入库」)。@unique 让"拿 token 换会话"是一次索引命中。
//
// §3.12 明写「不新增自动清理 cron,过期会话由现有手动 retention SOP 清理」
// ⇒ 本刀不建任何 cron / 定时任务。
model RegistrationUploadSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId    String
  memberId      String
  // 上传会话必然发生在"填某一版报名表的 file 题"语境里 ⇒ 与 §3.7 不同,这里
  // NOT NULL(合同字段表也未标 `?`)。
  formVersionId String

  tokenHash  String    @unique
  expiresAt  DateTime // §3.12 必填 —— 无过期的上传票据等于永久凭证
  consumedAt DateTime? // statusCode=consumed 当且仅当非空(第 79 migration 双向 CHECK)
  // 维护者 2026-08-07 按推荐拍板的闭集:active / consumed / revoked。第 79 migration
  // 落 statusCode CHECK；过期由 expiresAt 推导，不新增 cron。第 72 migration 的既有
  // 单向 consumedAt shape CHECK 保留，第 79 migration 只补反向半边。
  statusCode String

  activity    Activity                @relation(fields: [activityId], references: [id], onDelete: Restrict)
  member      Member                  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  formVersion RegistrationFormVersion @relation(fields: [formVersionId, activityId], references: [id, activityId], onDelete: Restrict)

  @@index([activityId])
  @@index([memberId])
  @@index([formVersionId])
  @@index([statusCode])
  @@index([expiresAt])
}

// ===== §3.13 ActivityQualificationRuleSet:资格规则冻结版本 =====
//
// 「一组规则的冻结版本,发布审核后 active」。三级作用域:活动级(session/position 皆空)、
// 场次级(sessionId 有值)、岗位级(positionId 有值)。
//
// 第 83 migration 明确闭集为 draft / active / retired；同一作用域的版本与 active
// 版本均由 NULLS NOT DISTINCT 索引去重，NULL 也参与作用域判定。
model ActivityQualificationRuleSet {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String
  sessionId  String?
  positionId String?

  version    Int
  statusCode String

  activity Activity                 @relation(fields: [activityId], references: [id], onDelete: Restrict)
  // 复合 FK(activityId, sessionId)→ ActivitySession(activityId, id):沿第一刀,
  // 让「场次属于该活动」由 DB 保证。sessionId 为 NULL 时 PostgreSQL MATCH SIMPLE
  // 不校验该 FK —— 正是活动级规则集要的行为。
  session  ActivitySession?         @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  position ActivitySessionPosition? @relation("PositionQualificationRuleSetScope", fields: [activityId, sessionId, positionId], references: [activityId, sessionId, id], onDelete: Restrict)

  rules               ActivityQualificationRule[]
  evaluationSnapshots QualificationEvaluationSnapshot[]
  // §3.3 的 ActivitySessionPosition.qualificationRuleSetId 反向侧(本刀兑现第一刀的欠账)
  scopedPositions     ActivitySessionPosition[]         @relation("PositionQualificationRuleSet")
  // 第 1 批第五刀(§3.11):预留名额组的「资格条件版本」指回本表(本表自带 version 列)。
  reservedQuotaGroups ActivityReservedQuotaGroup[]

  @@unique([activityId, sessionId, positionId, id], map: "activity_qualification_rule_set_scope_pointer_key")
  @@index([activityId])
  @@index([sessionId])
  @@index([positionId])
  @@index([statusCode])
}

// ===== §3.13 ActivityQualificationRule:单条资格规则 =====
model ActivityQualificationRule {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ruleSetId       String
  // grade / organization / certificate / age / training / gender / insurance
  // (§3.13「支持 …」七种;migration CHECK 闭集 —— 与 goal 对 §3.12「支持类型」
  //  同样按闭集处理保持一致口径)
  ruleTypeCode    String
  enforcementCode String // block / warn(§3.13 明写闭集)

  // 第 83 migration 固定 wire：grade/gender=in+codes；organization=in_subtree+
  // organizationIds；certificate/training=has_any+standardIds；age=between+
  // minYears/maxYears(可单边)；insurance=covers_activity 且 valueJson 为 NULL。
  operator  String
  valueJson Json?
  warnScore Int?
  message   String?
  sortOrder Int     @default(0)

  ruleSet ActivityQualificationRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)

  @@index([ruleSetId])
  @@index([ruleTypeCode])
  @@index([ruleSetId, sortOrder])
}

// ===== §3.13 QualificationEvaluationSnapshot:资格评估快照 =====
//
// 不可变快照 ⇒ 无 updatedAt / deletedAt。
//
// ⚠️ identityId / registrationRevisionId 双双可空,合同字段表未标 `?` —— 偏离理由
// 直接来自 §3.13 同段原话:「**展示**、提交和审核三次评估分别留快照」。**展示**发生在
// 报名之前,那一刻既没有 ParticipationIdentity 也没有 RegistrationRevision;
// 若两列 NOT NULL,展示态快照根本写不进来,合同自相矛盾。
//
// §3.13 硬约束:「不把证件号、完整保单或其他高敏感原值复制进 details,
// 只保存规则编号、结果和必要引用」—— 那是**写侧 service 的**职责,本刀只建列。
model QualificationEvaluationSnapshot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  identityId             String?
  registrationRevisionId String?
  ruleSetVersionId       String // 指向 ActivityQualificationRuleSet 行(该表自带 version 列)

  evaluatedAt         DateTime
  resultCode          String // pass / warn / fail(§3.13 明写闭集)
  // display 必须双锚点为 NULL；submit/review 只要求 registrationRevisionId，identityId 可空。
  evaluationPhaseCode String

  detailsJson    Json?
  inputFactsHash String?

  identity             ActivityParticipationIdentity? @relation(fields: [identityId], references: [id], onDelete: Restrict)
  registrationRevision ActivityRegistrationRevision?  @relation(fields: [registrationRevisionId], references: [id], onDelete: Restrict)
  ruleSetVersion       ActivityQualificationRuleSet   @relation(fields: [ruleSetVersionId], references: [id], onDelete: Restrict)

  @@index([identityId])
  @@index([registrationRevisionId])
  @@index([ruleSetVersionId])
  @@index([resultCode])
  @@index([evaluatedAt])
}

// ===== §3.14 ActivityInvitation:定向邀请 =====
//
// 「接受时调用同一 registration/qualification/capacity service,不直接改为 pass」
// —— 那是后续批次的 service 纪律,本刀只建表。
//
// ⚠️ active partial unique 是 (activityId, memberId, sessionId),而 sessionId **可空**
// (活动级邀请)。PostgreSQL 默认 NULL 互不相等 ⇒ 同一个人可被重复发出多张活动级
// 邀请而不被拦。本刀显式用 **NULLS NOT DISTINCT**(PG15+;本库 postgres:16)让 NULL
// 参与去重,沿 role_bindings_active_unique 既有先例。见 migration 末尾。
model ActivityInvitation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String
  memberId   String
  sessionId  String? // 空 = 活动级邀请
  positionId String?

  statusCode String // pending / accepted / declined / revoked / expired(§3.14 明写闭集)

  expiresAt       DateTime
  invitedByUserId String? // 沿本仓 actor FK 一律可空的既有范式
  respondedAt     DateTime?
  revokedAt       DateTime?
  reason          String?

  operationKey String?
  requestHash  String?

  activity  Activity                 @relation(fields: [activityId], references: [id], onDelete: Restrict)
  member    Member                   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  session   ActivitySession?         @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  position  ActivitySessionPosition? @relation("InvitationPosition", fields: [positionId, activityId, sessionId], references: [id, activityId, sessionId], onDelete: Restrict)
  invitedBy User?                    @relation("ActivityInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([activityId])
  @@index([memberId])
  @@index([sessionId])
  @@index([positionId])
  @@index([statusCode])
  @@index([expiresAt])
  @@index([operationKey])
}

// ===== §3.14 ActivityVisitor:现场访客 =====
//
// 🔴 **刻意零 Member relation**,不是漏了。合同 §3.14 原话:「与 Member、Participation、
// Ledger 无 relation;禁止通过访客创建贡献分」。`invitedByMemberId` 只是一个**裸字符串
// 留痕列**,不建外键、不建 relation —— 一旦接上 Member,访客就有了通往
// Participation / Ledger 的图上路径,"禁止通过访客创建贡献分"这条不变量就只剩文字。
// (Activity / ActivitySession 不在合同的禁止清单里,故双锚点 FK 照建。)
//
// 本表没有 identity / revision / 结算列,天然进不了任何贡献分链路。
model ActivityVisitor {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String
  sessionId  String

  name              String
  organization      String?
  // 🔴 裸列,**无 FK / 无 relation**(见上)。
  invitedByMemberId String?
  note              String?
  attendanceCode    String?

  activity Activity        @relation(fields: [activityId], references: [id], onDelete: Restrict)
  session  ActivitySession @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)

  @@index([activityId])
  @@index([sessionId])
  @@index([invitedByMemberId])
  @@index([attendanceCode])
}

// ============================================================================
// 活动改造 v1.1 —— 第 1 批第三刀:Punch / Evidence
// (2026-08-04;合同 docs/archive/reviews/activity-business-overhaul-v1.1/
//  §3.15 / §3.16 / §3.17 / §3.18;§14「第 1 批」建议拆分第 3 项)
//
// 本刀是纯 schema expand:**五张新表零调用方**是预期状态,消费方在第 5 批。
// 沿前两刀的四条工程判断:① 只做加法 ② 跨切片外键列不提前占位
// ③ 既有表原样保留 ④ 合同没给的一律不发明。
//
// 本刀按 ② 明确**不建**三个列(不是漏了；其中离线锚已由第 6 批补齐):
//   - AttendancePunchEvent.importJobItemId   → ActivityBatchJobItem(§3.27,第四刀)
//   - AttendancePunchEvent.offlinePackageId  → OfflinePackage(当时的合同第三处内部矛盾:
//     被 §5 列为核心新对象、被 §3.16 当外键列引用、被 §5.7 描述协议字段,
//     但 §3 数据模型从头到尾**没有定义它**。当时按 ④ 不从散文推导表结构；
//     第 6 批补充合同 v1 已给出完整字段表，见下方第 6 批模型与 migration 88)
//   - ParticipantServiceSegmentRevision.effectiveBatchId → 结算批次(§3.19/§3.22,第四刀)
//
// ⚠️ 时间重叠**刻意不进 DB**:§3.18 明写「时间重叠校验在现有 member lock 内完成」
// ⇒ 不用 exclusion constraint / btree_gist 表达段重叠,那是 service 层的事(第 5 批)。
//
// ⚠️ 坐标按普通业务字段保存(修订说明 §7 拍板):零加密仓、零隔离库、零专用保存期限。
// ⚠️ tokenDigest 只存服务端签名载荷摘要,signingKeyVersion 只是整数版本号
// ⇒ 本刀**零密钥材料、零签名实现、零 crypto 代码**(沿第二刀 tokenHash 同一纪律)。
//
// 命名沿前两刀:**不使用 @@map**,物理表名即 PascalCase model 名。
// 状态类字段一律 String + migration CHECK 闭集兜底,不建 Prisma enum(合同 §3 前言)。
// ============================================================================

// ===== §3.15 AttendanceQrCredential:场次签到/签退二维码凭证 =====
//
// §3.15 原话:「tokenDigest = 服务端签名载荷摘要,**不保存可直接使用的完整二维码文本**」。
// 本表因此只有摘要与整数密钥版本号,没有任何可复原成有效二维码的材料。
//
// §4.4:`active → revoked | expired` **不可逆**;重发建新 credentialVersion,
// 不把旧行改回 active ⇒ 「至多一个 active」用 partial unique 落 DB(§3.15 明写要求)。
model AttendanceQrCredential {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String
  sessionId  String
  actionCode String // check_in / check_out(§3.15 明写二值闭集)

  credentialVersion Int // 同 (sessionId, actionCode) 内单调递增
  statusCode        String // active / revoked / expired(§3.15 明写闭集)

  tokenDigest       String
  signingKeyVersion Int

  validFrom  DateTime
  validUntil DateTime

  issuedByUserId String? // 沿本仓 actor FK 一律可空的既有范式
  issuedAt       DateTime

  revokedByUserId String?
  revokedAt       DateTime?
  revokeReason    String?

  operationKey String? // 重发／作废防重
  requestHash  String?

  activity  Activity        @relation(fields: [activityId], references: [id], onDelete: Restrict)
  // 双锚点复合 FK:(activityId, sessionId) → ActivitySession(activityId, id),
  // 挡住「凭证挂到别的活动的场次上」(沿第一刀 ActivitySessionPosition 范式)。
  session   ActivitySession @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  issuedBy  User?           @relation("AttendanceQrCredentialIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  revokedBy User?           @relation("AttendanceQrCredentialRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  punchEvents AttendancePunchEvent[]

  // 默认名 AttendanceQrCredential_sessionId_actionCode_credentialVersion_key = 65 字符
  // > PostgreSQL 63 字符标识符上限 ⇒ 必须显式 map(否则被静默截断,与既有长名漂移同源)。
  @@unique([sessionId, actionCode, credentialVersion], map: "attendance_qr_credential_session_action_version_key")
  // 业务复合锚点闭合(第六轮评审 A-2 / B-03):被引用侧锚点 —— PostgreSQL 复合外键
  // 要求被引用列上有**精确匹配**的 unique;id 单列主键不能替代。仅作 FK 靶点,不新增业务约束。
  @@unique([id, activityId, sessionId], map: "attendance_qr_credential_id_activity_session_key")
  @@index([activityId])
  @@index([sessionId])
  @@index([statusCode])
  @@index([validUntil])
  @@index([operationKey])
  @@index([sessionId, actionCode, statusCode])
}

// ===== §3.16 AttendancePunchEvent:追加式打卡事件 =====
//
// §3.16 原话:「正式现场事实的**唯一写入表**,不提供 update/delete endpoint」
// +「append-only trigger／权限:生产业务角色不得 UPDATE/DELETE」。
// ⇒ 本表由 **DB trigger** 强制 append-only(migration 末尾,镜像既有
//    trg_insurance_evidence_20_immutable 的「函数 + trigger」两段范式)。
//
// 不可变模型 ⇒ 按合同 §3 前言 **不带 updatedAt / deletedAt**
// (§3.16 字段表亦明写「createdAt 入库时间;无 updatedAt/deletedAt」)。
//
// 第 6 批补齐 offlinePackageId 与四个离线链锚点；importJobItemId 已由第 4 批补齐。
model AttendancePunchEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  activityId String
  sessionId  String
  positionId String?

  participationIdentityId String
  memberId                String

  eventTypeCode String // check_in / check_out / early_departure_close / void / replace
  sourceCode    String // self_qr / staff_scan / proxy / bulk / import / offline / correction

  occurredAt DateTime // 真实发生时间;在线由服务端生成(DTO 不接客户端时间)
  receivedAt DateTime // 服务端收到时间

  operatorUserId   String // §3.16「本人自助也记录 User」⇒ 恒有值
  operatorMemberId String?

  reason String? // 特殊闭合、作废和替代必填(CHECK 兜底);见下方 reason CHECK 的口径说明

  qrCredentialId String?
  deviceId       String?

  // 🟢 **兑现第三刀欠账**(第三刀按「跨切片外键列不提前占位」暂缓,目标表 §3.27
  //    ActivityBatchJobItem 正是本刀建的):import / bulk 来源的事件指回产生它的任务项。
  //    可空 —— 自助 / 现场扫码等在线来源没有任务项。
  //    ⚠️ 本表有 append-only trigger,但加列走的是 ALTER TABLE ADD COLUMN(DDL),
  //       行级 trigger 不参与 DDL;加列后已重跑该 trigger 的四条判据(见 migration 说明)。
  importJobItemId String?

  // 第 6 批离线上传/人工复核的不可变链锚点。只有 sourceCode='offline' 才能同空同有，
  // 由 migration 的计数式 CHECK 兜底；绝不存 raw package token、签名或原始 payload。
  offlinePackageId        String?
  offlineSequence         Int?
  offlinePriorHash        String?
  offlineEventPayloadHash String?

  // §3.16「普通业务字段,可空」;修订说明 §7 拍板坐标按普通业务字段保存。
  // 精度沿既有 activity_check_ins:经纬度 Decimal(10,7)、精度/距离 Decimal(10,2)。
  longitude Decimal? @db.Decimal(10, 7)
  latitude  Decimal? @db.Decimal(10, 7)
  accuracy  Decimal? @db.Decimal(10, 2)
  distance  Decimal? @db.Decimal(10, 2)

  // 判定快照:写入时冻结,不回查规则(沿 §3.4「不实时继承」同一思路)。
  geoVerified Boolean @default(false)
  outOfRange  Boolean @default(false)
  lowAccuracy Boolean @default(false)

  eventKey    String // 客户端或任务防重号,**全局 unique**(§3.16 + §11.3)
  requestHash String

  supersedesEventId String? // void / replace 的目标事件
  evidenceRevision  Int // 本事件提交后活动证据版本

  activity              Activity                      @relation(fields: [activityId], references: [id], onDelete: Restrict)
  session               ActivitySession               @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  position              ActivitySessionPosition?      @relation("PunchEventPosition", fields: [positionId, activityId, sessionId], references: [id, activityId, sessionId], onDelete: Restrict)
  participationIdentity ActivityParticipationIdentity @relation(fields: [participationIdentityId, activityId, sessionId, memberId], references: [id, activityId, sessionId, memberId], onDelete: Restrict)
  member                Member                        @relation("AttendancePunchEventMember", fields: [memberId], references: [id], onDelete: Restrict)
  operatorUser          User                          @relation("AttendancePunchEventOperatorUser", fields: [operatorUserId], references: [id], onDelete: Restrict)
  operatorMember        Member?                       @relation("AttendancePunchEventOperatorMember", fields: [operatorMemberId], references: [id], onDelete: Restrict)
  qrCredential          AttendanceQrCredential?       @relation(fields: [qrCredentialId, activityId, sessionId], references: [id, activityId, sessionId], onDelete: Restrict)
  importJobItem         ActivityBatchJobItem?         @relation("PunchEventImportJobItem", fields: [importJobItemId], references: [id], onDelete: Restrict)
  offlinePackage        OfflinePackage?               @relation("OfflinePackagePunchEvents", fields: [offlinePackageId, activityId, sessionId], references: [id, activityId, sessionId], onDelete: Restrict)
  offlineReviewItem     OfflinePunchReviewItem?       @relation("OfflineReviewFormalPunchEvent")

  supersedesEvent AttendancePunchEvent?  @relation("PunchEventSupersede", fields: [supersedesEventId, activityId, sessionId, memberId], references: [id, activityId, sessionId, memberId], onDelete: Restrict)
  supersededBy    AttendancePunchEvent[] @relation("PunchEventSupersede")

  serviceSegmentCheckIns ParticipantServiceSegmentRevision[] @relation("SegmentSourceCheckInEvent")
  serviceSegmentCloses   ParticipantServiceSegmentRevision[] @relation("SegmentSourceCloseEvent")

  @@unique([eventKey])
  @@unique([offlinePackageId, offlineSequence], map: "attendance_punch_event_offline_package_sequence_key")
  // 业务复合锚点闭合(第六轮评审 A-2 / B-03):被引用侧锚点 —— PostgreSQL 复合外键
  // 要求被引用列上有**精确匹配**的 unique;id 单列主键不能替代。仅作 FK 靶点,不新增业务约束。
  @@unique([id, activityId, sessionId, memberId], map: "attendance_punch_event_id_activity_session_member_key")
  // 业务复合锚点闭合(第六轮评审 A-2 / B-03):被引用侧锚点 —— PostgreSQL 复合外键
  // 要求被引用列上有**精确匹配**的 unique;id 单列主键不能替代。仅作 FK 靶点,不新增业务约束。
  @@unique([id, activityId, sessionId], map: "attendance_punch_event_id_activity_session_key")
  // §11.3 点名的三条:
  @@index([activityId, sessionId, occurredAt])
  @@index([participationIdentityId, occurredAt], map: "attendance_punch_event_identity_occurred_idx")
  @@index([operatorUserId, createdAt])
  @@index([activityId])
  @@index([sessionId])
  @@index([positionId])
  @@index([memberId])
  @@index([eventTypeCode])
  @@index([qrCredentialId])
  @@index([supersedesEventId])
  @@index([importJobItemId])
  @@index([offlinePackageId])
}

// ===== §3.17 ActivityEvidenceState:一活动一行的证据/人口版本指针 =====
//
// §3.17:由 PunchEvent、ParticipationRevision、场次取消／终止、人工复核正式化
// **同事务**递增。本刀只建表与约束,不写任何递增逻辑(第 2 批)。
model ActivityEvidenceState {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String @unique // §3.17「一活动一行」

  evidenceRevision   Int @default(0)
  populationRevision Int @default(0)
  version            Int @default(0) // CAS 版本

  lastEvidenceAt   DateTime?
  lastPopulationAt DateTime?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
}

// ===== §3.17 EvidenceSeal:不可变封场凭证 =====
//
// 「不可变」指**内容**不可变(evidenceRevision / contentHash / 计数快照一旦写入不改);
// §4.6 明确 statusCode 走 `active → superseded` 投影(「可在新 seal 写入时把旧 active 改
// superseded 作为投影」)⇒ 本行**会被 UPDATE**,故按合同 §3 前言默认带 updatedAt,
// 且**不装** append-only trigger(与 AttendancePunchEvent 的处置刻意不同)。
//
// ⚠️ 合同**未给**「一活动至多一个 active seal」的 partial unique
// (§11.3 只给 Closure 点了 partial unique active,Seal 没给)⇒ 按 ④ 不自行发明。
model EvidenceSeal {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId   String
  sealRevision Int

  evidenceRevision   Int
  populationRevision Int
  workflowRevision   Int

  allWindowsClosedAt       DateTime
  openSegmentCount         Int
  manualReviewPendingCount Int

  populationCountDistinct  Int
  populationCountBySession Json

  contentHash String
  statusCode  String // active / superseded(§3.17 明写闭集)

  sealedByUserId String? // 沿本仓 actor FK 一律可空的既有范式
  sealedAt       DateTime

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  sealedBy User?    @relation("EvidenceSealSealer", fields: [sealedByUserId], references: [id], onDelete: Restrict)

  // 第 1 批第四刀反向 relation(合同 §3.19 / §3.26):仅关系映射,零标量字段。
  settlementVersions AttendanceSettlementVersion[]
  closureRevisions   ActivitySettlementClosureRevision[]

  @@unique([activityId, sealRevision])
  @@index([activityId])
  @@index([statusCode])
  @@index([sealedAt])
}

// ===== §3.18 ParticipantServiceSegmentRevision:服务段投影与修订 =====
//
// §3.18:服务段**不是**直接人工编辑的主事实 —— 普通草稿由 PunchEvent 重建;
// 认定变更形成**新的** segment revision,不覆盖旧 revision。
//
// ⚠️ **时间重叠不进 DB**:§3.18 明写「时间重叠校验在现有 member lock 内完成」
// ⇒ 刻意不用 exclusion constraint / btree_gist(见文件头)。
// DB 只落「每个 (identityId, segmentKey) 至多一个非 superseded 当前修订」这条
// 单点 partial unique —— 它是**点唯一**不是**区间不相交**,两者不是一回事。
//
// ⚠️ effectiveBatchId **本刀不建**(结算批次表在第四刀),见文件头。
model ParticipantServiceSegmentRevision {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participationIdentityId String
  segmentKey              String
  revision                Int

  sourceCheckInEventId String
  // ⚠️ 合同字段表未标 `?`,本刀**改可空并上报**:§4.5「无开放段＋check_in → open」
  // 说明存在「已签到、尚未闭合」的段,此刻闭合事件根本不存在;NOT NULL 会让该形态
  // 写不进来(沿第二刀 QualificationEvaluationSnapshot 同一处置)。
  sourceCloseEventId   String?

  resultCode String // valid / early_departure_zero / voided / replaced(§3.18 明写闭集)
  statusCode String // draft / committed / superseded(§3.18 明写闭集)

  checkInAt    DateTime
  // 同上:开放段没有签退时间与时长。
  checkOutAt   DateTime?
  serviceHours Decimal?  @db.Decimal(5, 2) // 精度沿既有 AttendanceRecord.serviceHours

  lateFlag           Boolean @default(false)
  earlyLeaveFlag     Boolean @default(false)
  exceptionFlagsJson Json?

  baseRevisionId String? // 首个 revision 无前驱

  // 🟢 **兑现第三刀欠账**(目标表 §3.22 LedgerPostingBatch 正是本刀建的):
  //    §3.18 字段表原文 `baseRevisionId/effectiveBatchId?` —— 合同**自带** `?`,
  //    正式生效前(draft 段)本就没有批次。
  effectiveBatchId String?

  identity           ActivityParticipationIdentity @relation(fields: [participationIdentityId], references: [id], onDelete: Restrict)
  sourceCheckInEvent AttendancePunchEvent          @relation("SegmentSourceCheckInEvent", fields: [sourceCheckInEventId], references: [id], onDelete: Restrict)
  sourceCloseEvent   AttendancePunchEvent?         @relation("SegmentSourceCloseEvent", fields: [sourceCloseEventId], references: [id], onDelete: Restrict)

  baseRevision     ParticipantServiceSegmentRevision?  @relation("SegmentBaseRevision", fields: [baseRevisionId], references: [id], onDelete: Restrict)
  derivedRevisions ParticipantServiceSegmentRevision[] @relation("SegmentBaseRevision")

  effectiveBatch LedgerPostingBatch? @relation("SegmentEffectiveBatch", fields: [effectiveBatchId], references: [id], onDelete: Restrict)

  // model 名 33 字符 ⇒ 复合索引默认名普遍越过 PostgreSQL 63 字符上限,全部显式 map。
  @@unique([participationIdentityId, segmentKey, revision], map: "participant_service_segment_identity_key_revision_key")
  @@index([participationIdentityId], map: "participant_service_segment_identity_idx")
  @@index([participationIdentityId, statusCode], map: "participant_service_segment_identity_status_idx")
  @@index([statusCode], map: "participant_service_segment_status_idx")
  @@index([resultCode], map: "participant_service_segment_result_idx")
  @@index([sourceCheckInEventId], map: "participant_service_segment_checkin_event_idx")
  @@index([sourceCloseEventId], map: "participant_service_segment_close_event_idx")
  @@index([baseRevisionId], map: "participant_service_segment_base_revision_idx")
  @@index([effectiveBatchId], map: "participant_service_segment_effective_batch_idx")
}

// ============================================================================
// 活动改造 v1.1 —— 第 1 批第四刀:Settlement / Ledger / Correction / Closure / Job
// (2026-08-04;合同 docs/archive/reviews/activity-business-overhaul-v1.1/
//  §3.19 / §3.20 / §3.21 / §3.22 / §3.23 / §3.24 / §3.25 / §3.26 / §3.27;
//  §14「第 1 批」建议拆分第 4 项)
//
// 本刀是纯 schema expand:**十四张新表零调用方**是预期状态,消费方在第 2 批。
// 沿前三刀的四条工程判断:① 只做加法 ② 跨切片外键列不提前占位
// ③ 既有表原样保留 ④ 合同没给的一律不发明。
//
// 🔴 本刀语义像钱:`ParticipationLedgerEntry` 一旦随 batch committed 就是队员贡献值真值。
//
// 本刀**兑现**前面欠下的两个列(第三刀按 ② 暂缓,目标表正是本刀建的):
//   - ParticipantServiceSegmentRevision.effectiveBatchId → LedgerPostingBatch(§3.22)
//   - AttendancePunchEvent.importJobItemId               → ActivityBatchJobItem(§3.27)
//
// 本刀按 ② 仍**不建**:AttendancePunchEvent.offlinePackageId(OfflinePackage 当时是合同第三处
// 内部矛盾,§3 从未定义该表；第 6 批补充合同 v1 已另行补齐);§3.11 分配相关四表与
// ActivityParticipationRevision.allocationBatchId(**合同第四处内部矛盾**:§14 任何一刀
// 都没列入,而第 4 批行为实现要用 —— 维护者 2026-08-04 拍板另走第五刀)。
//
// ⚠️ 「日合计 0..3」(§3.24)**刻意不进任何表级 CHECK / trigger**:那是**跨行**不变量
//    (同一 member 同一 ledgerDate 的多条分录求和),表级 CHECK 只能看单行,trigger 伪造
//    跨行求和会在并发下骗人。跨行日上限归 service(第 2 批,在既有 member advisory lock 内)。
//    详见 migration 末尾的具名声明段。
//
// ⚠️ `ledgerDate` **唯一选型 = `DateTime @db.Date`**(§3.21 明写「必须唯一选型」),
//    三处同型:ParticipantSettlementDay / ParticipationLedgerEntry /
//    MemberContributionDayState。混型会让 (memberId, ledgerDate) 唯一在跨表 join 时静默错位。
//    业务侧的北京日换算统一走 BeijingCalendarService(第 2 批),本刀零转换代码。
//
// ⚠️ worker 协议**零新增基础设施**(§3.27):`ActivityBatchJob` 的 lease/fencing 列镜像
//    既有 outbox / storage-operation 两张表的形状,复用 PostgreSQL `SKIP LOCKED + lease`。
//    本刀**不新增 cron**(全仓终态恰 2)、不引入 Redis/queue、不注册 worker 进程。
//
// ⚠️ **不存敏感原值**(§3.27 明写):`ActivityBatchJobItem` 只有 `lastErrorCode`(编码)与
//    `safeMessage`(已脱敏文案),**没有为异常堆栈 / SQL / 敏感原值预留任何字段**;
//    `ActivitySettlementClosureRevision.checksJson` 只存非敏感摘要与失败计数,不复制人员明细。
//
// 命名沿前三刀:**不使用 @@map**,物理表名即 PascalCase model 名。
// 状态类字段一律 String + migration CHECK 闭集兜底,不建 Prisma enum(合同 §3 前言)。
// 本刀 model 名普遍 ≥ 24 字符 ⇒ 复合索引默认名易越过 PostgreSQL 63 字符上限并被静默截断,
// 故**所有** @@unique / @@index 一律显式 `map:`(沿第三刀 ParticipantServiceSegmentRevision)。
// ============================================================================

// ===== §3.19 AttendanceSettlementRun:结算根,一活动一行 =====
//
// §3.19:「状态是页面投影和流程根,正式人员结果／账本仍由版本和 batch 主导」
// ⇒ 本行**会被 UPDATE**(statusCode / 各 current* 指针 / version CAS),按 §3 前言带 updatedAt。
model AttendanceSettlementRun {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String @unique // §3.19「一活动一行」

  // not_started / drafting / submitted / pending_first_review / pending_final_review
  // / posting / posted / correction_open / closed(§3.19 明写九值闭集)
  statusCode String

  // 快速指针,不是真相源(真相在 Version / PostingBatch / ClosureRevision 行上)。
  currentDraftVersion     Int?
  currentSubmittedVersion Int?
  currentPostedVersion    Int?
  currentClosureRevision  Int?

  version Int @default(0) // CAS

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)

  versions           AttendanceSettlementVersion[]
  postingBatches     LedgerPostingBatch[]
  correctionRequests AttendanceCorrectionRequest[]

  @@index([statusCode], map: "attendance_settlement_run_status_idx")
}

// ===== §3.19 AttendanceSettlementVersion:不可变提交版本 =====
//
// 「不可变」指**内容**不可变(evidenceSealId / contentHash / 三个计数快照一旦写入不改);
// 但 §3.19 的 statusCode 闭集含 `returned/approved/voided` —— 审核结果要写回本行
// ⇒ 本行**会被 UPDATE**,故按 §3 前言带 updatedAt,且**不装** append-only trigger。
// 这与第三刀 EvidenceSeal 的处置逐字同源(内容不可变 ≠ 行不可变)。
model AttendanceSettlementVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settlementRunId String
  version         Int

  evidenceSealId     String
  evidenceRevision   Int
  populationRevision Int
  workflowRevision   Int

  contentHash               String
  personCount               Int
  sessionParticipationCount Int
  serviceSegmentCount       Int

  createdByUserId String? // 沿本仓 actor FK 一律可空的既有范式
  submittedAt     DateTime?

  statusCode String // draft / submitted / returned / approved / voided(§3.19 明写五值闭集)

  priorVersionId  String? // 首版无前驱
  returnFromStage String? // 仅退回版本有值
  returnReason    String?

  operationKey String?
  requestHash  String?

  settlementRun AttendanceSettlementRun @relation(fields: [settlementRunId], references: [id], onDelete: Restrict)
  evidenceSeal  EvidenceSeal            @relation(fields: [evidenceSealId], references: [id], onDelete: Restrict)
  createdBy     User?                   @relation("SettlementVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  priorVersion    AttendanceSettlementVersion?  @relation("SettlementVersionPrior", fields: [priorVersionId], references: [id], onDelete: Restrict)
  derivedVersions AttendanceSettlementVersion[] @relation("SettlementVersionPrior")

  reviewActions      SettlementReviewAction[]
  resultRevisions    ParticipantSettlementResultRevision[]
  postingBatches     LedgerPostingBatch[]
  closureRevisions   ActivitySettlementClosureRevision[]
  correctionRequests AttendanceCorrectionRequest[]         @relation("CorrectionRequestBaseVersion")
  correctionApplied  CorrectionApplication[]               @relation("CorrectionApplicationNewVersion")
  batchJobs          ActivityBatchJob[]

  @@unique([settlementRunId, version], map: "attendance_settlement_version_run_version_key")
  @@index([settlementRunId], map: "attendance_settlement_version_run_idx")
  @@index([statusCode], map: "attendance_settlement_version_status_idx")
  @@index([evidenceSealId], map: "attendance_settlement_version_seal_idx")
  @@index([priorVersionId], map: "attendance_settlement_version_prior_idx")
  @@index([operationKey], map: "attendance_settlement_version_operation_key_idx")
}

// ===== §3.19 SettlementReviewAction:审核动作,append-only =====
//
// §3.19 明写 append-only ⇒ 按 §3 前言**不带 updatedAt / deletedAt**。
// ⚠️ 与 ParticipationLedgerEntry 不同,合同**没有**为本表点名「数据库角色层禁止
//    UPDATE/DELETE」(那句只写在 §3.23.8 账本上)⇒ 本刀**不装** append-only trigger,
//    只用「无 updatedAt + 至多一个生效决定」的形状表达。沿 ④ 不自行加码。
//
// 🔴 actorUserId 取 NOT NULL(合同字段表未标 `?`):§3.19 的「提交人／一审人／终审人分离」
//    是事务内硬不变量,审核动作没有 actor 就无法复判分离 —— 与第三刀
//    AttendancePunchEvent.operatorUserId 同一处置(该列亦因合同点名而 NOT NULL)。
model SettlementReviewAction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  settlementVersionId String
  stageCode           String // first / final(§3.19 明写二值闭集)
  actionCode          String // approve / return(§3.19 明写二值闭集)

  actorUserId String
  actedAt     DateTime
  note        String?

  operationKey String  @unique // §3.19 明写 unique;单列不复合(复合恰好放行同 key 不同 payload)
  requestHash  String?

  settlementVersion AttendanceSettlementVersion @relation(fields: [settlementVersionId], references: [id], onDelete: Restrict)
  actor             User                        @relation("SettlementReviewActionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([settlementVersionId], map: "settlement_review_action_version_idx")
  @@index([settlementVersionId, stageCode], map: "settlement_review_action_version_stage_idx")
  @@index([actorUserId, actedAt], map: "settlement_review_action_actor_acted_idx")
}

// ===== §3.20 ParticipantSettlementResultRevision:人员结算结果修订 =====
//
// §3.20:unique `(settlementVersionId, participationIdentityId)` —— 一个 identity
// 每个正式版本**一条**(注意:unique 不含 revision,revision 只是本条的修订序号)。
// statusCode `draft/committed/superseded` 是投影 ⇒ 本行会被 UPDATE,带 updatedAt。
model ParticipantSettlementResultRevision {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settlementVersionId     String
  participationIdentityId String
  revision                Int

  // present / leave / absent / cancelled / not_selected / waitlist_expired
  // / review_expired / invitation_expired / exempt / early_departure_zero(§3.20 明写十值闭集)
  resultCode String

  lateFlag           Boolean @default(false)
  earlyLeaveFlag     Boolean @default(false)
  exceptionFlagsJson Json?

  // 精度沿既有 AttendanceRecord.serviceHours / contributionPoints = Decimal(5,2)。
  // 四列**均 NOT NULL**:请假/缺席/未入选等零结果写 0,不是写 NULL ——
  // 「认定 ≠ 计算 ⇒ adjustmentReason 必填」那条 CHECK 依赖它们可比较。
  recognizedServiceHours       Decimal @db.Decimal(5, 2)
  recognizedContributionPoints Decimal @db.Decimal(5, 2)
  calculatedServiceHours       Decimal @db.Decimal(5, 2)
  calculatedContributionPoints Decimal @db.Decimal(5, 2)

  adjustmentReason String? // §3.20:认定与计算不同**必填**(migration CHECK 兜底)

  statusCode String // draft / committed / superseded(§3.20 明写三值闭集)

  baseResultRevisionId String? // 首个 revision 无前驱
  correctionRequestId  String?

  settlementVersion AttendanceSettlementVersion   @relation(fields: [settlementVersionId], references: [id], onDelete: Restrict)
  identity          ActivityParticipationIdentity @relation(fields: [participationIdentityId], references: [id], onDelete: Restrict)

  baseResultRevision ParticipantSettlementResultRevision?  @relation("ResultRevisionBase", fields: [baseResultRevisionId], references: [id], onDelete: Restrict)
  derivedRevisions   ParticipantSettlementResultRevision[] @relation("ResultRevisionBase")

  correctionRequest AttendanceCorrectionRequest? @relation(fields: [correctionRequestId], references: [id], onDelete: Restrict)

  settlementDays ParticipantSettlementDay[]
  ledgerEntries  ParticipationLedgerEntry[]

  @@unique([settlementVersionId, participationIdentityId], map: "participant_settlement_result_version_identity_key")
  // §11.3 点名的两条:
  @@index([settlementVersionId, resultCode], map: "participant_settlement_result_version_result_idx")
  @@index([participationIdentityId, statusCode], map: "participant_settlement_result_identity_status_idx")
  @@index([statusCode], map: "participant_settlement_result_status_idx")
  @@index([baseResultRevisionId], map: "participant_settlement_result_base_idx")
  @@index([correctionRequestId], map: "participant_settlement_result_correction_idx")
}

// ===== §3.21 ParticipantSettlementDay:北京日拆分 =====
//
// 🔴 `ledgerDate` = `DateTime @db.Date`(§3.21 明写「必须唯一选型」)—— 三处同型之一。
//
// ⚠️ 本表也有 recognized / credited / cappedOut 三列,但**刻意不落**
//    `recognized = credited + cappedOut` 的等式 CHECK:§3.23.6 只把该等式加在
//    **账本分录**上,而 §3.21 明写本表「preparing 阶段可重算」—— 重算是分步 UPDATE,
//    中途出现不平衡是合法过程态,加等式会静默误杀合法写入(沿第三刀「过严 CHECK 会误杀
//    合法行」的实测教训)。等式的执法位在 ParticipationLedgerEntry 上,那里 committed 即真值。
model ParticipantSettlementDay {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resultRevisionId String
  memberId         String
  ledgerDate       DateTime @db.Date

  serviceHours     Decimal @db.Decimal(5, 2)
  recognizedPoints Decimal @db.Decimal(5, 2)
  creditedPoints   Decimal @db.Decimal(5, 2)
  cappedOutPoints  Decimal @db.Decimal(5, 2)

  sequenceStartAt DateTime // 当日服务起点,日内稳定排序的第一键
  stableOrderKey  String // 同起点时的确定性 tiebreaker(不依赖 id 生成顺序)

  resultRevision ParticipantSettlementResultRevision @relation(fields: [resultRevisionId], references: [id], onDelete: Restrict)
  member         Member                              @relation("ParticipantSettlementDayMember", fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([resultRevisionId, ledgerDate], map: "participant_settlement_day_result_date_key")
  @@index([memberId, ledgerDate], map: "participant_settlement_day_member_date_idx")
  @@index([resultRevisionId], map: "participant_settlement_day_result_idx")
}

// ===== §3.22 LedgerPostingBatch:账本发布批次 =====
//
// §3.22:「准备中和 ready 分录必须对所有正常读面不可见,只允许通过
// `batch.statusCode='committed'` join 后读取」⇒ 可见性由 batch 状态决定,
// 本刀只建表与约束,读面切换在第 2 批。
model LedgerPostingBatch {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settlementRunId     String
  settlementVersionId String
  batchRevision       Int // 同一 run 内单调递增

  statusCode String // preparing / ready / committed / failed / voided(§3.22 明写五值闭集)

  requestKey  String  @unique // 幂等键;**单列**不复合(复合恰好放行同 key 不同 payload)
  requestHash String?

  baselineJsonHash String? // seal、人员、day-state 基线摘要

  preparedCount Int @default(0)
  totalCount    Int @default(0)
  failureCount  Int @default(0)

  preparedAt  DateTime?
  committedAt DateTime?
  failedAt    DateTime?
  voidedAt    DateTime?

  preparedByUserId  String? // 沿本仓 actor FK 一律可空的既有范式
  committedByUserId String?

  version Int @default(0) // CAS

  settlementRun     AttendanceSettlementRun     @relation(fields: [settlementRunId], references: [id], onDelete: Restrict)
  settlementVersion AttendanceSettlementVersion @relation(fields: [settlementVersionId], references: [id], onDelete: Restrict)
  preparedBy        User?                       @relation("LedgerPostingBatchPreparer", fields: [preparedByUserId], references: [id], onDelete: Restrict)
  committedBy       User?                       @relation("LedgerPostingBatchCommitter", fields: [committedByUserId], references: [id], onDelete: Restrict)

  ledgerEntries     ParticipationLedgerEntry[]
  dayStates         MemberContributionDayState[]
  closureRevisions  ActivitySettlementClosureRevision[]
  correctionApplied CorrectionApplication[]             @relation("CorrectionApplicationNewBatch")
  batchJobs         ActivityBatchJob[]
  effectiveSegments ParticipantServiceSegmentRevision[] @relation("SegmentEffectiveBatch")

  @@unique([settlementVersionId, batchRevision], map: "ledger_posting_batch_version_revision_key")
  // §11.3 点名的两条:
  @@index([statusCode, createdAt], map: "ledger_posting_batch_status_created_idx")
  @@index([settlementVersionId], map: "ledger_posting_batch_version_idx")
  @@index([settlementRunId], map: "ledger_posting_batch_run_idx")
}

// ===== §3.23 ParticipationLedgerEntry:正式账本 =====
//
// 🔴 §3.23 明写「append-only,无 updatedAt/deletedAt」+ §3.23.8「只允许 INSERT;
//    数据库角色层禁止业务账号 UPDATE/DELETE」⇒ 由 **DB trigger** 强制,
//    镜像第三刀 AttendancePunchEvent 的函数 + trigger 两段范式(本刀第二组)。
//
// 🔴 §3.23.6「recognized = credited + cappedOut 对每个贡献分录成立」——
//    四个 delta 列**全部 NOT NULL**,且 migration 里的等式 CHECK 把
//    `IS NOT NULL` 守卫写在 AND 链**最前**(AND 是 FALSE-主导 ⇒ 整式结构上不可能塌成 NULL,
//    不会出现「表达式为 NULL ⇒ CHECK 判通过」的静默失效)。两道防线,见 migration 说明。
//
// 🔴 `ledgerDate` = `DateTime @db.Date` —— 三处同型之二。
model ParticipationLedgerEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  postingBatchId String

  entryKey     String  @unique // 分录级幂等键
  operationKey String  @unique // 操作级幂等键
  requestHash  String?

  memberId                String
  activityId              String
  sessionId               String
  participationIdentityId String
  resultRevisionId        String

  ledgerDate DateTime @db.Date

  // service_credit / contribution_credit / service_reversal / contribution_reversal
  entryTypeCode String

  // 精度沿既有 AttendanceRecord.serviceHours / contributionPoints = Decimal(5,2)。
  // 四列**均 NOT NULL** —— 账本没有「不知道」的余地,冲回写负数不写 NULL。
  serviceHoursDelta     Decimal @db.Decimal(5, 2)
  recognizedPointsDelta Decimal @db.Decimal(5, 2)
  creditedPointsDelta   Decimal @db.Decimal(5, 2)
  cappedOutPointsDelta  Decimal @db.Decimal(5, 2)

  reversesEntryId String? // §3.23.4:reversal 必带;普通 credit 不得带(migration CHECK)

  postingBatch   LedgerPostingBatch                  @relation(fields: [postingBatchId], references: [id], onDelete: Restrict)
  member         Member                              @relation("ParticipationLedgerEntryMember", fields: [memberId], references: [id], onDelete: Restrict)
  activity       Activity                            @relation(fields: [activityId], references: [id], onDelete: Restrict)
  // 双锚点复合 FK:(activityId, sessionId) → ActivitySession(activityId, id),
  // 挡住「分录挂到别的活动的场次上」(沿第一刀 / 第三刀范式)。
  session        ActivitySession                     @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  identity       ActivityParticipationIdentity       @relation(fields: [participationIdentityId, activityId, sessionId, memberId], references: [id, activityId, sessionId, memberId], onDelete: Restrict)
  resultRevision ParticipantSettlementResultRevision @relation(fields: [resultRevisionId], references: [id], onDelete: Restrict)

  reversesEntry ParticipationLedgerEntry?  @relation("LedgerEntryReversal", fields: [reversesEntryId, activityId, sessionId, memberId], references: [id, activityId, sessionId, memberId], onDelete: Restrict)
  reversedBy    ParticipationLedgerEntry[] @relation("LedgerEntryReversal")

  reversalClaim LedgerEntryReversalClaim? @relation("ReversalClaimOriginalEntry")

  @@unique([postingBatchId, resultRevisionId, ledgerDate, entryTypeCode], map: "participation_ledger_entry_batch_result_date_type_key")
  // 业务复合锚点闭合(第六轮评审 A-2 / B-03):被引用侧锚点 —— PostgreSQL 复合外键
  // 要求被引用列上有**精确匹配**的 unique;id 单列主键不能替代。仅作 FK 靶点,不新增业务约束。
  @@unique([id, activityId, sessionId, memberId], map: "participation_ledger_entry_id_activity_session_member_key")
  // §11.3 点名的三条:
  @@index([memberId, ledgerDate], map: "participation_ledger_entry_member_date_idx")
  @@index([activityId, postingBatchId], map: "participation_ledger_entry_activity_batch_idx")
  @@index([postingBatchId, resultRevisionId], map: "participation_ledger_entry_batch_result_idx")
  @@index([sessionId], map: "participation_ledger_entry_session_idx")
  @@index([participationIdentityId], map: "participation_ledger_entry_identity_idx")
  @@index([entryTypeCode], map: "participation_ledger_entry_type_idx")
  @@index([reversesEntryId], map: "participation_ledger_entry_reverses_idx")
}

// ===== §3.23.5 LedgerEntryReversalClaim:冲回占位辅助表 =====
//
// §3.23.5 **点名**要这张辅助表:「一条原 entry 至多被一个 committed reversal 逻辑冲回;
// 因跨 batch 状态,service 锁后检查 + partial unique 辅助表
// `LedgerEntryReversalClaim(originalEntryId unique)`」。
//
// 沿 ④:合同只点名 `originalEntryId unique` 这一件事,故本表**只有这一列**。
// 「是哪条 reversal 冲的」不需要再存一列 —— ParticipationLedgerEntry.reversesEntryId
// 已经指回 originalEntryId,加列反而是两处真相源。
model LedgerEntryReversalClaim {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  originalEntryId String @unique

  originalEntry ParticipationLedgerEntry @relation("ReversalClaimOriginalEntry", fields: [originalEntryId], references: [id], onDelete: Restrict)
}

// ===== §3.24 MemberContributionDayState:持久化日版本行 =====
//
// §3.24 明写「**不是**新的 advisory lock」—— 本表只承载日版本与日合计,
// 排他性仍由既有 member advisory lock 提供,本刀**不建第二套 member 锁域**。
//
// 🔴 `ledgerDate` = `DateTime @db.Date` —— 三处同型之三。
//
// ⚠️ §3.24「日合计必须 0..3」**刻意不落 CHECK** —— 见文件头与 migration 末尾具名声明。
model MemberContributionDayState {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberId   String
  ledgerDate DateTime @db.Date

  version                 Int     @default(0)
  committedCreditedPoints Decimal @default(0) @db.Decimal(5, 2)

  latestBatchId String?

  member      Member              @relation("MemberContributionDayStateMember", fields: [memberId], references: [id], onDelete: Restrict)
  latestBatch LedgerPostingBatch? @relation(fields: [latestBatchId], references: [id], onDelete: Restrict)

  @@unique([memberId, ledgerDate], map: "member_contribution_day_state_member_date_key")
  @@index([ledgerDate], map: "member_contribution_day_state_date_idx")
  @@index([latestBatchId], map: "member_contribution_day_state_batch_idx")
}

// ===== §3.25 AttendanceCorrectionRequest:更正申请 =====
model AttendanceCorrectionRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId              String
  settlementRunId         String
  participationIdentityId String? // §3.25 明标 `?`:活动级更正没有单人锚点

  baseSettlementVersionId String
  baseResultRevisionId    String? // §3.25 明标 `?`
  baseClosureRevision     Int

  requestTypeCode String // result / service / time / points / person_identity / other

  requestedChangeJson Json
  reason              String
  attachmentIds       Json?

  // pending / returned / approved / rejected / applying / applied / voided(§3.25 明写七值闭集)
  statusCode String

  submittedByUserId String? // 沿本仓 actor FK 一律可空的既有范式
  submittedAt       DateTime
  reviewedByUserId  String?
  reviewedAt        DateTime?
  reviewNote        String?

  operationKey String?
  requestHash  String?
  version      Int     @default(0) // CAS

  activity              Activity                       @relation(fields: [activityId], references: [id], onDelete: Restrict)
  settlementRun         AttendanceSettlementRun        @relation(fields: [settlementRunId], references: [id], onDelete: Restrict)
  identity              ActivityParticipationIdentity? @relation(fields: [participationIdentityId], references: [id], onDelete: Restrict)
  baseSettlementVersion AttendanceSettlementVersion    @relation("CorrectionRequestBaseVersion", fields: [baseSettlementVersionId], references: [id], onDelete: Restrict)
  submittedBy           User?                          @relation("CorrectionRequestSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedBy            User?                          @relation("CorrectionRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  applications      CorrectionApplication[]
  resultRevisions   ParticipantSettlementResultRevision[]
  supersededClosure ActivitySettlementClosureRevision[]   @relation("ClosureSupersededByCorrection")

  // §11.3 点名的两条:
  @@index([activityId, statusCode], map: "attendance_correction_request_activity_status_idx")
  @@index([participationIdentityId, statusCode], map: "attendance_correction_request_identity_status_idx")
  @@index([settlementRunId], map: "attendance_correction_request_run_idx")
  @@index([baseSettlementVersionId], map: "attendance_correction_request_base_version_idx")
  @@index([operationKey], map: "attendance_correction_request_operation_key_idx")
}

// ===== §3.25 CorrectionApplication:批准后的不可变应用版本 =====
//
// statusCode `preparing/committed/failed/voided` 是过程投影 ⇒ 本行会被 UPDATE,带 updatedAt。
model CorrectionApplication {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  correctionRequestId    String
  newSettlementVersionId String
  newResultRevisionIds   Json // 本次应用产出的 ResultRevision id 列表
  newPostingBatchId      String

  statusCode String // preparing / committed / failed / voided(§3.25 明写四值闭集)

  correctionRequest    AttendanceCorrectionRequest @relation(fields: [correctionRequestId], references: [id], onDelete: Restrict)
  newSettlementVersion AttendanceSettlementVersion @relation("CorrectionApplicationNewVersion", fields: [newSettlementVersionId], references: [id], onDelete: Restrict)
  newPostingBatch      LedgerPostingBatch          @relation("CorrectionApplicationNewBatch", fields: [newPostingBatchId], references: [id], onDelete: Restrict)

  @@index([correctionRequestId], map: "correction_application_request_idx")
  @@index([statusCode], map: "correction_application_status_idx")
  @@index([newSettlementVersionId], map: "correction_application_new_version_idx")
  @@index([newPostingBatchId], map: "correction_application_new_batch_idx")
}

// ===== §3.26 ActivitySettlementClosureRevision:关闭版本 =====
//
// 「不可变」同 EvidenceSeal / SettlementVersion:**内容**不可变,但 statusCode
// `active → superseded` 是投影(§3.26「旧 active closure 在同一事务变 superseded」)
// ⇒ 本行会被 UPDATE,带 updatedAt,不装 append-only trigger。
//
// ⚠️ `serviceHours` / `contributionPoints` 是**整活动合计**,不是单人值
//    ⇒ 精度取 Decimal(12,2) 而非本刀其它表的 (5,2):万人 × 24h 会直接撑爆 999.99。
//    这是**刻意与既有单人列不同型**,不是漂移。
//
// ⚠️ `checksJson` 只存非敏感摘要与失败计数(§3.26 明写「不复制人员明细」)。
model ActivitySettlementClosureRevision {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String
  revision   Int

  settlementVersionId String
  postingBatchId      String
  evidenceSealId      String

  evidenceRevision   Int
  populationRevision Int
  workflowRevision   Int

  personCount               Int
  sessionParticipationCount Int
  resultCountsJson          Json
  serviceHours              Decimal @db.Decimal(12, 2)
  contributionPoints        Decimal @db.Decimal(12, 2)

  checksHash String
  checksJson Json

  statusCode String // active / superseded / voided(§3.26 明写三值闭集)

  closedByUserId String? // 沿本仓 actor FK 一律可空的既有范式
  closedAt       DateTime

  supersededAt             DateTime?
  supersededByCorrectionId String?

  activity          Activity                    @relation(fields: [activityId], references: [id], onDelete: Restrict)
  settlementVersion AttendanceSettlementVersion @relation(fields: [settlementVersionId], references: [id], onDelete: Restrict)
  postingBatch      LedgerPostingBatch          @relation(fields: [postingBatchId], references: [id], onDelete: Restrict)
  evidenceSeal      EvidenceSeal                @relation(fields: [evidenceSealId], references: [id], onDelete: Restrict)
  closedBy          User?                       @relation("ClosureRevisionCloser", fields: [closedByUserId], references: [id], onDelete: Restrict)

  supersededByCorrection AttendanceCorrectionRequest? @relation("ClosureSupersededByCorrection", fields: [supersededByCorrectionId], references: [id], onDelete: Restrict)

  @@unique([activityId, revision], map: "activity_settlement_closure_activity_revision_key")
  @@index([activityId], map: "activity_settlement_closure_activity_idx")
  @@index([statusCode], map: "activity_settlement_closure_status_idx")
  @@index([settlementVersionId], map: "activity_settlement_closure_version_idx")
  @@index([postingBatchId], map: "activity_settlement_closure_batch_idx")
  @@index([evidenceSealId], map: "activity_settlement_closure_seal_idx")
  @@index([supersededByCorrectionId], map: "activity_settlement_closure_superseded_by_idx")
}

// ===== §3.27 ActivityBatchJob:后台任务 =====
//
// §3.27:「复用现有 PostgreSQL `SKIP LOCKED + lease/fencing` 模式,在现有 worker 进程
// 注册 ActivityBatchWorker,**不新增 cron 和外部队列**」⇒ 本刀只建表,
// lease/fencing 列的形状镜像既有 `notification_outbox_intents` 与
// `storage_object_operations`(两表并集恰好就是 §3.27 点名的五列:
// leaseOwner / leaseGeneration / leaseExpiresAt / attempts / availableAt;
// `leaseGeneration` 在 outbox 上没有、在 storage-operation 上有)。
// `availableAt` / `leaseExpiresAt` 沿两表的 `@db.Timestamptz(3)` 逐字同型 ——
// 领取判据要和 `now()` 直接比较,时区语义必须与既有 worker 一致。
model ActivityBatchJob {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // settlement_prepare / bulk_proxy / import_preview / import_execute
  // / export / notification_expand / reconciliation(§3.27 明写七值闭集)
  jobTypeCode String

  activityId          String
  sessionId           String?
  settlementVersionId String?
  postingBatchId      String?

  // pending / processing / succeeded / partial_failed / failed / cancelled / dead
  statusCode String

  operationKey   String  @unique // §3.27 幂等;单列不复合
  requestHash    String?
  payloadVersion Int
  payload        Json

  total     Int @default(0)
  succeeded Int @default(0)
  failed    Int @default(0)
  skipped   Int @default(0)

  // ↓ worker 协议五列,镜像既有 outbox / storage-operation,零新增基础设施。
  leaseOwner      String?
  leaseGeneration Int       @default(0)
  leaseExpiresAt  DateTime? @db.Timestamptz(3)
  attempts        Int       @default(0)
  availableAt     DateTime  @default(now()) @db.Timestamptz(3)

  createdByUserId String? // 沿本仓 actor FK 一律可空的既有范式
  startedAt       DateTime?
  completedAt     DateTime?
  lastErrorCode   String? // 只存编码,不存堆栈/SQL(§3.27)

  activity          Activity                     @relation(fields: [activityId], references: [id], onDelete: Restrict)
  session           ActivitySession?             @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  settlementVersion AttendanceSettlementVersion? @relation(fields: [settlementVersionId], references: [id], onDelete: Restrict)
  postingBatch      LedgerPostingBatch?          @relation(fields: [postingBatchId], references: [id], onDelete: Restrict)
  createdBy         User?                        @relation("ActivityBatchJobCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  items ActivityBatchJobItem[]

  // §11.3 点名的两条:
  @@index([statusCode, availableAt, leaseExpiresAt], map: "activity_batch_job_claim_idx")
  @@index([activityId, createdAt], map: "activity_batch_job_activity_created_idx")
  @@index([leaseExpiresAt], map: "activity_batch_job_lease_expires_idx")
  @@index([jobTypeCode], map: "activity_batch_job_type_idx")
  @@index([sessionId], map: "activity_batch_job_session_idx")
  @@index([settlementVersionId], map: "activity_batch_job_version_idx")
  @@index([postingBatchId], map: "activity_batch_job_batch_idx")
}

// ===== §3.27 ActivityBatchJobItem:逐项进度 =====
//
// 🔴 §3.27 明写「**不存异常堆栈、SQL 和敏感原值**」⇒ 本表只有:
//    `lastErrorCode`(错误编码)、`safeMessage`(已脱敏的可展示文案)、
//    `payloadHash`(摘要,不是原值)、`resultReference`(指针,不是内容)。
//    本刀**没有为原值预留任何字段**,这条在建表时就没有落点,不靠后续代码自律。
//
// ⚠️ 本表 statusCode **刻意不落闭集 CHECK**:§3.27 给了 Job 的七值闭集,
//    却**没给 Item 的取值集**(沿 ④ 不自行发明;第二刀对三处未给闭集同样处置)。
//    已在报告与 PR body 列为合同缺口。
model ActivityBatchJobItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobId   String
  itemKey String

  statusCode    String
  attempts      Int     @default(0)
  lastErrorCode String?
  safeMessage   String?

  // 逐项防重锚点;import_preview 这类「资源尚未创建」的任务此刻没有资源可指
  // ⇒ 两列可空(合同字段表未标 `?`,本刀改可空并上报,沿第二刀同一处置)。
  resourceType String?
  resourceId   String?

  payloadHash     String?
  resultReference String?

  job ActivityBatchJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  punchEvents AttendancePunchEvent[] @relation("PunchEventImportJobItem")

  @@unique([jobId, itemKey], map: "activity_batch_job_item_job_key_key")
  // §11.3 点名的一条:
  @@index([jobId, statusCode], map: "activity_batch_job_item_job_status_idx")
  @@index([resourceType, resourceId], map: "activity_batch_job_item_resource_idx")
}

// ============================================================================
// 活动改造 v1.1 —— 第 6 批:工作人员 / 导入 / 离线主链(2026-08-16)
//
// 维护者批准的补充合同 v1 已补齐 OfflinePackage / OfflinePunchReviewItem 的完整字段表。
// `OfflinePackageParticipant` 是最小必要支持表：只存 roster hash 无法由 DB 证明某永久
// identity 属于被签名的冻结名单。所有状态闭集、hash、窗口、序号和复核形状由 migration
// 的 CHECK / partial unique 守护；运行时仍必须在 Activity 根事务内复验。
// ============================================================================

model OfflinePackage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId       String
  sessionId        String
  operatorUserId   String
  operatorMemberId String
  deviceId         String

  packageVersion    Int
  packageKeyVersion Int    @default(0)
  statusCode        String

  tokenDigest             String
  ruleSnapshotId          String
  ruleSnapshotHash        String
  workflowRevision        Int
  participantSnapshotHash String
  validFrom               DateTime
  validUntil              DateTime
  uploadUntil             DateTime
  sequenceStart           Int
  nextExpectedSequence    Int
  chainAnchorHash         String
  lastAcceptedHash        String
  lastAcceptedAt          DateTime?
  issuedAt                DateTime
  issueOperationKey       String    @unique(map: "offline_package_issue_operation_key_key")
  issueRequestHash        String

  revokedByUserId    String?
  revokedAt          DateTime?
  revokeReason       String?
  revokeOperationKey String?   @unique(map: "offline_package_revoke_operation_key_key")
  revokeRequestHash  String?

  activity       Activity             @relation(fields: [activityId], references: [id], onDelete: Restrict)
  session        ActivitySession      @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  operatorUser   User                 @relation("OfflinePackageOperator", fields: [operatorUserId], references: [id], onDelete: Restrict)
  operatorMember Member               @relation("OfflinePackageOperatorMember", fields: [operatorMemberId], references: [id], onDelete: Restrict)
  ruleSnapshot   ActivityRuleSnapshot @relation(fields: [ruleSnapshotId, activityId], references: [id, activityId], onDelete: Restrict)
  revokedByUser  User?                @relation("OfflinePackageRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  participants OfflinePackageParticipant[]
  reviewItems  OfflinePunchReviewItem[]
  punchEvents  AttendancePunchEvent[]      @relation("OfflinePackagePunchEvents")

  // `id` 单列主键不能作为 PunchEvent/participant 的 activity+session 双锚被引用键。
  @@unique([id, activityId, sessionId], map: "offline_package_id_activity_session_key")
  @@unique([activityId, sessionId, deviceId, packageVersion], map: "offline_package_activity_session_device_version_key")
  @@index([activityId, sessionId, statusCode], map: "offline_package_activity_session_status_idx")
  @@index([operatorUserId, statusCode], map: "offline_package_operator_status_idx")
  @@index([uploadUntil], map: "offline_package_upload_until_idx")
}

model OfflinePackageParticipant {
  offlinePackageId        String
  activityId              String
  sessionId               String
  participationIdentityId String
  memberId                String
  participationRevisionId String
  positionId              String?
  createdAt               DateTime @default(now())

  // 名册是**冻结记录**(只有 createdAt、没有 updatedAt、唯一写者是 createMany)。
  // 四条复合外键一律 `onUpdate: Restrict`:Prisma 的默认 onUpdate 是 Cascade,
  // 上游改编号会让这份名册**跟着被改掉且不留痕**(本表无 updatedAt、无 append-only trigger,
  // 事后没有任何一处能看出它变过)。Restrict 把「改上游编号」变成当场 23503 报错。
  // ⚠️ 单列外键(activity / member / participationRevision)刻意不动 —— 本刀只锁复合锚。
  offlinePackage        OfflinePackage                @relation(fields: [offlinePackageId, activityId, sessionId], references: [id, activityId, sessionId], onDelete: Restrict, onUpdate: Restrict)
  activity              Activity                      @relation(fields: [activityId], references: [id], onDelete: Restrict)
  session               ActivitySession               @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict, onUpdate: Restrict)
  participationIdentity ActivityParticipationIdentity @relation(fields: [participationIdentityId, activityId, sessionId, memberId], references: [id, activityId, sessionId, memberId], onDelete: Restrict, onUpdate: Restrict)
  member                Member                        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  participationRevision ActivityParticipationRevision @relation(fields: [participationRevisionId], references: [id], onDelete: Restrict)
  position              ActivitySessionPosition?      @relation(fields: [positionId, activityId, sessionId], references: [id, activityId, sessionId], onDelete: Restrict, onUpdate: Restrict)

  @@id([offlinePackageId, participationIdentityId], map: "offline_package_participant_pkey")
  @@index([participationIdentityId], map: "offline_package_participant_identity_idx")
  @@index([participationRevisionId], map: "offline_package_participant_revision_idx")
  @@index([positionId], map: "offline_package_participant_position_idx")
}

model OfflinePunchReviewItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offlinePackageId   String
  activityId         String
  sessionId          String
  sequence           Int
  eventKey           String
  statusCode         String
  anomalyCode        String
  approvalPolicyCode String

  participationIdentityId String?
  participationRevisionId String?
  actionCode              String?
  deviceTime              DateTime?
  longitude               Decimal?  @db.Decimal(10, 7)
  latitude                Decimal?  @db.Decimal(9, 7)
  accuracy                Decimal?  @db.Decimal(8, 2)
  providedPriorHash       String?
  eventPayloadHash        String?
  signatureDigest         String?

  stagedByUserId   String
  stagedByMemberId String?
  stagedAt         DateTime

  reviewedByUserId   String?
  reviewedByMemberId String?
  reviewedAt         DateTime?
  reviewReason       String?

  resolutionOperationKey String? @unique(map: "offline_review_item_resolution_operation_key_key")
  resolutionRequestHash  String?
  formalPunchEventId     String? @unique(map: "offline_review_item_formal_punch_event_key")

  offlinePackage        OfflinePackage                 @relation(fields: [offlinePackageId, activityId, sessionId], references: [id, activityId, sessionId], onDelete: Restrict)
  activity              Activity                       @relation(fields: [activityId], references: [id], onDelete: Restrict)
  session               ActivitySession                @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  participationIdentity ActivityParticipationIdentity? @relation(fields: [participationIdentityId, activityId, sessionId], references: [id, activityId, sessionId], onDelete: Restrict)
  participationRevision ActivityParticipationRevision? @relation(fields: [participationRevisionId], references: [id], onDelete: Restrict)
  stagedByUser          User                           @relation("OfflinePunchReviewItemStager", fields: [stagedByUserId], references: [id], onDelete: Restrict)
  stagedByMember        Member?                        @relation("OfflinePunchReviewItemStagerMember", fields: [stagedByMemberId], references: [id], onDelete: Restrict)
  reviewedByUser        User?                          @relation("OfflinePunchReviewItemReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  reviewedByMember      Member?                        @relation("OfflinePunchReviewItemReviewerMember", fields: [reviewedByMemberId], references: [id], onDelete: Restrict)
  formalPunchEvent      AttendancePunchEvent?          @relation("OfflineReviewFormalPunchEvent", fields: [formalPunchEventId, activityId, sessionId], references: [id, activityId, sessionId], onDelete: Restrict)

  @@unique([offlinePackageId, sequence], map: "offline_review_item_package_sequence_key")
  // 1:1 关系的定义侧:Prisma 要求复合外键的本地列也具备 unique。
  // ⚠️ 上方 formalPunchEventId 的单列 @unique **保留不动** —— 只加不减,
  // 否则「一个正式打卡事件至多被一条复核项认领」这条既有保证会被放宽。
  @@unique([formalPunchEventId, activityId, sessionId], map: "offline_review_item_formal_punch_event_activity_session_key")
  @@index([activityId, sessionId, statusCode, createdAt], map: "offline_review_item_activity_session_status_created_idx")
  @@index([offlinePackageId, statusCode], map: "offline_review_item_package_status_idx")
  @@index([participationIdentityId], map: "offline_review_item_identity_idx")
  @@index([participationRevisionId], map: "offline_review_item_revision_idx")
}

// ============================================================================
// 活动改造 v1.1 —— 第 1 批第五刀:分配 / 志愿 / 候补 / 预留名额
// (2026-08-04;合同 docs/archive/reviews/activity-business-overhaul-v1.1/
//  SRVF_活动业务全流程改造_详细开发文档_v1.1.md §3.11)
//
// ⚠️ **本刀的存在本身是在补合同的洞**:§3.11 这四张表**没有被 §14「第 1 批」建议拆分
// 的任何一条列入**(那四条是 Activity/Session/Participation/Capacity、
// Form/Qualification/Invitation、Punch/Evidence、Settlement/Ledger/Correction/
// Closure/Job),而 §14「第 4 批」的交付清单里明写要用 Allocation 与 Waitlist。
// 这是合同的**第四处内部矛盾**;维护者 2026-08-04 拍板**单独第五刀补齐**,
// 不并进第四刀(账本链语义像钱,不与不相干的分配表混刀)。
//
// 与前四刀同口径:纯 schema expand,**四张新表零调用方**是预期状态 —— 不接线、
// 不写 service / controller / DTO / policy / presenter,消费方在第 4 批。
// ⚠️ 特别是**抽签**:`randomCommitment` 只是一个列,本刀**不实现任何随机数逻辑**。
//
// 命名:不使用 @@map,物理表名即 PascalCase model 名(沿前四刀)。
// 状态类字段一律 String + migration CHECK 闭集兜底,不建 Prisma enum(§3 前言)。
// model 名普遍 ≥ 23 字符 ⇒ 所有 @@unique / @@index 一律显式 map:,
// 免 PG 63 字符静默截断(沿第三 / 第四刀)。
//
// 🔴 §3.11 对后两张表**只给了散文、没给字段表**。沿本批次一贯口径④「合同没给的
//    一律不发明」:**只落散文明确点到的那些**,拿不准的宁可不建 ——
//    逐列依据与「散文提到但刻意未建」清单见 PR body。
// ============================================================================

// ===== §3.11 ActivityPositionPreference:岗位志愿 =====
//
// 合同原文:`registrationRevisionId/sessionId/positionId/preferenceOrder`,
// unique `(registrationRevisionId, sessionId, preferenceOrder)` 和
// `(registrationRevisionId, sessionId, positionId)` —— 两条**缺一不可**:
// 前者拦「同一场次里两个岗位抢同一个志愿序位」,后者拦「同一岗位被填两次志愿」。
//
// 不可变模型 ⇒ 按合同 §3 前言**不带 updatedAt / deletedAt**:志愿挂在**不可变的**
// ActivityRegistrationRevision 上,改志愿 = 追加新报名修订(§3.7),不是原地改行。
//
// ⚠️ 本表**没有 activityId**,故 sessionId 走**单列** FK 而非前几刀的
//    (activityId, sessionId) 双锚点复合 FK —— 合同字段表只给了四列,
//    按④不自行加聚合根列。「志愿的场次与报名的活动一致」是跨表判据,归第 4 批 service。
model ActivityPositionPreference {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  registrationRevisionId String
  sessionId              String
  positionId             String
  preferenceOrder        Int // >= 1(migration CHECK)

  registrationRevision ActivityRegistrationRevision @relation(fields: [registrationRevisionId], references: [id], onDelete: Restrict)
  session              ActivitySession              @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  position             ActivitySessionPosition      @relation(fields: [positionId], references: [id], onDelete: Restrict)

  // 🟢 两条 unique 的键列**全 NOT NULL** ⇒ 不需要 NULLS NOT DISTINCT。
  @@unique([registrationRevisionId, sessionId, preferenceOrder], map: "activity_position_preference_order_key")
  @@unique([registrationRevisionId, sessionId, positionId], map: "activity_position_preference_position_key")
  @@index([sessionId], map: "activity_position_preference_session_idx")
  @@index([positionId], map: "activity_position_preference_position_idx")
}

// ===== §3.11 ActivityAllocationBatch:分配批次 =====
//
// 合同字段表(§3.11 唯一给了字段的两张表之一):
//   `activityId/sessionId/positionId?` · `modeCode` 三值闭集 ·
//   `candidateSnapshotHash/ruleSnapshotId/randomCommitment?` ·
//   `statusCode` 三值闭集 · `operationKey/requestHash/createdBy/committedAt`
//
// ⚠️ **`ruleSnapshotId` 第 1 批第五刀未建**:它指向 §3.4 的 `ActivityRuleSnapshot`,
//    目标表当时尚未建(§14 第 3 批「Template snapshot」才实现)。
//    沿 goal ②「跨切片外键列不提前占位」—— 提前建一列指向不存在的表,
//    既加不了外键也无人写入,正是前三刀反复拒绝的形态。
//    ⇒ 第 3 批①.5 建表时已**连列带 FK 一起补上**(兑现该刀欠账)。
//
// ⚠️ `committedAt` 改可空(合同字段表未标 `?`):§3.11 自己的 `statusCode` 闭集里
//    有 `preparing` —— 那一刻批次尚未提交,NOT NULL 会让 preparing 态根本写不进来,
//    合同自相矛盾(沿第二 / 三 / 四刀同一处置口径)。
// ⚠️ `requestHash` 可空、`createdBy` 命名为 `createdByUserId` 且可空:
//    前者沿全仓 requestHash 一律可空的既有范式(9 处无一例外),
//    后者沿本仓 actor FK 一律可空的既有范式。
// ✅ `candidateSnapshotHash` **保持 NOT NULL**:同一条 bullet 里作者对
//    `positionId` 与 `randomCommitment` 显式标了 `?`,说明"未标 = 必填"是刻意的;
//    且找不到任何合同条款定义"该哈希此刻不存在"的合法形态,故不放宽。
model ActivityAllocationBatch {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId     String
  sessionId      String
  positionId     String? // null = 场次级批次(不限定岗位)
  // §3.11:由建 §3.4 ActivityRuleSnapshot 的本刀连列带 FK 补齐;null = 尚未消费快照的旧／草稿批次。
  ruleSnapshotId String?

  modeCode String // first_come / qualification_rank / lottery(§3.11 明写闭集)

  candidateSnapshotHash String
  // 非闭集算法版本；历史批次必须能按保存的版本原样重放，未来升级不改旧行。
  algorithmVersionCode  String
  // §5.4 抽签:「保存 random commitment 和实现版本」。非抽签模式无 commitment ⇒ 可空。
  randomCommitment      String?
  // lottery 提交前只保存 commitment；提交后保存 64 位十六进制 seed reveal。
  randomSeedReveal      String?

  statusCode String // preparing / committed / voided(§3.11 明写闭集)

  // 🔴 幂等键取**单列** unique 而非 (operationKey, requestHash) 复合 ——
  //    复合唯一恰好放行「同一个 key 配不同 payload」,那正是幂等键要拦的冲突
  //    (第二刀实测)。单列唯一严格蕴含复合唯一,故同时满足合同字面。
  operationKey String  @unique(map: "activity_allocation_batch_operation_key_key")
  requestHash  String?

  createdByUserId String?
  committedAt     DateTime?
  // D86:作废必须留下业务事实；actor 可由同批唯一 void command receipt 精确追溯，避免双写。
  voidReason      String?
  voidedAt        DateTime?

  activity     Activity                 @relation(fields: [activityId], references: [id], onDelete: Restrict)
  // 复合 FK(activityId, sessionId)→ ActivitySession(activityId, id):沿第一刀,
  // 让「场次属于该活动」由 DB 保证,而不是只靠 service 自觉。
  session      ActivitySession          @relation(fields: [activityId, sessionId], references: [activityId, id], onDelete: Restrict)
  position     ActivitySessionPosition? @relation("AllocationBatchPosition", fields: [positionId, activityId, sessionId], references: [id, activityId, sessionId], onDelete: Restrict)
  ruleSnapshot ActivityRuleSnapshot?    @relation(fields: [ruleSnapshotId, activityId], references: [id, activityId], onDelete: Restrict)
  createdBy    User?                    @relation("AllocationBatchCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  candidates             ActivityAllocationCandidate[]
  commandReceipts        ActivityAllocationCommandReceipt[]        @relation("AllocationBatchCommandReceipts")
  applicationProjections ActivityAllocationApplicationProjection[] @relation("AllocationBatchApplicationProjections")
  // §3.9 的 ActivityParticipationRevision.allocationBatchId 反向侧(本刀兑现第一刀欠账)
  participationRevisions ActivityParticipationRevision[]

  @@unique([id, activityId], map: "activity_allocation_batch_id_activity_unique")
  @@unique([id, activityId, sessionId], map: "activity_allocation_batch_id_activity_session_unique")
  @@index([activityId], map: "activity_allocation_batch_activity_idx")
  @@index([sessionId], map: "activity_allocation_batch_session_idx")
  @@index([positionId], map: "activity_allocation_batch_position_idx")
  @@index([ruleSnapshotId], map: "activity_allocation_batch_rule_snapshot_idx")
  @@index([statusCode], map: "activity_allocation_batch_status_idx")
  @@index([modeCode], map: "activity_allocation_batch_mode_idx")
}

// ===== §3.11 ActivityAllocationCandidate:候选人评分与结果 =====
//
// 🔴 合同**只给散文不给字段表**:「保存 identity、资格评分、稳定 tie-break、
//    抽签序号、最终结果、候补序号和解释。结果 committed 后不可改。」
//    ⇒ 按④只落散文**明确点到**的七项(+ 批次锚点),逐项依据:
//      · batch 锚点 `allocationBatchId` —— 结构必需,非发明:表名即「批次的候选人」,
//        §11.4「候补排名由 AllocationCandidate 可索引 rank 读取」与
//        §3.11「候补查询从最新 committed allocation batch 读取」都要求 batch → candidates。
//      · identity            → `participationIdentityId`(沿全仓既有列名)
//      · 资格评分            → `qualificationScore`,可空(§5.4 只有 qualification_rank
//                              模式产生评分;lottery 用资格做闸门不做排序)
//      · 稳定 tie-break      → `tieBreakKey` String,NOT NULL(它是"稳定"排序的锚,
//                              取 String 而非 Int 是为了同时容纳 序号 / 哈希 / 复合键 三种实现)
//      · 抽签序号            → `lotteryOrder` Int?,仅 lottery 模式有
//      · 最终结果            → `resultCode` String?,preparing 期尚未定(见下)
//      · 候补序号            → `waitlistRank` Int?,仅候补者有
//                              (与 ActivityParticipationRevision.waitlistRank 同名同型)
//      · 解释                → `explanation` Json?,取 Json 而非 String:§5.4「保存**每项**
//                              评分和 tie-break」指向逐规则明细,结构化存放;
//                              纯文本亦是合法 JSON,不损失表达力。
//
// `resultCode` 保持可空:preparing 期尚未形成结果。维护者 2026-08-07 对缺口⑤拍板，
// 非空仅 allocated / waitlisted / not_selected；第 80 migration 以 CHECK 落库。
//
// 🔴 **刻意不装 append-only trigger**,理由不止一条先例:
//    ① 先例:合同这里说的是「结果 **committed 后**不可改」,**没有**像 §3.23.8
//       那样点名"DB 角色层禁 UPDATE/DELETE"。§3.17 EvidenceSeal(第三刀)与
//       §3.19 SettlementReviewAction(第四刀)都按「合同没点名 ⇒ 不装」处理,本刀沿这条。
//    ② 更硬的正面理由:这里是**条件不可变**,不是 append-only。批次 preparing 期
//       正要往候选行里写评分 / 抽签序号 / 结果,一条无条件 append-only trigger 会把
//       **合法写路径直接堵死**——装上就是错的。
//    ③ 而"按父批次 statusCode 判"的条件 trigger 是**跨行**判据:行级 trigger 里读
//       父批次在并发下会骗人(两事务互相看不见对方未提交的 status 变更),
//       与第四刀「日合计求和 trigger 在并发下骗人」同型。执行位归第 4 批 service
//       (Activity 锁内重读批次状态)。
//    ⇒ 用两条会变红的 e2e 钉死"刻意":①preparing 期 UPDATE 必须放行
//       ②本表零 trigger。
//
// 同一 `(allocationBatchId, participationIdentityId)` 永久唯一(维护者 2026-08-07
// 对缺口⑤拍板)。两键均 NOT NULL，普通 unique 即可，不需要 NULLS NOT DISTINCT。
model ActivityAllocationCandidate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocationBatchId         String
  // D87：Candidate 自身冻结 batch 的活动/场次事实；两列必填且不靠 runtime 回推。
  activityId                String
  sessionId                 String
  // 仅 waitlisted 结果非空；与 activityId/sessionId 一起复合锚定真实场次岗位。
  waitlistPositionId        String?
  participationIdentityId   String
  registrationId            String
  registrationRevisionId    String
  acceptedAt                DateTime
  qualificationSnapshotHash String

  qualificationScore Decimal? @db.Decimal(12, 4)
  tieBreakKey        String
  lotteryOrder       Int?

  resultCode   String?
  waitlistRank Int?
  explanation  Json

  allocationBatch        ActivityAllocationBatch                   @relation(fields: [allocationBatchId, activityId, sessionId], references: [id, activityId, sessionId], onDelete: Restrict, onUpdate: Restrict, map: "activity_allocation_candidate_batch_anchor_fkey")
  waitlistPosition       ActivitySessionPosition?                  @relation("AllocationCandidateWaitlistPosition", fields: [activityId, sessionId, waitlistPositionId], references: [activityId, sessionId, id], onDelete: Restrict, onUpdate: Restrict, map: "activity_allocation_candidate_waitlist_position_fkey")
  participationIdentity  ActivityParticipationIdentity             @relation(fields: [participationIdentityId, registrationId, activityId, sessionId], references: [id, registrationId, activityId, sessionId], onDelete: Restrict, onUpdate: Restrict, map: "activity_allocation_candidate_identity_registration_fkey")
  registrationRevision   ActivityRegistrationRevision              @relation(fields: [registrationId, registrationRevisionId], references: [registrationId, id], onDelete: Restrict, onUpdate: Restrict, map: "activity_allocation_candidate_registration_revision_fkey")
  // Prisma 对复合 FK + 被引用方单列 unique 无法同时表达 1:1；DB 的 projection
  // candidate 单列 unique 才是权威一对一保证，关系仍保留完整同 batch/identity 锚。
  applicationProjections ActivityAllocationApplicationProjection[] @relation("AllocationCandidateApplicationProjection")

  // §11.4 明写「候补排名由 AllocationCandidate **可索引 rank** 读取,
  // 不在每次列表对全队列重新排序」⇒ 这条索引是合同点名的,不是盲加。
  @@unique([allocationBatchId, participationIdentityId], map: "activity_allocation_candidate_batch_identity_key")
  @@unique([id, allocationBatchId, participationIdentityId], map: "activity_allocation_candidate_id_batch_identity_unique")
  @@unique([allocationBatchId, tieBreakKey], map: "activity_allocation_candidate_batch_tie_break_key")
  // 业务复合锚点闭合(第六轮评审 A-2 / B-03):被引用侧锚点 —— PostgreSQL 复合外键
  // 要求被引用列上有**精确匹配**的 unique;id 单列主键不能替代。仅作 FK 靶点,不新增业务约束。
  @@unique([id, allocationBatchId, participationIdentityId, activityId, sessionId], map: "activity_allocation_candidate_id_batch_identity_act_sess_key")
  @@index([allocationBatchId, waitlistPositionId, waitlistRank], map: "activity_allocation_candidate_batch_position_rank_idx")
  @@index([allocationBatchId], map: "activity_allocation_candidate_batch_idx")
  @@index([participationIdentityId], map: "activity_allocation_candidate_identity_idx")
  @@index([registrationId, registrationRevisionId], map: "activity_allocation_candidate_registration_revision_idx")
}

// ===== D86 ActivityAllocationCommandReceipt:三阶段 command 的不可变精确回执 =====
//
// 本表只保存安全传输回执，不保存 allocation/void 真值；真值仍是 Batch、Candidate、
// ParticipationRevision 与 CapacityReservation。responseReceipt 的 v1 形状由 migration
// 函数精确白名单，故不能携带 L3、未揭示 seed 或未来未声明字段。
model ActivityAllocationCommandReceipt {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  activityId            String
  allocationBatchId     String
  commandCode           String // prepare / commit / void
  operationKey          String
  requestHash           String // SHA-256 hex; future command checks same key's exact hash before replay
  responseSchemaVersion String
  responseHash          String
  responseReceipt       Json
  actorUserId           String

  // 同批次/活动锚由复合 FK 物理保证，不能退化成只按 batch id 的关系。
  allocationBatch ActivityAllocationBatch @relation("AllocationBatchCommandReceipts", fields: [allocationBatchId, activityId], references: [id, activityId], onDelete: Restrict, onUpdate: Restrict, map: "activity_allocation_command_receipt_batch_anchor_fkey")
  actor           User                    @relation("AllocationCommandReceiptActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "activity_allocation_command_receipt_actor_fkey")

  @@unique([activityId, commandCode, operationKey], map: "activity_allocation_command_receipt_activity_command_key")
  @@unique([allocationBatchId, commandCode], map: "activity_allocation_command_receipt_batch_command_key")
  @@index([allocationBatchId], map: "activity_allocation_command_receipt_batch_idx")
  @@index([actorUserId, createdAt], map: "activity_allocation_command_receipt_actor_created_idx")
}

// ===== D86 ActivityAllocationApplicationProjection:committed 后不可变应用投影 =====
//
// 一名 candidate 至多一行。activity/session/batch/identity/revision/reservation/bucket 的
// 实体锚点以 migration 的复合 FK 固定；Batch 当前 committed 状态、Candidate/Revision
// 内容与 Identity 当前 pointer 的实时一致性必须留给后续 Activity 根锁命令在同一事务复核。
model ActivityAllocationApplicationProjection {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  appliedAt DateTime

  activityId                     String
  sessionId                      String
  allocationBatchId              String
  allocationCandidateId          String
  participationIdentityId        String
  memberId                       String
  appliedParticipationRevisionId String

  appliedResultCode  String // allocated / waitlisted / not_selected
  appliedStatusCode  String // pass / waitlisted / not_selected
  positionId         String?
  populationIncluded Boolean

  // 对应 Identity.capacityReservationId 的期望值。allocated 时必须等于 session reservation；
  // 该快速 pointer 本身按既有决策没有 FK，后续根锁命令必须复核 live identity。
  expectedIdentityCapacityReservationId String?
  activityPersonReservationId           String?
  activityPersonBucketId                String?
  sessionReservationId                  String?
  sessionBucketId                       String?
  positionReservationId                 String?
  positionBucketId                      String?

  allocationBatch              ActivityAllocationBatch       @relation("AllocationBatchApplicationProjections", fields: [allocationBatchId, activityId, sessionId], references: [id, activityId, sessionId], onDelete: Restrict, onUpdate: Restrict, map: "activity_allocation_application_projection_batch_anchor_fkey")
  allocationCandidate          ActivityAllocationCandidate   @relation("AllocationCandidateApplicationProjection", fields: [allocationCandidateId, allocationBatchId, participationIdentityId, activityId, sessionId], references: [id, allocationBatchId, participationIdentityId, activityId, sessionId], onDelete: Restrict, onUpdate: Restrict, map: "activity_allocation_app_projection_candidate_anchor_fkey")
  // memberId 是 committed 时冻结的 identity 事实；四元 FK 防止同 activity/session
  // 的 identity 与 member 被拼接。activity_person reservation 则按 member/activity
  // 锚定，允许同一 member 的不同 session identity 正确复用那一条 reservation。
  participationIdentity        ActivityParticipationIdentity @relation("AllocationApplicationProjectionIdentity", fields: [participationIdentityId, activityId, sessionId, memberId], references: [id, activityId, sessionId, memberId], onDelete: Restrict, onUpdate: Restrict, map: "activity_allocation_app_projection_identity_anchor_fkey")
  appliedParticipationRevision ActivityParticipationRevision @relation("AllocationApplicationProjectionAppliedRevision", fields: [appliedParticipationRevisionId, allocationBatchId, participationIdentityId], references: [id, allocationBatchId, identityId], onDelete: Restrict, onUpdate: Restrict, map: "activity_allocation_app_projection_revision_anchor_fkey")
  position                     ActivitySessionPosition?      @relation("AllocationApplicationProjectionPosition", fields: [activityId, sessionId, positionId], references: [activityId, sessionId, id], onDelete: Restrict, onUpdate: Restrict, map: "activity_allocation_app_projection_position_anchor_fkey")
  activityPersonReservation    CapacityReservation?          @relation("AllocationApplicationProjectionActivityPersonReservation", fields: [activityPersonReservationId, memberId, activityId, activityPersonBucketId], references: [id, memberId, activityId, bucketId], onDelete: Restrict, onUpdate: Restrict, map: "activity_allocation_app_projection_activity_reservation_fkey")
  sessionReservation           CapacityReservation?          @relation("AllocationApplicationProjectionSessionReservation", fields: [sessionReservationId, participationIdentityId, sessionBucketId], references: [id, identityId, bucketId], onDelete: Restrict, onUpdate: Restrict, map: "activity_allocation_app_projection_session_reservation_fkey")
  positionReservation          CapacityReservation?          @relation("AllocationApplicationProjectionPositionReservation", fields: [positionReservationId, participationIdentityId, positionBucketId], references: [id, identityId, bucketId], onDelete: Restrict, onUpdate: Restrict, map: "activity_allocation_app_projection_position_reservation_fkey")
  activityPersonBucket         ActivityCapacityBucket?       @relation("AllocationApplicationProjectionActivityPersonBucket", fields: [activityPersonBucketId, activityId], references: [id, activityId], onDelete: Restrict, onUpdate: Restrict, map: "activity_allocation_app_projection_activity_bucket_fkey")
  sessionBucket                ActivityCapacityBucket?       @relation("AllocationApplicationProjectionSessionBucket", fields: [sessionBucketId, activityId], references: [id, activityId], onDelete: Restrict, onUpdate: Restrict, map: "activity_allocation_app_projection_session_bucket_fkey")
  positionBucket               ActivityCapacityBucket?       @relation("AllocationApplicationProjectionPositionBucket", fields: [positionBucketId, activityId], references: [id, activityId], onDelete: Restrict, onUpdate: Restrict, map: "activity_allocation_app_projection_position_bucket_fkey")

  @@unique([allocationCandidateId], map: "activity_allocation_application_projection_candidate_key")
  @@unique([allocationBatchId, participationIdentityId], map: "activity_allocation_application_projection_batch_identity_key")
  @@index([allocationBatchId], map: "activity_allocation_application_projection_batch_idx")
  @@index([participationIdentityId], map: "activity_allocation_application_projection_identity_idx")
  @@index([appliedParticipationRevisionId], map: "activity_allocation_application_projection_revision_idx")
}

// ===== §3.11 ActivityReservedQuotaGroup:预留名额组 =====
//
// 🔴 合同**只给散文不给字段表**:「scope、资格条件版本、capacity、releaseAt、
//    fallbackMode。释放到公共池时走 Activity 锁和 capacity transaction。」
//    ⇒ 按④只落散文明确点到的五项(+ 聚合根锚点),逐项依据:
//      · 聚合根 `activityId` —— 非发明:同段原话「释放…走 **Activity 锁**」要求本表
//        归属某个活动;且 §3.10 的姊妹表 ActivityCapacityBucket 同样是
//        「activityId 聚合根 + scopeTypeCode/scopeId」两段式。
//      · scope             → `scopeTypeCode` + `scopeId`,**逐字沿 §3.10 的 scope 惯用法**
//                            (§3.10 的 scopeTypeCode 闭集里就有 `reserve_group`,
//                             其 scopeId 指的正是本表的行 ⇒ 两表 scope 语义同族)。
//                            多态 id ⇒ **不加 FK**(沿 ActivityCapacityBucket.scopeId
//                            与 role_bindings.principalId 的既有范式)。
//      · 资格条件版本      → `qualificationRuleSetId`,可空,FK → ActivityQualificationRuleSet
//                            (§3.13,第二刀已建;该表自带 `version` 列 ⇒ 指向它就是
//                             指向"资格条件的某个版本")。可空 = 不附加资格条件的预留组。
//      · capacity          → `capacity` Int?,null 不限;有值 >= 1(migration CHECK,DoD 3)
//      · releaseAt         → `releaseAt` DateTime,**保持 NOT NULL**(散文未标可空,
//                            也找不到合同条款定义"没有释放时刻"的合法形态)
//      · fallbackMode      → `fallbackMode`,**逐字用合同的 token**(未加 `Code` 后缀:
//                            合同在同一节里对闭集字段写的是 `modeCode`、对本列写的是
//                            `fallbackMode`,这个区别照抄)
//
// 维护者 2026-08-07 对缺口⑤拍板：scope 沿 §3.10 容量桶闭集；fallback 仅释放公共池
// 或到期作废，默认释放公共池。第 80 migration 以 CHECK 和 DB default 落库。
model ActivityReservedQuotaGroup {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityId String // 聚合根(§3.11「释放到公共池时走 Activity 锁」)

  // activity_person / session_participation / position_participation / reserve_group
  // 多态 scope,沿 §3.10 ActivityCapacityBucket 同一形状 ⇒ scopeId 不加 FK。
  scopeTypeCode String
  scopeId       String

  qualificationRuleSetId String?

  capacity     Int? // null 不限;有值 >= 1
  releaseAt    DateTime
  fallbackMode String   @default("release_to_public_pool")

  activity             Activity                      @relation(fields: [activityId], references: [id], onDelete: Restrict)
  qualificationRuleSet ActivityQualificationRuleSet? @relation(fields: [qualificationRuleSetId], references: [id], onDelete: Restrict)

  @@index([activityId], map: "activity_reserved_quota_group_activity_idx")
  @@index([scopeTypeCode, scopeId], map: "activity_reserved_quota_group_scope_idx")
  @@index([releaseAt], map: "activity_reserved_quota_group_release_idx")
  @@index([qualificationRuleSetId], map: "activity_reserved_quota_group_ruleset_idx")
}
